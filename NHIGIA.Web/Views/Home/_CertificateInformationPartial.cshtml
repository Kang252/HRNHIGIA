<script src="@Url.Content("~/Scripts/app/controller/CertificateInformationController.js")"></script>
<div class="container-fluid" ng-controller="CertificateInformationController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-if="HideButton" ng-click="ShowPopupCertificate('ADD_CERTIFICATE')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:120px;">Số chứng chỉ</th>
                            <th style="max-width:180px;">Tên chứng chỉ</th>
                            <th style="max-width:140px;">Nhóm chứng chỉ</th>
                            <th style="max-width:140px;">Ngày cấp</th>
                            <th style="max-width:140px;">Ngày hết hạn</th>
                            <th style="max-width: 130px;">Xếp loại</th>
                            <th ng-if="GetAllCertificateInformation.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllCertificateInformation.length > 0" ng-repeat="item in GetAllCertificateInformation">
                            <td>{{item.NumberOfCertificates}}</td>
                            <td>{{item.CertificateName}}</td>
                            <td>{{item.CertificateName}}</td>
                            <td>{{item.DateRangeString}}</td>
                            <td>{{item.ExpirationDateString}}</td>
                            <td>{{item.ClassificationName}}</td>
                            <td>
                                <a ng-click="ShowPopupCertificate('EDIT_CERTIFICATE',item.Id)">
                                    <i class="material-icons" ng-if="HideButton" style="color:#0c68b4;">mode_edit</i>
                                    <i class="material-icons" ng-if="ShowButton" style="color:#0c68b4;">remove_red_eye</i>
                                </a>
                                <a ng-if="HideButton" ng-click="ShowPopupCertificate('DELETE_CERTIFICATE',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllCertificateInformation.length === 0">
                            <td colspan="6" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("CertificateInformation", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidCertificate", @id = "ValidCertificate", @novalidate = "novalidate" }))
    {
        <div id="KenWindownCertificate" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="height: 400px; margin: 0 -15px 15px 0; overflow: auto; overflow-x: hidden;">
                <div class="row m-t--10">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Nhóm chứng chỉ <span class="asterisk">*</span>
                        </label>
                        <select kendo-drop-down-list
                                id="CertificateGroupId"
                                name="CertificateGroupId"
                                ng-model="modelCertificate.CertificateGroupId"
                                k-data-source="CertificateGroupDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                k-filter="'contains'"
                                class="Dropdownlist-Custom"
                                ng-class="{'has-error': showHasErrorCertificateGroupId}"
                                title="{{MessageErrorForSelect}}"
                                ng-change="onChangeValueCertificate('CertificateGroupId')"></select>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Tên chứng chỉ <span class="asterisk">*</span>
                        </label>
                        <input class="form-control"
                               name="CertificateName"
                               id="CertificateName"
                               ng-model="modelCertificate.CertificateName"
                               ng-class="{'has-error': showHasErrorCertificateName}"
                               title="{{MessageErrorForSelect}}"
                               ng-change="onChangeValueCertificate('CertificateName')"
                               maxlength="100"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Số chứng chỉ
                        </label>
                        <input class="form-control"
                               name="NumberOfCertificates"
                               id="NumberOfCertificates"
                               ng-model="modelCertificate.NumberOfCertificates"
                               maxlength="100"
                               autocomplete="off" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Trình độ đào tạo
                        </label>
                        <select kendo-drop-down-list
                                id="DegreeTrainingIdCertificate"
                                name="DegreeTrainingIdCertificate"
                                k-filter="'contains'"
                                ng-model="modelCertificate.DegreeTrainingId"
                                k-data-source="DegreeTrainingDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Ngày cấp
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelCertificate.DateRange"
                               id="DateRangeCertificate"
                               name="DateRangeCertificate"
                               ng-model="modelCertificate.DateRange"
                               placeholder="dd/MM/yyyy">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Ngày hết hạn
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelCertificate.ExpirationDate"
                               id="ExpirationDateCertificate"
                               name="ExpirationDateCertificate"
                               ng-model="modelCertificate.ExpirationDate"
                               ng-class="{'has-error': CheckExpirationDate}"
                               title="{{MessageCheckExpirationDate}}"
                               placeholder="dd/MM/yyyy">
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                        <label>
                            Nơi cấp
                        </label>
                        <textarea class="form-control"
                                  name="IssuedBy"
                                  id="IssuedBy"
                                  ng-model="modelCertificate.IssuedBy"
                                  maxlength="100"
                                  rows="5"
                                  autocomplete="off"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                        <label>
                            Xếp loại
                        </label>
                        <select kendo-drop-down-list
                                id="ClassificationIdCertificate"
                                name="ClassificationIdCertificate"
                                k-filter="'contains'"
                                ng-model="modelCertificate.ClassificationId"
                                k-data-source="ClassificationDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                        <label>
                            Ghi chú
                        </label>
                        <textarea class="form-control"
                                  name="NoteCertificate"
                                  id="NoteCertificate"
                                  ng-model="modelCertificate.Note"
                                  maxlength="100"
                                  autocomplete="off"
                                  rows="5"></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveCertificate"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-if="HideButton"
                                ng-click="SaveCertificate()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseCertificate"
                                ng-click="CloseCertificate()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>