<div class="row m-r-0">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 margin-bottom-5 m-t--25">
        <div class="form-group image-style">
            <input ng-show="false"
                   name="Image"
                   id="ImageLabel"
                   ng-model="model.Image" />
            <div name="Image"
                 style="width: 160px; margin: 0 auto; padding: 0; height: 160px; cursor: pointer; margin-top: 30px; background-repeat: no-repeat; background-size: contain; background-image: url('{{model.Image}}');"
                 id="ImagePic" ng-click="ChoonseImage()"></div>
        </div>
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Mã nhân viên</label>
        <input class="form-control"
               name="EmployeeCode"
               id="EmployeeCode"
               ng-model="model.EmployeeCode"
               disabled
               maxlength="50"
               autocomplete="off" />
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Đơn vị công tác <span class="asterisk">*</span></label>
        <select kendo-drop-down-list
                id="WorkUnitId"
                name="WorkUnitId"
                k-filter="'contains'"
                ng-model="model.WorkUnitId"
                k-data-source="WorkUnitDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"
                ng-class="{'has-error': showErrorMsg(Valid.WorkUnitId)}"
                required
                title="{{MessageErrorForSelect}}"
                ng-disabled="DisableInput"></select>
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Họ và tên <span class="asterisk">*</span></label>
        <input class="form-control"
               name="EmployeeName"
               id="EmployeeName"
               ng-model="model.EmployeeName"
               maxlength="50"
               ng-class="{'has-error': showErrorMsg(Valid.EmployeeName)}"
               required
               title="{{MessageErrorForInput}}"
               autocomplete="off" />
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Vị trí công việc <span class="asterisk">*</span></label>
        <select kendo-drop-down-list
                id="JobPositionId"
                name="JobPositionId"
                k-filter="'contains'"
                ng-model="model.JobPositionId"
                k-data-source="JobPositionDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"
                ng-class="{'has-error': showErrorMsg(Valid.JobPositionId)}"
                required
                title="{{MessageErrorForSelect}}"></select>
    </div>
</div>
