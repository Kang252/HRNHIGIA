<script src="@Url.Content("~/Scripts/app/controller/ContractInformationController.js")"></script>
<div class="container-fluid" ng-controller="ContractInformationController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-if="HideButton" ng-click="ShowPopupContract('ADD_CONTRACT')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:200px;">Trạng thái hợp đồng</th>
                            <th style="max-width:180px;">Số hợp đồng</th>
                            <th style="max-width:120px;">Loại hợp đồng</th>
                            <th style="max-width:180px;">Thời hạn hợp đồng</th>
                            <th style="max-width: 130px;">Vị trí công việc</th>
                            <th ng-if="GetAllContractInformation.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllContractInformation.length > 0" ng-repeat="item in GetAllContractInformation">
                            <td>
                                <div class="statusIconGreen" ng-if="item.ExpirationDateValue === '1'"></div>
                                <div class="statusIconGray" ng-if="item.ExpirationDateValue === '0'"></div>
                                {{item.ExpirationDateString}}
                            </td>
                            <td>{{item.SomeContracts}}</td>
                            <td>{{item.ContractTypeName}}</td>
                            <td>{{item.ContractTermName}}</td>
                            <td>{{item.JobPositionName}}</td>
                            <td>
                                <a ng-click="ShowPopupContract('EDIT_CONTRACT',item.Id)">
                                    <i class="material-icons" style="color:#0c68b4;" ng-if="item.ExpirationDateValue === '1' && HideButton">mode_edit</i>
                                    <i class="material-icons" style="color:#0c68b4;" ng-if="item.ExpirationDateValue === '1' && ShowButton">remove_red_eye</i>
                                </a>
                                <a ng-click="ShowPopupContract('VIEW_CONTRACT',item.Id)"><i class="material-icons" style="color:#0c68b4;" ng-if="item.ExpirationDateValue === '0'">remove_red_eye</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllContractInformation.length === 0">
                            <td colspan="5" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("ContractInformation", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidContract", @id = "ValidContract", @novalidate = "novalidate" }))
    {
        <div id="KenWindownContract" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="height: 400px; margin: 0 -15px 15px 0; overflow: auto; overflow-x: hidden;">
                <div class="row m-t--10">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Họ và tên NLĐ
                        </label>
                        <input class="form-control"
                               name="EmployeeNameContract"
                               id="EmployeeNameContract"
                               ng-model="modelContract.EmployeeName"
                               maxlength="100"
                               disabled />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Mã nhân viên
                        </label>
                        <input class="form-control"
                               name="EmployeeCodeContract"
                               id="EmployeeCodeContract"
                               ng-model="modelContract.EmployeeCode"
                               maxlength="100"
                               disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Vị trí công việc
                        </label>
                        <select kendo-drop-down-list
                                id="JobPositionIdContract"
                                name="JobPositionIdContract"
                                k-filter="'contains'"
                                ng-model="modelContract.JobPositionId"
                                k-data-source="JobPositionDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Số hợp đồng
                        </label>
                        <input class="form-control"
                               name="SomeContracts"
                               id="SomeContracts"
                               ng-model="modelContract.SomeContracts"
                               maxlength="100"
                               autocomplete="off"
                               disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Đơn vị công tác
                        </label>
                        <select kendo-drop-down-list
                                id="WorkUnitIdContract"
                                name="WorkUnitIdContract"
                                k-filter="'contains'"
                                ng-model="modelContract.WorkUnitId"
                                k-data-source="WorkUnitDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Ngày ký
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelContract.SignDay"
                               id="SignDay"
                               name="SignDay"
                               ng-model="modelContract.SignDay"
                               placeholder="dd/MM/yyyy">
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                        <label>
                            Tên hợp đồng <span class="asterisk">*</span>
                        </label>
                        <input class="form-control"
                               name="ContractName"
                               id="ContractName"
                               ng-model="modelContract.ContractName"
                               maxlength="100"
                               autocomplete="off"
                               ng-class="{'has-error': showHasErrorContractName}"
                               title="{{MessageErrorForInput}}"
                               ng-change="onChangeValueContract('ContractName')" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Loại hợp đồng <span class="asterisk">*</span>
                        </label>
                        <select kendo-drop-down-list
                                id="ContractTypeIdContract"
                                name="ContractTypeIdContract"
                                k-filter="'contains'"
                                ng-model="modelContract.ContractTypeId"
                                k-data-source="ContractTypeDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"
                                ng-class="{'has-error': showHasErrorContractTypeIdContract}"
                                title="{{MessageErrorForSelect}}"
                                ng-change="onChangeValueContract('ContractTypeIdContract')"></select>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Thời hạn hợp đồng
                        </label>
                        <select kendo-drop-down-list
                                id="ContractTermId"
                                name="ContractTermId"
                                k-filter="'contains'"
                                ng-model="modelContract.ContractTermId"
                                k-data-source="ContractTermDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Hình thức làm việc
                        </label>
                        <select kendo-drop-down-list
                                id="TheFormOfWorkId"
                                name="TheFormOfWorkId"
                                k-filter="'contains'"
                                ng-model="modelContract.TheFormOfWorkId"
                                k-data-source="TheFormOfWorkDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Tỷ lệ hưởng lương
                        </label>
                        <input class="form-control"
                               name="WageRate"
                               id="WageRate"
                               ng-model="modelContract.WageRate"
                               numbers-Only
                               maxlength="3"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Ngày có hiệu lực
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelContract.EffectiveDate"
                               id="EffectiveDate"
                               name="EffectiveDate"
                               ng-model="modelContract.EffectiveDate"
                               placeholder="dd/MM/yyyy">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                        <label>
                            Ngày hết hạn
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelContract.ExpirationDate"
                               id="ExpirationDate"
                               name="ExpirationDate"
                               ng-model="modelContract.ExpirationDate"
                               ng-class="{'has-error': CheckExpirationDate}"
                               title="{{MessageCheckExpirationDate}}"
                               placeholder="dd/MM/yyyy">
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                        <label>
                            Trích yếu
                        </label>
                        <textarea class="form-control"
                                  name="Abstract"
                                  id="Abstract"
                                  ng-model="modelContract.Abstract"
                                  maxlength="100"
                                  rows="3"
                                  autocomplete="off"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                        <label>
                            Ghi chú
                        </label>
                        <textarea class="form-control"
                                  name="NoteContract"
                                  id="NoteContract"
                                  ng-model="modelContract.Note"
                                  rows="3"
                                  maxlength="100"
                                  autocomplete="off"></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveContract"
                                class="btn btn-primary waves-effect float-right m-l-5 custom_hidden_contract"
                                ng-if="HideButton"
                                ng-click="SaveContract()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseContract"
                                ng-click="CloseContract()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
