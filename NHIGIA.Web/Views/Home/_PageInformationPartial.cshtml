<script src="@Url.Content("~/Scripts/app/controller/PageInformationController.js")"></script>
<div class="container-fluid" ng-controller="PageInformationController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-if="HideButton" ng-click="ShowPopupPage('ADD_PAGE')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:250px;">Tên giấy tờ</th>
                            <th style="max-width:180px;">Nơi cấp</th>
                            <th style="max-width:180px;">Ngày cấp</th>
                            <th style="max-width: 180px;">Ngày hết hạn</th>
                            <th ng-if="GetAllPageInformation.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllPageInformation.length > 0" ng-repeat="item in GetAllPageInformation">
                            <td>{{item.NameOfPapers}}</td>
                            <td>{{item.IssuedBy}}</td>
                            <td>{{item.DateRangeString}}</td>
                            <td>{{item.ExpirationDateString}}</td>
                            <td>
                                <a ng-click="ShowPopupPage('EDIT_PAGE',item.Id)">
                                    <i class="material-icons" ng-if="HideButton" style="color:#0c68b4;">mode_edit</i>
                                    <i class="material-icons" ng-if="ShowButton" style="color:#0c68b4;">remove_red_eye</i>
                                </a>
                                <a ng-if="HideButton" ng-click="ShowPopupPage('DELETE_PAGE',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllPageInformation.length === 0">
                            <td colspan="4" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("PageInformation", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidPage", @id = "ValidPage", @novalidate = "novalidate" }))
    {
        <div id="KenWindownPage" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="margin: 0 0 15px 0;">
                <div class="row m-t--10">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Tên giấy tờ <span class="asterisk">*</span>
                        </label>
                        <input class="form-control"
                               name="NameOfPapers"
                               id="NameOfPapers"
                               ng-model="modelPage.NameOfPapers"
                               ng-class="{'has-error': showHasErrorNameOfPapers}"
                               title="{{MessageErrorForInput}}"
                               ng-change="onChangeValuePage('NameOfPapers')"
                               maxlength="100"
                               autocomplete="off" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Nơi cấp
                        </label>
                        <input class="form-control"
                               name="IssuedByPage"
                               id="IssuedByPage"
                               ng-model="modelPage.IssuedBy"
                               maxlength="100"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Ngày cấp
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelPage.DateRange"
                               id="DateRangePage"
                               name="DateRangePage"
                               ng-model="modelPage.DateRange"
                               placeholder="dd/MM/yyyy">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Ngày hết hạn
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelPage.ExpirationDate"
                               id="ExpirationDatePage"
                               name="ExpirationDatePage"
                               ng-model="modelPage.ExpirationDate"
                               ng-class="{'has-error': CheckExpirationDate}"
                               title="{{MessageCheckExpirationDate}}"
                               placeholder="dd/MM/yyyy">
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Ghi chú
                        </label>
                        <textarea class="form-control"
                                  name="NotePage"
                                  id="NotePage"
                                  ng-model="modelPage.Note"
                                  rows="3"
                                  maxlength="100"
                                  autocomplete="off"></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSavePage"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-if="HideButton"
                                ng-click="SavePage()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnClosePage"
                                ng-click="ClosePage()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>