<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Mã chấm công</label>
        <input class="form-control"
               name="TimekeepingCode"
               id="TimekeepingCode"
               ng-model="model.TimekeepingCode"
               disabled
               autocomplete="off" />
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Số sổ QL lao động</label>
        <input class="form-control"
               name="LaborManagementBookNumber"
               id="LaborManagementBookNumber"
               ng-model="model.LaborManagementBookNumber"
               maxlength="50"
               autocomplete="off" />
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Đơn vị công tác <span class="asterisk">*</span></label>
        <select kendo-drop-down-list
                id="WorkUnitId1"
                name="WorkUnitId"
                k-filter="'contains'"
                ng-model="model.WorkUnitId"
                k-data-source="WorkUnitDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"
                ng-class="{'has-error': showErrorMsg(Valid.WorkUnitId)}"
                required
                title="{{MessageErrorForSelect}}"></select>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Loại hợp đồng</label>
        <select kendo-drop-down-list
                id="ContractTypeId"
                name="ContractTypeId"
                k-filter="'contains'"
                ng-model="model.ContractTypeId"
                k-data-source="ContractTypeDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"
                ng-disabled="model.Id > 0"></select>
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Vị trí công việc <span class="asterisk">*</span></label>
        <select kendo-drop-down-list
                id="JobPositionId1"
                name="JobPositionId"
                k-filter="'contains'"
                ng-model="model.JobPositionId"
                k-data-source="JobPositionDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"
                ng-class="{'has-error': showErrorMsg(Valid.JobPositionId)}"
                required
                title="{{MessageErrorForSelect}}"></select>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Ngày tập sự</label>
        <input kendo-date-picker
               class="form-control date-picker-style"
               k-format="'dd/MM/yyyy'"
               onkeydown="return true;"
               k-ng-model="model.ApprenticeDay"
               id="ApprenticeDay"
               name="ApprenticeDay"
               ng-model="model.ApprenticeDay"
               ng-class="{'has-error': CheckApprenticeDayLessProbationDay}"
               title="{{MessageCheckApprenticeDayLessProbationDay}}"
               placeholder="dd/MM/yyyy">
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Trạng thái</label>
        <select kendo-drop-down-list
                id="WorkStatusId"
                name="WorkStatusId"
                k-filter="'contains'"
                ng-model="model.WorkStatusId"
                k-data-source="WorkStatusDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"></select>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Ngày thử việc</label>
        <input kendo-date-picker
               class="form-control date-picker-style"
               k-format="'dd/MM/yyyy'"
               onkeydown="return true;"
               k-ng-model="model.ProbationDay"
               id="ProbationDay"
               name="ProbationDay"
               ng-model="model.ProbationDay"
               ng-class="{'has-error': CheckProbationDayLessOfficialDate}"
               title="{{MessageCheckProbationDayLessOfficialDate}}"
               placeholder="dd/MM/yyyy">
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Quản lý trực tiếp</label>
        <input kendo-auto-complete
               name="DirectManagementId"
               id="DirectManagementId"
               k-data-text-field="'EmployeeName'"
               placeholder="Nhập 3 ký tự trở lên"
               k-filter="'contains'"
               k-min-length="3"
               k-data-source="GetEmployeeForDirectManagement"
               k-on-select="onSelectDirectManagementId(kendoEvent)"
               ng-blur="onChangeDirectManagementId()"
               ng-change="onChangeDirectManagementIdValue()"
               ng-model="model.DirectManagementAutoComplete" />
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Ngày chính thức</label>
        <input kendo-date-picker
               class="form-control date-picker-style"
               k-format="'dd/MM/yyyy'"
               onkeydown="return true;"
               k-ng-model="model.OfficialDate"
               id="OfficialDate"
               name="OfficialDate"
               ng-model="model.OfficialDate"
               placeholder="dd/MM/yyyy">
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Quản lý gián tiếp</label>
        <input kendo-auto-complete
               name="IndirectManagementId"
               id="IndirectManagementId"
               k-data-text-field="'EmployeeName'"
               placeholder="Nhập 3 ký tự trở lên"
               k-filter="'contains'"
               k-min-length="3"
               k-data-source="GetEmployeeForIndirectManagement"
               k-on-select="onSelectIndirectManagementId(kendoEvent)"
               ng-model="model.IndirectManagementAutoComplete"
               ng-blur="onChangeIndirectManagementId()"
               ng-change="onChangeIndirectManagementIdValue()" />
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Số ngày phép</label>
        <input class="form-control"
               name="NumberOfDaysOff"
               id="NumberOfDaysOff"
               ng-model="model.NumberOfDaysOff"
               numbers-Only
               maxlength="50"
               autocomplete="off" />
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 p-r-0">
        <label>Địa điểm làm việc</label>
        <select kendo-drop-down-list
                id="WorkLocationId"
                name="WorkLocationId"
                k-filter="'contains'"
                ng-model="model.WorkLocationId"
                k-data-source="WorkLocationDropdownlist"
                k-option-label="' '"
                k-data-text-field="'Name'"
                k-data-value-field="'Id'"
                class="Dropdownlist-Custom"></select>
    </div>
    <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4 margin-bottom-5 p-r-0">
        <label style="width:100%;">Tự động tăng phép theo thâm niên</label>
        <div class="demo-checkbox">
            <input type="checkbox" id="AutomaticallyIncreasesMagicAccordingToSeniority" class="filled-in chk-col-blue" ng-model="model.AutomaticallyIncreasesMagicAccordingToSeniority" />
            <label class="m-t-5" for="AutomaticallyIncreasesMagicAccordingToSeniority">Tự động tăng</label>
        </div>
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2 margin-bottom-5 p-r-0">
        <label>Tăng phép sau</label>
        <input class="form-control"
               name="IncreaseLaterSpells"
               id="IncreaseLaterSpells"
               disabled
               ng-model="model.IncreaseLaterSpells"
               maxlength="50"
               autocomplete="off" />
    </div>
</div>
<div class="row m-r-0">
    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 margin-bottom-5 m-t-15">
