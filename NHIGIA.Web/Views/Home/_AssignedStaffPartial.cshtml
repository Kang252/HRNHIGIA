<script src="@Url.Content("~/Scripts/app/controller/EmployeesOnBusinessTripAssignedStaffController.js")"></script>
<div class="container-fluid" ng-controller="EmployeesOnBusinessTripAssignedStaffController">
    <div class="row clearfix" style="overflow:hidden;">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0 m-b--30">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-click="ShowPopupEmployeesOnBusinessTripAssignedStaff('ADD_EMPLOYEESONBUSINESSTRIPASSIGNEDSTAFF')"><i class="material-icons">add_circle</i><span class="icon-name">Chọn nhân viên</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:100px;">Mã nhân viên</th>
                            <th style="max-width:100px;">Họ và tên</th>
                            <th style="max-width:100px;">Vị trí công việc</th>
                            <th style="max-width:100px;">Đơn vị công tác</th>
                            <th style="max-width:100px;">Điện thoại</th>
                            <th style="max-width: 100px;">Email</th>
                            <th ng-if="GetAllEmployeesOnBusinessTripAssignedStaff.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllEmployeesOnBusinessTripAssignedStaff.length > 0" ng-repeat="item in GetAllEmployeesOnBusinessTripAssignedStaff">
                            <td>{{item.EmployeeCode}}</td>
                            <td>{{item.EmployeeName}}</td>
                            <td>{{item.JobPositionName}}</td>
                            <td>{{item.WorkUnitName}}</td>
                            <td>{{item.MobilePhone}}</td>
                            <td>{{item.CompanyEmail}}</td>
                            <td>
                                <a ng-click="ShowPopupEmployeesOnBusinessTripAssignedStaff('DELETE_EMPLOYEESONBUSINESSTRIPASSIGNEDSTAFF',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllEmployeesOnBusinessTripAssignedStaff.length === 0">
                            <td colspan="6" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("EmployeesOnBusinessTripAssignedStaff", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidEmployeesOnBusinessTripAssignedStaff", @id = "ValidEmployeesOnBusinessTripAssignedStaff", @novalidate = "novalidate" }))
    {
        <div id="KenWindownEmployeesOnBusinessTripAssignedStaff" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="max-height: 400px; margin: 0 0 15px 0; overflow: auto; overflow-x: hidden;">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div kendo-grid="gridEmployeesOnBusinessTripAssignedStaff"
                             id="TableEmployeesOnBusinessTripAssignedStaff"
                             k-options="SectionEmployeesOnBusinessTripAssignedStaff">
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveEmployeesOnBusinessTripAssignedStaff"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-click="SaveEmployeesOnBusinessTripAssignedStaff()">
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseEmployeesOnBusinessTripAssignedStaff"
                                ng-click="CloseEmployeesOnBusinessTripAssignedStaff()">
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>