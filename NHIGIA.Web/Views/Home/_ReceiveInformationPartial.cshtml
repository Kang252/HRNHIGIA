<script src="@Url.Content("~/Scripts/app/controller/ReceiveInformationController.js")"></script>
<div class="container-fluid" ng-controller="ReceiveInformationController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-if="HideButton" ng-click="ShowPopupReceive('ADD_RECEIVE')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:125px;">Trạng thái</th>
                            <th style="max-width:250px;">Tên thủ tục</th>
                            <th style="max-width:180px;">Nhóm thủ tục</th>
                            <th style="max-width: 180px;">Ngày hoàn thành</th>
                            <th ng-if="GetAllReceiveInformation.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllReceiveInformation.length > 0" ng-repeat="item in GetAllReceiveInformation">
                            <td>
                                <div class="statusIconGreen" ng-if="item.Accomplished === true"></div>
                                <div class="statusIconGray" ng-if="item.Accomplished === false"></div>
                                {{item.AccomplishedString}}
                            </td>
                            <td>{{item.NameOfProcedure}}</td>
                            <td>{{item.ProcedureGroupReceiveName}}</td>
                            <td>{{item.FinishDayString}}</td>
                            <td>
                                <a ng-click="ShowPopupReceive('EDIT_RECEIVE',item.Id)">
                                    <i class="material-icons" ng-if="HideButton" style="color:#0c68b4;">mode_edit</i>
                                    <i class="material-icons" ng-if="ShowButton" style="color:#0c68b4;">remove_red_eye</i>
                                </a>
                                <a ng-if="HideButton" ng-click="ShowPopupReceive('DELETE_RECEIVE',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllReceiveInformation.length === 0">
                            <td colspan="4" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("ReceiveInformation", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidReceive", @id = "ValidReceive", @novalidate = "novalidate" }))
    {
        <div id="KenWindownReceive" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="margin: 0 0 15px 0;">
                <div class="row m-t--10">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Tên thủ tục <span class="asterisk">*</span>
                        </label>
                        <input class="form-control"
                               name="NameOfProcedure"
                               id="NameOfProcedure"
                               ng-model="modelReceive.NameOfProcedure"
                               ng-class="{'has-error': showHasErrorNameOfProcedure}"
                               title="{{MessageErrorForInput}}"
                               ng-change="onChangeValueReceive('NameOfProcedure')"
                               maxlength="100"
                               autocomplete="off" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Nhóm thủ tục
                        </label>
                        <select kendo-drop-down-list
                                id="ProcedureGroupReceiveId"
                                name="ProcedureGroupReceiveId"
                                ng-model="modelReceive.ProcedureGroupReceiveId"
                                k-data-source="ProcedureGroupReceiveDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                k-filter="'contains'"
                                class="Dropdownlist-Custom"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 m-t-10">
                        <div class="demo-checkbox">
                            <input type="checkbox" id="Accomplished" class="filled-in chk-col-blue" ng-model="modelReceive.Accomplished" ng-change="onChangeAccomplished()" />
                            <label class="m-t-5 checkbox_label_popup" for="Accomplished">Đã hoàn thành</label>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Ngày hoàn thành
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelReceive.FinishDay"
                               id="FinishDay"
                               name="FinishDay"
                               ng-model="modelReceive.FinishDay"
                               placeholder="dd/MM/yyyy"
                               ng-disabled="modelReceive.Accomplished === false">
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveReceive"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-if="HideButton"
                                ng-click="SaveReceive()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseReceive"
                                ng-click="CloseReceive()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>