<script src="@Url.Content("~/Scripts/app/controller/SalaryHistoryInformationController.js")"></script>
<div class="container-fluid" ng-controller="SalaryHistoryInformationController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-if="HideButton" ng-click="ShowPopupSalaryHistory('ADD_SALARYHISTORY')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:120px;">Ngày thay đổi</th>
                            <th style="max-width:180px;">Vị trí công việc</th>
                            <th style="max-width:120px;">Lương cơ bản</th>
                            <th style="max-width:180px;">Lương đóng BH</th>
                            <th style="max-width: 210px;">Diễn giải</th>
                            <th ng-if="GetAllSalaryHistoryInformation.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllSalaryHistoryInformation.length > 0" ng-repeat="item in GetAllSalaryHistoryInformation">
                            <td>{{item.DateOfChangeString}}</td>
                            <td>{{item.JobPositionName}}</td>
                            <td>{{item.BasicSalary}}</td>
                            <td>{{item.InsurancePremiums}}</td>
                            <td>{{item.Explain}}</td>
                            <td>
                                <a ng-click="ShowPopupSalaryHistory('EDIT_SALARYHISTORY',item.Id)">
                                    <i class="material-icons" ng-if="HideButton" style="color:#0c68b4;">mode_edit</i>
                                    <i class="material-icons" ng-if="ShowButton" style="color:#0c68b4;">remove_red_eye</i>
                                </a>
                                <a ng-click="ShowPopupSalaryHistory('DELETE_SALARYHISTORY',item.Id)" ng-if="GetAllSalaryHistoryInformation.length > 1 && HideButton"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllSalaryHistoryInformation.length === 0">
                            <td colspan="6" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("SalaryHistoryInformation", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidSalaryHistory", @id = "ValidSalaryHistory", @novalidate = "novalidate" }))
    {
        <div id="KenWindownSalaryHistory" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="margin: 0 0 15px 0;">
                <div class="row m-t--10">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Ngày thay đổi
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelSalaryHistory.DateOfChange"
                               id="DateOfChange"
                               name="DateOfChange"
                               ng-model="modelSalaryHistory.DateOfChange"
                               placeholder="dd/MM/yyyy">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Vị trí công việc
                        </label>
                        <select kendo-drop-down-list
                                id="JobPositionIdSalaryHistory"
                                name="JobPositionIdSalaryHistory"
                                k-filter="'contains'"
                                ng-model="modelSalaryHistory.JobPositionId"
                                k-data-source="JobPositionDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                class="Dropdownlist-Custom"
                                disabled></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Lương cơ bản
                        </label>
                        <input class="form-control"
                               name="BasicSalarySalaryHistory"
                               id="BasicSalarySalaryHistory"
                               ng-model="modelSalaryHistory.BasicSalary"
                               min="0"
                               max="999999999999999"
                               number-format
                               maxlength="15"
                               autocomplete="off" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Lương đóng BH
                        </label>
                        <input class="form-control"
                               name="InsurancePremiumsSalaryHistory"
                               id="InsurancePremiumsSalaryHistory"
                               ng-model="modelSalaryHistory.InsurancePremiums"
                               min="0"
                               max="999999999999999"
                               number-format
                               maxlength="15"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <div class="demo-checkbox p-t-7">
                            <input type="checkbox" id="JoinInsurance" class="filled-in chk-col-blue" ng-model="modelSalaryHistory.JoinInsurance" />
                            <label class="m-t-5 checkbox_label_popup" for="JoinInsurance"> Tham gia bảo hiểm</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 m-t--5">
                        <label>
                            Diễn giải
                        </label>
                        <textarea class="form-control"
                                  name="Explain"
                                  id="Explain"
                                  ng-model="modelSalaryHistory.Explain"
                                  maxlength="100"
                                  rows="4"
                                  autocomplete="off"> </textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveSalaryHistory"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-if="HideButton"
                                ng-click="SaveSalaryHistory()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseSalaryHistory"
                                ng-click="CloseSalaryHistory()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
