<script src="@Url.Content("~/Scripts/app/controller/EvaluateInformationController.js")"></script>
<style>
    #KenWindownEvaluateInformation .content {
        height: 285px !important;
    }
</style>
<div class="container-fluid" ng-controller="EvaluateInformationController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:140px;">Tên đợt đánh giá</th>
                            <th style="max-width:140px;">Kỳ đánh giá</th>
                            <th style="max-width:140px;">Đợt đánh giá</th>
                            <th style="max-width: 140px;">Kết quả</th>
                            <th ng-if="GetEvaluateByEmployee.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetEvaluateByEmployee.length > 0" ng-repeat="item in GetEvaluateByEmployee">
                            <td>{{item.NameOfAudit}}</td>
                            <td>{{item.EvaluationPeriodName}}</td>
                            <td>{{item.DateString}}</td>
                            <td>{{item.Result}}</td>
                            <td>
                                <a ng-click="ShowPopupEvaluate('VIEW_EVALUATE',item.Id)"><i class="material-icons" style="color:#0c68b4;">remove_red_eye</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetEvaluateByEmployee.length === 0">
                            <td colspan="4" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("EvaluateInformation", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidEvaluateInformation", @id = "ValidEvaluateInformation", @novalidate = "novalidate" }))
    {
        <div id="KenWindownEvaluateInformation" class="k-window-content KenWindownPopup custom_tab_information" style="display:none;">
            <div class="row m-t--10">
                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                    <label>
                        Tên đợt đánh giá
                    </label>
                    <input class="form-control"
                           name="NameOfAuditEvaluateInformation"
                           id="NameOfAuditEvaluateInformation"
                           ng-model="modelEvaluateForm.NameOfAudit"
                           disabled />
                </div>
                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                    <label>
                        Kỳ đánh giá
                    </label>
                    <input class="form-control"
                           name="EvaluationPeriodName"
                           id="EvaluationPeriodName"
                           ng-model="modelEvaluateForm.EvaluationPeriodName"
                           disabled />
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                    <label>
                        Đợt đánh giá
                    </label>
                    <input class="form-control"
                           name="DateString"
                           id="DateString"
                           ng-model="modelEvaluateForm.DateString"
                           disabled />
                </div>
                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                    <label>
                        Tổng điểm
                    </label>
                    <input class="form-control"
                           name="Result"
                           id="Result"
                           ng-model="modelEvaluateForm.Result"
                           disabled />
                </div>
            </div>
            <br />
            @Html.Partial("_EvaluateFormPartial")
        </div>
    }
</div>