<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:125px;">Trạng thái</th>
                            <th style="max-width:250px;">Tên thủ tục</th>
                            <th style="max-width:180px;">Nhóm thủ tục</th>
                            <th style="max-width: 180px;">Ngày hoàn thành</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllQuitInformation.length > 0" ng-repeat="item in GetAllQuitInformation">
                            <td>
                                <div class="statusIconGreen" ng-if="item.Accomplished === true"></div>
                                <div class="statusIconGray" ng-if="item.Accomplished === false"></div>
                                {{item.AccomplishedString}}
                            </td>
                            <td>{{item.NameOfProcedure}}</td>
                            <td>{{item.ProcedureGroupQuitName}}</td>
                            <td>{{item.FinishDayString}}</td>
                        </tr>
                        <tr ng-if="GetAllQuitInformation.length === 0">
                            <td colspan="4" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>