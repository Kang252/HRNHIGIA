<script src="@Url.Content("~/Scripts/app/controller/ProblemInformationRelatedStaffController.js")"></script>
<div class="container-fluid" ng-controller="ProblemInformationRelatedStaffController">
    <div class="row clearfix" style="overflow:hidden;">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0 m-b--30">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-click="ShowPopupProblemInformationRelatedStaff('ADD_PROBLEMINFORMATIONRELATEDSTAFF')"><i class="material-icons">add_circle</i><span class="icon-name">Chọn nhân viên</span></button>
                <label>
                    <input class="form-control"
                           name="searchText"
                           id="searchText"
                           ng-model="searchText"
                           placeholder="Tìm kiếm" />
                </label>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:100px;">Trạng thái</th>
                            <th style="max-width:100px;">Mã nhân viên</th>
                            <th style="max-width:100px;">Họ và tên</th>
                            <th style="max-width:100px;">Vị trí công việc</th>
                            <th style="max-width:100px;">Đơn vị công tác</th>
                            <th ng-if="GetAllProblemInformationRelatedStaff.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllProblemInformationRelatedStaff.length > 0" ng-repeat="item in GetAllProblemInformationRelatedStaff| filter:searchText">
                            <td>{{item.ProcessingStatusName}}</td>
                            <td>{{item.EmployeeCode}}</td>
                            <td>{{item.EmployeeName}}</td>
                            <td>{{item.JobPositionName}}</td>
                            <td>{{item.WorkUnitName}}</td>
                            <td>
                                <a ng-click="ShowPopupProblemInformationRelatedStaff('EDIT_PROBLEMINFORMATIONRELATEDSTAFF',item.Id)"><i class="material-icons" style="color:#0c68b4;">mode_edit</i></a>
                                <a ng-click="ShowPopupProblemInformationRelatedStaff('DELETE_PROBLEMINFORMATIONRELATEDSTAFF',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllProblemInformationRelatedStaff.length === 0">
                            <td colspan="5" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("ProblemInformationRelatedStaff", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidProblemInformationRelatedStaff", @id = "ValidProblemInformationRelatedStaff", @novalidate = "novalidate" }))
    {
        <div id="KenWindownProblemInformationRelatedStaff" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="max-height: 400px; margin: 0 0 15px 0; overflow: auto; overflow-x: hidden;">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div kendo-grid="gridProblemInformationRelatedStaff"
                             id="TableProblemInformationRelatedStaff"
                             k-options="SectionProblemInformationRelatedStaff">
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveProblemInformationRelatedStaff"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-click="SaveProblemInformationRelatedStaff()">
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseProblemInformationRelatedStaff"
                                ng-click="CloseProblemInformationRelatedStaff()">
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    @using (Ajax.BeginForm("ProblemInformationRelatedStaffEdit", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidProblemInformationRelatedStaffEdit", @id = "ValidProblemInformationRelatedStaffEdit", @novalidate = "novalidate" }))
    {
        <div id="KenWindownProblemInformationRelatedStaffEdit" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="height: 400px; margin: 0 -15px 15px 0; overflow: auto; overflow-x: hidden;">
                <ul class="nav nav-tabs tab-nav-right" role="tablist" style="margin:-10px 15px 0 0;">
                    <li role="presentation" class="active"><a href="#staff_involved" data-toggle="tab" aria-expanded="true">Nhân viên tham gia</a></li>
                    <li role="presentation" class=""><a href="#troubleshooting_decision" data-toggle="tab" aria-expanded="false">Quyết định xử lý sự cố</a></li>
                </ul>
                <div class="tab-content tab_content_troubleshooting_decision">
                    <div role="tabpanel" class="tab-pane fade active in" id="staff_involved" style="padding-top: 0;">
                        <div class="row m-t--10">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Mã nhân viên
                                </label>
                                <input class="form-control"
                                       name="EmployeeCode"
                                       id="EmployeeCode"
                                       ng-model="modelProblemInformationRelatedStaff.EmployeeCode"
                                       maxlength="100"
                                       disabled />
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                                <label>
                                    Họ và tên
                                </label>
                                <input class="form-control"
                                       name="EmployeeName"
                                       id="EmployeeName"
                                       ng-model="modelProblemInformationRelatedStaff.EmployeeName"
                                       maxlength="100"
                                       disabled />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Vị trí công việc
                                </label>
                                <input class="form-control"
                                       name="JobPositionName"
                                       id="JobPositionName"
                                       ng-model="modelProblemInformationRelatedStaff.JobPositionName"
                                       maxlength="100"
                                       disabled />
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                                <label>
                                    Đơn vị công tác
                                </label>
                                <input class="form-control"
                                       name="WorkUnitName"
                                       id="WorkUnitName"
                                       ng-model="modelProblemInformationRelatedStaff.WorkUnitName"
                                       maxlength="100"
                                       disabled />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                                <label>
                                    Mô tả sự liên quan
                                </label>
                                <textarea class="form-control"
                                          name="DescribeTheRelationship"
                                          id="DescribeTheRelationship"
                                          ng-model="modelProblemInformationRelatedStaff.DescribeTheRelationship"
                                          rows="3"
                                          maxlength="100"></textarea>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Tổng số ngày nghỉ TNLĐ
                                </label>
                                <input class="form-control"
                                       name="TotalNumberOfDaysOffDueToOccupationalAccidents"
                                       id="TotalNumberOfDaysOffDueToOccupationalAccidents"
                                       ng-model="modelProblemInformationRelatedStaff.TotalNumberOfDaysOffDueToOccupationalAccidents"
                                       maxlength="2"
                                       numbers-Only
                                       autocomplete="off" />
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                                <label>
                                    Tình trạng thương tích
                                </label>
                                <select kendo-drop-down-list
                                        id="InjuryConditionId"
                                        name="InjuryConditionId"
                                        ng-model="modelProblemInformationRelatedStaff.InjuryConditionId"
                                        k-data-source="InjuryConditionDropdownlist"
                                        k-data-text-field="'Name'"
                                        k-data-value-field="'Id'"
                                        k-filter="'contains'"
                                        class="Dropdownlist-Custom"></select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Trạng thái xử lý <span class="asterisk">*</span>
                                </label>
                                <select kendo-drop-down-list
                                        id="ProcessingStatusId"
                                        name="ProcessingStatusId"
                                        ng-model="modelProblemInformationRelatedStaff.ProcessingStatusId"
                                        k-data-source="ProcessingStatusDropdownlist"
                                        k-data-text-field="'Name'"
                                        k-data-value-field="'Id'"
                                        k-filter="'contains'"
                                        class="Dropdownlist-Custom"
                                        ng-class="{'has-error': showHasErrorProcessingStatusId}"
                                        title="{{MessageErrorForSelect}}"
                                        ng-change="onChangeValueEdit('ProcessingStatusId')"></select>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 m-t-12">
                                <br />
                                <div class="demo-checkbox">
                                    <input type="checkbox" id="HavePassedLaborSafetyTraining" class="filled-in chk-col-blue" ng-model="modelProblemInformationRelatedStaff.HavePassedLaborSafetyTraining" />
                                    <label class="m-t-5 checkbox_label_popup" for="HavePassedLaborSafetyTraining">Đã qua huấn luyện an toàn lao động</label>
                                </div>
                            </div>
                        </div>
                        <div class="row m-t-10">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                                <ul class="nav nav-tabs tab-nav-right" role="tablist" style="margin-top:-10px;">
                                    <li role="presentation" class="active"><a href="#track_employee_compensation" data-toggle="tab" aria-expanded="true">Theo dõi nhân viên thực hiện bồi thường</a></li>
                                    <li role="presentation" class=""><a href="#employee_compensation" data-toggle="tab" aria-expanded="false">Các khoản nhân viên được bồi thường</a></li>
                                </ul>
                                <div class="tab-content">
                                    <div role="tabpanel" class="tab-pane fade active in custom_tab_information" id="track_employee_compensation" style="padding-top: 0;">
                                        <div class="row m-t--10 m-r-15">
                                            <table class="table" style="margin: 10px 0 0 15px;">
                                                <thead>
                                                    <tr>
                                                        <th style="max-width:200px;">Số tiền</th>
                                                        <th style="max-width:200px;">Ngày trả</th>
                                                        <th style="max-width:85px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td style="padding: 5px;">
                                                            <input class="form-control"
                                                                   name="AmountMoneyAdd"
                                                                   id="AmountMoneyAdd"
                                                                   min="0"
                                                                   max="999999999999999"
                                                                   ng-model="modelProblemInformationRelatedStaff.AmountMoneyAdd"
                                                                   number-format
                                                                   maxlength="15"
                                                                   autocomplete="off" />
                                                        </td>
                                                        <td style="padding: 5px;">
                                                            <input kendo-date-picker
                                                                   class="form-control date-picker-style"
                                                                   k-format="'dd/MM/yyyy'"
                                                                   onkeydown="return true;"
                                                                   k-ng-model="modelProblemInformationRelatedStaff.PayDayAdd"
                                                                   ng-model="modelProblemInformationRelatedStaff.PayDayAdd"
                                                                   blocker-paste
                                                                   id="PayDayAdd"
                                                                   name="PayDayAdd"
                                                                   placeholder="dd/MM/yyyy">
                                                        </td>
                                                        <td style="padding: 5px;">
                                                            <button ng-click="insertDataTrackEmployeeCompensation()" type="button" class="btn btn-success btn-sm">Thêm</button>
                                                        </td>
                                                    </tr>
                                                    <tr ng-if="GetAllProblemInformationTrackEmployeeCompensation.length > 0"
                                                        ng-repeat="item in GetAllProblemInformationTrackEmployeeCompensation"
                                                        ng-include="loadTemplateTrackEmployeeCompensation(item)"
                                                        class="ProblemInformationTrackEmployeeCompensation_{{item.AmountMoney}}_{{item.Id}}">
                                                    </tr>
                                                    <tr ng-if="GetAllProblemInformationTrackEmployeeCompensation.length === 0">
                                                        <td colspan="3" align="center">Không có dữ liệu</td>
                                                    </tr>
                                                    <tr class="ShowDeleteClient hide">
                                                        <td colspan="3" align="center">Không có dữ liệu</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <script type="text/ng-template" id="displayTrackEmployeeCompensation">
                                                <td>{{item.AmountMoney | currency : "" : 0}}</td>
                                                <td>{{item.PayDayString | date:'dd/MM/yyyy'}}</td>
                                                <td>
                                                    <a ng-click="editContentTrackEmployeeCompensation(item)"><i class="material-icons" style="color:#0c68b4;">mode_edit</i></a>
                                                    <a ng-click="deleteContentTrackEmployeeCompensation(item,$index)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                                                </td>
                                            </script>
                                            <script type="text/ng-template" id="editTrackEmployeeCompensation">
                                                <td style="padding: 5px;">
                                                    <input class="form-control"
                                                           name="AmountMoneyEdit"
                                                           id="AmountMoneyEdit"
                                                           min="0"
                                                           max="999999999999999"
                                                           ng-model="editablerowTrackEmployeeCompensation.AmountMoney"
                                                           number-format
                                                           maxlength="15"
                                                           autocomplete="off" />
                                                </td>
                                                <td style="padding: 5px;">
                                                    <input kendo-date-picker
                                                           class="form-control date-picker-style"
                                                           k-format="'dd/MM/yyyy'"
                                                           onkeydown="return true;"
                                                           k-ng-model="item.PayDay"
                                                           ng-model="editablerowTrackEmployeeCompensation.PayDay"
                                                           blocker-paste
                                                           id="PayDayEdit"
                                                           name="PayDayEdit"
                                                           placeholder="dd/MM/yyyy">
                                                </td>
                                                <td>
                                                    <a ng-click="saveDataTrackEmployeeCompensation($index)"><i class="material-icons" style="color:#0c68b4;">check</i></a>
                                                    <a ng-click="resetTrackEmployeeCompensation()"><i class="material-icons" style="color:#E55B5C;">cancel</i></a>
                                                </td>
                                            </script>
                                        </div>
                                    </div>
                                    <div role="tabpanel" class="tab-pane fade custom_tab_information" id="employee_compensation" style="padding-top: 0;">
                                        <div class="row m-t--10 m-r-15">
                                            <table class="table" style="margin: 10px 0 0 15px;">
                                                <thead>
                                                    <tr>
                                                        <th style="max-width:200px;">Nguồn bồi thường</th>
                                                        <th style="max-width:200px;">Số tiền</th>
                                                        <th style="max-width:85px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td style="padding: 5px;">
                                                            <input class="form-control"
                                                                   name="SourceCompensationAdd"
                                                                   id="SourceCompensationAdd"
                                                                   ng-model="modelProblemInformationRelatedStaff.SourceCompensationAdd"
                                                                   maxlength="50"
                                                                   autocomplete="off" />
                                                        </td>
                                                        <td style="padding: 5px;">
                                                            <input class="form-control"
                                                                   name="AmountMoneyAdd1"
                                                                   id="AmountMoneyAdd1"
                                                                   min="0"
                                                                   max="999999999999999"
                                                                   ng-model="modelProblemInformationRelatedStaff.AmountMoneyAdd1"
                                                                   number-format
                                                                   maxlength="15"
                                                                   autocomplete="off" />
                                                        </td>
                                                        <td style="padding: 5px;">
                                                            <button ng-click="insertDataEmployeeCompensation()" type="button" class="btn btn-success btn-sm">Thêm</button>
                                                        </td>
                                                    </tr>
                                                    <tr ng-if="GetAllEmployeeCompensation.length > 0"
                                                        ng-repeat="item in GetAllEmployeeCompensation"
                                                        ng-include="loadTemplateEmployeeCompensation(item)"
                                                        class="ProblemInformationEmployeeCompensation_{{item.SourceCompensation}}_{{item.Id}}">
                                                    </tr>
                                                    <tr ng-if="GetAllEmployeeCompensation.length === 0">
                                                        <td colspan="3" align="center">Không có dữ liệu</td>
                                                    </tr>
                                                    <tr class="ShowDeleteClient1 hide">
                                                        <td colspan="3" align="center">Không có dữ liệu</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <script type="text/ng-template" id="displayEmployeeCompensation">
                                                <td>{{item.SourceCompensation }}</td>
                                                <td>{{item.AmountMoney | currency : "" : 0}}</td>
                                                <td>
                                                    <a ng-click="editContentEmployeeCompensation(item)"><i class="material-icons" style="color:#0c68b4;">mode_edit</i></a>
                                                    <a ng-click="deleteContentEmployeeCompensation(item,$index)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                                                </td>
                                            </script>
                                            <script type="text/ng-template" id="editEmployeeCompensation">
                                                <td style="padding: 5px;">
                                                    <input class="form-control"
                                                           name="SourceCompensationEdit"
                                                           id="SourceCompensationEdit"
                                                           ng-model="editablerowEmployeeCompensation.SourceCompensation"
                                                           maxlength="50"
                                                           autocomplete="off" />
                                                </td>
                                                <td style="padding: 5px;">
                                                    <input class="form-control"
                                                           name="AmountMoneyEdit1"
                                                           id="AmountMoneyEdit1"
                                                           min="0"
                                                           max="999999999999999"
                                                           ng-model="editablerowEmployeeCompensation.AmountMoney"
                                                           number-format
                                                           maxlength="15"
                                                           autocomplete="off" />
                                                </td>
                                                <td>
                                                    <a ng-click="saveDataEmployeeCompensation($index)"><i class="material-icons" style="color:#0c68b4;">check</i></a>
                                                    <a ng-click="resetEmployeeCompensation()"><i class="material-icons" style="color:#E55B5C;">cancel</i></a>
                                                </td>
                                            </script>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade custom_tab_information" id="troubleshooting_decision" style="padding-top: 0;">
                        <div class="row m-t--10">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Số quyết định
                                </label>
                                <input class="form-control"
                                       name="DecisionNumber"
                                       id="DecisionNumber"
                                       ng-model="modelProblemInformationRelatedStaff.DecisionNumber"
                                       maxlength="100" />
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                                <label>
                                    Ngày quyết định
                                </label>
                                <input kendo-date-picker
                                       class="form-control date-picker-style"
                                       k-format="'dd/MM/yyyy'"
                                       onkeydown="return true;"
                                       k-ng-model="modelProblemInformationRelatedStaff.DecisionDate"
                                       id="DecisionDate"
                                       name="DecisionDate"
                                       ng-model="modelProblemInformationRelatedStaff.DecisionDate"
                                       placeholder="dd/MM/yyyy">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Loại quyết định
                                </label>
                                <select kendo-drop-down-list
                                        id="KindOfDecisionId"
                                        name="KindOfDecisionId"
                                        ng-model="modelProblemInformationRelatedStaff.KindOfDecisionId"
                                        k-data-source="KindOfDecisionDropdownlist"
                                        k-data-text-field="'Name'"
                                        k-data-value-field="'Id'"
                                        k-filter="'contains'"
                                        class="Dropdownlist-Custom"></select>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                                <label>
                                    Ngày hiệu lực
                                </label>
                                <input kendo-date-picker
                                       class="form-control date-picker-style"
                                       k-format="'dd/MM/yyyy'"
                                       onkeydown="return true;"
                                       k-ng-model="modelProblemInformationRelatedStaff.EffectiveDate"
                                       id="EffectiveDate"
                                       name="EffectiveDate"
                                       ng-model="modelProblemInformationRelatedStaff.EffectiveDate"
                                       placeholder="dd/MM/yyyy">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                                <label>
                                    Hình thức xử lý
                                </label>
                                <select kendo-drop-down-list
                                        id="FormsProcessingId"
                                        name="FormsProcessingId"
                                        ng-model="modelProblemInformationRelatedStaff.FormsProcessingId"
                                        k-data-source="FormsProcessingDropdownlist"
                                        k-data-text-field="'Name'"
                                        k-data-value-field="'Id'"
                                        k-filter="'contains'"
                                        class="Dropdownlist-Custom"></select>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-30">
                                <label>
                                    Người quyết định
                                </label>
                                <input kendo-auto-complete
                                       name="TheDecisionId"
                                       id="TheDecisionId"
                                       k-data-text-field="'EmployeeName'"
                                       placeholder="Nhập 3 ký tự trở lên"
                                       k-filter="'contains'"
                                       k-min-length="3"
                                       k-data-source="GetEmployeeForTheDecision"
                                       k-on-select="onSelectTheDecisionId(kendoEvent)"
                                       ng-model="modelProblemInformationRelatedStaff.TheDecisionAutoComplete"
                                       ng-blur="onChangeTheDecisionId()"
                                       ng-change="onChangeTheDecisionIdValue()" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-30">
                                <label>
                                    Trích yếu
                                </label>
                                <textarea class="form-control"
                                          name="CitationOfContent"
                                          id="CitationOfContent"
                                          ng-model="modelProblemInformationRelatedStaff.CitationOfContent"
                                          rows="3"
                                          maxlength="100"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveProblemInformationRelatedStaffEdit"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-click="SaveProblemInformationRelatedStaffEdit()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseProblemInformationRelatedStaffEdit"
                                ng-click="CloseProblemInformationRelatedStaffEdit()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>