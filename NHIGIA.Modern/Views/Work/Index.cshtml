@model WorkPage
@{
    var statusLabels = new Dictionary<string,string> { ["TRACKING"]="Đang theo dõi", ["PENDING"]="Chờ phê duyệt", ["AVAILABLE"]="Sẵn sàng", ["ASSIGNED"]="Đã cấp phát", ["OPEN"]="Mới tiếp nhận" };
}
<div class="hrm-page-header"><div><h2>@Model.Title</h2><p>@Model.Subtitle</p></div><span class="hrm-badge">@Model.Items.Count bản ghi</span></div>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
@if (TempData["WorkSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<div class="work-layout">
<section class="work-panel">
    <h3>Danh sách @Model.Title</h3>
    <form method="get" asp-controller="Work" asp-action="Index" class="work-search">
        <input type="hidden" name="kind" value="@Model.Kind" />
        <input class="form-control" name="q" value="@Model.Query" placeholder="Tìm theo tên, mã, nhân viên…" aria-label="Tìm kiếm" />
        <button class="hrm-btn" type="submit">Tìm kiếm</button>
    </form>
    @if (!Model.Available) { <p>Chưa tải được dữ liệu. Vui lòng thử lại sau.</p> }
    else if (Model.Items.Count == 0) { <div class="work-empty"><i class="material-icons">inbox</i><h4>Chưa có bản ghi</h4><p>@(Model.CanCreate ? "Điền biểu mẫu bên cạnh để tạo bản ghi đầu tiên." : "Các bản ghi liên quan đến bạn sẽ hiển thị tại đây.")</p></div> }
    else {
    <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Nội dung</th><th>Nhân viên</th><th>@(Model.Kind == "kpi" ? "Kết quả / Mục tiêu" : "Thông tin")</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach (var item in Model.Items) {
        <tr><td><strong>@item.Title</strong><small class="work-muted">#@item.Id.ToString("D5") · @item.Reference</small><p class="work-description">@item.Description</p></td><td>@(item.EmployeeName ?? "Chưa phân công")<small class="work-muted">@item.DepartmentName</small></td><td>
        @if (Model.Kind == "kpi") { <strong>@(item.Actual ?? 0) / @item.Target</strong><small class="work-muted">Trọng số: @item.Weight%</small> }
        else { <span>@item.Category</span> }
        <small class="work-muted">@item.DueDate?.ToString("dd/MM/yyyy")</small>
        @if (Model.Kind == "helpdesk") { <span>@item.Priority</span> }
        </td><td><span class="work-status">@(statusLabels.GetValueOrDefault(item.Status, item.Status))</span></td></tr>
    }
    </tbody></table></div>
    }
</section>
@if (Model.CanCreate) {
<section class="work-panel"><h3>@(Model.Kind == "helpdesk" ? "Tạo yêu cầu Helpdesk IT" : "Thêm mới")</h3>
<form method="post" asp-controller="Work" asp-action="Create">
<fieldset disabled="@(!Model.Available)">
<input type="hidden" name="Kind" value="@Model.Kind" />
<label for="Title">@(Model.Kind == "assets" ? "Tên tài sản" : "Tiêu đề") *</label><input id="Title" name="Title" class="form-control" required maxlength="200" value="@Model.Draft.Title" />
@if (Model.Kind != "helpdesk") {
<label for="EmployeeId">Nhân viên @(Model.Kind is "kpi" or "transfer" ? "*" : "")</label><select id="EmployeeId" name="EmployeeId" class="form-control" required="@(Model.Kind is "kpi" or "transfer")"><option value="">Chọn nhân viên</option>@foreach(var person in Model.People){<option value="@person.Id" selected="@(Model.Draft.EmployeeId == person.Id)">@person.DisplayName</option>}</select>
}
@if (Model.Kind == "transfer") {
<label for="DepartmentId">Phòng ban mới *</label><select id="DepartmentId" name="DepartmentId" required class="form-control"><option value="">Chọn phòng ban</option>@foreach(var department in Model.Departments){<option value="@department.Id" selected="@(Model.Draft.DepartmentId == department.Id)">@department.Name</option>}</select>
}
@if (Model.Kind == "assets") { <label for="Reference">Mã tài sản *</label><input id="Reference" name="Reference" class="form-control" required maxlength="100" value="@Model.Draft.Reference" /> }
<label for="Category">@(Model.Kind == "kpi" ? "Đơn vị đo" : "Phân loại")</label><input id="Category" name="Category" class="form-control" maxlength="100" value="@Model.Draft.Category" />
@if (Model.Kind == "kpi") {
<label for="Target">Mục tiêu *</label><input id="Target" name="Target" class="form-control" type="number" min="0.0001" max="1000000000" step="0.0001" required value="@Model.Draft.Target" />
<label for="Actual">Kết quả thực tế</label><input id="Actual" name="Actual" class="form-control" type="number" min="0" max="1000000000" step="0.0001" value="@Model.Draft.Actual" />
<label for="Weight">Trọng số (%) *</label><input id="Weight" name="Weight" class="form-control" type="number" min="1" max="100" step="0.01" required value="@Model.Draft.Weight" />
}
@if (Model.Kind is "kpi" or "transfer") { <label for="DueDate">@(Model.Kind == "transfer" ? "Ngày điều chuyển dự kiến" : "Hạn hoàn thành") *</label><input id="DueDate" name="DueDate" type="date" class="form-control" required value="@Model.Draft.DueDate?.ToString("yyyy-MM-dd")" /> }
@if (Model.Kind == "helpdesk") {
<label for="Priority">Mức ưu tiên *</label><select id="Priority" name="Priority" class="form-control">@foreach(var priority in new Dictionary<string,string>{{"LOW","Thấp"},{"NORMAL","Bình thường"},{"HIGH","Cao"},{"URGENT","Khẩn cấp"}}){<option value="@priority.Key" selected="@(Model.Draft.Priority == priority.Key)">@priority.Value</option>}</select>
}
<label for="Description">Mô tả @(Model.Kind == "helpdesk" ? "*" : "")</label><textarea id="Description" name="Description" class="form-control" rows="4" maxlength="2000" required="@(Model.Kind == "helpdesk")">@Model.Draft.Description</textarea>
<button type="submit" class="hrm-btn hrm-btn-primary work-submit">@(Model.Kind == "helpdesk" ? "Gửi yêu cầu" : "Lưu bản ghi")</button>
</fieldset>
</form></section>
}
</div>
