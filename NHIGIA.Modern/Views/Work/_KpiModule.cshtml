                                        <i class="material-icons">corporate_fare</i>
                                        <div>
                                            <strong>KPI từ kế hoạch</strong>
                                            <p>Áp dụng chung toàn công ty hoặc giao cho cấp phòng ban.</p>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label for="createKpiTitle" style="font-weight:600;">Tên mục tiêu / Tiêu chí KPI *</label>
                                    <input id="createKpiTitle" name="Title" class="form-control" required placeholder="Ví dụ: Đạt doanh thu dự án 90%, Xử lý 100 khách hàng..." />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="createKpiReference" style="font-weight:600;">Mã KPI</label>
                                    <input id="createKpiReference" name="Reference" class="form-control" placeholder="Ví dụ: KPI-IT-001" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6" id="createEmployeeGroup">
                                <div class="form-group">
                                    <label for="createKpiEmployeeId" style="font-weight:600;">Nhân viên nhận KPI *</label>
                                    <select id="createKpiEmployeeId" name="EmployeeId" class="form-control">
                                        <option value="">-- Chọn nhân viên --</option>
                                        @foreach (var person in Model.People)
                                        {
                                            <option value="@person.Id">@person.DisplayName (@person.DepartmentName)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="createKpiDepartmentId" style="font-weight:600;">Phòng ban</label>
                                    <select id="createKpiDepartmentId" name="DepartmentId" class="form-control">
                                        <option value="">-- Chọn phòng ban --</option>
                                        @foreach (var dept in Model.Departments)
                                        {
                                            <option value="@dept.Id">@dept.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="createKpiTarget" style="font-weight:600;">Chỉ tiêu (Target) *</label>
                                    <input type="number" step="0.01" min="0.01" max="1000000000" id="createKpiTarget" name="Target" class="form-control" required placeholder="Ví dụ: 10, 100..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="createKpiCategory" style="font-weight:600;">Đơn vị đo *</label>
                                    <input id="createKpiCategory" name="Category" class="form-control" required placeholder="%, VNĐ, hồ sơ, giờ…" value="%" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="createKpiWeight" style="font-weight:600;">Trọng số (%) *</label>
                                    <input type="number" step="0.01" min="1" max="100" id="createKpiWeight" name="Weight" class="form-control" required placeholder="1 - 100" value="10" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="createKpiQuarter" style="font-weight:600;">Kỳ áp dụng</label>
                                    <select id="createKpiQuarter" name="Quarter" class="form-control">
                                        <option value="Quý 1-2025" selected>Quý 1-2025</option>
                                        <option value="Quý 2-2025">Quý 2-2025</option>
                                        <option value="Quý 3-2025">Quý 3-2025</option>
                                        <option value="Quý 4-2025">Quý 4-2025</option>
                                        <option value="Quý 1-2026">Quý 1-2026</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="createKpiDescription" style="font-weight:600;">Cách đo / Nguồn dữ liệu</label>
                            <textarea id="createKpiDescription" name="Description" class="form-control" rows="3" placeholder="Mô tả công thức tính, nguồn số liệu đối chiếu và tiêu chuẩn nghiệm thu..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="hrm-btn" data-dismiss="modal">Hủy</button>
                        <button type="submit" class="hrm-btn hrm-btn-primary"><i class="material-icons">save</i> Tạo và giao KPI</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

