@model WorkPage
@{
    var currentUser = HrmUser.Current;
    var canEditKpi = Model.CanManage;
    var isManager = User.IsInRole(HrmRoles.Manager);
    var isEmployee = User.IsInRole(HrmRoles.Employee);
}

    <div class="kpi-container">
        <!-- 1. Bộ lọc thời hạn & Chuyển tab (Slide 10 & 11) -->
        <div class="kpi-filter-toolbar">
            <form method="get" asp-controller="Work" asp-action="Index" id="kpiFilterForm" class="kpi-filter-form">
                <input type="hidden" name="kind" value="kpi" />
                <input type="hidden" name="kpiType" id="kpiTypeInput" value="@Model.KpiTypeFilter" />

                <div class="kpi-filter-fields">
                    <div class="kpi-filter-group">
                        <label class="kpi-filter-label">Loại thời hạn</label>
                        <select name="periodType" class="form-control kpi-filter-select" onchange="document.getElementById('kpiFilterForm').submit()">
                            <option value="QUARTER" selected="@(Model.PeriodType == "QUARTER")">Quý</option>
                            <option value="YEAR" selected="@(Model.PeriodType == "YEAR")">Năm</option>
                            <option value="MONTH" selected="@(Model.PeriodType == "MONTH")">Tháng</option>
                        </select>
                    </div>

                    <div class="kpi-filter-group">
                        <label class="kpi-filter-label">Bắt đầu</label>
                        <select name="fromQuarter" class="form-control kpi-filter-select" onchange="document.getElementById('kpiFilterForm').submit()">
                            <option value="Quý 1-2025" selected="@(Model.FromQuarter == "Quý 1-2025")">Quý 1-2025</option>
                            <option value="Quý 2-2025" selected="@(Model.FromQuarter == "Quý 2-2025")">Quý 2-2025</option>
                            <option value="Quý 3-2025" selected="@(Model.FromQuarter == "Quý 3-2025")">Quý 3-2025</option>
                            <option value="Quý 4-2025" selected="@(Model.FromQuarter == "Quý 4-2025")">Quý 4-2025</option>
                            <option value="Quý 1-2026" selected="@(Model.FromQuarter == "Quý 1-2026")">Quý 1-2026</option>
                        </select>
                    </div>

                    <div class="kpi-filter-group">
                        <label class="kpi-filter-label">Kết thúc</label>
                        <select name="toQuarter" class="form-control kpi-filter-select" onchange="document.getElementById('kpiFilterForm').submit()">
                            <option value="Quý 1-2025" selected="@(Model.ToQuarter == "Quý 1-2025")">Quý 1-2025</option>
                            <option value="Quý 2-2025" selected="@(Model.ToQuarter == "Quý 2-2025")">Quý 2-2025</option>
                            <option value="Quý 3-2025" selected="@(Model.ToQuarter == "Quý 3-2025")">Quý 3-2025</option>
                            <option value="Quý 4-2025" selected="@(Model.ToQuarter == "Quý 4-2025")">Quý 4-2025</option>
                            <option value="Quý 1-2026" selected="@(Model.ToQuarter == "Quý 1-2026")">Quý 1-2026</option>
                        </select>
                    </div>

                    <div class="kpi-filter-group kpi-search-group">
                        <label class="kpi-filter-label">Tìm kiếm</label>
                        <div class="kpi-search-wrap">
                            <i class="material-icons">search</i>
                            <input name="q" value="@Model.Query" class="form-control kpi-search-input" placeholder="Tìm theo mục tiêu, mã, nhân viên…" />
                        </div>
                    </div>

                    <button type="submit" class="hrm-btn kpi-filter-btn" title="Tìm kiếm"><i class="material-icons">filter_list</i> Lọc</button>
                </div>
            </form>

            <div class="kpi-tabs-and-actions">
                <!-- Slide 11: Tabs KPI được chỉ định vs KPI từ kế hoạch -->
                <div class="kpi-pill-tabs">
                    <a href="@Url.Action("Index", new { kind = "kpi", kpiType = "ASSIGNED", fromQuarter = Model.FromQuarter, toQuarter = Model.ToQuarter, periodType = Model.PeriodType, q = Model.Query })"
                       class="kpi-pill-tab @(Model.KpiTypeFilter != "PLAN" ? "is-active" : "")">
                        <i class="material-icons">person</i> KPI được chỉ định
                    </a>
                    <a href="@Url.Action("Index", new { kind = "kpi", kpiType = "PLAN", fromQuarter = Model.FromQuarter, toQuarter = Model.ToQuarter, periodType = Model.PeriodType, q = Model.Query })"
                       class="kpi-pill-tab @(Model.KpiTypeFilter == "PLAN" ? "is-active" : "")">
                        <i class="material-icons">corporate_fare</i> KPI từ kế hoạch
                    </a>
                </div>

                @if (Model.CanManage)
                {
                    <button type="button" class="hrm-btn hrm-btn-primary kpi-create-btn" onclick="openCreateKpiModal()">
                        <i class="material-icons">add</i> Tạo KPI mới
                    </button>
                }
            </div>
        </div>

        <!-- 2. 4 Thẻ thống kê KPI chuẩn (Slide 10) -->
        <div class="kpi-stats-grid">
            <!-- Thẻ 1: Khối xanh dương chủ đạo nổi bật -->
            <div class="kpi-stat-card kpi-card-highlight">
                <div class="kpi-card-top">
                    <span class="kpi-card-label">Tổng số chỉ định KPI</span>
                    <span class="kpi-card-icon"><i class="material-icons">assignment</i></span>
                </div>
                <div class="kpi-card-value">@Model.TotalAssignedKpiCount</div>
                <div class="kpi-card-sub">
                    <span class="kpi-tag-sub">@Model.FromQuarter - @Model.ToQuarter</span>
                </div>
            </div>

            <!-- Thẻ 2: Số chỉ định đã chứng minh -->
            <div class="kpi-stat-card">
                <div class="kpi-card-top">
                    <span class="kpi-card-label">Số chỉ định đã chứng minh</span>
                    <span class="kpi-card-icon icon-emerald"><i class="material-icons">verified</i></span>
                </div>
                <div class="kpi-card-value text-slate">@Model.ProvenKpiCount</div>
                <div class="kpi-card-sub text-emerald">
                    <i class="material-icons" style="font-size:14px; vertical-align:text-top;">check_circle</i> Đã phê duyệt chứng minh
                </div>
            </div>

            <!-- Thẻ 3: Tỉ lệ đạt (Xanh lá) -->
            <div class="kpi-stat-card">
                <div class="kpi-card-top">
                    <span class="kpi-card-label">Tỉ lệ đạt</span>
                    <span class="kpi-card-icon icon-emerald"><i class="material-icons">trending_up</i></span>
                </div>
                <div class="kpi-card-value text-emerald">@Model.KpiPassRate.ToString("0.##")%</div>
                <div class="kpi-card-sub text-muted">
                    Chỉ tiêu hoàn thành / Đã đánh giá
                </div>
            </div>

            <!-- Thẻ 4: Tỉ lệ thực hiện KPI trung bình (Xanh dương) -->
            <div class="kpi-stat-card">
                <div class="kpi-card-top">
                    <span class="kpi-card-label">Tỉ lệ thực hiện KPI trung bình</span>
                    <span class="kpi-card-icon icon-blue"><i class="material-icons">pie_chart</i></span>
                </div>
                <div class="kpi-card-value text-blue">@Model.KpiAverageExecutionRate.ToString("0.##")%</div>
                <div class="kpi-card-progress">
                    <div class="kpi-card-progress-bar" style="width:@Math.Min(100, Model.KpiAverageExecutionRate)%"></div>
                </div>
            </div>
        </div>

        <!-- 3. Danh sách chỉ định KPI (Slide 10) -->
        <div class="kpi-table-card">
            <div class="kpi-table-header">
                <div class="kpi-table-title-group">
                    <h3 class="kpi-table-title">@(Model.KpiTypeFilter == "PLAN" ? "Danh sách KPI từ kế hoạch" : "Danh sách chỉ định KPI")</h3>
                    <span class="kpi-counter-badge">@Model.Items.Count bản ghi</span>
                </div>
                <!-- 4 Chú thích trạng thái màu sắc theo Slide 10 -->
                <div class="kpi-legend-row">
                    <div class="kpi-legend-item"><span class="kpi-dot dot-waiting-result"></span> Chờ kết quả</div>
                    <div class="kpi-legend-item"><span class="kpi-dot dot-waiting-proof"></span> Chờ chứng minh</div>
                    <div class="kpi-legend-item"><span class="kpi-dot dot-needs-revision"></span> Yêu cầu chỉnh sửa</div>
                    <div class="kpi-legend-item"><span class="kpi-dot dot-proven"></span> Đã chứng minh</div>
                </div>
            </div>

            @if (!Model.Available)
            {
                <div class="kpi-empty-box"><p>Chưa tải được dữ liệu KPI. Vui lòng thử lại sau.</p></div>
            }
            else if (Model.Items.Count == 0)
            {
                <div class="kpi-empty-box">
                    <i class="material-icons">inbox</i>
                    <h4>Chưa có dữ liệu KPI</h4>
                    <p>@(Model.CanManage ? "Bấm nút 'Tạo KPI mới' để giao chỉ tiêu đầu tiên." : "Chưa có chỉ tiêu KPI nào được giao trong kỳ này.")</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table kpi-table">
                        <thead>
                            <tr>
                                <th style="min-width:300px;">Mục tiêu</th>
                                <th style="width:130px;">KPI</th>
                                <th style="width:140px;">KPI Thực hiện</th>
                                <th style="width:130px; text-align:center;">Kết quả</th>
                                <th style="width:160px;">Tỉ lệ hoàn thành</th>
                                <th style="width:180px; text-align:right;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                var dotClass = item.Status switch
                                {
                                    "PROVEN" or "APPROVED" => "dot-proven",
                                    "WAITING_PROOF" => "dot-waiting-proof",
                                    "NEEDS_REVISION" or "REJECTED" => "dot-needs-revision",
                                    _ => "dot-waiting-result"
                                };
                                var dotTitle = item.Status switch
                                {
                                    "PROVEN" or "APPROVED" => "Đã chứng minh",
                                    "WAITING_PROOF" => "Chờ chứng minh",
                                    "NEEDS_REVISION" or "REJECTED" => "Yêu cầu chỉnh sửa",
                                    _ => "Chờ kết quả"
                                };
                                var isProven = item.Status is "PROVEN" or "APPROVED";
                                var canSubmitProof = currentUser != null && (Model.CanManage || item.EmployeeId == currentUser.Id);
                                var canEvaluate = Model.CanManage;
                                var rateClass = item.CompletionRate >= 100m ? "rate-green" : item.CompletionRate >= 70m ? "rate-blue" : item.CompletionRate >= 40m ? "rate-amber" : "rate-red";

                                <tr>
                                    <!-- Cột Mục tiêu: Dấu chấm trạng thái + Tiêu đề + Thông tin nhân viên / mã -->
                                    <td>
                                        <div class="kpi-target-cell">
                                            <span class="kpi-status-dot @dotClass" title="@dotTitle"></span>
                                            <div class="kpi-target-content">
                                                <div class="kpi-item-name">@item.Title</div>
                                                <div class="kpi-item-meta">
                                                    @if (!string.IsNullOrWhiteSpace(item.EmployeeName))
                                                    {
                                                        <span class="kpi-user-badge"><span class="kpi-mini-avatar">@GetInitials(item.EmployeeName)</span> @item.EmployeeName</span>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(item.DepartmentName))
                                                    {
                                                        <span class="kpi-dept-badge"><i class="material-icons">business</i> @item.DepartmentName</span>
                                                    }
                                                    <span class="kpi-code-tag">@(string.IsNullOrWhiteSpace(item.Reference) ? $"#{item.Id:D5}" : item.Reference)</span>
                                                    @if (item.Weight.HasValue)
                                                    {
                                                        <span class="kpi-weight-tag">Trọng số: @item.Weight%</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.ProofNote))
                                                {
                                                    <div class="kpi-proof-snippet" title="@item.ProofNote">
                                                        <i class="material-icons">attach_file</i>
                                                        <strong>Chứng minh:</strong> <span>@item.ProofNote</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.LastActionNote))
                                                {
                                                    <div class="kpi-feedback-snippet" title="@item.LastActionNote">
                                                        <i class="material-icons">announcement</i>
                                                        <strong>Phản hồi:</strong> <span>@item.LastActionNote</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Cột KPI (Target) -->
                                    <td>
                                        <div class="kpi-value-box">
                                            <span class="kpi-val-num">@(item.Target?.ToString("N0") ?? "0")</span>
                                            <span class="kpi-val-unit">@item.Category</span>
                                        </div>
                                    </td>

                                    <!-- Cột KPI Thực hiện (Actual) -->
                                    <td>
                                        <div class="kpi-value-box">
                                            @if (item.Actual.HasValue)
                                            {
                                                <span class="kpi-val-num actual-val">@item.Actual?.ToString("N0")</span>
                                                <span class="kpi-val-unit">@item.Category</span>
                                            }
                                            else
                                            {
                                                <span class="kpi-val-empty">Chưa nộp</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Cột Kết quả: Huy hiệu Đạt / Không đạt (Slide 10) -->
                                    <td style="text-align:center;">
                                        @if (isProven)
                                        {
                                            if (item.IsAchieved)
                                            {
                                                <span class="kpi-badge kpi-badge-pass"><i class="material-icons">check_circle</i> Đạt</span>
                                            }
                                            else
                                            {
                                                <span class="kpi-badge kpi-badge-fail"><i class="material-icons">cancel</i> Không đạt</span>
                                            }
                                        }
                                        else if (item.Status == "WAITING_PROOF")
                                        {
                                            <span class="kpi-badge kpi-badge-pending-proof"><i class="material-icons">pending</i> Chờ chứng minh</span>
                                        }
                                        else if (item.Status is "NEEDS_REVISION" or "REJECTED")
                                        {
                                            <span class="kpi-badge kpi-badge-revision"><i class="material-icons">error_outline</i> Cần chỉnh sửa</span>
                                        }
                                        else
                                        {
                                            <span class="kpi-badge kpi-badge-wait-result"><i class="material-icons">hourglass_empty</i> Chờ kết quả</span>
                                        }
                                    </td>

                                    <!-- Cột Tỉ lệ hoàn thành: % + Thanh tiến độ trực quan -->
                                    <td>
                                        <div class="kpi-progress-container">
                                            <div class="kpi-progress-bar-track">
                                                <div class="kpi-progress-bar-fill @rateClass" style="width:@Math.Min(100, item.CompletionRate)%"></div>
                                            </div>
                                            <span class="kpi-progress-label @rateClass">@item.CompletionRate.ToString("0.#")%</span>
                                        </div>
                                    </td>

                                    <!-- Cột Thao tác: Chứng minh & Phê duyệt theo sơ đồ Slide 12 -->
                                    <td style="text-align:right;">
                                        <div class="kpi-actions-cell">
                                            <!-- 1. Nút Gửi chứng minh (Nhân viên / Quản lý) -->
                                            @if (canSubmitProof)
                                            {
                                                <button type="button" class="kpi-action-btn btn-proof btn-trigger-proof"
                                                        title="Cập nhật kết quả & gửi chứng minh"
                                                        data-id="@item.Id"
                                                        data-title="@item.Title"
                                                        data-target="@(item.Target?.ToString("N0") ?? "0")"
                                                        data-category="@(item.Category ?? "")"
                                                        data-actual="@(item.Actual?.ToString("0.##") ?? "")"
                                                        data-proof="@(item.ProofNote ?? "")">
                                                    <i class="material-icons">upload_file</i> Chứng minh
                                                </button>
                                            }

                                            <!-- 2. Nút Phê duyệt kết quả (Dành cho Quản lý / HR / Giám đốc) -->
                                            @if (canEvaluate)
                                            {
                                                <button type="button" class="kpi-action-btn btn-evaluate btn-trigger-evaluate"
                                                        title="Đánh giá & Phê duyệt chứng minh (YES/NO)"
                                                        data-id="@item.Id"
                                                        data-title="@item.Title"
                                                        data-target="@(item.Target?.ToString("N0") ?? "0")"
                                                        data-category="@(item.Category ?? "")"
                                                        data-actual="@(item.Actual?.ToString("N0") ?? "")"
                                                        data-proof="@(item.ProofNote ?? "")"
                                                        data-review="@(item.LastActionNote ?? "")">
                                                    <i class="material-icons">rule</i> Duyệt
                                                </button>
                                            }

                                            <!-- 3. Nút Sửa / Xóa (Quản lý) -->
                                            @if (Model.CanManage)
                                            {
                                                <div class="btn-group">
                                                    <button type="button" class="kpi-icon-dropdown-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Tùy chọn khác">
                                                        <i class="material-icons">more_vert</i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-right kpi-dropdown-menu">
                                                        <li>
                                                            <a href="javascript:void(0)" class="btn-trigger-edit"
                                                               data-id="@item.Id"
                                                               data-title="@item.Title"
                                                               data-category="@(item.Category ?? "")"
                                                               data-reference="@(item.Reference ?? "")"
                                                               data-target="@(item.Target?.ToString("0.##") ?? "")"
                                                               data-weight="@(item.Weight?.ToString("0.##") ?? "")"
                                                               data-employee="@(item.EmployeeId?.ToString() ?? "")"
                                                               data-dept="@(item.DepartmentId?.ToString() ?? "")"
                                                               data-type="@(item.KpiType ?? "ASSIGNED")"
                                                               data-quarter="@(item.Quarter ?? "Quý 1-2025")"
                                                               data-desc="@(item.Description ?? "")"
                                                               data-status="@(item.Status ?? "WAITING_RESULT")">
                                                                <i class="material-icons" style="font-size:16px;">edit</i> Chỉnh sửa KPI
                                                            </a>
                                                        </li>
                                                        <li role="separator" class="divider"></li>
                                                        <li>
                                                            <form method="post" asp-controller="Work" asp-action="DeleteKpi" onsubmit="return confirm('Bạn có chắc chắn muốn xóa KPI này không?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" class="kpi-delete-link">
                                                                    <i class="material-icons" style="font-size:16px;">delete</i> Xóa KPI
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- MODAL 1: GỬI CHỨNG MINH KẾT QUẢ KPI (Slide 12) -->
    <div class="modal fade" id="modalSubmitProof" tabindex="-1" role="dialog" aria-labelledby="modalSubmitProofTitle">
        <div class="modal-dialog" role="document">
            <div class="modal-content kpi-modal-content">
                <form method="post" asp-controller="Work" asp-action="SubmitKpiProof">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="proofKpiId" value="" />
                    <div class="modal-header kpi-modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="modalSubmitProofTitle"><i class="material-icons">upload_file</i> Cập nhật kết quả & Chứng minh KPI</h4>
                    </div>
                    <div class="modal-body">
                        <div class="kpi-modal-info-box">
                            <div class="info-row"><span>Mục tiêu:</span><strong id="proofKpiTitle">—</strong></div>
                            <div class="info-row"><span>Chỉ tiêu giao:</span><strong id="proofKpiTarget" class="text-blue">—</strong></div>
                        </div>

                        <div class="form-group" style="margin-top:16px;">
                            <label for="proofActual" style="font-weight:600; color:#1e293b;">Kết quả thực hiện thực tế *</label>
                            <input type="number" step="0.01" min="0" max="1000000000" id="proofActual" name="actual" class="form-control" required placeholder="Nhập số liệu thực hiện..." />
                            <small class="text-muted">Nhập số liệu bạn đã hoàn thành để hệ thống tính tỉ lệ đạt.</small>
                        </div>

                        <div class="form-group">
                            <label for="proofNote" style="font-weight:600; color:#1e293b;">Tài liệu / Ghi chú chứng minh kết quả *</label>
                            <textarea id="proofNote" name="proofNote" class="form-control" rows="4" required placeholder="Mô tả minh chứng, đường dẫn file drive, số hóa đơn/hợp đồng hoặc kết quả chi tiết..."></textarea>
                            <small class="text-muted">Ghi chú minh chứng sẽ được gửi cho cấp quản lý thẩm định.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="hrm-btn" data-dismiss="modal">Hủy</button>
                        <button type="submit" class="hrm-btn hrm-btn-primary"><i class="material-icons">send</i> Gửi chứng minh (Chờ duyệt)</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2: ĐÁNH GIÁ & PHÊ DUYỆT CHỨNG MINH (Slide 12: YES / NO) -->
    <div class="modal fade" id="modalEvaluateProof" tabindex="-1" role="dialog" aria-labelledby="modalEvaluateProofTitle">
        <div class="modal-dialog" role="document">
            <div class="modal-content kpi-modal-content">
                <form method="post" asp-controller="Work" asp-action="EvaluateKpiProof">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="evalKpiId" value="" />
                    <div class="modal-header kpi-modal-header evaluate-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="modalEvaluateProofTitle"><i class="material-icons">fact_check</i> Đánh giá kết quả chứng minh KPI</h4>
                    </div>
                    <div class="modal-body">
                        <div class="kpi-modal-info-box">
                            <div class="info-row"><span>Mục tiêu:</span><strong id="evalKpiTitle">—</strong></div>
                            <div class="info-row"><span>Chỉ tiêu giao:</span><strong id="evalKpiTarget" class="text-blue">—</strong></div>
                            <div class="info-row"><span>Kết quả nhân viên báo cáo:</span><strong id="evalKpiActual" class="text-emerald">—</strong></div>
                        </div>

                        <div class="kpi-proof-display-box" style="margin-top:16px;">
                            <label style="font-weight:600; color:#334155; display:flex; align-items:center; gap:6px;">
                                <i class="material-icons" style="font-size:16px; color:#2563eb;">description</i> Minh chứng của nhân viên:
                            </label>
                            <div id="evalProofNote" class="kpi-proof-text">—</div>
                        </div>

                        <div class="form-group" style="margin-top:16px;">
                            <label for="evalReviewNote" style="font-weight:600; color:#1e293b;">Ý kiến đánh giá / Phản hồi của người duyệt</label>
                            <textarea id="evalReviewNote" name="reviewNote" class="form-control" rows="3" placeholder="Nhập ý kiến đánh giá hoặc lý do yêu cầu chỉnh sửa nếu từ chối..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
                        <button type="button" class="hrm-btn" data-dismiss="modal">Đóng</button>
                        <div style="display:flex; gap:10px;">
                            <!-- NO: Yêu cầu chỉnh sửa -->
                            <button type="submit" name="approve" value="false" class="hrm-btn kpi-btn-reject" title="Từ chối chứng minh, chuyển sang Yêu cầu chỉnh sửa">
                                <i class="material-icons">close</i> Yêu cầu chỉnh sửa (NO)
                            </button>
                            <!-- YES: Phê duyệt -->
                            <button type="submit" name="approve" value="true" class="hrm-btn kpi-btn-approve" title="Phê duyệt chứng minh, chuyển sang Đã chứng minh">
                                <i class="material-icons">check</i> Phê duyệt (YES)
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 3: TẠO KPI MỚI (Slide 11: Cá nhân vs Kế hoạch) -->
    <div class="modal fade" id="modalCreateKpi" tabindex="-1" role="dialog" aria-labelledby="modalCreateKpiTitle">
