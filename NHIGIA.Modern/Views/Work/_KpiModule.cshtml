<script>
    function openCreateKpiModal() {
        $('#modalCreateKpi').modal('show');
    }

    function toggleCreateKpiType(type) {
        if (type === 'PLAN') {
            $('#createEmployeeGroup').hide();
            $('#createKpiEmployeeId').val('');
        } else {
            $('#createEmployeeGroup').show();
        }
    }

    function toggleEditKpiType(type) {
        if (type === 'PLAN') {
            $('#editEmployeeGroup').hide();
            $('#editKpiEmployeeId').val('');
        } else {
            $('#editEmployeeGroup').show();
        }
    }

    function switchKpiTab(type) {
        $('#kpiTypeInput').val(type);
        $('#kpiFilterForm').submit();
    }

    $(document).ready(function() {
        // Gửi chứng minh kết quả
        $(document).on('click', '.btn-trigger-proof', function() {
            var btn = $(this);
            $('#proofKpiId').val(btn.attr('data-id') || btn.data('id'));
            $('#proofKpiTitle').text(btn.attr('data-title') || btn.data('title') || '—');
            var target = btn.attr('data-target') || btn.data('target') || '0';
            var cat = btn.attr('data-category') || btn.data('category') || '';
            $('#proofKpiTarget').text(target + ' ' + cat);
            $('#proofActual').val(btn.attr('data-actual') || btn.data('actual') || '');
            $('#proofNote').val(btn.attr('data-proof') || btn.data('proof') || '');
            $('#modalSubmitProof').modal('show');
        });

        // Duyệt & Đánh giá kết quả (YES/NO)
        $(document).on('click', '.btn-trigger-evaluate', function() {
            var btn = $(this);
            $('#evalKpiId').val(btn.attr('data-id') || btn.data('id'));
            $('#evalKpiTitle').text(btn.attr('data-title') || btn.data('title') || '—');
            var target = btn.attr('data-target') || btn.data('target') || '0';
            var cat = btn.attr('data-category') || btn.data('category') || '';
            $('#evalKpiTarget').text(target + ' ' + cat);
            var actual = btn.attr('data-actual') || btn.data('actual') || '0';
            $('#evalKpiActual').text(actual + ' ' + cat);
            var proof = btn.attr('data-proof') || btn.data('proof');
            $('#evalProofNote').text(proof && proof.trim() ? proof : 'Chưa có ghi chú minh chứng');
            $('#evalReviewNote').val(btn.attr('data-review') || btn.data('review') || '');
            $('#modalEvaluateProof').modal('show');
        });

        // Chỉnh sửa KPI
        $(document).on('click', '.btn-trigger-edit', function() {
            var btn = $(this);
            $('#editKpiId').val(btn.attr('data-id') || btn.data('id'));
            $('#editKpiTitle').val(btn.attr('data-title') || btn.data('title') || '');
            $('#editKpiCategory').val(btn.attr('data-category') || btn.data('category') || '');
            $('#editKpiReference').val(btn.attr('data-reference') || btn.data('reference') || '');
            $('#editKpiTarget').val(btn.attr('data-target') || btn.data('target') || '');
            $('#editKpiWeight').val(btn.attr('data-weight') || btn.data('weight') || '10');
            $('#editKpiEmployeeId').val(btn.attr('data-employee') || btn.data('employee') || '');
            $('#editKpiDepartmentId').val(btn.attr('data-dept') || btn.data('dept') || '');
            var kpiType = btn.attr('data-type') || btn.data('type') || 'ASSIGNED';
            if (kpiType === 'PLAN') {
                $('#editTypePlan').prop('checked', true);
                toggleEditKpiType('PLAN');
            } else {
                $('#editTypeAssigned').prop('checked', true);
                toggleEditKpiType('ASSIGNED');
            }
            $('#editKpiQuarter').val(btn.attr('data-quarter') || btn.data('quarter') || 'QuÃ½ 1-2025');
            $('#editKpiDescription').val(btn.attr('data-desc') || btn.data('desc') || '');
            $('#editKpiStatus').val(btn.attr('data-status') || btn.data('status') || 'WAITING_RESULT');
            $('#modalEditKpi').modal('show');
        });
    });
</script>
