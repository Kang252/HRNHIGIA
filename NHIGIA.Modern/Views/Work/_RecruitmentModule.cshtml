    .integration-card-head { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
    .integration-card-head h4 { margin:0 0 3px; font-size:18px; font-weight:750; }
    .provider-mark { width:44px; height:44px; display:grid; place-items:center; border-radius:12px; color:#fff; font-weight:800; }
