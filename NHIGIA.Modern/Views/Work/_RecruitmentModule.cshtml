@model WorkPage
@{
    var items = Model.Items ?? new List<WorkItem>();
    var totalPositions = items.Count;
    var candidates = Model.RecruitmentCandidates ?? new List<RecruitmentCandidateModel>();
    var integrations = Model.RecruitmentIntegrations ?? new List<RecruitmentIntegrationSettingsModel>();
    var topCvIntegration = integrations.FirstOrDefault(x => x.ProviderCode == "TOPCV");
    var careerVietIntegration = integrations.FirstOrDefault(x => x.ProviderCode == "CAREERVIET");
    var activeSources = integrations.Count(x => x.IsEnabled);
    var totalApplicants = candidates.Count > 0 ? candidates.Count : items.Sum(x => x.Actual ?? 0);
    var totalTarget = items.Sum(x => x.Target ?? 0);
}

<div class="recruitment-container">
    <!-- Header -->
    <div class="recruitment-header-hero">
        <div>
            <h2 style="font-weight:700; color:#0f172a; margin:0 0 6px;">Nhu cầu tuyển dụng</h2>
            <p style="color:#64748b; margin:0; font-size:14px;">Theo dõi nhu cầu tuyển dụng và tiến độ ứng viên theo từng vị trí.</p>
        </div>
        <div>
            <a class="hrm-btn hrm-btn-primary" asp-controller="Work" asp-action="CreateRecruitmentPosition" style="display:inline-flex; align-items:center; gap:6px; padding:9px 18px; font-weight:600; border-radius:8px;">
                <i class="material-icons" style="font-size:18px;">add</i> Tạo vị trí mới
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="recruitment-stats-grid">
        <div class="rec-stat-card">
            <div class="rec-stat-icon" style="background:#eff6ff; color:#2563eb;">
                <i class="material-icons">work</i>
            </div>
            <div class="rec-stat-info">
                <h4>Vị trí đang tuyển</h4>
                <div class="rec-stat-val">@totalPositions</div>
                <small>Chiến dịch tuyển dụng</small>
            </div>
        </div>
        <div class="rec-stat-card">
            <div class="rec-stat-icon" style="background:#f0fdf4; color:#16a34a;">
                <i class="material-icons">group_add</i>
            </div>
            <div class="rec-stat-info">
                <h4>Chỉ tiêu cần tuyển</h4>
                <div class="rec-stat-val">@totalTarget.ToString("N0")</div>
                <small>Nhân sự mục tiêu</small>
            </div>
        </div>
        <div class="rec-stat-card">
            <div class="rec-stat-icon" style="background:#fdf4ff; color:#a855f7;">
                <i class="material-icons">description</i>
            </div>
            <div class="rec-stat-info">
                <h4>Số lượng CV nhận</h4>
                <div class="rec-stat-val">@totalApplicants.ToString("N0")</div>
                <small>Hồ sơ ứng viên</small>
            </div>
        </div>
        <div class="rec-stat-card">
            <div class="rec-stat-icon" style="background:#fffbeb; color:#d97706;">
                <i class="material-icons">how_to_reg</i>
            </div>
            <div class="rec-stat-info">
                <h4>Tiến độ tiếp nhận</h4>
                <div class="rec-stat-val">@(totalTarget > 0 ? Math.Round((double)totalApplicants * 100 / (double)totalTarget, 0) : 0)%</div>
                <small>Tỷ lệ ứng tuyển</small>
            </div>
        </div>
    </div>

    <!-- Filter toolbar -->
    <div class="recruitment-toolbar-card">
        <form method="get" asp-controller="Work" asp-action="Index" class="recruitment-filter-form">
            <input type="hidden" name="kind" value="recruitment" />
            <div class="rec-search-input-wrap">
                <i class="material-icons">search</i>
                <input name="q" value="@Model.Query" class="form-control" placeholder="Tìm theo tên vị trí, mã, phòng ban…" />
            </div>
            <button class="hrm-btn hrm-btn-primary" type="submit" style="padding:8px 16px; border-radius:8px;">Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="recruitment" style="border-radius:8px;">Đặt lại</a>
            }
        </form>
    </div>

    <!-- Table -->
    <div class="recruitment-table-card">
        <div class="table-responsive">
            <table class="table table-hover recruitment-main-table">
                <thead>
                    <tr>
                        <th style="width:280px;">Vị trí tuyển dụng</th>
                        <th>Phòng ban</th>
                        <th>Chỉ tiêu</th>
                        <th>Số lượng CV</th>
                        <th>Hạn nộp</th>
                        <th>Địa điểm</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right; width:130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Available)
                    {
                        <tr><td colspan="8" class="text-center" style="padding:30px; color:#64748b;">Chưa kết nối được cơ sở dữ liệu. Vui lòng thử lại.</td></tr>
                    }
                    else if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center" style="padding:40px; color:#64748b;">
                                <i class="material-icons" style="font-size:40px; color:#cbd5e1; display:block; margin-bottom:8px;">inventory_2</i>
                                <span>Chưa có vị trí tuyển dụng nào phù hợp.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in items)
                        {
                            var target = item.Target ?? 1;
                            var cvCount = item.Actual ?? 0;
                            var pct = target > 0 ? Math.Min(100, Math.Round((double)cvCount * 100 / (double)target, 0)) : 0;
                            <tr>
                                <td>
                                    <div style="font-weight:700; color:#0f172a; font-size:14px;">@item.Title</div>
                                    <small style="color:#64748b; font-size:12px;">Mã: @(item.Reference ?? $"TD-{item.Id:D3}")</small>
                                </td>
                                <td>
                                    <span style="font-weight:500; color:#334155;">@(item.DepartmentName ?? "Chưa phân phòng")</span>
                                    @if (!string.IsNullOrWhiteSpace(item.JobLevel))
                                    {
                                        <div style="font-size:11.5px; color:#64748b;">Cấp bậc: @item.JobLevel</div>
                                    }
                                </td>
                                <td>
                                    <strong style="color:#0f172a; font-size:13.5px;">@target.ToString("N0")</strong>
                                    <span style="font-size:12px; color:#64748b;">người</span>
                                </td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <strong style="color:#2563eb; font-size:13.5px;">@cvCount.ToString("N0")</strong>
                                        <span style="font-size:11.5px; color:#64748b;">(@pct%)</span>
                                    </div>
                                    <div class="rec-progress-track">
                                        <div class="rec-progress-fill" style="width:@pct%;"></div>
                                    </div>
                                </td>
                                <td>
                                    <span style="color:#334155; font-size:13px;">@(item.DueDate?.ToString("dd/MM/yyyy") ?? "—")</span>
                                </td>
                                <td>
                                    <span style="color:#64748b; font-size:13px;">@(item.WorkLocation ?? "TP. Hồ Chí Minh")</span>
                                </td>
                                <td>
                                    <span class="rec-status-badge status-active">Đang tuyển</span>
                                </td>
                                <td style="text-align:right;">
                                    <div style="display:inline-flex; gap:4px;">
                                        <button type="button" class="btn btn-default btn-sm btn-view-recruitment"
                                                title="Xem chi tiết vị trí"
                                                data-id="@item.Id"
                                                data-title="@item.Title"
                                                data-ref="@(item.Reference ?? $"TD-{item.Id:D3}")"
                                                data-dept="@(item.DepartmentName ?? "")"
                                                data-target="@target"
                                                data-actual="@cvCount"
                                                data-due="@(item.DueDate?.ToString("dd/MM/yyyy") ?? "")"
                                                data-start="@(item.StartDate?.ToString("dd/MM/yyyy") ?? "")"
                                                data-loc="@(item.WorkLocation ?? "TP. Hồ Chí Minh")"
                                                data-joblevel="@(item.JobLevel ?? "")"
                                                data-salary="@(item.SalaryRange ?? "Thỏa thuận")"
                                                data-contract="@(item.ContractType ?? "Toàn thời gian")"
                                                data-desc="@item.Description"
                                                data-skills="@item.SkillRequirements"
                                                data-benefits="@item.Benefits"
                                                data-contact="@item.ContactName"
                                                data-phone="@item.ContactPhone"
                                                data-email="@item.ContactEmail">
                                            <i class="material-icons" style="font-size:16px;">visibility</i>
                                        </button>
                                        @if (Model.CanManage)
                                        {
                                            <form method="post" asp-controller="Work" asp-action="DeleteRecruitmentPosition" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vị trí tuyển dụng này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-default btn-sm text-danger" title="Xóa vị trí">
                                                    <i class="material-icons" style="font-size:16px; color:#ef4444;">delete</i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <section id="candidate-inbox" class="recruitment-source-section">
        <div class="recruitment-section-heading">
            <div><h3>Hồ sơ ứng viên</h3><p>CV nhận từ nguồn đã kết nối; hiện tại TopCV sử dụng webhook trực tiếp.</p></div>
            <span class="recruitment-count">@candidates.Count hồ sơ</span>
        </div>
        <div class="table-responsive recruitment-table-card">
            <table class="table table-hover recruitment-main-table candidate-table">
                <thead><tr><th>Ứng viên</th><th>Nguồn</th><th>Vị trí</th><th>Ngày ứng tuyển</th><th>Trạng thái</th><th>CV</th></tr></thead>
                <tbody>
                @if (candidates.Count == 0)
                {
                    <tr><td colspan="6"><div class="recruitment-source-empty"><i class="material-icons">inbox</i><strong>Chưa nhận CV từ nguồn tuyển dụng</strong><span>TopCV sẽ tự động chuyển hồ sơ mới về đây sau khi webhook được kích hoạt.</span></div></td></tr>
                }
                else
                {
                    foreach (var candidate in candidates)
                    {
                        <tr>
                            <td><strong>@(candidate.FullName ?? "Chưa có tên")</strong><small>@(candidate.Email ?? candidate.Phone ?? "Chưa có thông tin liên hệ")</small></td>
                            <td><span class="provider-chip provider-@candidate.ProviderCode.ToLowerInvariant()">@(candidate.ProviderCode == "TOPCV" ? "TopCV" : "CareerViet")</span></td>
                            <td>
                                @if (candidate.RecruitmentWorkItemId.HasValue)
                                {
                                    <strong>@candidate.PositionTitle</strong><small>@(candidate.PositionReference ?? candidate.ExternalJobId ?? "—")</small>
                                }
                                else
                                {
                                    <form method="post" asp-controller="Work" asp-action="AssignRecruitmentCandidate" class="candidate-assign-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="candidateId" value="@candidate.Id" />
                                        <select name="workItemId" class="form-control" required><option value="">Chọn vị trí…</option>@foreach (var position in items) { <option value="@position.Id">@(position.Reference ?? $"TD-{position.Id:D3}") · @position.Title</option> }</select>
                                        <button class="hrm-btn" type="submit">Ghép</button>
                                    </form>
                                    <small>Mã nguồn: @(candidate.ExternalJobId ?? "—")</small>
                                }
                            </td>
                            <td>@(candidate.AppliedAt?.ToString("dd/MM/yyyy HH:mm") ?? candidate.ReceivedAt.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td><span class="rec-status-badge @(candidate.RecruitmentWorkItemId.HasValue ? "status-active" : "status-unmapped")">@(candidate.RecruitmentWorkItemId.HasValue ? "Đã tiếp nhận" : "Cần ghép vị trí")</span></td>
                            <td>
                                @if (candidate.HasCvContent || !string.IsNullOrWhiteSpace(candidate.CvUrl))
                                {
                                    <a class="hrm-btn candidate-cv" asp-controller="Work" asp-action="RecruitmentCandidateCv" asp-route-id="@candidate.Id"><i class="material-icons">download</i> Tải CV</a>
                                }
                                else { <span class="text-muted">Chưa có tệp</span> }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section id="candidate-integrations" class="recruitment-source-section">
        <div class="recruitment-section-heading">
            <div><h3>Kết nối nguồn CV</h3><p>Cấu hình theo đúng phương thức đang được từng nền tảng hỗ trợ.</p></div>
            <span class="recruitment-count">@activeSources nguồn đang bật</span>
        </div>
        <div class="integration-overview">
            <div class="integration-overview-icon"><i class="material-icons">hub</i></div>
            <div><strong>Luồng tiếp nhận hiện tại</strong><span>TopCV gửi hồ sơ mới vào webhook của Nhị Gia. CareerViet chỉ được kích hoạt sau khi nhà cung cấp cấp tài liệu tích hợp đối tác.</span></div>
        </div>
        <div class="recruitment-integration-grid">
        @if (topCvIntegration != null)
        {
            var topCvWebhookUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/api/recruitment/topcv/applications";
            var topCvConnected = topCvIntegration.IsEnabled && topCvIntegration.LastStatus == "SUCCESS";
            <form method="post" asp-controller="Work" asp-action="SaveRecruitmentIntegration" class="recruitment-integration-card integration-card-primary">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProviderCode" value="TOPCV" />
                <input type="hidden" name="ApiBaseUrl" value="@topCvIntegration.ApiBaseUrl" />
                <input type="hidden" name="AccountId" value="@topCvIntegration.AccountId" />
                <input type="hidden" name="ApiKey" value="@topCvIntegration.ApiKey" />
                <div class="integration-card-head">
                    <div class="provider-mark provider-topcv">T</div>
                    <div class="integration-card-title"><h4>TopCV</h4><span>Nhận CV tự động bằng webhook</span></div>
                    <span class="integration-status-pill @(topCvConnected ? "is-success" : topCvIntegration.IsEnabled ? "is-waiting" : "is-off")">
                        <i class="material-icons">@(topCvConnected ? "check_circle" : topCvIntegration.IsEnabled ? "sync" : "pause_circle")</i>
                        @(topCvConnected ? "Đã kết nối" : topCvIntegration.IsEnabled ? "Đang chờ CV" : "Đang tắt")
                    </span>
                </div>

                <div class="integration-steps" aria-label="Các bước kết nối TopCV">
                    <div class="is-done"><span>1</span><p><strong>Chọn Webhook</strong><small>Trong mục Đồng bộ CV của TopCV</small></p></div>
                    <div class="is-done"><span>2</span><p><strong>Chọn API Key</strong><small>Dùng khóa bảo mật bên dưới</small></p></div>
                    <div class="@(topCvIntegration.IsEnabled ? "is-done" : "")"><span>3</span><p><strong>Bật tiếp nhận</strong><small>Lưu cấu hình và gửi bản thử</small></p></div>
                </div>

                <label>Webhook URL
                    <div class="webhook-copy-row"><input id="topCvWebhookUrl" class="form-control" readonly value="@topCvWebhookUrl" /><button class="hrm-btn copy-integration-value" type="button" data-target="topCvWebhookUrl" title="Sao chép URL"><i class="material-icons">content_copy</i></button></div>
                    <small class="integration-field-help">Dán địa chỉ này vào trường Webhook URL trên TopCV.</small>
                </label>
                <label>Secret key / API Key
                    <div class="webhook-copy-row"><input id="topCvWebhookSecret" class="form-control" type="password" name="WebhookSecret" value="@topCvIntegration.WebhookSecret" autocomplete="off" /><button class="hrm-btn toggle-secret" type="button" data-target="topCvWebhookSecret" title="Hiện hoặc ẩn khóa"><i class="material-icons">visibility</i></button><button class="hrm-btn copy-integration-value" type="button" data-target="topCvWebhookSecret" title="Sao chép khóa"><i class="material-icons">content_copy</i></button></div>
                    <small class="integration-field-help">TopCV gửi khóa này qua API Key; hệ thống cũng hỗ trợ các header Secret Key và Bearer token phổ biến.</small>
                </label>
                <label class="integration-toggle"><input type="checkbox" name="IsEnabled" value="true" checked="@topCvIntegration.IsEnabled" /><span class="integration-switch" aria-hidden="true"></span><span>Cho phép TopCV gửi hồ sơ vào hệ thống</span></label>
                <div class="integration-message status-@((topCvIntegration.LastStatus ?? "unknown").ToLowerInvariant())"><strong>@(topCvConnected ? "Kết nối hoạt động" : "Trạng thái TopCV")</strong><span>@(topCvIntegration.LastMessage ?? "Chưa có dữ liệu kiểm tra.")</span>@if (topCvIntegration.LastReceivedAt.HasValue) { <small>Nhận gần nhất: @topCvIntegration.LastReceivedAt.Value.ToString("dd/MM/yyyy HH:mm")</small> }</div>
                <button class="hrm-btn hrm-btn-primary integration-save" type="submit"><i class="material-icons">save</i> Lưu cấu hình TopCV</button>
            </form>
        }
        @if (careerVietIntegration != null)
        {
            var careerVietWebhookUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/api/recruitment/careerviet/applications";
            <article class="recruitment-integration-card integration-card-pending">
                <div class="integration-card-head">
                    <div class="provider-mark provider-careerviet">CV</div>
                    <div class="integration-card-title"><h4>CareerViet</h4><span>Tích hợp dành cho đối tác ATS</span></div>
                    <span class="integration-status-pill is-pending"><i class="material-icons">schedule</i> Chờ nhà cung cấp</span>
                </div>
                <div class="provider-notice provider-notice-warning">
                    <i class="material-icons">info</i><div><strong>Chưa có API công khai để nhận CV</strong><span>CareerViet cần cấp tài liệu tích hợp, thông tin xác thực và payload mẫu theo tài khoản doanh nghiệp trước khi bật kết nối.</span></div>
                </div>
                <div class="integration-requirements">
                    <strong>Thông tin cần CareerViet cung cấp</strong>
                    <ul><li>Cơ chế webhook hoặc API đồng bộ hồ sơ</li><li>Kiểu xác thực và khóa dành cho đối tác</li><li>Payload mẫu, tải tệp CV và mã vị trí</li><li>Sự kiện thử nghiệm, retry và chống trùng hồ sơ</li></ul>
                </div>
                <label>Endpoint HRM đã chuẩn bị
                    <div class="webhook-copy-row"><input id="careerVietWebhookUrl" class="form-control" readonly value="@careerVietWebhookUrl" /><button class="hrm-btn copy-integration-value" type="button" data-target="careerVietWebhookUrl" title="Sao chép URL"><i class="material-icons">content_copy</i></button></div>
                    <small class="integration-field-help">Chỉ cung cấp endpoint này sau khi CareerViet xác nhận chuẩn tích hợp.</small>
                </label>
                <div class="integration-message"><strong>Trạng thái CareerViet</strong><span>Chưa kích hoạt; đang chờ CareerViet cấp chuẩn tích hợp chính thức.</span></div>
                <div class="integration-pending-actions"><button class="hrm-btn" type="button" disabled><i class="material-icons">lock</i> Chưa thể kích hoạt</button><a href="mailto:sales@careerviet.vn?subject=Yêu cầu tích hợp ATS với CareerViet" class="integration-contact-link"><i class="material-icons">mail_outline</i> Liên hệ CareerViet</a></div>
            </article>
        }
        </div>
    </section>
</div>

<!-- MODAL: CHI TIẾT VỊ TRÍ TUYỂN DỤNG -->
<div class="modal fade" id="modalRecruitmentDetail" tabindex="-1" role="dialog" aria-labelledby="modalRecruitmentDetailTitle">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #1e3a8a, #2563eb); color:#ffffff; padding:18px 24px;">
                <button type="button" class="close" data-dismiss="modal" style="color:#ffffff; opacity:0.85;">&times;</button>
                <h4 class="modal-title" id="modalRecruitmentDetailTitle" style="font-weight:700; display:flex; align-items:center; gap:8px;">
                    <i class="material-icons">work</i> <span id="recDetailTitle">Chi tiết vị trí tuyển dụng</span>
                </h4>
            </div>
            <div class="modal-body" style="padding:24px;">
                <!-- Overview Row -->
                <div class="rec-modal-grid">
                    <div><span>Mã vị trí:</span> <strong id="recDetailRef">—</strong></div>
                    <div><span>Phòng ban:</span> <strong id="recDetailDept">—</strong></div>
                    <div><span>Số lượng tuyển:</span> <strong id="recDetailTarget" class="text-blue">—</strong></div>
                    <div><span>Số lượng CV nộp:</span> <strong id="recDetailActual" class="text-emerald">—</strong></div>
                    <div><span>Hạn nộp hồ sơ:</span> <strong id="recDetailDue">—</strong></div>
                    <div><span>Địa điểm:</span> <strong id="recDetailLoc">—</strong></div>
                    <div><span>Cấp bậc:</span> <strong id="recDetailLevel">—</strong></div>
                    <div><span>Mức lương:</span> <strong id="recDetailSalary" style="color:#059669;">—</strong></div>
                </div>

                <div style="margin-top:20px;">
                    <h5 style="font-weight:700; color:#0f172a; margin-bottom:6px;"><i class="material-icons" style="font-size:16px; vertical-align:middle;">subject</i> Mô tả công việc</h5>
                    <div id="recDetailDesc" class="rec-modal-section-box">Chưa có mô tả chi tiết.</div>
                </div>

                <div style="margin-top:16px;">
                    <h5 style="font-weight:700; color:#0f172a; margin-bottom:6px;"><i class="material-icons" style="font-size:16px; vertical-align:middle;">checklist</i> Yêu cầu kỹ năng & kinh nghiệm</h5>
                    <div id="recDetailSkills" class="rec-modal-section-box">Chưa có yêu cầu kỹ năng.</div>
                </div>

                <div style="margin-top:16px;">
                    <h5 style="font-weight:700; color:#0f172a; margin-bottom:6px;"><i class="material-icons" style="font-size:16px; vertical-align:middle;">card_giftcard</i> Quyền lợi & Đãi ngộ</h5>
                    <div id="recDetailBenefits" class="rec-modal-section-box">Chưa có quyền lợi chi tiết.</div>
                </div>

