<script>
    $(document).ready(function() {
        $(document).on('click', '.btn-view-recruitment', function() {
            var btn = $(this);
            $('#recDetailTitle').text(btn.data('title') || 'Vị trí tuyển dụng');
            $('#recDetailRef').text(btn.data('ref') || '—');
            $('#recDetailDept').text(btn.data('dept') || '—');
            $('#recDetailTarget').text((btn.data('target') || '0') + ' người');
            $('#recDetailActual').text((btn.data('actual') || '0') + ' hồ sơ');
            $('#recDetailDue').text(btn.data('due') || '—');
            $('#recDetailLoc').text(btn.data('loc') || 'TP. Hồ Chí Minh');
            $('#recDetailLevel').text(btn.data('joblevel') || 'Nhân viên');
            $('#recDetailSalary').text(btn.data('salary') || 'Thỏa thuận');

            $('#recDetailDesc').text(btn.data('desc') || 'Chưa có mô tả chi tiết.');
            $('#recDetailSkills').text(btn.data('skills') || 'Chưa có yêu cầu kỹ năng.');
            $('#recDetailBenefits').text(btn.data('benefits') || 'Chưa có thông tin đãi ngộ.');

            var contact = btn.data('contact');
            var phone = btn.data('phone');
            var email = btn.data('email');
            $('#recDetailContact').text('Người liên hệ: ' + (contact || 'Phòng Tuyển dụng'));
            $('#recDetailPhone').text('SĐT: ' + (phone || '0901 234 567'));
            $('#recDetailEmail').text('Email: ' + (email || 'tuyendung@nhigia.vn'));

            $('#modalRecruitmentDetail').modal('show');
        });
        $(document).on('click', '.copy-integration-value', function() {
            var button = $(this), input = document.getElementById(button.attr('data-target'));
            if (!input) return;
            var copied = function() {
                button.find('i').text('check');
                setTimeout(function(){ button.find('i').text('content_copy'); }, 1500);
            };
            if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(input.value).then(copied);
            else {
                input.select();
                document.execCommand('copy');
                input.setSelectionRange(0, 0);
                copied();
            }
        });
        $(document).on('click', '.toggle-secret', function() {
            var button = $(this), input = document.getElementById(button.attr('data-target'));
            if (!input) return;
            var reveal = input.type === 'password';
            input.type = reveal ? 'text' : 'password';
            button.find('i').text(reveal ? 'visibility_off' : 'visibility');
        });
    });
</script>

