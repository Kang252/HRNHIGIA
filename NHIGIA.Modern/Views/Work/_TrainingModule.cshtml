    <!-- MODAL 1: CHI TIẾT KHÓA ĐÀO TẠO & KHO TÀI LIỆU (Slide 16 & 17) -->
    <div class="modal fade" id="modalTrainingDetail" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                <div class="modal-header trn-modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="dtCourseTitle" style="font-weight:700;"><i class="material-icons" style="vertical-align:middle;margin-right:6px;">school</i> Chi tiết khóa đào tạo</h4>
                </div>
                <div class="modal-body trn-modal-body">
                    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:14px; margin-bottom:18px;">
                        <div><span style="color:#64748b; font-size:12px;">Mã khóa học:</span> <div id="dtCourseRef" style="font-weight:700; color:#0284c7;">—</div></div>
                        <div><span style="color:#64748b; font-size:12px;">Hình thức:</span> <div id="dtCourseCat" style="font-weight:700;">—</div></div>
                        <div><span style="color:#64748b; font-size:12px;">Thời lượng:</span> <div id="dtCourseHours" style="font-weight:700;">— giờ</div></div>
                        <div><span style="color:#64748b; font-size:12px;">Phạm vi:</span> <div id="dtCourseScope" style="font-weight:700;">—</div></div>
                    </div>

                    <div class="form-group">
                        <label style="font-weight:700; color:#1e293b;">Mô tả khóa đào tạo</label>
                        <p id="dtCourseDesc" style="color:#475569; font-size:13.5px; line-height:1.6; margin:0;"></p>
                    </div>

                    <div class="row" style="margin-top:16px;">
                        <div class="col-md-6">
                            <label style="font-weight:700; color:#1e293b;"><i class="material-icons" style="font-size:16px;color:#16a34a;vertical-align:middle;">task_alt</i> Mục tiêu & Kỹ năng đạt được</label>
                            <div id="dtCourseSkills" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:12px; font-size:13px; color:#166534; line-height:1.5;"></div>
                        </div>
                        <div class="col-md-6">
                            <label style="font-weight:700; color:#1e293b;"><i class="material-icons" style="font-size:16px;color:#0284c7;vertical-align:middle;">folder_open</i> Kho tri thức & Tài liệu học tập</label>
                            <div id="dtCourseBenefits" style="background:#f0f9ff; border:1px solid #bae6fd; border-radius:8px; padding:12px; font-size:13px; color:#0369a1; line-height:1.5;"></div>
                        </div>
                    </div>

                    <div style="margin-top:20px;">
                        <label style="font-weight:700; color:#1e293b;"><i class="material-icons" style="font-size:16px;color:#d97706;vertical-align:middle;">person</i> Giảng viên phụ trách</label>
                        <div id="dtCourseInstructor" style="font-size:13.5px; color:#334155; font-weight:600;">—</div>
                    </div>
                </div>
                <div class="modal-footer" style="background:#fafafa; border-top:1px solid #e2e8f0;">
                    <button type="button" class="hrm-btn" data-dismiss="modal">Đóng</button>
                    <div id="dtEnrollActionWrap" style="display:inline-block;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 2: TẠO / SỬA KHÓA ĐÀO TẠO (Slide 16: Tạo và quản lý chương trình) -->
    @if (Model.CanManage)
    {
        <div class="modal fade" id="modalCreateTraining" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                    <form method="post" asp-controller="Work" asp-action="SaveTrainingCourse">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" id="editTrnId" value="0" />
                        <input type="hidden" name="Keywords" id="trnKeywords" value="" />
                        <div class="modal-header trn-modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="modalCreateTrainingTitle"><i class="material-icons" style="vertical-align:middle;margin-right:6px;">school</i> Thiết lập chương trình đào tạo</h4>
                        </div>
                        <div class="modal-body trn-modal-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="trnTitle" style="font-weight:700;">Tên khóa đào tạo *</label>
                                        <input id="trnTitle" name="Title" class="form-control" required placeholder="Nhập tên khóa học..." />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="trnRef" style="font-weight:700;">Mã khóa học</label>
                                        <input id="trnRef" name="Reference" class="form-control" placeholder="Tự động (VD: TRN-DEV-01)" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="trnThemePill" style="font-weight:700;">Chủ đề nhận diện</label>
                                        <select id="trnThemePill" class="form-control">
                                            <option value="">Tự động theo tên</option>
                                            <option value="TRN-DEV">Công nghệ phần mềm</option>
                                            <option value="TRN-DEVOPS">DevOps & Cloud</option>
                                            <option value="TRN-WEB">Phát triển Web</option>
                                            <option value="TRN-PM">Quản lý dự án</option>
                                            <option value="TRN-AGILE">Agile & Scrum</option>
                                            <option value="TRN-ENG">Tiếng Anh kinh doanh</option>
                                            <option value="TRN-TIME">Quản lý thời gian</option>
                                            <option value="TRN-LEAD">Lãnh đạo & Quản trị</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="trnCategory" style="font-weight:700;">Hình thức</label>
                                        <select id="trnCategory" name="Category" class="form-control">
                                            <option value="Online">Online</option>
                                            <option value="Offline">Offline</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="trnLocation" style="font-weight:700;">Phạm vi áp dụng</label>
                                        <input id="trnLocation" name="WorkLocation" class="form-control" value="Tất cả" placeholder="Tất cả / Phòng ban..." />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="trnTarget" style="font-weight:700;">Thời lượng (Giờ)</label>
                                        <input type="number" id="trnTarget" name="Target" class="form-control" value="24" min="1" max="500" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="trnInstructor" style="font-weight:700;">Giảng viên / Chuyên gia</label>
                                        <input id="trnInstructor" name="ContactName" class="form-control" placeholder="Họ tên giảng viên..." />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="trnStart" style="font-weight:700;">Ngày bắt đầu</label>
                                        <input type="text" id="trnStart" name="StartDate" class="form-control hrm-date-input" data-hrm-datepicker="true" value="2026-01-01" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="trnDue" style="font-weight:700;">Ngày kết thúc</label>
                                        <input type="text" id="trnDue" name="DueDate" class="form-control hrm-date-input" data-hrm-datepicker="true" value="2026-03-31" autocomplete="off" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="trnDesc" style="font-weight:700;">Mô tả tóm tắt nội dung</label>
                                <textarea id="trnDesc" name="Description" class="form-control" rows="2" placeholder="Giới thiệu nội dung trọng tâm của khóa học..."></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="trnSkills" style="font-weight:700;">Mục tiêu & Kỹ năng đầu ra</label>
                                        <textarea id="trnSkills" name="SkillRequirements" class="form-control" rows="2" placeholder="Kiến thức học viên đạt được..."></textarea>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="trnBenefits" style="font-weight:700;">Kho tài liệu & Quyền lợi</label>
                                        <textarea id="trnBenefits" name="Benefits" class="form-control" rows="2" placeholder="Slide, video bài giảng, tài liệu tham khảo..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer" style="background:#fafafa; border-top:1px solid #e2e8f0;">
                            <button type="button" class="hrm-btn" data-dismiss="modal">Hủy</button>
                            <button type="submit" class="hrm-btn hrm-btn-primary"><i class="material-icons">save</i> Lưu khóa đào tạo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL 3: ĐÁNH GIÁ HỌC VIÊN & CẤP CHỨNG CHỈ (Slide 16) -->
        <div class="modal fade" id="modalEvaluateStudent" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                    <form method="post" asp-controller="Work" asp-action="EvaluateTrainingStudent">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="enrollmentId" id="evalEnrollmentId" value="" />
                        <div class="modal-header trn-modal-header" style="background: linear-gradient(135deg, #065f46, #047857);">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title"><i class="material-icons" style="vertical-align:middle;margin-right:6px;">rate_review</i> Đánh giá học viên & Cấp chứng chỉ</h4>
                        </div>
                        <div class="modal-body trn-modal-body">
                            <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:12px; margin-bottom:16px;">
                                <div><span style="color:#64748b; font-size:12px;">Khóa học:</span> <strong id="evalCourseTitle" style="color:#065f46;">—</strong></div>
                                <div><span style="color:#64748b; font-size:12px;">Học viên:</span> <strong id="evalStudentName">—</strong></div>
                            </div>

                            <div class="form-group">
                                <label for="evalProgress" style="font-weight:700;">Tiến độ hoàn thành (%) *</label>
                                <input type="number" id="evalProgress" name="progress" min="0" max="100" class="form-control" required />
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="evalScore" style="font-weight:700;">Điểm số đánh giá (thang 100)</label>
                                        <input type="number" step="0.5" id="evalScore" name="score" min="0" max="100" class="form-control" placeholder="VD: 90" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="evalResult" style="font-weight:700;">Xếp loại kết quả *</label>
                                        <select id="evalResult" name="result" class="form-control" required>
                                            <option value="Xuất sắc">Xuất sắc</option>
                                            <option value="Đạt">Đạt</option>
                                            <option value="Cần cải thiện">Cần cải thiện</option>
                                            <option value="Chưa đạt">Chưa đạt</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="evalNote" style="font-weight:700;">Nhận xét của giảng viên / quản lý</label>
                                <textarea id="evalNote" name="note" class="form-control" rows="3" placeholder="Nhận xét tinh thần học tập, kết quả bài thi hoặc áp dụng vào thực tế..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer" style="background:#fafafa; border-top:1px solid #e2e8f0;">
                            <button type="button" class="hrm-btn" data-dismiss="modal">Đóng</button>
                            <button type="submit" class="hrm-btn hrm-btn-primary" style="background:#059669;"><i class="material-icons">verified</i> Cập nhật & Cấp chứng chỉ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- MODAL 4: CHI TIẾT BUỔI HỌC (Click từ lịch) -->
