                    <p style="font-size:13px; color:#64748b;">Chứng nhận anh/chị:</p>
                    <h3 id="certStudentName" style="font-size:24px; font-weight:800; color:#1e40af; margin:6px 0 16px; text-transform:uppercase;">—</h3>
                    <p style="font-size:13.5px; color:#475569; max-width:600px; margin:0 auto;">
                        Đã hoàn thành xuất sắc khóa đào tạo chuyên sâu:
                    </p>
                    <h4 id="certCourseTitle" style="font-size:18px; font-weight:750; color:#0f172a; margin:10px 0 16px;">—</h4>
                    <div style="display:inline-block; background:#ecfdf5; border:1px solid #86efac; border-radius:20px; padding:6px 20px; font-size:13px; color:#065f46; font-weight:700;">
                        Kết quả: <span id="certResult">Xuất sắc</span> (<span id="certScore">95</span>/100 điểm)
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-top:40px; padding:0 30px;">
                        <div style="text-align:left; font-size:12px; color:#64748b;">
                            <div>Mã chứng chỉ: <strong id="certCode" style="color:#0284c7;">—</strong></div>
                            <div>Ngày cấp: <strong id="certDate">—</strong></div>
                        </div>
                        <div style="text-align:center;">
                            <div style="font-size:12px; color:#64748b; margin-bottom:45px;">GIÁM ĐỐC TRUNG TÂM ĐÀO TẠO</div>
                            <div style="font-weight:750; font-size:14px; color:#0f172a;">NHỊ GIA HRM ACADEMY</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="background:#fefce8; border-top:1px solid #fef08a; text-align:center;">
                    <button type="button" class="hrm-btn" onclick="window.print();"><i class="material-icons">print</i> In chứng chỉ</button>
                    <button type="button" class="hrm-btn hrm-btn-primary" data-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
<script>
    var allTrainingSessions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sessions.Select(s => new {
        id = s.Id,
        trainingId = s.TrainingId,
        course = s.CourseTitle ?? "",
        title = s.SessionTitle ?? "",
        date = s.DateStr ?? "",
        time = s.TimeStr ?? "",
        inst = s.Instructor ?? "Giảng viên Nhị Gia",
        room = s.LocationOrUrl ?? "Google Meet Online",
        isOnline = s.IsOnline
    })));

    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    var initMonthStr = '@(Model.TrainingMonth ?? "2026-01")';
    var curParts = initMonthStr.split('-');
    var curYear = parseInt(curParts[0], 10) || 2026;
    var curMonth = parseInt(curParts[1], 10) || 1;
    if (curYear < 2026) { curYear = 2026; curMonth = 1; }

    function renderCalendar(year, month) {
        var monthStr = month < 10 ? '0' + month : '' + month;
        var monthText = 'Tháng ' + monthStr + '/' + year;
        $('#lblMonthTitleText').text(monthText);

        var today = new Date();
        var todayYear = today.getFullYear();
        var todayMonth = today.getMonth() + 1;
        var todayDay = today.getDate();

        var firstDay = new Date(year, month - 1, 1);
        // Monday-based offset: 0 for Mon, 1 for Tue, ..., 6 for Sun
        var dayOfWeek = firstDay.getDay();
        var startOffset = (dayOfWeek === 0 ? 6 : dayOfWeek - 1);

        var daysInPrevMonth = new Date(year, month - 1, 0).getDate();
        var daysInCurMonth = new Date(year, month, 0).getDate();

        var totalCells = startOffset + daysInCurMonth;
        var totalRows = Math.ceil(totalCells / 7);
        if (totalRows < 5) totalRows = 5;

        var html = '';
        var cellIndex = 0;

        for (var r = 0; r < totalRows; r++) {
            html += '<tr>';
            for (var c = 0; c < 7; c++) {
                if (cellIndex < startOffset) {
                    // Trailing days of previous month
                    var prevD = daysInPrevMonth - startOffset + cellIndex + 1;
                    var prevDStr = prevD < 10 ? '0' + prevD : '' + prevD;
                    html += '<td class="other-month"><div class="trn-cal-date-num">' + prevDStr + '</div></td>';
                } else if (cellIndex >= startOffset && cellIndex < startOffset + daysInCurMonth) {
                    // Days of current month
                    var curD = cellIndex - startOffset + 1;
                    var curDStr = curD < 10 ? '0' + curD : '' + curD;
                    var fullDate = year + '-' + monthStr + '-' + curDStr;
                    var isToday = (todayYear === year && todayMonth === month && todayDay === curD);
                    var cellClass = isToday ? 'trn-cal-active-day trn-cal-today' : '';

                    var daySessions = allTrainingSessions.filter(function(s) {
                        return s.date === fullDate;
                    });

                    var chipsHtml = '';
                    if (daySessions.length > 0) {
                        chipsHtml += '<div class="trn-cal-chips-wrap">';
                        daySessions.forEach(function(s) {
                            var timeBadge = s.time ? '[' + s.time.replace(/\s+/g, '') + ']' : '';
                            var displayTitle = s.title || 'Buổi học';
                            if (displayTitle.length > 30) displayTitle = displayTitle.substring(0, 28) + '...';
                            var chipColor = s.isOnline ? '#16a34a' : '#0284c7';
                            var chipBorder = s.isOnline ? '#15803d' : '#0369a1';
                            chipsHtml += '<span class="trn-cal-chip btn-cal-chip" ' +
                                'style="background:' + chipColor + '; border-color:' + chipBorder + ';" ' +
                                'data-id="' + s.id + '" ' +
                                'data-title="' + escapeHtml(s.title) + '" ' +
                                'data-course="' + escapeHtml(s.course) + '" ' +
                                'data-time="' + escapeHtml(s.time) + '" ' +
                                'data-date="' + fullDate + '" ' +
                                'data-inst="' + escapeHtml(s.inst) + '" ' +
                                'data-room="' + escapeHtml(s.room) + '" ' +
                                'title="' + escapeHtml(timeBadge + ' ' + s.title + ' - ' + s.course + ' (' + s.inst + ')') + '">' +
                                timeBadge + ' ' + escapeHtml(displayTitle) +
                                '</span>';
                        });
                        chipsHtml += '</div>';
                    }

                    html += '<td class="' + cellClass + '">' +
                        '<div class="trn-cal-date-num">' + curDStr + '</div>' +
                        chipsHtml +
                        '</td>';
                } else {
                    // Leading days of next month
                    var nextD = cellIndex - (startOffset + daysInCurMonth) + 1;
                    var nextDStr = nextD < 10 ? '0' + nextD : '' + nextD;
                    html += '<td class="other-month"><div class="trn-cal-date-num">' + nextDStr + '</div></td>';
                }
                cellIndex++;
            }
            html += '</tr>';
        }

        $('#trnCalendarBody').html(html);

        // Sync quick year selector in dropdown
        if ($('#selCalQuickYear').length) {
            if (!$('#selCalQuickYear option[value="' + year + '"]').length) {
                $('#selCalQuickYear').append('<option value="' + year + '">Năm ' + year + '</option>');
            }
            $('#selCalQuickYear').val(year);
        }
        $('.opt-cal-month-btn').each(function() {
            var m = parseInt($(this).data('month'), 10);
            if (m === month) {
                $(this).css({ 'background': '#16a34a', 'color': '#ffffff', 'border-color': '#15803d', 'font-weight': '700' });
            } else {
                $(this).css({ 'background': '#ffffff', 'color': '#1e293b', 'border-color': '#e2e8f0', 'font-weight': '600' });
            }
        });

        // Update URL query state smoothly without reloading page
        if (window.history && window.history.replaceState) {
            var url = new URL(window.location.href);
            url.searchParams.set('trainingMonth', year + '-' + monthStr);
            window.history.replaceState(null, '', url.toString());
        }
    }

    $(document).ready(function() {
        // Initial calendar render
        renderCalendar(curYear, curMonth);

        // Calendar Month Navigation: Previous
        $('#btnPrevMonth').on('click', function(e) {
            e.preventDefault();
            curMonth--;
            if (curMonth < 1) {
                curMonth = 12;
                curYear--;
            }
            renderCalendar(curYear, curMonth);
        });

        // Calendar Month Navigation: Next
        $('#btnNextMonth').on('click', function(e) {
            e.preventDefault();
            curMonth++;
            if (curMonth > 12) {
                curMonth = 1;
                curYear++;
            }
            renderCalendar(curYear, curMonth);
        });

        // Quick Month Selection: Year change
        $(document).on('change', '#selCalQuickYear', function() {
            var y = parseInt($(this).val(), 10) || curYear;
            curYear = y;
            renderCalendar(curYear, curMonth);
        });

        // Quick Month Selection: Month button click
        $(document).on('click', '.opt-cal-month-btn', function(e) {
            e.preventDefault();
            var m = parseInt($(this).data('month'), 10) || 1;
            var y = parseInt($('#selCalQuickYear').val(), 10) || curYear;
            curYear = y;
            curMonth = m;
            renderCalendar(curYear, curMonth);
            $('#lblMonthTitle').dropdown('toggle');
        });

        // Jump to Calendar from Course card
        $(document).on('click', '.btn-jump-cal', function(e) {
            e.preventDefault();
            var y = parseInt($(this).data('year'), 10) || 2026;
            var m = parseInt($(this).data('month'), 10) || 1;
            curYear = y;
            curMonth = m;
            renderCalendar(curYear, curMonth);
            var calEl = document.getElementById('trnCalendarSection');
            if (calEl) {
                calEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });

        // Chi tiết buổi học (Session click on chip or list)
        $(document).on('click', '.trn-session-item, .btn-session-detail, .btn-cal-chip, .trn-cal-chip', function(e) {
            e.preventDefault();
            var item = $(this);
            $('#sesTitle').text(item.attr('data-title') || item.data('title') || 'Buổi học');
            $('#sesCourse').text(item.attr('data-course') || item.data('course') || '');
            var d = item.attr('data-date') || item.data('date');
            var t = item.attr('data-time') || item.data('time') || '';
            $('#sesTime').text((d ? (d + ' ') : '') + (t ? ('(' + t + ')') : ''));
            $('#sesInstructor').text(item.attr('data-inst') || item.data('inst') || item.data('instructor') || 'Giảng viên Nhị Gia');
            $('#sesRoom').text(item.attr('data-room') || item.data('room') || 'Google Meet Online');
            $('#modalSessionDetail').modal('show');
        });

        // 1. Chi tiết khóa đào tạo
        $(document).on('click', '.btn-open-detail', function() {
            var btn = $(this);
            $('#dtCourseTitle').html('<i class="material-icons" style="vertical-align:middle;margin-right:6px;">school</i> ' + (btn.data('title') || ''));
            $('#dtCourseRef').text(btn.data('ref') || '—');
            $('#dtCourseCat').text(btn.data('cat') || 'Chung');
            $('#dtCourseScope').text(btn.data('scope') || 'Tất cả');
            $('#dtCourseHours').text((btn.data('hours') || '24') + ' giờ');
            $('#dtCourseDesc').text(btn.data('desc') || 'Chưa có mô tả chi tiết.');
            $('#dtCourseSkills').text(btn.data('skills') || 'Kỹ năng làm việc chuyên môn.');
            $('#dtCourseBenefits').text(btn.data('benefits') || 'Kho tài liệu & slide bài giảng.');
            $('#dtCourseInstructor').text(btn.data('instructor') || 'Giảng viên Nhị Gia');

            var isEnrolled = btn.data('enrolled') === true || btn.data('enrolled') === 'true';
            var courseId = btn.data('id');
            if (isEnrolled) {
                $('#dtEnrollActionWrap').html('<span class="label label-success" style="font-size:13px; padding:6px 12px;"><i class="material-icons" style="font-size:14px; vertical-align:middle;">check</i> Bạn đang tham gia khóa học này</span>');
            } else {
                $('#dtEnrollActionWrap').html('<form method="post" action="/Work/EnrollTraining" style="display:inline;">@Html.AntiForgeryToken()<input type="hidden" name="trainingId" value="' + courseId + '" /><button type="submit" class="hrm-btn hrm-btn-primary"><i class="material-icons" style="font-size:14px;">how_to_reg</i> Đăng ký tham gia</button></form>');
            }
            $('#modalTrainingDetail').modal('show');
        });

        // 2. Chỉnh sửa khóa đào tạo
        $(document).on('click', '.btn-edit-course', function() {
            var btn = $(this);
            $('#editTrnId').val(btn.data('id'));
            $('#trnTitle').val(btn.data('title'));
            $('#trnRef').val(btn.data('ref'));
            $('#trnCategory').val(btn.data('cat') || 'Online');
            $('#trnWorkLocation').val(btn.data('scope') || '');
            $('#trnStartDate').val(btn.data('start') || '');
            $('#trnDueDate').val(btn.data('due') || '');
            $('#trnTarget').val(btn.data('hours') || '24');
            $('#trnContactName').val(btn.data('instructor') || '');
            $('#trnDescription').val(btn.data('desc') || '');
            $('#trnSkillRequirements').val(btn.data('skills') || '');
            $('#trnBenefits').val(btn.data('benefits') || '');
            $('#modalCreateTrainingTitle').html('<i class="material-icons">edit</i> Chỉnh sửa chương trình đào tạo');
            $('#modalCreateTraining').modal('show');
        });

        // 3. Đánh giá học viên & Cấp chứng chỉ
        $(document).on('click', '.btn-eval-student', function() {
            var btn = $(this);
            $('#evalEnrollmentId').val(btn.data('id'));
            $('#evalCourseTitle').text(btn.data('course') || '—');
            $('#evalStudentName').text(btn.data('student') || '—');
            $('#evalProgress').val(btn.data('progress') || 100);
            $('#evalScore').val(btn.data('score') || '');
            $('#evalResult').val(btn.data('result') || 'Đạt');
            $('#evalNote').val(btn.data('note') || '');
            $('#modalEvaluateStudent').modal('show');
        });

        // 4. Xem chứng chỉ vinh danh
        $(document).on('click', '.btn-view-cert', function() {
            var btn = $(this);
            $('#certStudentName').text(btn.data('student') || '—');
            $('#certCourseTitle').text(btn.data('course') || '—');
            $('#certResult').text(btn.data('result') || 'Đạt');
            $('#certScore').text(btn.data('score') || '90');
            $('#certCode').text(btn.data('cert') || 'NG-CERT-2026');
            $('#certDate').text(btn.data('date') || '—');
            $('#modalViewCert').modal('show');
        });
    });
</script>
