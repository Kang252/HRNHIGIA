@model WorkPage
@{
    var currentTab = Model.TrainingTab ?? "ALL";
    var filteredCourses = Model.Items.Where(x => x.Kind == "training").ToList();
    if (currentTab == "ENROLLED")
    {
        filteredCourses = filteredCourses.Where(c => Model.MyEnrollments.Any(e => e.TrainingId == c.Id)).ToList();
    }
    else if (currentTab == "NOT_ENROLLED")
    {
        filteredCourses = filteredCourses.Where(c => !Model.MyEnrollments.Any(e => e.TrainingId == c.Id)).ToList();
    }
}

    <div class="trn-container">
        <!-- 1. HÀNG THỐNG KÊ TỔNG QUAN (Slide 16) -->
        <div class="trn-stats-row">
            <div class="trn-stat-card">
                <div class="trn-stat-icon trn-icon-blue"><i class="material-icons">school</i></div>
                <div class="trn-stat-info">
                    <span class="trn-stat-val">@Model.Items.Count(x => x.Kind == "training")</span>
                    <span class="trn-stat-lbl">Tổng số khóa học</span>
                </div>
            </div>
            <div class="trn-stat-card">
                <div class="trn-stat-icon trn-icon-amber"><i class="material-icons">auto_stories</i></div>
                <div class="trn-stat-info">
                    <span class="trn-stat-val">@Model.EnrolledCoursesCount</span>
                    <span class="trn-stat-lbl">Khóa đang tham gia</span>
                </div>
            </div>
            <div class="trn-stat-card">
                <div class="trn-stat-icon trn-icon-green"><i class="material-icons">task_alt</i></div>
                <div class="trn-stat-info">
                    <span class="trn-stat-val">@Model.CompletedCoursesCount</span>
                    <span class="trn-stat-lbl">Khóa đã hoàn thành</span>
                </div>
            </div>
            <div class="trn-stat-card">
                <div class="trn-stat-icon trn-icon-purple"><i class="material-icons">workspace_premium</i></div>
                <div class="trn-stat-info">
                    <span class="trn-stat-val">@Model.CertificatesCount</span>
                    <span class="trn-stat-lbl">Chứng chỉ đạt được</span>
                </div>
            </div>
        </div>

        <!-- 2. THANH ĐIỀU HƯỚNG TAB & TÌM KIẾM -->
        <div class="trn-toolbar">
            <div class="trn-tabs">
                <a href="@Url.Action("Index", new { kind = "training", trainingTab = "ALL", q = Model.Query })"
                   class="trn-tab-btn @(currentTab == "ALL" ? "active" : "")">
                    <i class="material-icons">view_module</i> Tất cả khóa đào tạo
                </a>
                <a href="@Url.Action("Index", new { kind = "training", trainingTab = "ENROLLED", q = Model.Query })"
                   class="trn-tab-btn @(currentTab == "ENROLLED" ? "active" : "")">
                    <i class="material-icons">menu_book</i> Khóa đang học (@Model.EnrolledCoursesCount)
                </a>
                <a href="@Url.Action("Index", new { kind = "training", trainingTab = "NOT_ENROLLED", q = Model.Query })"
                   class="trn-tab-btn @(currentTab == "NOT_ENROLLED" ? "active" : "")">
                    <i class="material-icons">app_registration</i> Khóa chưa đăng ký
                </a>
                <a href="@Url.Action("Index", new { kind = "training", trainingTab = "CALENDAR" })"
                   class="trn-tab-btn @(currentTab == "CALENDAR" ? "active" : "")">
                    <i class="material-icons">calendar_month</i> Thời gian biểu học tập
                </a>
                <a href="@Url.Action("Index", new { kind = "training", trainingTab = "CERTIFICATES" })"
                   class="trn-tab-btn @(currentTab == "CERTIFICATES" ? "active" : "")">
                    <i class="material-icons">verified</i> Chứng chỉ & Đánh giá
                </a>
            </div>

            <div class="trn-toolbar-actions">
                <form method="get" asp-controller="Work" asp-action="Index" class="trn-search-box">
                    <input type="hidden" name="kind" value="training" />
                    <input type="hidden" name="trainingTab" value="@currentTab" />
                    <i class="material-icons">search</i>
                    <input name="q" value="@Model.Query" placeholder="Tìm khóa học, giảng viên..." />
                </form>

                @if (Model.CanManage)
                {
                    <button type="button" class="hrm-btn hrm-btn-primary" onclick="window.openCreateCourseModal()" data-toggle="modal" data-target="#modalCreateTraining" style="padding: 7px 14px; font-size: 13px;">
                        <i class="material-icons" style="font-size:18px;">add</i> Tạo khóa mới
                    </button>
                }
            </div>
        </div>

        @if (currentTab == "CERTIFICATES")
        {
            <!-- TAB 1: CHỨNG CHỈ & ĐÁNH GIÁ (Slide 16 & 17) -->
            <div class="trn-catalog-card">
                <div class="trn-section-header">
                    <div>
                        <span class="trn-section-tag" style="background:#059669;"><i class="material-icons" style="font-size:14px;vertical-align:middle;">verified</i> Kho tri thức & Chứng nhận</span>
                        <h3 class="trn-section-title">Kết quả đánh giá & Chứng chỉ hoàn thành khóa đào tạo</h3>
                    </div>
                </div>

                @if (Model.MyEnrollments.Count == 0 && !Model.CanManage)
                {
                    <div class="work-empty">
                        <i class="material-icons">workspace_premium</i>
                        <h4>Chưa có chứng chỉ nào</h4>
                        <p>Hãy tham gia các khóa đào tạo và hoàn thành bài tập để nhận chứng chỉ từ Nhị Gia.</p>
                    </div>
                }
                else
                {
                    <div class="trn-cert-grid">
                        @foreach (var cert in (Model.CanManage ? Model.Enrollments : Model.MyEnrollments))
                        {
                            var isPass = cert.Status == "COMPLETED" || cert.Score >= 50;
                            var certNo = string.IsNullOrWhiteSpace(cert.CertificateNumber) ? $"CERT-NHIGIA-{DateTime.Now.Year}-{cert.Id:D4}" : cert.CertificateNumber;

                            <div class="trn-cert-card">
                                <div class="trn-cert-top">
                                    <div>
                                        <h4 class="trn-cert-title">@cert.CourseTitle</h4>
                                        <span class="trn-cert-code">@certNo</span>
                                    </div>
                                    <div class="trn-cert-seal">
                                        <i class="material-icons">military_tech</i>
                                    </div>
                                </div>

                                <div class="trn-cert-info-row">
                                    <span>Học viên:</span>
                                    <strong>@cert.EmployeeName</strong>
                                </div>
                                <div class="trn-cert-info-row">
                                    <span>Hình thức:</span>
                                    <strong>@(cert.CourseCategory ?? "Online")</strong>
                                </div>
                                <div class="trn-cert-info-row">
                                    <span>Tiến độ hoàn thành:</span>
                                    <strong>@cert.ProgressPercent%</strong>
                                </div>
                                <div class="trn-cert-info-row">
                                    <span>Đánh giá kết quả:</span>
                                    @if (cert.Score.HasValue)
                                    {
                                        <span class="trn-cert-score-badge">
                                            <i class="material-icons" style="font-size:15px;">check_circle</i>
                                            @cert.EvaluationResult (@cert.Score/100 điểm)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#f1f5f9; color:#64748b;">Đang theo học</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(cert.EvaluationNote))
                                {
                                    <div style="background:#f8fafc; border-radius:6px; padding:8px 10px; margin-top:10px; font-size:12px; color:#475569; font-style:italic;">
                                        " @cert.EvaluationNote "
                                    </div>
                                }

                                <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px; padding-top:12px; border-top:1px solid #f1f5f9;">
                                    <button type="button" class="trn-btn-detail btn-view-cert" onclick="window.openViewCert(this)"
                                            data-title="@cert.CourseTitle"
                                            data-name="@cert.EmployeeName"
                                            data-code="@certNo"
                                            data-score="@(cert.Score?.ToString("0.#") ?? "100")"
                                            data-result="@(cert.EvaluationResult ?? "Đạt")"
                                            data-date="@(cert.CertificateIssuedAt?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))">
                                        <i class="material-icons" style="font-size:15px;">card_membership</i> Xem chứng chỉ
                                    </button>

                                    @if (Model.CanManage)
                                    {
                                        <button type="button" class="trn-btn-detail btn-open-eval btn-eval-student" onclick="window.openEvalStudent(this)"
                                                data-id="@cert.Id"
                                                data-course="@cert.CourseTitle"
                                                data-student="@cert.EmployeeName"
                                                data-progress="@cert.ProgressPercent"
                                                data-score="@(cert.Score?.ToString("0.#") ?? "")"
                                                data-result="@(cert.EvaluationResult ?? "Đạt")"
                                                data-note="@(cert.EvaluationNote ?? "")">
                                            <i class="material-icons" style="font-size:15px;">rate_review</i> Đánh giá
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- BỐ CỤC 2 CỘT CHUẨN SLIDE 17 (Trái: Danh sách khóa học - Phải: Thời gian biểu) -->
            <div class="trn-main-layout">
                <!-- CỘT TRÁI: "Đăng ký khoá đào tạo theo nhu cầu" -->
                <div class="trn-catalog-card">
                    <div class="trn-section-header">
                        <div>
                            <span class="trn-section-tag">Đăng ký khoá đào tạo theo nhu cầu</span>
                            <h3 class="trn-section-title">@(currentTab == "ENROLLED" ? "Danh sách khóa đào tạo đang học" : "Danh sách khóa đào tạo")</h3>
                        </div>
                        <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:700; padding:6px 10px; font-size:12px;">
                            @filteredCourses.Count khóa học
                        </span>
                    </div>

                    @if (filteredCourses.Count == 0)
                    {
                        <div class="work-empty">
                            <i class="material-icons">search_off</i>
                            <h4>Không tìm thấy khóa đào tạo phù hợp</h4>
                            <p>Vui lòng chọn tab khác hoặc thử từ khóa tìm kiếm mới.</p>
                        </div>
                    }
                    else
                    {
                        <div class="trn-course-grid">
                            @foreach (var item in filteredCourses)
                            {
                                var isEnrolled = Model.MyEnrollments.Any(e => e.TrainingId == item.Id);
                                var enrollment = Model.MyEnrollments.FirstOrDefault(e => e.TrainingId == item.Id);
                                var isOffline = item.Category == "Offline";
                                var bannerInfo = GetCourseBannerInfo(item.Reference, item.Title, item.Category);

                                <div class="trn-card">
                                    <!-- Banner ảnh / nghệ thuật nhận diện khóa học -->
                                    <div class="trn-card-banner" style="@bannerInfo.Gradient">
                                        <span class="trn-card-badge @(isOffline ? "badge-offline" : "badge-online")">
                                            @(isOffline ? "Offline" : "Online")
                                        </span>
                                        <div class="trn-banner-art">
                                            @foreach (var pill in bannerInfo.Pills)
                                            {
                                                <span class="trn-banner-icon-pill" style="color:@pill.Color;"><i class="material-icons" style="font-size:15px;">@pill.Icon</i> @pill.Text</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Thân thẻ: Tiêu đề & Thông tin -->
                                    <div class="trn-card-body">
                                        <h4 class="trn-card-title" title="@item.Title">@item.Title</h4>
                                        <p class="trn-card-desc" title="@item.Description">@item.Description</p>

                                        <div class="trn-card-meta">
                                            <div class="trn-meta-row">
                                                <span>Phạm vi:</span> <strong>@(item.WorkLocation ?? "Tất cả")</strong>
                                            </div>
                                            <div class="trn-meta-row">
                                                <span>Thời gian:</span>
                                                <strong>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "01/01/2026") - @(item.DueDate?.ToString("dd/MM/yyyy") ?? "31/03/2026")</strong>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.ContactName))
                                            {
                                                <div class="trn-meta-row">
                                                    <span>Giảng viên:</span> <strong>@item.ContactName</strong>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Chân thẻ: Thao tác đăng ký / xem chi tiết -->
                                    <div class="trn-card-footer">
                                        <div>
                                            @if (isEnrolled)
                                            {
                                                <span class="trn-btn-enrolled">
                                                    <i class="material-icons" style="font-size:14px;">check</i> Đang tham gia
                                                </span>
                                            }
                                            else
                                            {
                                                <form method="post" asp-controller="Work" asp-action="EnrollTraining" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="trainingId" value="@item.Id" />
                                                    <button type="submit" class="trn-btn-enroll">
                                                        <i class="material-icons" style="font-size:14px;">how_to_reg</i> Đăng ký
                                                    </button>
                                                </form>
                                            }
                                        </div>

                                        <div style="display:flex; gap:4px;">
                                            <button type="button" class="trn-btn-detail btn-open-detail" onclick="window.openTrainingDetail(this)"
                                                    data-id="@item.Id"
                                                    data-title="@item.Title"
                                                    data-ref="@item.Reference"
                                                    data-cat="@item.Category"
                                                    data-scope="@item.WorkLocation"
                                                    data-start="@(item.StartDate?.ToString("dd/MM/yyyy") ?? "")"
                                                    data-due="@(item.DueDate?.ToString("dd/MM/yyyy") ?? "")"
                                                    data-hours="@(item.Target?.ToString("0") ?? "24")"
                                                    data-instructor="@item.ContactName"
                                                    data-desc="@item.Description"
                                                    data-skills="@item.SkillRequirements"
                                                    data-benefits="@item.Benefits"
                                                    data-enrolled="@(isEnrolled ? "true" : "false")">
                                                Chi tiết
                                            </button>

                                            <button type="button" class="trn-btn-detail btn-jump-cal" onclick="window.jumpToCalendar(this)" data-year="@(item.StartDate?.Year ?? 2026)" data-month="@(item.StartDate?.Month ?? 1)" title="Xem lịch học trên thời gian biểu">
                                                <i class="material-icons" style="font-size:14px;vertical-align:middle;margin-right:2px;">event</i> Lịch học
                                            </button>

                                            @if (Model.CanManage)
                                            {
                                                <div class="dropdown" style="display:inline-block;">
                                                    <button class="trn-btn-detail dropdown-toggle" type="button" data-toggle="dropdown" style="padding:5px 8px;">
                                                        <i class="material-icons" style="font-size:16px;">more_vert</i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-right" style="border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.12);">
                                                        <li>
                                                            <a href="javascript:void(0)" class="btn-edit-course" onclick="window.openEditCourse(this)"
                                                               data-id="@item.Id"
                                                               data-title="@item.Title"
                                                               data-ref="@item.Reference"
                                                               data-cat="@item.Category"
                                                               data-scope="@item.WorkLocation"
                                                               data-start="@(item.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                               data-due="@(item.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                                               data-hours="@(item.Target?.ToString("0") ?? "24")"
                                                               data-instructor="@item.ContactName"
                                                               data-desc="@item.Description"
                                                               data-skills="@item.SkillRequirements"
                                                               data-benefits="@item.Benefits"
                                                               data-keywords="@item.Keywords">
                                                                <i class="material-icons" style="font-size:16px;vertical-align:middle;margin-right:6px;">edit</i> Chỉnh sửa khóa học
                                                            </a>
                                                        </li>
                                                        <li role="separator" class="divider"></li>
                                                        <li>
                                                            <form method="post" asp-controller="Work" asp-action="DeleteTrainingCourse" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa đào tạo này?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" style="background:none; border:none; color:#dc2626; padding:8px 20px; width:100%; text-align:left; font-size:13px; cursor:pointer;">
                                                                    <i class="material-icons" style="font-size:16px;vertical-align:middle;margin-right:6px;">delete</i> Xóa khóa học
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Phân trang danh sách khóa học (Slide 17) -->
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:20px; padding-top:14px; border-top:1px solid #f1f5f9;">
                            <span style="font-size:12.5px; color:#64748b;">Đang hiển thị 1 - @filteredCourses.Count của @filteredCourses.Count khóa học</span>
                            <div style="display:flex; gap:6px;">
                                <button type="button" class="trn-btn-detail" disabled style="opacity:0.5;">Trang trước</button>
                                <button type="button" class="trn-btn-detail" disabled style="opacity:0.5;">Trang sau</button>
                            </div>
                        </div>
                    }
                </div>

                <!-- CỘT PHẢI: "Quản lý thời gian biểu học tập của bạn" (Slide 17) -->
                <div class="trn-calendar-card" id="trnCalendarSection">
                    <div class="trn-cal-header-bar">
                        <div>
                            <span class="trn-section-tag" style="background:#16a34a;">Quản lý thời gian biểu học tập của bạn</span>
                            <h3 class="trn-section-title" style="font-size:15.5px;">Lịch trình buổi học trong tháng</h3>
                        </div>
                        <div class="trn-cal-month-nav" style="display:flex; align-items:center; gap:6px; flex-wrap:nowrap;">
                            <button type="button" class="trn-cal-month-btn" id="btnPrevMonth" onclick="window.trnCalChangeMonth(-1)" title="Tháng trước" style="width:32px; height:32px; border-radius:7px; border:1px solid #cbd5e1; background:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#334155;">
                                <i class="material-icons" style="font-size:18px; pointer-events:none;">chevron_left</i>
                            </button>

                            <div style="position:relative; display:inline-block;">
                                <button type="button" id="lblMonthTitle" onclick="window.toggleTrnMonthPopup(event)" title="Bấm để chọn tháng nhanh" style="display:inline-flex; align-items:center; gap:4px; border:1px solid #cbd5e1; border-radius:7px; background:#fff; padding:4px 10px; font-weight:700; color:#1e293b; font-size:13px; cursor:pointer; height:32px;">
                                    <i class="material-icons" style="font-size:16px; color:#16a34a; pointer-events:none;">calendar_month</i>
                                    <span id="lblMonthTitleText">Tháng 01</span>
                                    <i class="material-icons" style="font-size:16px; color:#64748b; pointer-events:none;">arrow_drop_down</i>
                                </button>
                                
                                <div id="trnMonthPopup" style="display:none; position:absolute; top:calc(100% + 4px); left:50%; transform:translateX(-50%); z-index:1050; width:220px; background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:10px; box-shadow:0 12px 30px rgba(0,0,0,0.18);">
                                    <div style="text-align:center; font-size:11px; font-weight:700; color:#64748b; margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">Chọn tháng</div>
                                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px;">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            var mStr = m < 10 ? $"0{m}" : $"{m}";
                                            <button type="button" class="opt-cal-month-btn" data-month="@m" onclick="window.trnCalSelectMonth(@m)" style="padding:6px 2px; font-size:12px; font-weight:600; border-radius:6px; border:1px solid #e2e8f0; background:#fff; color:#1e293b; cursor:pointer; text-align:center;">
                                                Tháng @mStr
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <select id="selCalHeaderYear" onchange="window.trnCalSelectYear(this.value)" style="border:1px solid #cbd5e1; border-radius:7px; font-weight:700; color:#0284c7; padding:2px 8px; font-size:13px; outline:none; background:#fff; cursor:pointer; height:32px;">
                                @for (int y = 2026; y <= 2040; y++)
                                {
                                    <option value="@y">Năm @y</option>
                                }
                            </select>

                            <button type="button" class="trn-cal-month-btn" id="btnNextMonth" onclick="window.trnCalChangeMonth(1)" title="Tháng sau" style="width:32px; height:32px; border-radius:7px; border:1px solid #cbd5e1; background:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#334155;">
                                <i class="material-icons" style="font-size:18px; pointer-events:none;">chevron_right</i>
                            </button>

                            <button type="button" class="trn-cal-month-btn" id="btnTodayMonth" onclick="window.trnCalGoToday()" title="Trở về thời gian biểu hiện tại" style="height:32px; padding:0 9px; width:auto; font-size:11.5px; font-weight:700; color:#16a34a; border-radius:7px; border:1px solid #bbf7d0; background:#f0fdf4; cursor:pointer;">
                                Hôm nay
                            </button>
                        </div>
                    </div>

                    <!-- Bảng Lịch học 7 cột (T2 -> CN) chuẩn Slide 17 -->
                    <div class="table-responsive" style="margin-top:10px;">
                        <table class="trn-calendar-table">
                            <thead>
                                <tr>
                                    <th>T2</th>
                                    <th>T3</th>
                                    <th>T4</th>
                                    <th>T5</th>
                                    <th>T6</th>
                                    <th>T7</th>
                                    <th>CN</th>
                                </tr>
                            </thead>
                            <tbody id="trnCalendarBody">
                                <tr>
                                    <td colspan="7" style="text-align:center; padding:30px; color:#64748b;">
                                        <i class="material-icons" style="font-size:20px; vertical-align:middle;">calendar_month</i> Đang tải thời gian biểu...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- MODAL 1: CHI TIẾT KHÓA ĐÀO TẠO & KHO TÀI LIỆU (Slide 16 & 17) -->
    <div class="modal fade" id="modalTrainingDetail" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                <div class="modal-header trn-modal-header">
