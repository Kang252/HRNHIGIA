        </div>
    </div>
<script>
    var allTrainingSessions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sessions.Select(s => new {
        id = s.Id,
        trainingId = s.TrainingId,
        course = s.CourseTitle ?? "",
        title = s.SessionTitle ?? "",
        date = s.DateStr ?? "",
        time = s.TimeStr ?? "",
        inst = s.Instructor ?? "Giảng viên Nhị Gia",
        room = s.LocationOrUrl ?? "Google Meet Online",
        isOnline = s.IsOnline
    })));

    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    var initMonthStr = '@(Model.TrainingMonth ?? "2026-01")';
    var curParts = initMonthStr.split('-');
    var curYear = parseInt(curParts[0], 10) || 2026;
    var curMonth = parseInt(curParts[1], 10) || 1;
    if (curYear < 2026) { curYear = 2026; curMonth = 1; }

    window.trnCalCurYear = curYear;
    window.trnCalCurMonth = curMonth;

    // --- POPUP CHỌN THÁNG (1 - 12) ---
    window.toggleTrnMonthPopup = function(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        var popup = document.getElementById('trnMonthPopup');
        if (!popup) return;
        var isShown = popup.style.display === 'block';
        popup.style.display = isShown ? 'none' : 'block';
    };

    window.closeTrnMonthPopup = function() {
        var popup = document.getElementById('trnMonthPopup');
        if (popup) popup.style.display = 'none';
    };

    window.trnCalSelectMonth = function(m) {
        window.trnCalCurMonth = parseInt(m, 10) || 1;
        window.closeTrnMonthPopup();
        renderCalendar(window.trnCalCurYear, window.trnCalCurMonth);
    };

    window.trnCalSelectYear = function(y) {
        window.trnCalCurYear = parseInt(y, 10) || 2026;
        renderCalendar(window.trnCalCurYear, window.trnCalCurMonth);
    };

    window.trnCalChangeMonth = function(delta) {
        window.trnCalCurMonth += delta;
        if (window.trnCalCurMonth < 1) {
            window.trnCalCurMonth = 12;
            window.trnCalCurYear--;
        } else if (window.trnCalCurMonth > 12) {
            window.trnCalCurMonth = 1;
            window.trnCalCurYear++;
        }
        if (window.trnCalCurYear < 2026) {
            window.trnCalCurYear = 2026;
            window.trnCalCurMonth = 1;
        }
        renderCalendar(window.trnCalCurYear, window.trnCalCurMonth);
    };

    window.trnCalGoToday = function() {
        var d = new Date();
        window.trnCalCurYear = Math.max(d.getFullYear(), 2026);
        window.trnCalCurMonth = d.getMonth() + 1;
        renderCalendar(window.trnCalCurYear, window.trnCalCurMonth);
    };

    // --- MODAL HELPERS (Bootstrap + Vanilla Fallback) ---
    window.showModalSafe = function(modalId) {
        var m = document.getElementById(modalId);
        if (!m) return;
        var $el = window.jQuery ? window.jQuery('#' + modalId) : null;
        if ($el && $el.length && typeof $el.modal === 'function') {
            try {
                $el.modal('show');
                return;
            } catch(e) {
                console.warn('Bootstrap modal show failed, using manual fallback:', e);
            }
        }
        m.classList.add('in');
        m.style.display = 'block';
        document.body.classList.add('modal-open');
        if (!document.getElementById('manual-backdrop')) {
            var bd = document.createElement('div');
            bd.className = 'modal-backdrop fade in';
            bd.id = 'manual-backdrop';
            bd.onclick = window.closeAllModals;
            document.body.appendChild(bd);
        }
    };

    window.closeAllModals = function() {
        document.querySelectorAll('.modal').forEach(function(m) {
            var $m = window.jQuery ? window.jQuery(m) : null;
            if ($m && typeof $m.modal === 'function') {
                try { $m.modal('hide'); } catch(e) {}
            }
            m.classList.remove('in');
            m.style.display = 'none';
        });
        document.body.classList.remove('modal-open');
        var bd = document.getElementById('manual-backdrop');
        if (bd) bd.remove();
    };

