    // Client-side session synthesizer fallback: ensures that even if local cache or connection is delayed, every month has session chips
    function ensureMonthSessions(year, month) {
        var prefix = year + '-' + (month < 10 ? '0' + month : '' + month);
        var exists = allTrainingSessions.some(function(s) { return s.date && s.date.startsWith(prefix); });
        if (!exists) {
            var daysInMonth = new Date(year, month, 0).getDate();
            var tCount = 0, fCount = 0, thCount = 0;
            for (var d = 1; d <= daysInMonth; d++) {
                var dt = new Date(year, month - 1, d);
                var dow = dt.getDay(); // 0 Sun, 2 Tue, 4 Thu, 5 Fri
                var dStr = prefix + '-' + (d < 10 ? '0' + d : '' + d);

                if (dow === 2) { // Tuesday
                    tCount++;
                    if (tCount === 2) {
                        allTrainingSessions.push({
                            id: 900000 + d,
                            trainingId: 1,
                            course: 'An toàn thông tin cơ bản',
                            title: 'An toàn thông tin: Nhận diện rủi ro & Bảo mật số',
                            date: dStr,
                            time: '09:00 - 11:00',
                            inst: 'Giảng viên Nhị Gia',
                            room: 'Google Meet Online',
                            isOnline: true
                        });
                    } else if (tCount === 4) {
                        allTrainingSessions.push({
                            id: 900000 + d,
                            trainingId: 1,
                            course: 'An toàn thông tin cơ bản',
                            title: 'An toàn thông tin: Thực hành phòng chống sự cố',
                            date: dStr,
                            time: '14:00 - 16:00',
                            inst: 'Giảng viên Nhị Gia',
                            room: 'Google Meet Online',
                            isOnline: true
                        });
                    }
                } else if (dow === 5) { // Friday
                    fCount++;
                    if (fCount === 2) {
                        allTrainingSessions.push({
                            id: 910000 + d,
                            trainingId: 2,
                            course: 'Kỹ năng quản lý nhóm',
                            title: 'Kỹ năng quản lý: Quản lý mục tiêu & Hiệu suất',
                            date: dStr,
                            time: '08:30 - 16:30',
                            inst: 'Giảng viên Nhị Gia',
                            room: 'Hội trường đào tạo Lầu 3',
                            isOnline: false
                        });
                    } else if (fCount === 4) {
                        allTrainingSessions.push({
                            id: 910000 + d,
                            trainingId: 2,
                            course: 'Kỹ năng quản lý nhóm',
                            title: 'Kỹ năng quản lý: Phát triển đội ngũ kế thừa',
                            date: dStr,
                            time: '13:30 - 17:00',
                            inst: 'Giảng viên Nhị Gia',
                            room: 'Hội trường đào tạo Lầu 3',
                            isOnline: false
                        });
                    }
                } else if (dow === 4) { // Thursday
                    thCount++;
                    if (thCount === 3) {
                        allTrainingSessions.push({
                            id: 920000 + d,
                            trainingId: 3,
                            course: 'Excel cho nghiệp vụ kế toán',
                            title: 'Excel chuyên sâu: Tự động hóa báo cáo',
                            date: dStr,
                            time: '08:30 - 17:00',
                            inst: 'Giảng viên Nhị Gia',
                            room: 'Phòng máy Lầu 2',
                            isOnline: false
                        });
                    }
                }
            }
        }
    }

    function renderCalendar(year, month) {
        try {
            window.trnCalCurYear = year;
            window.trnCalCurMonth = month;
            var monthStr = month < 10 ? '0' + month : '' + month;
            
            // Update labels
            $('#lblMonthTitleText').text('Tháng ' + monthStr);
            if ($('#selCalHeaderYear').length) {
                if (!$('#selCalHeaderYear option[value="' + year + '"]').length) {
                    $('#selCalHeaderYear').append('<option value="' + year + '">Năm ' + year + '</option>');
                }
                $('#selCalHeaderYear').val(year);
            }

            // Highlight month in popup
            $('.opt-cal-month-btn').each(function() {
                var m = parseInt($(this).data('month'), 10);
                if (m === month) {
                    $(this).css({ 'background': '#16a34a', 'color': '#ffffff', 'border-color': '#15803d', 'font-weight': '700' });
                } else {
                    $(this).css({ 'background': '#ffffff', 'color': '#1e293b', 'border-color': '#e2e8f0', 'font-weight': '600' });
                }
            });

            // Ensure sessions exist
            ensureMonthSessions(year, month);

            var today = new Date();
            var todayYear = today.getFullYear();
            var todayMonth = today.getMonth() + 1;
            var todayDay = today.getDate();

            var firstDay = new Date(year, month - 1, 1);
            // Monday-based offset: 0 for Mon, 1 for Tue, ..., 6 for Sun
            var dayOfWeek = firstDay.getDay();
            var startOffset = (dayOfWeek === 0 ? 6 : dayOfWeek - 1);

            var daysInPrevMonth = new Date(year, month - 1, 0).getDate();
            var daysInCurMonth = new Date(year, month, 0).getDate();

            var totalCells = startOffset + daysInCurMonth;
            var totalRows = Math.ceil(totalCells / 7);
            if (totalRows < 5) totalRows = 5;

            var html = '';
            var cellIndex = 0;

            for (var r = 0; r < totalRows; r++) {
                html += '<tr>';
                for (var c = 0; c < 7; c++) {
                    if (cellIndex < startOffset) {
                        // Trailing days of previous month
                        var prevD = daysInPrevMonth - startOffset + cellIndex + 1;
                        var prevDStr = prevD < 10 ? '0' + prevD : '' + prevD;
                        html += '<td class="other-month"><div class="trn-cal-date-num">' + prevDStr + '</div></td>';
                    } else if (cellIndex >= startOffset && cellIndex < startOffset + daysInCurMonth) {
                        // Days of current month
                        var curD = cellIndex - startOffset + 1;
                        var curDStr = curD < 10 ? '0' + curD : '' + curD;
                        var fullDate = year + '-' + monthStr + '-' + curDStr;
                        var isToday = (todayYear === year && todayMonth === month && todayDay === curD);
                        var cellClass = isToday ? 'trn-cal-active-day trn-cal-today' : '';

                        var daySessions = allTrainingSessions.filter(function(s) {
                            return s.date === fullDate;
                        });

                        var chipsHtml = '';
                        if (daySessions.length > 0) {
                            chipsHtml += '<div class="trn-cal-chips-wrap">';
                            daySessions.forEach(function(s) {
                                var timeBadge = s.time ? '[' + s.time.replace(/\s+/g, '') + ']' : '';
                                var displayTitle = s.title || 'Buổi học';
                                if (displayTitle.length > 28) displayTitle = displayTitle.substring(0, 26) + '...';
                                var chipColor = s.isOnline ? '#16a34a' : '#0284c7';
                                var chipBorder = s.isOnline ? '#15803d' : '#0369a1';
                                chipsHtml += '<span class="trn-cal-chip btn-cal-chip" ' +
                                    'style="background:' + chipColor + '; border-color:' + chipBorder + '; cursor:pointer;" ' +
                                    'onclick="window.openSessionDetail(this)" ' +
                                    'data-id="' + s.id + '" ' +
                                    'data-title="' + escapeHtml(s.title) + '" ' +
                                    'data-course="' + escapeHtml(s.course) + '" ' +
                                    'data-time="' + escapeHtml(s.time) + '" ' +
                                    'data-date="' + fullDate + '" ' +
                                    'data-inst="' + escapeHtml(s.inst) + '" ' +
                                    'data-room="' + escapeHtml(s.room) + '" ' +
                                    'title="' + escapeHtml(timeBadge + ' ' + s.title + ' - ' + s.course + ' (' + s.inst + ')') + '">' +
                                    timeBadge + ' ' + escapeHtml(displayTitle) +
                                    '</span>';
                            });
                            chipsHtml += '</div>';
                        }

                        html += '<td class="' + cellClass + '">' +
                            '<div class="trn-cal-date-num">' + curDStr + '</div>' +
                            chipsHtml +
                            '</td>';
                    } else {
                        // Leading days of next month
                        var nextD = cellIndex - (startOffset + daysInCurMonth) + 1;
                        var nextDStr = nextD < 10 ? '0' + nextD : '' + nextD;
                        html += '<td class="other-month"><div class="trn-cal-date-num">' + nextDStr + '</div></td>';
                    }
                    cellIndex++;
                }
                html += '</tr>';
            }

            $('#trnCalendarBody').html(html);

            // Update URL query state smoothly without reloading page
            try {
                if (window.history && window.history.replaceState) {
                    var url = new URL(window.location.href);
                    url.searchParams.set('trainingMonth', year + '-' + monthStr);
                    window.history.replaceState(null, '', url.toString());
                }
            } catch(e) {}
        } catch(err) {
            console.error('Error rendering training calendar:', err);
        }
    }

    // Close month popup when clicking outside
    document.addEventListener('click', function(e) {
        var popup = document.getElementById('trnMonthPopup');
        var btn = document.getElementById('lblMonthTitle');
        if (!popup || popup.style.display !== 'block') return;
        if (!popup.contains(e.target) && (!btn || !btn.contains(e.target))) {
            popup.style.display = 'none';
        }
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeTrnMonthPopup();
            window.closeAllModals();
        }
    });

