                                <th>Lương sản phẩm</th>
                                <th>Doanh số</th>
                                <th>Lương KPI</th>
                                <th>Tổng phụ cấp</th>
                                <th>Thưởng</th>
                                <th>BH (10.5%)</th>
                                <th>Thuế TNCN</th>
                                <th>Tạm ứng</th>
                                <th>Khấu trừ</th>
                                <th>Thực nhận (Net)</th>
                                <th class="th-center">Trạng thái</th>
                                <th class="th-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (periodItems.Count == 0)
                            {
                                <tr>
                                    <td colspan="16" style="text-align:center; padding:40px 20px; color:#64748b;">
                                        <i class="material-icons" style="font-size:40px; color:#cbd5e1; display:block; margin-bottom:8px;">inbox</i>
                                        Không tìm thấy bản ghi lương nào phù hợp điều kiện lọc.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int stt = 1;
                                foreach (var item in periodItems)
                                {
                                    var initials = GetLocalInitials(item.EmployeeName);
                                    var jsonItem = System.Text.Json.JsonSerializer.Serialize(item);
                                    <tr>
                                        <td class="td-left">
                                            <div class="emp-cell">
                                                <div class="emp-avatar">@initials</div>
                                                <div class="emp-meta">
                                                    <strong>@item.EmployeeName</strong>
                                                    <small>@item.EmployeeCode · @item.EmployeeEmail</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="td-left" style="color:#334155; font-weight:500;">
                                            @item.DepartmentName
                                        </td>
                                        <td class="td-left" style="color:#64748b;">
                                            @item.Branch
                                        </td>
                                        <td style="font-weight:600; color:#0f172a;">
                                            @item.BaseSalary.ToString("N0")
                                        </td>
                                        <td>@(item.SalesSalary > 0 ? item.SalesSalary.ToString("N0") : "—")</td>
                                        <td>@(item.SalesSalary > 0 ? item.SalesSalary.ToString("N0") : "—")</td>
                                        <td>@(item.KpiSalary > 0 ? item.KpiSalary.ToString("N0") : "—")</td>
                                        <td style="color:#0284c7; font-weight:600;">@(item.TotalAllowance > 0 ? item.TotalAllowance.ToString("N0") : "—")</td>
                                        <td style="color:#059669; font-weight:600;">@(item.Bonus > 0 ? item.Bonus.ToString("N0") : "—")</td>
                                        <td style="color:#7c3aed;">@item.TotalInsurance.ToString("N0")</td>
                                        <td style="color:#d97706;">@item.PersonalIncomeTax.ToString("N0")</td>
                                        <td style="color:#e11d48;">@(item.Advance > 0 ? item.Advance.ToString("N0") : "—")</td>
                                        <td style="color:#dc2626;">@(item.Deduction > 0 ? item.Deduction.ToString("N0") : "—")</td>
                                        <td>
                                            <span class="net-salary-highlight">@item.NetSalary.ToString("N0") đ</span>
                                        </td>
                                        <td class="td-center">
                                            <span class="badge @(item.Status switch {
                                                "DRAFT" => "badge-payroll-draft",
                                                "PENDING_APPROVAL" => "badge-payroll-pending",
                                                "APPROVED" => "badge-payroll-approved",
                                                "REJECTED" => "badge-payroll-rejected",
                                                "PUBLISHED" => "badge-payroll-published",
                                                "PAID" => "badge-payroll-paid",
                                                _ => "badge-payroll-draft"
                                            })" style="font-size:11px; padding:4px 8px; border-radius:6px;">
                                                @item.StatusText
                                            </span>
                                        </td>
                                        <td class="td-center">
                                            <button type="button" class="btn btn-sm btn-default" style="padding:3px 8px; font-size:11.5px; border-radius:6px; color:#2563eb; border-color:#93c5fd;" onclick="viewPayslipDetail(@jsonItem)" title="Xem phiếu lương chi tiết">
                                                <i class="material-icons" style="font-size:15px; vertical-align:text-bottom;">visibility</i> Phiếu lương
                                            </button>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "allowance")
