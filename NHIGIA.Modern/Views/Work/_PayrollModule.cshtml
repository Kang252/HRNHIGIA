                <input type="hidden" name="actionType" value="FINALIZE" />
                <div class="modal-header" style="background:#2563eb; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchFinalize', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;"><i class="material-icons" style="vertical-align:text-bottom;">send</i> Chốt bảng lương trình Ban Giám đốc</h4>
                </div>
                <div class="modal-body" style="padding:22px;">
                    <p style="font-size:13.5px; color:#1e293b;">
                        Xác nhận hoàn tất đối soát số liệu lương cơ bản, KPI, phụ cấp, OT, BHXH và thuế TNCN cho kỳ <strong>@currentPeriod</strong> để trình Ban Giám đốc phê duyệt?
                    </p>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchFinalize', event)">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="font-weight:600;">Xác nhận trình duyệt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 5: PHÁT HÀNH PHIẾU LƯƠNG (BATCH PUBLISH)                           -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalBatchPublish" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <form method="post" asp-controller="Work" asp-action="BatchPayrollAction">
                @Html.AntiForgeryToken()
                <input type="hidden" name="period" value="@currentPeriod" />
                <input type="hidden" name="actionType" value="PUBLISH" />
                <div class="modal-header" style="background:#7c3aed; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchPublish', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;"><i class="material-icons" style="vertical-align:text-bottom;">mark_email_read</i> Phát hành phiếu lương điện tử kỳ @currentPeriod</h4>
                </div>
                <div class="modal-body" style="padding:22px;">
                    <p style="font-size:13.5px; color:#1e293b;">
                        Sau khi phát hành, toàn bộ <strong>@Model.TotalPayrollEmployees nhân viên</strong> sẽ có thể đăng nhập vào hệ thống để tra cứu và in phiếu lương cá nhân của kỳ <strong>@currentPeriod</strong>.
                    </p>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchPublish', event)">Hủy</button>
                    <button type="submit" class="btn" style="background:#7c3aed; color:#fff; font-weight:600;">Xác nhận phát hành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 6: THÊM MỚI PHỤ CẤP                                                -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalAddAllowance" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <form method="post" asp-controller="Work" asp-action="SavePayrollComponent">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Kind" value="payroll-allowance" />
                <input type="hidden" name="Quarter" value="@currentPeriod" />
                <div class="modal-header" style="background:#0284c7; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalAddAllowance', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;">+ Tạo mới khoản phụ cấp nhân viên</h4>
                </div>
                <div class="modal-body" style="padding:20px; font-size:13px;">
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Chọn nhân viên nhận phụ cấp:</label>
                        <select name="EmployeeId" class="form-control" required>
                            <option value="">-- Chọn nhân viên --</option>
                            @foreach (var p in Model.People)
                            {
                                <option value="@p.Id">@p.DisplayName (@p.DepartmentName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Loại phụ cấp:</label>
                        <input type="text" name="Title" class="form-control" list="allowanceTypesList" required placeholder="Ví dụ: Phụ cấp ăn trưa, Xăng xe, Điện thoại, Trách nhiệm..." />
                        <datalist id="allowanceTypesList">
                            <option value="Phụ cấp ăn trưa" />
                            <option value="Phụ cấp xăng xe - đi lại" />
                            <option value="Phụ cấp điện thoại - liên lạc" />
                            <option value="Phụ cấp trách nhiệm quản lý" />
                            <option value="Phụ cấp kỹ thuật độc hại" />
                        </datalist>
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Số tiền phụ cấp (VNĐ):</label>
                        <input type="number" name="Target" class="form-control" required min="10000" step="10000" placeholder="Ví dụ: 730000" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-xs-6">
                            <label style="font-weight:600; margin-bottom:4px;">Tính thuế TNCN?</label>
                            <select name="SalaryRange" class="form-control">
                                <option value="NON_TAXABLE">Miễn thuế TNCN (Ăn trưa, trang phục...)</option>
                                <option value="TAXABLE">Có tính thuế TNCN</option>
                            </select>
                        </div>
                        <div class="col-xs-6">
                            <label style="font-weight:600; margin-bottom:4px;">Tính đóng BHXH?</label>
                            <select name="JobLevel" class="form-control">
                                <option value="INSURANCE_NO">Không đóng BHXH</option>
                                <option value="INSURANCE_YES">Có đóng BHXH</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label style="font-weight:600; margin-bottom:4px;">Ghi chú / Căn cứ:</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Căn cứ hợp đồng lao động hoặc quyết định bổ nhiệm..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalAddAllowance', event)">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="font-weight:600;">Lưu phụ cấp</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 7: THÊM MỚI KHẤU TRỪ                                                -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalAddDeduction" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <form method="post" asp-controller="Work" asp-action="SavePayrollComponent">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Kind" value="payroll-deduction" />
                <input type="hidden" name="Quarter" value="@currentPeriod" />
                <div class="modal-header" style="background:#dc2626; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalAddDeduction', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;">+ Tạo mới khoản khấu trừ lương</h4>
                </div>
                <div class="modal-body" style="padding:20px; font-size:13px;">
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Chọn nhân viên bị khấu trừ:</label>
                        <select name="EmployeeId" class="form-control" required>
                            <option value="">-- Chọn nhân viên --</option>
                            @foreach (var p in Model.People)
                            {
                                <option value="@p.Id">@p.DisplayName (@p.DepartmentName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Loại khoản khấu trừ:</label>
                        <input type="text" name="Title" class="form-control" list="deductionTypesList" required placeholder="Ví dụ: Phạt vi phạm chấm công, Khấu trừ đồng phục..." />
                        <datalist id="deductionTypesList">
                            <option value="Phạt vi phạm quy chế chấm công" />
                            <option value="Thu phí đồng phục đợt 1" />
                            <option value="Bồi thường thất thoát tài sản" />
                            <option value="Khấu trừ tạm giữ bảo lãnh" />
                        </datalist>
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Số tiền khấu trừ (VNĐ):</label>
                        <input type="number" name="Target" class="form-control" required min="10000" step="10000" placeholder="Ví dụ: 200000" />
                    </div>
                    <div class="form-group">
                        <label style="font-weight:600; margin-bottom:4px;">Lý do chi tiết:</label>
                        <textarea name="Description" class="form-control" rows="2" required placeholder="Ghi nhận căn cứ quyết định xử lý kỷ luật hoặc biên bản vi phạm..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalAddDeduction', event)">Hủy</button>
                    <button type="submit" class="btn btn-danger" style="font-weight:600;">Lưu khấu trừ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 8: THÊM MỚI TẠM ỨNG LƯƠNG                                           -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalAddAdvance" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <form method="post" asp-controller="Work" asp-action="SavePayrollComponent">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Kind" value="payroll-advance" />
                <input type="hidden" name="Quarter" value="@currentPeriod" />
                <div class="modal-header" style="background:#2563eb; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalAddAdvance', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;">+ Tạo mới phiếu tạm ứng lương</h4>
                </div>
                <div class="modal-body" style="padding:20px; font-size:13px;">
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Chọn nhân viên tạm ứng:</label>
                        <select name="EmployeeId" class="form-control" required>
                            <option value="">-- Chọn nhân viên --</option>
                            @foreach (var p in Model.People)
                            {
                                <option value="@p.Id">@p.DisplayName (@p.DepartmentName)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Tiêu đề tạm ứng:</label>
                        <input type="text" name="Title" class="form-control" required value="Tạm ứng tiền lương cá nhân" />
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Số tiền tạm ứng (VNĐ):</label>
                        <input type="number" name="Target" class="form-control" required min="100000" step="100000" placeholder="Ví dụ: 2000000" />
                    </div>
                    <div class="form-group mb-3">
                        <label style="font-weight:600; margin-bottom:4px;">Ngày tạm ứng:</label>
                        <input type="date" name="StartDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="form-group">
                        <label style="font-weight:600; margin-bottom:4px;">Lý do tạm ứng:</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Ghi chú lý do giải quyết chi phí công tác hoặc việc cá nhân đột xuất..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalAddAdvance', event)">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="font-weight:600;">Lưu phiếu tạm ứng</button>
                </div>
            </form>
        </div>
    </div>
</div>

