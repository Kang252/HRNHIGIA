                                        <th>I. CÁC KHOẢN THU NHẬP</th>
                                        <th style="text-align:right;">Số tiền (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>1. Lương cơ bản / Giữ đóng</td><td style="text-align:right;" id="psBaseSalary">0</td></tr>
                                    <tr><td>2. Lương hiệu quả KPI</td><td style="text-align:right;" id="psKpiSalary">0</td></tr>
                                    <tr><td>3. Lương doanh số / Sản phẩm</td><td style="text-align:right;" id="psSalesSalary">0</td></tr>
                                    <tr><td>4. Lương làm thêm giờ (OT)</td><td style="text-align:right;" id="psOtSalary">0</td></tr>
                                    <tr><td>5. Tổng các khoản phụ cấp</td><td style="text-align:right;" id="psAllowance">0</td></tr>
                                    <tr><td>6. Tiền thưởng khen thưởng</td><td style="text-align:right;" id="psBonus">0</td></tr>
                                    <tr class="subtotal-row">
                                        <td>TỔNG THU NHẬP (GROSS)</td>
                                        <td style="text-align:right; color:#2563eb;" id="psGrossIncome">0</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Cột 2: Các khoản trích trừ -->
                        <div>
                            <table class="payslip-subtable">
                                <thead>
                                    <tr>
                                        <th>II. CÁC KHOẢN TRÍCH TRỪ</th>
                                        <th style="text-align:right;">Số tiền (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>1. Bảo hiểm xã hội (BHXH 8%)</td><td style="text-align:right;" id="psBhxh">0</td></tr>
                                    <tr><td>2. Bảo hiểm y tế (BHYT 1.5%)</td><td style="text-align:right;" id="psBhyt">0</td></tr>
                                    <tr><td>3. Bảo hiểm thất nghiệp (BHTN 1%)</td><td style="text-align:right;" id="psBhtn">0</td></tr>
                                    <tr><td>4. Thuế thu nhập cá nhân (TNCN)</td><td style="text-align:right;" id="psPit">0</td></tr>
                                    <tr><td>5. Tạm ứng lương trong kỳ</td><td style="text-align:right;" id="psAdvance">0</td></tr>
                                    <tr><td>6. Các khoản khấu trừ khác / Phạt</td><td style="text-align:right;" id="psDeduction">0</td></tr>
                                    <tr class="subtotal-row">
                                        <td>TỔNG CÁC KHOẢN TRỪ</td>
                                        <td style="text-align:right; color:#dc2626;" id="psTotalDeductions">0</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Hộp Thực nhận NET -->
                    <div class="payslip-net-box">
                        <div>
                            <h4>SỐ TIỀN THỰC LĨNH (NET SALARY)</h4>
                            <div class="net-num" id="psNetSalary">0 đ</div>
                        </div>
                        <div>
                            <div class="net-words" id="psNetWords">Bằng chữ: Không đồng chẵn.</div>
                        </div>
                    </div>

                    <!-- Chữ ký điện tử -->
                    <div class="payslip-sign-row">
                        <div>
                            <p>Người lập biểu</p>
                            <span>(Ký, ghi rõ họ tên)</span>
                        </div>
                        <div>
                            <p>Kế toán trưởng</p>
                            <span>(Ký, ghi rõ họ tên)</span>
                        </div>
                        <div>
                            <p>Ban Giám đốc</p>
                            <span>(Đã phê duyệt)</span>
                        </div>
                        <div>
                            <p>Người nhận tiền</p>
                            <span>(Xác nhận)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="background:#f8fafc; border-top:1px solid #e2e8f0; padding:12px 24px; display:flex; justify-content:space-between;">
                <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalViewPayslip', event)">Đóng</button>
                <div>
                    <button type="button" class="btn btn-primary" onclick="printPayslipIframe()" style="display:inline-flex; align-items:center; gap:6px;">
                        <i class="material-icons" style="font-size:18px;">print</i> In phiếu lương
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: DUYỆT BẢNG LƯƠNG (BATCH APPROVE CHO BAN GIÁM ĐỐC / ADMIN)       -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalBatchApprove" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <form method="post" asp-controller="Work" asp-action="BatchPayrollAction">
                @Html.AntiForgeryToken()
                <input type="hidden" name="period" value="@currentPeriod" />
                <input type="hidden" name="actionType" value="APPROVE" />
                <div class="modal-header" style="background:#10b981; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchApprove', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;"><i class="material-icons" style="vertical-align:text-bottom;">check_circle</i> Phê duyệt bảng lương kỳ @currentPeriod</h4>
                </div>
                <div class="modal-body" style="padding:22px;">
                    <p style="font-size:14px; color:#1e293b; line-height:1.5;">
                        Ban Giám đốc xác nhận phê duyệt bảng lương <strong>Kỳ @currentPeriod</strong> với các chỉ số tổng hợp:
                    </p>
                    <ul style="font-size:13.5px; color:#334155; line-height:1.9; background:#f8fafc; padding:14px 26px; border-radius:8px; border:1px solid #e2e8f0; list-style-type:square;">
                        <li>Tổng số nhân sự: <strong>@Model.TotalPayrollEmployees nhân viên</strong></li>
                        <li>Tổng chi phí thực nhận: <strong style="color:#059669;">@Model.TotalPayrollNetSalary.ToString("N0") đ</strong></li>
                        <li>Tổng trích nộp BHXH: <strong>@Model.TotalPayrollSocialInsurance.ToString("N0") đ</strong></li>
                        <li>Tổng thuế TNCN: <strong>@Model.TotalPayrollPersonalIncomeTax.ToString("N0") đ</strong></li>
                    </ul>
                    <div class="form-group" style="margin-top:14px;">
                        <label style="font-weight:600; font-size:13px; margin-bottom:4px;">Ghi chú phê duyệt của Ban Giám đốc (tùy chọn):</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="Đã duyệt chi lương theo tờ trình của Phòng Nhân sự."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchApprove', event)">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success" style="font-weight:600;"><i class="material-icons" style="font-size:16px; vertical-align:middle;">check_circle</i> Xác nhận phê duyệt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 3: YÊU CẦU ĐIỀU CHỈNH LẠI (BATCH REJECT CHO BAN GIÁM ĐỐC / ADMIN)   -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalBatchReject" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <form method="post" asp-controller="Work" asp-action="BatchPayrollAction">
                @Html.AntiForgeryToken()
                <input type="hidden" name="period" value="@currentPeriod" />
                <input type="hidden" name="actionType" value="REJECT" />
                <div class="modal-header" style="background:#ef4444; color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchReject', event)" style="color:#fff; opacity:0.9;"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" style="font-size:16px; font-weight:700;"><i class="material-icons" style="vertical-align:text-bottom;">replay</i> Yêu cầu điều chỉnh lại bảng lương</h4>
                </div>
                <div class="modal-body" style="padding:22px;">
                    <p style="font-size:13.5px; color:#1e293b;">
                        Bảng lương kỳ <strong>@currentPeriod</strong> sẽ chuyển về trạng thái <strong>Cần điều chỉnh</strong> để bộ phận HR/Kế toán rà soát lại số liệu theo đúng quy trình.
                    </p>
                    <div class="form-group">
                        <label style="font-weight:700; font-size:13px; color:#b91c1c; margin-bottom:6px;">Lý do yêu cầu điều chỉnh lại (bắt buộc):</label>
                        <textarea name="note" class="form-control" rows="3" required placeholder="Ví dụ: Rà soát lại số giờ tăng ca của phòng Kỹ thuật; Kiểm tra lại khoản giảm trừ gia cảnh của nhân sự mới..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background:#f8fafc;">
                    <button type="button" class="btn btn-default" data-dismiss="modal" data-bs-dismiss="modal" onclick="closePayrollModal('modalBatchReject', event)">Hủy</button>
                    <button type="submit" class="btn btn-danger" style="font-weight:600;"><i class="material-icons" style="font-size:16px; vertical-align:middle;">replay</i> Gửi yêu cầu điều chỉnh</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 4: DUYỆT CHỐT BẢNG LƯƠNG (BATCH FINALIZE CHO HR / KẾ TOÁN)          -->
