<!-- ========================================================================= -->
<script>
    function readVietnameseCurrency(num) {
        if (!num || num === 0) return "Không đồng chẵn.";
        var units = ["", "nghìn", "triệu", "tỷ", "nghìn tỷ", "triệu tỷ"];
        var digits = ["không", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín"];

        function readThree(n, showZeroHundred) {
            var h = Math.floor(n / 100);
            var t = Math.floor((n % 100) / 10);
            var u = n % 10;
            if (h === 0 && t === 0 && u === 0) return "";
            var res = "";
            if (h > 0 || showZeroHundred) {
                res += digits[h] + " trăm ";
            }
            if (t === 0 && u > 0) {
                if (h > 0 || showZeroHundred) res += "lẻ ";
                res += digits[u] + " ";
            } else if (t === 1) {
                res += "mười ";
                if (u === 1) res += "một ";
                else if (u === 5) res += "lăm ";
                else if (u > 0) res += digits[u] + " ";
            } else if (t > 1) {
                res += digits[t] + " mươi ";
                if (u === 1) res += "mốt ";
                else if (u === 5) res += "lăm ";
                else if (u > 0) res += digits[u] + " ";
            }
            return res;
        }

        var s = Math.round(num).toString();
        var groups = [];
        while (s.length > 0) {
            var len = Math.min(3, s.length);
            groups.unshift(parseInt(s.substring(s.length - len), 10));
            s = s.substring(0, s.length - len);
        }

        var result = "";
        for (var i = 0; i < groups.length; i++) {
            var g = groups[i];
            var unitIdx = groups.length - 1 - i;
            if (g > 0) {
                var strG = readThree(g, i > 0);
                result += strG + units[unitIdx] + " ";
            }
        }

        result = result.trim();
        if (!result) return "Không đồng chẵn.";
        result = result.charAt(0).toUpperCase() + result.slice(1) + " đồng chẵn.";
        return "Bằng chữ: " + result;
    }

    function viewPayslipDetail(item) {
        if (!item) return;

        document.getElementById('psEmpName').textContent = item.EmployeeName || 'Nhân viên';
        document.getElementById('psEmpCode').textContent = item.EmployeeCode || 'NV000';
        document.getElementById('psDeptName').textContent = item.DepartmentName || 'Chưa phân phòng';
        document.getElementById('psBranch').textContent = item.Branch || 'TP. Hồ Chí Minh';
        document.getElementById('psEmail').textContent = item.EmployeeEmail || (item.EmployeeCode ? item.EmployeeCode.toLowerCase() + '@@nhigia.vn' : 'nv@@nhigia.vn');
        document.getElementById('psPeriodLabel').textContent = 'Kỳ lương: ' + (item.Period || 'Tháng 02/2026');

        document.getElementById('psBaseSalary').textContent = (item.BaseSalary || 0).toLocaleString('vi-VN');
        document.getElementById('psKpiSalary').textContent = (item.KpiSalary || 0).toLocaleString('vi-VN');
        document.getElementById('psSalesSalary').textContent = (item.SalesSalary || 0).toLocaleString('vi-VN');
        document.getElementById('psOtSalary').textContent = (item.OtSalary || 0).toLocaleString('vi-VN');
        document.getElementById('psAllowance').textContent = (item.TotalAllowance || 0).toLocaleString('vi-VN');
        document.getElementById('psBonus').textContent = (item.Bonus || 0).toLocaleString('vi-VN');
        document.getElementById('psGrossIncome').textContent = (item.GrossIncome || 0).toLocaleString('vi-VN');

        document.getElementById('psBhxh').textContent = (item.SocialInsurance || 0).toLocaleString('vi-VN');
        document.getElementById('psBhyt').textContent = (item.HealthInsurance || 0).toLocaleString('vi-VN');
        document.getElementById('psBhtn').textContent = (item.UnemploymentInsurance || 0).toLocaleString('vi-VN');
        document.getElementById('psPit').textContent = (item.PersonalIncomeTax || 0).toLocaleString('vi-VN');
        document.getElementById('psAdvance').textContent = (item.Advance || 0).toLocaleString('vi-VN');
        document.getElementById('psDeduction').textContent = (item.Deduction || 0).toLocaleString('vi-VN');

        var totalDed = (item.TotalInsurance || 0) + (item.PersonalIncomeTax || 0) + (item.Advance || 0) + (item.Deduction || 0);
        document.getElementById('psTotalDeductions').textContent = totalDed.toLocaleString('vi-VN');

        document.getElementById('psNetSalary').textContent = (item.NetSalary || 0).toLocaleString('vi-VN') + ' đ';
        document.getElementById('psNetWords').textContent = readVietnameseCurrency(item.NetSalary || 0);

        openPayrollModal('modalViewPayslip');
    }

    function openPayrollModal(modalId, event) {
        if (event) {
            if (typeof event.preventDefault === 'function') event.preventDefault();
            if (typeof event.stopPropagation === 'function') event.stopPropagation();
        }
        var modalEl = typeof modalId === 'string' ? document.getElementById(modalId) : modalId;
        if (!modalEl) {
            console.warn('Không tìm thấy modal:', modalId);
            return;
        }

        // Ưu tiên Bootstrap qua jQuery (Bootstrap 3/4)
        if (window.jQuery && typeof jQuery.fn.modal === 'function') {
            $(modalEl).modal('show');
            return;
        }

        // Hỗ trợ Bootstrap 5
        if (window.bootstrap && bootstrap.Modal) {
            if (typeof bootstrap.Modal.getOrCreateInstance === 'function') {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            } else {
                new bootstrap.Modal(modalEl).show();
            }
            return;
        }

        // Fallback thuần JS nếu chưa tải kịp thư viện
        modalEl.style.display = 'block';
        modalEl.classList.add('in');
        modalEl.setAttribute('aria-hidden', 'false');
        var bd = document.createElement('div');
        bd.className = 'modal-backdrop fade in';
        bd.setAttribute('data-payroll-backdrop', modalEl.id);
        document.body.appendChild(bd);
        document.body.classList.add('modal-open');
    }

    function closePayrollModal(modalId, event) {
        if (event) {
            if (typeof event.preventDefault === 'function') event.preventDefault();
            if (typeof event.stopPropagation === 'function') event.stopPropagation();
        }
        var modalEl = typeof modalId === 'string' ? document.getElementById(modalId) : modalId;
        if (!modalEl) return;

        if (window.jQuery && typeof jQuery.fn.modal === 'function') {
            $(modalEl).modal('hide');
        } else if (window.bootstrap && bootstrap.Modal) {
            if (typeof bootstrap.Modal.getInstance === 'function') {
                var inst = bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide();
            }
        }

        modalEl.classList.remove('in');
        modalEl.style.display = 'none';
        modalEl.setAttribute('aria-hidden', 'true');
        var bd = document.querySelector('[data-payroll-backdrop="' + modalEl.id + '"]');
        if (bd) bd.remove();
        var openModals = document.querySelectorAll('.modal.in');
        if (openModals.length === 0) {
            document.body.classList.remove('modal-open');
            var backdrops = document.querySelectorAll('.modal-backdrop');
            backdrops.forEach(function (b) { b.remove(); });
        }
    }

    document.addEventListener('click', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('modal') && e.target.classList.contains('in')) {
            closePayrollModal(e.target.id, e);
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            var activeModal = document.querySelector('.modal.in');
            if (activeModal) closePayrollModal(activeModal.id, e);
        }
    });

    function printPayslipIframe() {
        var printArea = document.getElementById('payslipPrintArea');
        if (!printArea) return;
        var printContent = printArea.innerHTML;

        var iframe = document.createElement('iframe');
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        document.body.appendChild(iframe);

        var doc = iframe.contentWindow.document;
        doc.open();
        doc.write('<!DOCTYPE html><html><head><title>Phiếu Lương Nhị Gia</title>');
        doc.write('<style>');
        doc.write('body { font-family: "Segoe UI", Arial, sans-serif; padding: 20px; color: #1e293b; }');
        doc.write('.payslip-corp-header { display: flex; justify-content: space-between; border-bottom: 2px solid #0f766e; padding-bottom: 12px; margin-bottom: 16px; }');
        doc.write('.payslip-logo-title h3 { font-size: 14px; font-weight: 800; color: #0f766e; margin: 0 0 4px; text-transform: uppercase; }');
        doc.write('.payslip-logo-title p { font-size: 11px; color: #64748b; margin: 0; line-height: 1.4; }');
        doc.write('.payslip-period-badge h2 { font-size: 18px; margin: 0 0 4px; }');
        doc.write('.payslip-emp-info { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-bottom: 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; font-size: 12px; }');
        doc.write('.payslip-table-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }');
        doc.write('.payslip-subtable { width: 100%; border-collapse: collapse; font-size: 11.5px; }');
        doc.write('.payslip-subtable th { background: #f1f5f9; padding: 6px 8px; text-align: left; border-bottom: 1.5px solid #cbd5e1; }');
        doc.write('.payslip-subtable td { padding: 6px 8px; border-bottom: 1px solid #f1f5f9; }');
        doc.write('.payslip-subtable tr.subtotal-row { font-weight: 700; border-top: 1.5px solid #cbd5e1; background: #f8fafc; }');
        doc.write('.payslip-net-box { background: #059669; color: #fff; border-radius: 8px; padding: 12px 16px; display: flex; justify-content: space-between; margin-bottom: 16px; }');
        doc.write('.payslip-net-box .net-num { font-size: 20px; font-weight: 800; }');
        doc.write('.payslip-sign-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; margin-top: 20px; font-size: 11px; }');
        doc.write('.payslip-sign-row p { margin: 0 0 40px; font-weight: 700; }');
        doc.write('</style></head><body>');
        doc.write(printContent);
        doc.write('</body></html>');
        doc.close();

        setTimeout(function() {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            setTimeout(function() { document.body.removeChild(iframe); }, 1000);
        }, 300);
    }
</script>

