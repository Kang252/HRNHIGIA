                                    </td>
                                    <td class="td-left" style="color:#64748b; font-size:12px;">@a.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (activeTab == "insurance")
    {
        <!-- TAB 3: Bảo hiểm của nhân viên theo kỳ lương (Slide 7) -->
        <div class="payroll-table-card">
            <div class="payroll-table-toolbar">
                <div style="font-size:15px; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:8px;">
                    <i class="material-icons" style="color:#7c3aed;">security</i>
                    <span>Chi tiết trích nộp bảo hiểm nhân viên & doanh nghiệp (Kỳ @currentPeriod)</span>
