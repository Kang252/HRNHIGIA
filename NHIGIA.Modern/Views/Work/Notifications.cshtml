@model IReadOnlyList<WorkNotification>

<div class="container-fluid">
    <div class="hrm-page-header">
        <div>
            <h1 class="hrm-page-title">Thông báo của tôi</h1>
            <p class="hrm-page-subtitle">Lời mời họp, chuyến xe và các cập nhật liên quan đến bạn</p>
        </div>
    </div>

    <section class="work-panel">
        @if (Model.Count == 0)
        {
            <div class="work-empty"><i class="material-icons">notifications_none</i><h4>Chưa có thông báo</h4><p>Thông báo mới sẽ xuất hiện khi bạn được thêm vào lịch họp hoặc chuyến xe.</p></div>
        }
        else
        {
            <div class="notification-list">
                @foreach (var notification in Model)
                {
                    <form method="post" asp-controller="Work" asp-action="OpenNotification">
                        <input type="hidden" name="id" value="@notification.Id" />
                        <button type="submit" class="notification-item @(notification.IsRead ? "" : "is-unread")">
                            <i class="material-icons">@(notification.IsRead ? "notifications" : "notifications_active")</i>
                            <span class="notification-copy"><strong>@notification.Title</strong><span>@notification.Message</span><small>@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></span>
                        </button>
                    </form>
                }
            </div>
        }
    </section>
</div>
