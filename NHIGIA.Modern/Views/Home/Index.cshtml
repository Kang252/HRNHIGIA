@using NHIGIA.Modern.Models
@{
    var today = DateTime.Now;
    var dashboardUser = HrmUser.Current;
    var dashboardCanManage = dashboardUser != null && HrmRoles.CanManagePeople(dashboardUser.RoleCode);
    var dashboardIsEmployee = dashboardUser != null && dashboardUser.RoleCode == HrmRoles.Employee;
    var dashboardIsManager = dashboardUser != null && dashboardUser.RoleCode == HrmRoles.Manager;
    var dashboardIsHr = dashboardUser != null && dashboardUser.RoleCode == HrmRoles.Hr;
    var dashboardIsDirector = dashboardUser != null && dashboardUser.RoleCode == HrmRoles.Director;
    var dashboardIsAdmin = dashboardUser != null && dashboardUser.RoleCode == HrmRoles.Admin;
    var dashboardPayrollPeriod = today.ToString("MM/yyyy");
    var dashboardTitle = dashboardUser?.RoleCode switch
    {
        HrmRoles.Manager => "Tổng quan phòng ban",
        HrmRoles.Hr => "Điều hành nhân sự",
        HrmRoles.Director => "Tổng quan điều hành",
        HrmRoles.Admin => "Tổng quan hệ thống",
        _ => "Tổng quan của tôi"
    };
    var dashboardSubtitle = dashboardUser?.RoleCode switch
    {
        HrmRoles.Manager => "Theo dõi nhân sự và các yêu cầu thuộc phòng ban của bạn",
        HrmRoles.Hr => "Quản lý hồ sơ, chính sách và quy trình nhân sự toàn công ty",
        HrmRoles.Director => "Theo dõi chỉ số tổng hợp và các nội dung cần phê duyệt",
        HrmRoles.Admin => "Theo dõi vận hành hệ thống và dữ liệu nhân sự",
        _ => "Theo dõi lịch làm việc, chấm công và quyền lợi cá nhân"
    };
}

<div class="container-fluid hrm-dashboard">
    <div class="hrm-page-header">
        <div>
            <h1 class="hrm-page-title">@dashboardTitle</h1>
            <p class="hrm-page-subtitle">Ngày @today.ToString("dd/MM/yyyy") · @dashboardSubtitle</p>
        </div>
        <div class="hrm-header-actions">
            <a class="hrm-btn" href="@Url.Action("WorkSchedules", "Home")">
                <i class="material-icons">date_range</i> Lịch làm việc
            </a>
            @if (dashboardIsEmployee)
            {
                <a class="hrm-btn hrm-btn-primary" href="@Url.Action("LeaveRequests", "Home", new { create = "leave" })"><i class="material-icons">event_available</i> Xin nghỉ phép</a>
            }
            else if (dashboardCanManage)
            {
                <a class="hrm-btn hrm-btn-primary" href="@Url.Action("EmployeeInformation", "Home")"><i class="material-icons">groups</i> @(dashboardIsManager ? "Nhân sự phòng ban" : "Quản lý nhân sự")</a>
            }
        </div>
    </div>

    @if (dashboardIsEmployee)
    {
    <div class="hrm-grid hrm-grid-4">
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Trạng thái hôm nay</span><span class="hrm-stat-icon green"><i class="material-icons">how_to_reg</i></span></div>
            <div id="dashboardPersonalStatus" class="hrm-stat-value" style="font-size:21px">--</div>
            <div class="hrm-stat-note">Theo dữ liệu chấm công cá nhân</div>
        </div>
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Giờ vào</span><span class="hrm-stat-icon"><i class="material-icons">login</i></span></div>
            <div id="dashboardPersonalCheckIn" class="hrm-stat-value">--:--</div>
            <div class="hrm-stat-note">Bản ghi đầu tiên trong ngày</div>
        </div>
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Giờ ra</span><span class="hrm-stat-icon orange"><i class="material-icons">logout</i></span></div>
            <div id="dashboardPersonalCheckOut" class="hrm-stat-value">--:--</div>
            <div class="hrm-stat-note">Bản ghi cuối cùng trong ngày</div>
        </div>
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Phép năm còn lại</span><span class="hrm-stat-icon purple"><i class="material-icons">event_available</i></span></div>
            <div id="dashboardLeaveRemainingSummary" class="hrm-stat-value">--</div>
            <div class="hrm-stat-note">Cập nhật theo đơn nghỉ đã duyệt</div>
        </div>
    </div>
    }
    else
    {
    <div class="hrm-grid hrm-grid-4">
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">@(dashboardIsManager ? "Nhân sự phòng ban" : "Tổng nhân sự")</span><span class="hrm-stat-icon"><i class="material-icons">people</i></span></div>
            <div id="dashboardEmployees" class="hrm-stat-value">--</div>
            <div class="hrm-stat-note">Theo phạm vi tài khoản đang đăng nhập</div>
        </div>
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Có mặt hôm nay</span><span class="hrm-stat-icon green"><i class="material-icons">how_to_reg</i></span></div>
            <div id="dashboardPresent" class="hrm-stat-value">--</div>
            <div class="hrm-stat-note">Dữ liệu từ thiết bị chấm công</div>
        </div>
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Đi muộn / về sớm</span><span class="hrm-stat-icon orange"><i class="material-icons">schedule</i></span></div>
            <div id="dashboardLate" class="hrm-stat-value">--</div>
            <div class="hrm-stat-note">Theo lịch riêng từng nhân viên</div>
        </div>
        <div class="hrm-card hrm-stat">
            <div class="hrm-stat-top"><span class="hrm-stat-label">Đơn chờ duyệt</span><span class="hrm-stat-icon purple"><i class="material-icons">fact_check</i></span></div>
            <div id="dashboardPending" class="hrm-stat-value">0</div>
            <div class="hrm-stat-note">Nghỉ phép, công tác và làm thêm</div>
        </div>
    </div>
    }

    <div class="hrm-content-grid">
        <div class="hrm-card">
            <div class="hrm-card-header">
                <div><h2 class="hrm-card-title">@(dashboardIsEmployee ? "Chấm công hôm nay của tôi" : "Tình hình chấm công hôm nay")</h2><p class="hrm-card-subtitle">@(dashboardIsEmployee ? "Đối chiếu với lịch làm việc được phân" : "Tổng hợp từ thiết bị và lịch làm việc")</p></div>
                <a class="hrm-btn" href="@Url.Action("Attendance", "Home")">Xem chi tiết</a>
            </div>
            <div class="hrm-table-wrap">
                <table class="hrm-table">
                    <thead><tr><th>Nhân viên</th><th>Ca làm việc</th><th>Giờ vào</th><th>Giờ ra</th><th>Trạng thái</th></tr></thead>
                    <tbody id="dashboardAttendance">
                        <tr><td colspan="5"><div class="hrm-empty"><i class="material-icons">camera_front</i>Chưa có dữ liệu chấm công từ thiết bị.</div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="hrm-card">
            @if (dashboardIsEmployee)
            {
            <div class="hrm-card-header"><div><h2 class="hrm-card-title">Nghỉ phép của tôi</h2><p class="hrm-card-subtitle">Quỹ phép và trạng thái thủ tục cá nhân</p></div><span class="hrm-stat-icon green"><i class="material-icons">event_available</i></span></div>
            <div class="hrm-card-body">
                <ul class="hrm-metric-list">
                    <li><span>Phép năm còn lại</span><strong id="dashboardPersonalLeave">--</strong></li>
                    <li><span>Phép đã sử dụng</span><strong id="dashboardPersonalLeaveUsed">--</strong></li>
                    <li><span>Đơn đang chờ</span><strong id="dashboardPersonalPending">--</strong></li>
                    <li><span>Đơn đã duyệt</span><strong id="dashboardPersonalApproved">--</strong></li>
                </ul>
                <div class="employee-card-actions">
                    <a class="hrm-btn hrm-btn-primary" href="@Url.Action("LeaveRequests", "Home", new { create = "leave" })"><i class="material-icons">add_circle</i> Xin nghỉ phép</a>
                    <a class="hrm-btn" href="@Url.Action("LeaveRequests", "Home")">Xem thủ tục</a>
                </div>
            </div>
            }
            else
            {
            <div class="hrm-card-header"><div><h2 class="hrm-card-title">Tỷ lệ hiện diện</h2><p class="hrm-card-subtitle">Theo trạng thái trong ngày</p></div></div>
            <div class="hrm-card-body">
                <ul class="hrm-metric-list">
                    <li><span>Có mặt đúng giờ</span><strong id="dashboardOnTime">--</strong></li>
                    <li><span>Đi muộn / về sớm</span><strong id="dashboardLateMetric">--</strong></li>
                    <li><span>Đã ghi nhận</span><strong id="dashboardRecorded">--</strong></li>
                    <li><span>Chưa ghi nhận</span><strong id="dashboardMissing">--</strong></li>
                </ul>
                <div style="margin-top:18px">
                    <div style="display:flex;justify-content:space-between;margin-bottom:7px;color:#667085;font-size:12px"><span>Tỷ lệ nhân viên đã liên kết thiết bị</span><strong id="dashboardSyncText" style="color:#182230">0%</strong></div>
                    <div class="hrm-progress"><span id="dashboardSyncProgress" style="width:0%"></span></div>
                </div>
            </div>
            }
        </div>
    </div>

    @if (dashboardIsEmployee)
    {
    <div class="hrm-grid hrm-grid-2 hrm-section-gap employee-dashboard-grid">
        <div class="hrm-card">
            <div class="hrm-card-header"><div><h2 class="hrm-card-title">Chức năng thường dùng</h2><p class="hrm-card-subtitle">Truy cập nhanh các nghiệp vụ dành cho nhân viên</p></div></div>
            <div class="hrm-card-body">
                <div class="employee-service-grid">
                    <a class="employee-service-link is-primary" href="@Url.Action("LeaveRequests", "Home", new { create = "leave" })"><span><i class="material-icons">event_available</i></span><strong>Xin nghỉ phép</strong><small>Tạo đơn nghỉ mới</small></a>
                    <a class="employee-service-link" href="@Url.Action("Index", "Work", new { kind = "payroll" })"><span><i class="material-icons">payments</i></span><strong>Phiếu lương</strong><small>Tra cứu lương cá nhân</small></a>
                    <a class="employee-service-link" href="@Url.Action("WorkSchedules", "Home")"><span><i class="material-icons">event_note</i></span><strong>Lịch làm việc</strong><small id="dashboardPersonalShift">Xem ca đang áp dụng</small></a>
                    <a class="employee-service-link" href="@Url.Action("Index", "RemoteAttendance")"><span><i class="material-icons">add_location_alt</i></span><strong>Chấm công ngoài công ty</strong><small>Làm tại nhà hoặc đi thị trường</small></a>
                    <a class="employee-service-link" href="@Url.Action("Index", "Work", new { kind = "kpi" })"><span><i class="material-icons">track_changes</i></span><strong>KPI của tôi</strong><small>Theo dõi mục tiêu công việc</small></a>
                    <a class="employee-service-link" href="@Url.Action("Index", "Work", new { kind = "helpdesk" })"><span><i class="material-icons">support_agent</i></span><strong>Yêu cầu IT</strong><small>Gửi và theo dõi hỗ trợ</small></a>
                    <a class="employee-service-link" href="@Url.Action("MyProfile", "Home")"><span><i class="material-icons">badge</i></span><strong>Hồ sơ của tôi</strong><small>Xem thông tin cá nhân</small></a>
                    <a class="employee-service-link" href="@Url.Action("Index", "Work", new { kind = "training" })"><span><i class="material-icons">school</i></span><strong>Đào tạo</strong><small>Khóa học của tôi</small></a>
                </div>
            </div>
        </div>
        <div class="hrm-card employee-payroll-card">
            <div class="hrm-card-header"><div><h2 class="hrm-card-title">Phiếu lương của tôi</h2><p class="hrm-card-subtitle">Thông tin lương được bảo mật theo tài khoản</p></div><span class="hrm-stat-icon"><i class="material-icons">account_balance_wallet</i></span></div>
            <div class="hrm-card-body">
                <div class="employee-payroll-period"><span>Tháng hiện tại</span><strong>@dashboardPayrollPeriod</strong></div>
                <div class="employee-payroll-copy">
                    <h3>Tra cứu phiếu lương điện tử</h3>
                    <p>Xem chi tiết lương, phụ cấp, bảo hiểm, thuế, tạm ứng và các khoản khấu trừ đã được phát hành.</p>
                </div>
                <div class="employee-payroll-note"><i class="material-icons">lock</i><span>Chỉ bạn và người có thẩm quyền mới xem được dữ liệu này.</span></div>
                <a class="hrm-btn hrm-btn-primary employee-payroll-action" href="@Url.Action("Index", "Work", new { kind = "payroll" })"><i class="material-icons">receipt_long</i> Mở phiếu lương</a>
            </div>
        </div>
    </div>
    }
    else
    {
    <div class="hrm-grid hrm-grid-2 hrm-section-gap">
        <div class="hrm-card">
            <div class="hrm-card-header"><div><h2 class="hrm-card-title">Truy cập nhanh</h2><p class="hrm-card-subtitle">Các nghiệp vụ thường dùng</p></div></div>
            <div class="hrm-card-body">
                <div class="hrm-grid hrm-grid-3 hrm-quick-grid">
                    @if (dashboardIsManager)
                    {
                        <a class="hrm-btn" href="@Url.Action("EmployeeInformation", "Home")"><i class="material-icons">groups</i> Nhân sự phòng ban</a>
                        <a class="hrm-btn" href="@Url.Action("Approvals", "Home")"><i class="material-icons">fact_check</i> Phê duyệt</a>
                        <a class="hrm-btn" href="@Url.Action("WorkSchedules", "Home")"><i class="material-icons">event_note</i> Phân ca</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "kpi" })"><i class="material-icons">track_changes</i> KPI phòng ban</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "overtime" })"><i class="material-icons">more_time</i> Tăng ca</a>
                    }
                    else if (dashboardIsHr)
                    {
                        <a class="hrm-btn" href="@Url.Action("EmployeeInformation", "Home")"><i class="material-icons">groups</i> Quản lý nhân sự</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "kpi" })"><i class="material-icons">track_changes</i> Quản lý KPI</a>
                        <a class="hrm-btn" href="@Url.Action("Approvals", "Home")"><i class="material-icons">fact_check</i> Phê duyệt yêu cầu</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "payroll" })"><i class="material-icons">payments</i> Tính lương</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "recruitment" })"><i class="material-icons">person_search</i> Tuyển dụng</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "transfer" })"><i class="material-icons">swap_horiz</i> Điều chuyển</a>
                        <a class="hrm-btn" href="@Url.Action("Reports", "Home")"><i class="material-icons">analytics</i> Báo cáo</a>
                    }
                    else if (dashboardIsDirector)
                    {
                        <a class="hrm-btn" href="@Url.Action("Reports", "Home")"><i class="material-icons">analytics</i> Báo cáo điều hành</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "kpi" })"><i class="material-icons">track_changes</i> KPI toàn công ty</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "payroll" })"><i class="material-icons">approval</i> Duyệt bảng lương</a>
                        <a class="hrm-btn" href="@Url.Action("Approvals", "Home")"><i class="material-icons">fact_check</i> Phê duyệt</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "recruitment" })"><i class="material-icons">person_search</i> Tuyển dụng</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "transfer" })"><i class="material-icons">swap_horiz</i> Điều chuyển</a>
                    }
                    else if (dashboardIsAdmin)
                    {
                        <a class="hrm-btn" href="@Url.Action("EmployeeInformation", "Home")"><i class="material-icons">groups</i> Tài khoản nhân sự</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "kpi" })"><i class="material-icons">track_changes</i> Quản lý KPI</a>
                        <a class="hrm-btn" href="@Url.Action("Reports", "Home")"><i class="material-icons">analytics</i> Báo cáo</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "assets" })"><i class="material-icons">devices</i> Tài sản</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "helpdesk" })"><i class="material-icons">support_agent</i> Helpdesk IT</a>
                        <a class="hrm-btn" href="@Url.Action("Index", "Work", new { kind = "payroll" })"><i class="material-icons">payments</i> Bảng lương</a>
                        <a class="hrm-btn" href="@Url.Action("InternalCommunications", "Home")"><i class="material-icons">campaign</i> Truyền thông</a>
                    }
                </div>
            </div>
        </div>
        <div class="hrm-card">
            <div class="hrm-card-header"><div><h2 class="hrm-card-title">Bản tin nội bộ</h2><p class="hrm-card-subtitle">Tin tức dành cho toàn thể nhân viên</p></div></div>
            <div id="dashboardNews" class="hrm-card-body">
                <div class="hrm-empty" style="padding:22px 12px"><i class="material-icons">forum</i><strong>Chưa có thông báo mới</strong><br /><span>Các thông báo công ty và chính sách HR sẽ hiển thị tại đây.</span></div>
                <a class="hrm-btn" style="width:100%" href="@Url.Action("InternalCommunications", "Home")">Mở bảng tin nội bộ</a>
            </div>
        </div>
    </div>
    }
</div>
<script>
(function(){
    $('.home').addClass('active');var isEmployee=@dashboardIsEmployee.ToString().ToLowerInvariant();function esc(v){return $('<div>').text(v==null?'':v).html();}function statusLabel(v){var m={INSUFFICIENT_HOURS:'Chưa đủ giờ',ON_LEAVE:'Nghỉ đã duyệt',IN_PROGRESS:'Đang cập nhật',ON_TIME:'Đúng giờ',LATE:'Đi muộn',EARLY:'Về sớm',LATE_EARLY:'Muộn / về sớm',MISSING_CHECK:'Thiếu dữ liệu',MISSING_SCHEDULE:'Chưa có lịch'};return m[v]||v;}
    $.get('@Url.Action("Dashboard","Hrm")').done(function(r){var d=r.Data||{},a=d.AttendanceToday||[],personal=a.length?a[0]:null,total=d.TotalEmployees||0,present=d.PresentToday||0,mapped=Math.max(0,total-(d.UnmappedHanetUsers||0)),progress=total?Math.round(mapped*100/total):0;$('#dashboardEmployees').text(total);$('#dashboardPresent').text(present);$('#dashboardLate').text(d.LateOrEarlyToday||0);$('#dashboardPending').text(d.PendingApprovals||0);$('#dashboardOnTime').text(a.filter(function(x){return x.StatusCode==='ON_TIME';}).length);$('#dashboardLateMetric').text(d.LateOrEarlyToday||0);$('#dashboardRecorded').text(present);$('#dashboardMissing').text(Math.max(0,total-present-(d.OnLeaveToday||0)));$('#dashboardSyncText').text(progress+'%');$('#dashboardSyncProgress').css('width',progress+'%');if(isEmployee){$('#dashboardPersonalStatus').text(personal?statusLabel(personal.StatusCode):'Chưa chấm công');$('#dashboardPersonalCheckIn').text(personal&&personal.CheckIn?moment(personal.CheckIn).format('HH:mm'):'--:--');$('#dashboardPersonalCheckOut').text(personal&&personal.CheckOut?moment(personal.CheckOut).format('HH:mm'):'--:--');}if(a.length)$('#dashboardAttendance').html(a.map(function(x){return '<tr><td><strong>'+esc(x.DisplayName)+'</strong><small class="hrm-cell-note">'+esc(x.DepartmentName)+'</small></td><td>'+esc(x.ShiftName||'--')+'</td><td>'+(x.CheckIn?moment(x.CheckIn).format('HH:mm'):'--')+'</td><td>'+(x.CheckOut?moment(x.CheckOut).format('HH:mm'):'--')+'</td><td><span class="hrm-badge '+(x.StatusCode==='ON_TIME'?'hrm-badge-success':'hrm-badge-warning')+'">'+esc(statusLabel(x.StatusCode))+'</span></td></tr>';}).join(''));var news=d.Communications||[];if(news.length)$('#dashboardNews').html(news.map(function(x){return '<article style="padding:0 0 14px;margin-bottom:14px;border-bottom:1px solid #edf0f4"><strong>'+esc(x.Title)+'</strong><small class="hrm-cell-note">'+esc(x.AuthorName)+' · '+moment(x.PublishedAt).format('DD/MM HH:mm')+'</small></article>';}).join('')+'<a class="hrm-btn" style="width:100%" href="@Url.Action("InternalCommunications","Home")">Mở bảng tin nội bộ</a>');});
    if(isEmployee){$.get('@Url.Action("LeaveStats","Hrm")').done(function(r){var s=r.Data||{},remaining=Math.max(0,(s.AnnualAllowance||0)-(s.UsedDays||0));$('#dashboardLeaveRemainingSummary').text(remaining+' ngày');$('#dashboardPersonalLeave').text(remaining+' ngày');$('#dashboardPersonalLeaveUsed').text((s.UsedDays||0)+' ngày');$('#dashboardPersonalPending').text(s.PendingCount||0);$('#dashboardPersonalApproved').text(s.ApprovedCount||0);});$.get('@Url.Action("Schedules","Hrm")').done(function(r){var today=moment().startOf('day'),schedule=(r.Data||[]).filter(function(x){return !moment(x.EffectiveFrom).isAfter(today)&&(!x.EffectiveTo||!moment(x.EffectiveTo).isBefore(today));})[0];if(schedule)$('#dashboardPersonalShift').text(schedule.ShiftName+' · '+String(schedule.StartTime).substring(0,5)+'–'+String(schedule.EndTime).substring(0,5));});}
})();
</script>
