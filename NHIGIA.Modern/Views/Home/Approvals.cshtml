        </label>

        <select id="filterDepartment" class="tc-select" aria-label="Lọc theo phòng ban">
            <option value="">Tất cả phòng ban</option>
        </select>

        <select id="filterType" class="tc-select" aria-label="Lọc theo loại yêu cầu">
            <option value="">Tất cả loại nghỉ</option>
        </select>

        <div class="tc-date-group">
            <span>Từ</span>
            <input id="filterFromDate" type="date" class="tc-date-input" title="Từ ngày gửi đơn" />
            <span>đến</span>
            <input id="filterToDate" type="date" class="tc-date-input" title="Đến ngày gửi đơn" />
        </div>

        <button id="btnClearFilters" type="button" class="tc-clear-btn" title="Xóa bộ lọc">
            <i class="material-icons" style="font-size:16px;vertical-align:middle;">close</i> Xóa lọc
        </button>
    </div>

    <!-- Floating Bulk Action Bar -->
    <div id="tcBulkBar" class="tc-bulk-bar">
        <div class="tc-bulk-count">
            Đã chọn <strong id="tcBulkCountText">0</strong> yêu cầu
        </div>
        <div class="tc-bulk-actions">
            <button id="btnBulkDeselect" type="button" class="tc-btn">Bỏ chọn</button>
            @if (canManage)
            {
                <button id="btnBulkDelete" type="button" class="tc-btn" style="color:var(--tc-danger);border-color:var(--tc-danger-border);background:var(--tc-danger-bg);">
                    <i class="material-icons">delete</i> Xóa đã chọn
                </button>
            }
            <button id="btnBulkReject" type="button" class="tc-btn tc-btn-danger">
                <i class="material-icons">close</i> Từ chối đã chọn
            </button>
            <button id="btnBulkApprove" type="button" class="tc-btn tc-btn-success">
                <i class="material-icons">check</i> Chấp thuận đã chọn
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="tc-table-card">
        <div class="tc-table-wrap">
            <table class="tc-table">
                <thead>
                    <tr>
                        <th class="th-checkbox">
                            <input id="chkSelectAll" type="checkbox" class="tc-checkbox" title="Chọn tất cả" />
                        </th>
                        <th>Mã yêu cầu</th>
                        <th>Người yêu cầu</th>
                        <th>Loại yêu cầu</th>
                        <th>Thời gian áp dụng</th>
                        <th>Lý do</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;padding-right:20px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tcTableRows">
