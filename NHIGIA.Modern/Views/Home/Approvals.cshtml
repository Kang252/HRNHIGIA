                    var bg = idx % 2 === 0 ? '#ffffff' : '#f8fafc';
                    xlsContent += '<tr style="background:' + bg + ';height:30px;">';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:bold;color:#1769e0;">' + esc(x.RequestCode) + '</td>';
