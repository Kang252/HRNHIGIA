                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.DepartmentName || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:bold;">' + esc(x.LeaveType) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + fmtDate(x.StartDate) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + fmtDate(x.EndDate) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;font-weight:bold;">' + days + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + esc(x.SessionCode || 'Cả ngày') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.HandoverTo || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.Reason || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + fmtDateTime(x.CreatedAt) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + esc(getStatusLabel(x.StatusCode, x.RoleCode)) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.ManagerNote || x.HrNote || '') + '</td>';
                    xlsContent += '</tr>';
                });
            } else {
                xlsContent += '<tr><td colspan="' + headers.length + '" style="padding:16px;text-align:center;color:#667085;">Không có dữ liệu cho các loại yêu cầu đã chọn</td></tr>';
            }
            xlsContent += '\x3C/table\x3E\x3C/body\x3E\x3C/html\x3E';

            var blob = new Blob([xlsContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', fileName + '.xls');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else {
            var csvContent = '\uFEFF' + headers.join(',') + '\n';
            if (exportRows.length > 0) {
                exportRows.forEach(function (x) {
                    var days = calcDays(x.StartDate, x.EndDate);
                    var rowData = [
                        x.RequestCode,
                        x.DisplayName,
                        x.EmployeeCode || '',
                        x.DepartmentName || '',
                        x.LeaveType,
                        fmtDate(x.StartDate),
                        fmtDate(x.EndDate),
                        days,
                        x.SessionCode || 'Cả ngày',
                        x.HandoverTo || '',
                        (x.Reason || '').replace(/"/g, '""'),
                        fmtDateTime(x.CreatedAt),
                        getStatusLabel(x.StatusCode, x.RoleCode),
                        (x.ManagerNote || x.HrNote || '').replace(/"/g, '""')
                    ];
                    var quoted = rowData.map(function (val) {
                        return '"' + (val == null ? '' : String(val)) + '"';
                    });
                    csvContent += quoted.join(',') + '\n';
                });
            } else {
                csvContent += '"Thông báo: Không có dữ liệu phát sinh cho các loại yêu cầu đã chọn: ' + selectedTypes.join(', ') + '"\n';
            }

            var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', fileName + '.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        closeExportModal();
    }

