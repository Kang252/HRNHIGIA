    function performExport() {
        var selectedTypes = [];
        $('.exp-chk:checked').each(function () {
            selectedTypes.push($(this).val());
        });

        if (!selectedTypes.length) {
            alert('Vui lòng chọn ít nhất một loại yêu cầu để xuất file.');
            return;
        }

        var statusFilter = $('#exportStatusSelect').val();
        var from = $('#exportFromDate').val();
        var to = $('#exportToDate').val();

        // Filter records matching the export criteria
        var exportRows = records.filter(function (x) {
            var typeMatch = selectedTypes.indexOf(x.LeaveType) !== -1 || (x.LeaveType && selectedTypes.some(function(t) { return x.LeaveType.toLowerCase().indexOf(t.toLowerCase()) !== -1 || t.toLowerCase().indexOf(x.LeaveType.toLowerCase()) !== -1; }));
            if (!typeMatch && selectedTypes.indexOf('Nghỉ phép') !== -1) {
                typeMatch = true;
            }
            if (!typeMatch) return false;

            if (statusFilter === 'waiting') {
                if (x.StatusCode !== 'PENDING_MANAGER' && x.StatusCode !== 'PENDING_HR') return false;
            } else if (statusFilter === 'approved') {
                if (x.StatusCode !== 'APPROVED') return false;
            } else if (statusFilter === 'rejected') {
                if (x.StatusCode !== 'REJECTED') return false;
            }

            if (from) {
                if (moment(x.CreatedAt).isBefore(moment(from).startOf('day'))) return false;
            }
            if (to) {
                if (moment(x.CreatedAt).isAfter(moment(to).endOf('day'))) return false;
            }

            return true;
        });

        var headers = ['Mã yêu cầu', 'Nhân viên', 'Mã NV', 'Phòng ban', 'Loại yêu cầu', 'Từ ngày', 'Đến ngày', 'Số ngày', 'Buổi nghỉ', 'Người bàn giao', 'Lý do', 'Ngày gửi', 'Trạng thái', 'Ghi chú phê duyệt'];
        var format = $('#exportFormatSelect').val();
        var now = moment().format('YYYYMMDD_HHmm');
        var fileName = 'BaoCaoYeuCau_' + now;

