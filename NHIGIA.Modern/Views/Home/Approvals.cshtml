                        <td colspan="9">
                            <div class="tc-empty">
                                <i class="material-icons">hourglass_empty</i>
                                <h3>Đang tải dữ liệu...</h3>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="tc-table-footer">
            <div id="tcTableSummary">Đang tải...</div>
            <div style="display:flex;align-items:center;gap:12px;">
                <span id="tcTotalCountText"></span>
            </div>
        </div>
    </div>
</div>

<!-- Anti-forgery Token -->
<form id="tcTokenForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- RIGHT SLIDE-IN DRAWER (TANCA SIGNATURE) -->
<div id="tcDrawerBackdrop" class="tc-drawer-backdrop" aria-hidden="true"></div>

<aside id="tcDrawer" class="tc-drawer" aria-labelledby="drawerReqCode" role="dialog" aria-modal="true">
    <div class="tc-drawer-header">
        <div class="tc-drawer-title-box">
            <h2>Chi tiết yêu cầu</h2>
            <span id="drawerReqCode" class="tc-code-badge">#REQ</span>
            <span id="drawerReqStatus" class="tc-status waiting">Chờ duyệt</span>
        </div>
        <button id="tcDrawerClose" type="button" class="tc-drawer-close" aria-label="Đóng chi tiết">
            <i class="material-icons">close</i>
        </button>
    </div>

    <div class="tc-drawer-body">
        <!-- Requester Profile -->
        <div class="tc-drawer-profile">
            <div id="drawerAvatar" class="tc-drawer-avatar">NG</div>
            <div class="tc-drawer-user-info">
                <h3 id="drawerUserName">—</h3>
                <p id="drawerUserSub">—</p>
                <div id="drawerUserContact" style="font-size:12px;color:#667085;margin-top:4px;"></div>
            </div>
        </div>

        <!-- Detail Info -->
        <h4 class="tc-section-title">Thông tin đề xuất</h4>
        <dl class="tc-detail-grid">
            <dt>Loại yêu cầu</dt>
            <dd id="drawerLeaveType">—</dd>

            <dt>Khoảng thời gian</dt>
            <dd id="drawerTimeRange">—</dd>

            <dt>Tổng thời gian</dt>
            <dd id="drawerDuration">—</dd>

            <dt>Buổi nghỉ</dt>
            <dd id="drawerSession">—</dd>

            <dt>Người bàn giao</dt>
            <dd id="drawerHandover">—</dd>

            <dt>Tệp đính kèm</dt>
            <dd id="drawerAttachment">—</dd>
        </dl>

        <h4 class="tc-section-title">Lý do đề xuất</h4>
        <div id="drawerReason" class="tc-reason-box" style="margin-bottom:24px;">—</div>

        <!-- Approval Workflow Timeline -->
        <h4 class="tc-section-title">Tiến trình phê duyệt</h4>
        <div class="tc-workflow">
            <!-- Step 1: Request Created -->
            <div class="tc-step-item is-done">
                <span class="tc-step-icon"><i class="material-icons" style="font-size:14px;">check</i></span>
                <div class="tc-step-title">Nhân viên gửi yêu cầu</div>
                <div id="step1Info" class="tc-step-sub">—</div>
            </div>

            <!-- Step 2: Manager Approval -->
            <div id="step2Item" class="tc-step-item">
                <span id="step2Icon" class="tc-step-icon"><i class="material-icons" style="font-size:14px;">schedule</i></span>
                <div id="step2Title" class="tc-step-title">Trưởng phòng phê duyệt</div>
                <div id="step2Info" class="tc-step-sub">Chờ xác nhận</div>
                <div id="step2Note" class="tc-step-note" style="display:none;"></div>
            </div>
        </div>

        <!-- Approval Action Box -->
        <div id="drawerActionBox" class="tc-drawer-action-box">
            <label for="drawerNoteInput">Ghi chú xử lý / Lý do từ chối:</label>
            <textarea id="drawerNoteInput" class="tc-drawer-note" maxlength="1000" placeholder="Nhập ý kiến phản hồi hoặc lý do từ chối đơn..."></textarea>
            
            <div class="tc-action-btn-row">
                <button id="btnDrawerReject" type="button" class="tc-btn tc-btn-danger">
                    <i class="material-icons">close</i> Từ chối
                </button>
                <button id="btnDrawerApprove" type="button" class="tc-btn tc-btn-success">
                    <i class="material-icons">check</i> Chấp thuận
                </button>
            </div>
        </div>

        <div id="drawerNoticeBox" style="display:none;padding:12px 14px;border-radius:8px;margin-top:16px;font-size:13.5px;"></div>
    </div>

    <div class="tc-drawer-footer">
        <button id="tcPrintBtn" type="button" class="tc-btn" title="In phiếu yêu cầu">
            <i class="material-icons">print</i> In đơn
        </button>
        @if (canManage)
        {
            <button id="btnDrawerDelete" type="button" class="tc-btn" style="color:var(--tc-danger);border-color:var(--tc-danger-border);background:var(--tc-danger-bg);" title="Xóa yêu cầu này">
                <i class="material-icons">delete</i> Xóa đơn
            </button>
        }
        <button id="tcDrawerCloseBtn" type="button" class="tc-btn tc-btn-primary">
            Đóng
        </button>
    </div>
</aside>

