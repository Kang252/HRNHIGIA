<script>
(function () {
    var managerStage = @managerStage.ToString().ToLowerInvariant();
    var canManage = @canManage.ToString().ToLowerInvariant();
    var currentDisplayName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(current?.DisplayName ?? "Tôi"));
    var currentUserId = @(current?.Id ?? 0);
    var roleCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleCode));
    var records = [];
    var selectedRecord = null;
    var checkedIds = new Set();

    var AVATAR_PALETTE = [
        { bg: '#EBF4FF', color: '#1769E0' },
        { bg: '#ECFDF3', color: '#027A48' },
        { bg: '#FFFAEB', color: '#B54708' },
        { bg: '#FEF3F2', color: '#B42318' },
        { bg: '#FDF2FA', color: '#C11574' },
        { bg: '#F0FDF9', color: '#0E9384' },
        { bg: '#F8F9FC', color: '#363F72' }
    ];

    function esc(v) {
        return HrmRequestForm.escapeHtml(v);
    }

    function getInitials(name) {
        if (!name) return 'NV';
        var parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function getAvatarStyle(name) {
        if (!name) return AVATAR_PALETTE[0];
        var hash = 0;
        for (var i = 0; i < name.length; i++) {
            hash = (hash << 5) - hash + name.charCodeAt(i);
            hash |= 0;
        }
        var idx = Math.abs(hash) % AVATAR_PALETTE.length;
        return AVATAR_PALETTE[idx];
    }

    function fmtDate(v) {
        return v ? moment(v).format('DD/MM/YYYY') : '—';
    }

    function fmtDateTime(v) {
        return v ? moment(v).format('DD/MM/YYYY HH:mm') : '—';
    }

    function calcDays(start, end) {
        if (!start || !end) return 1;
        var s = moment(start).startOf('day');
        var e = moment(end).startOf('day');
        return Math.max(1, e.diff(s, 'days') + 1);
    }

    function getStatusLabel(s, requesterRole) {
        switch (s) {
            case 'PENDING_MANAGER':
            case 'PENDING_HR':
                return (requesterRole === 'MANAGER') ? 'Chờ Giám đốc duyệt' : 'Chờ Trưởng phòng duyệt';
            case 'APPROVED': return 'Chấp thuận';
            case 'REJECTED': return 'Từ chối';
            case 'CANCELLED': return 'Đã hủy';
            default: return s || 'Chờ duyệt';
        }
    }

    function getStatusCss(s) {
        switch (s) {
            case 'APPROVED': return 'approved';
            case 'REJECTED': return 'rejected';
            case 'CANCELLED': return 'cancelled';
            default: return 'waiting';
        }
    }

    function canUserApprove(x) {
        return HrmRequestForm.canApprove(x, roleCode, currentUserId, @(current?.DepartmentId ?? 0));
    }

    /* URL Hash Navigation: #filter?req_id=&req_sta=waiting */
    function parseHash() {
        var hash = window.location.hash || '';
        var params = { req_id: '', req_sta: 'waiting' };
        if (hash.indexOf('#filter?') === 0) {
            var q = hash.substring(8);
            var pairs = q.split('&');
            for (var i = 0; i < pairs.length; i++) {
                var p = pairs[i].split('=');
                if (p.length === 2) {
                    params[decodeURIComponent(p[0])] = decodeURIComponent(p[1]);
                }
            }
        }
        return params;
    }

    function updateHash() {
        var activeTab = $('.tc-tab-item.active').data('status') || 'waiting';
        var searchVal = $('#filterSearch').val().trim();
        var newHash = '#filter?req_id=' + encodeURIComponent(searchVal) + '&req_sta=' + encodeURIComponent(activeTab);
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', newHash);
        } else {
            window.location.hash = newHash;
        }
    }

    function applyHashParams() {
        var p = parseHash();
        if (p.req_sta) {
            $('.tc-tab-item').removeClass('active');
            var matchTab = $('.tc-tab-item[data-status="' + p.req_sta + '"]');
            if (matchTab.length) {
                matchTab.addClass('active');
            } else {
                $('.tc-tab-item[data-status="waiting"]').addClass('active');
            }
        }
        if (p.req_id && !$('#filterSearch').val()) {
            $('#filterSearch').val(p.req_id);
        }
    }

    /* Filter & Render */
    function getFilteredList() {
        var tab = $('.tc-tab-item.active').data('status') || 'waiting';
        var search = $('#filterSearch').val().trim().toLowerCase();
        var dept = $('#filterDepartment').val();
        var type = $('#filterType').val();
        var from = $('#filterFromDate').val();
        var to = $('#filterToDate').val();

        var isFiltering = !!(search || dept || type || from || to);
        $('#btnClearFilters').toggle(isFiltering);

        return records.filter(function (x) {
            // Status Tab Filtering
            if (tab === 'waiting') {
                if (x.StatusCode !== 'PENDING_MANAGER' && x.StatusCode !== 'PENDING_HR') return false;
            } else if (tab === 'approved') {
                if (x.StatusCode !== 'APPROVED') return false;
            } else if (tab === 'rejected') {
                if (x.StatusCode !== 'REJECTED') return false;
            }

            // Department
            if (dept && (x.DepartmentName || '') !== dept) return false;

            // Leave Type
            if (type && x.LeaveType !== type) return false;

            // Date Range (CreatedAt)
            if (from) {
                var dStart = moment(x.CreatedAt).startOf('day');
                if (dStart.isBefore(moment(from).startOf('day'))) return false;
            }
            if (to) {
                var dEnd = moment(x.CreatedAt).startOf('day');
                if (dEnd.isAfter(moment(to).startOf('day'))) return false;
            }

            // Text search
            if (search) {
                var text = [
                    x.RequestCode,
                    x.DisplayName,
                    x.DepartmentName,
                    x.EmployeeCode,
                    x.LeaveType,
                    x.Reason,
                    x.HandoverTo
                ].join(' ').toLowerCase();
                if (text.indexOf(search) === -1) return false;
            }

            return true;
        });
    }

    function updateBadges() {
        var waiting = records.filter(function (x) {
            return x.StatusCode === 'PENDING_MANAGER' || x.StatusCode === 'PENDING_HR';
        }).length;
        var approved = records.filter(function (x) { return x.StatusCode === 'APPROVED'; }).length;
        var rejected = records.filter(function (x) { return x.StatusCode === 'REJECTED'; }).length;

        $('#badgeWaiting').text(waiting);
        $('#badgeApproved').text(approved);
        $('#badgeRejected').text(rejected);
        $('#badgeAll').text(records.length);
    }

    function updateBulkBar() {
        var count = checkedIds.size;
        if (count > 0) {
            $('#tcBulkCountText').text(count);
            $('#tcBulkBar').css('display', 'flex');
        } else {
            $('#tcBulkBar').hide();
        }
        var currentFiltered = getFilteredList();
        var currentManageable = currentFiltered.filter(function (x) { return canManage || canUserApprove(x); });
        var allChecked = currentManageable.length > 0 && currentManageable.every(function (x) { return checkedIds.has(x.Id); });
        $('#chkSelectAll').prop('checked', allChecked);
    }

    function render() {
        try {
            var tab = $('.tc-tab-item.active').data('status') || 'waiting';
            var rows = getFilteredList();
            updateBadges();
            updateBulkBar();

            $('#tcTableSummary').text('Hiển thị ' + rows.length + ' / ' + records.length + ' yêu cầu');
            $('#tcTotalCountText').text(rows.length ? 'Tổng ' + rows.length + ' mục' : '');

            if (!rows.length) {
                var isWaiting = tab === 'waiting';
                var emptyHtml = '<div class="tc-empty">' +
                    '<i class="material-icons">inbox</i>' +
                    '<h3>' + (isWaiting ? 'Không có yêu cầu nào đang chờ duyệt' : 'Không tìm thấy yêu cầu phù hợp') + '</h3>' +
                    '<p>' + (isWaiting ? 'Hiện tại không có yêu cầu nào đang chờ bạn phê duyệt.' : 'Hãy thử thay đổi từ khóa hoặc tiêu chí bộ lọc.') + '</p>' +
                    '</div>';
                $('#tcTableRows').html('<tr><td colspan="9">' + emptyHtml + '</td></tr>');
                return;
            }

            var html = rows.map(function (x) {
                var isChecked = checkedIds.has(x.Id);
                var canApprove = canUserApprove(x);
                var av = getAvatarStyle(x.DisplayName);
                var days = calcDays(x.StartDate, x.EndDate);

                return '<tr class="tc-row ' + (isChecked ? 'is-selected' : '') + '" data-id="' + x.Id + '">' +
                    '<td class="td-checkbox">' +
                        ((canManage || canApprove)
                            ? '<input type="checkbox" class="tc-checkbox row-chk" data-id="' + x.Id + '" ' + (isChecked ? 'checked' : '') + ' />'
                            : '<span style="display:inline-block;width:18px;"></span>') +
                    '</td>' +
                    '<td>' +
                        '<a href="javascript:void(0)" class="tc-code-badge open-detail" data-id="' + x.Id + '">#' + esc(x.RequestCode) + '</a>' +
                    '</td>' +
                    '<td>' +
                        '<div class="tc-user-cell">' +
                            '<div class="tc-avatar" style="background:' + av.bg + ';color:' + av.color + ';">' + esc(getInitials(x.DisplayName)) + '</div>' +
                            '<div>' +
                                '<span class="tc-user-name">' + esc(x.DisplayName) + '</span>' +
                                '<span class="tc-user-sub">' + esc(x.EmployeeCode ? x.EmployeeCode + ' · ' : '') + esc(x.DepartmentName || 'Chưa phân phòng') + '</span>' +
                            '</div>' +
                        '</div>' +
                    '</td>' +
                    '<td><span class="tc-type-tag">' + esc(x.LeaveType) + '</span></td>' +
                    '<td>' +
                        '<div class="tc-date-range">' +
                            '<strong>' + fmtDate(x.StartDate) + ' — ' + fmtDate(x.EndDate) + '</strong>' +
                            '<span>' + days + ' ngày · ' + esc(x.SessionCode || 'Cả ngày') + '</span>' +
                        '</div>' +
                    '</td>' +
                    '<td><div class="tc-reason-text" title="' + esc(x.Reason) + '">' + esc(x.Reason || '—') + '</div></td>' +
                    '<td>' + fmtDateTime(x.CreatedAt) + '</td>' +
                    '<td><span class="tc-status ' + getStatusCss(x.StatusCode) + '">' + esc(getStatusLabel(x.StatusCode, x.RoleCode)) + '</span></td>' +
                    '<td style="text-align:right;padding-right:20px;">' +
                        '<div class="tc-action-group">' +
                            (canApprove ? '<button type="button" class="tc-row-btn btn-quick-approve" data-id="' + x.Id + '" title="Chấp thuận nhanh"><i class="material-icons">check</i></button>' : '') +
                            (canApprove ? '<button type="button" class="tc-row-btn btn-quick-reject" data-id="' + x.Id + '" title="Từ chối nhanh"><i class="material-icons">close</i></button>' : '') +
                            (canManage ? '<button type="button" class="tc-row-btn btn-quick-delete" data-id="' + x.Id + '" title="Xóa yêu cầu" style="color:var(--tc-danger);"><i class="material-icons">delete_outline</i></button>' : '') +
                            '<button type="button" class="tc-row-btn open-detail" data-id="' + x.Id + '" title="Xem chi tiết đơn"><i class="material-icons">arrow_forward</i></button>' +
                        '</div>' +
                    '</td>' +
                '</tr>';
            }).join('');

            $('#tcTableRows').html(html);
        } catch (err) {
            console.error('Lỗi khi hiển thị bảng yêu cầu:', err);
            $('#tcTableRows').html(
                '<tr><td colspan="9"><div class="tc-empty" style="color:var(--tc-danger);">' +
                '<i class="material-icons" style="color:var(--tc-danger);">error_outline</i>' +
                '<h3>Đã xảy ra lỗi khi hiển thị dữ liệu</h3>' +
                '<p>' + esc(err && err.message ? err.message : 'Vui lòng làm mới lại trang.') + '</p>' +
                '</div></td></tr>'
            );
        }
    }

    window.addEventListener('hrm-approvals-changed', function () { loadData(true); });
    function loadData(fromInbox) {
        if (!fromInbox) window.dispatchEvent(new Event('hrm-procedures-changed'));
        $.get('@Url.Action("LeaveRequests", "Hrm")').done(function (res) {
            records = res.Data || [];

            // Populate unique departments
            var currentDept = $('#filterDepartment').val();
            var depts = [...new Set(records.map(function (x) { return x.DepartmentName; }).filter(Boolean))].sort();
            var deptOptions = '<option value="">Tất cả phòng ban</option>' + depts.map(function (d) {
                return '<option value="' + esc(d) + '">' + esc(d) + '</option>';
            }).join('');
            $('#filterDepartment').html(deptOptions).val(currentDept);

            // Populate unique leave types
            var currentType = $('#filterType').val();
            var types = [...new Set(records.map(function (x) { return x.LeaveType; }).filter(Boolean))].sort();
            var typeOptions = '<option value="">Tất cả loại nghỉ</option>' + types.map(function (t) {
                return '<option value="' + esc(t) + '">' + esc(t) + '</option>';
            }).join('');
            $('#filterType').html(typeOptions).val(currentType);

            render();

            // Check if selected drawer is open and update it
            if (selectedRecord) {
                var updated = records.find(function (x) { return x.Id === selectedRecord.Id; });
                if (updated) openDrawer(updated.Id);
            }
        }).fail(function () {
            $('#tcTableRows').html(
                '<tr><td colspan="9"><div class="tc-empty" style="color:var(--tc-danger);">' +
                '<i class="material-icons" style="color:var(--tc-danger);">error_outline</i>' +
                '<h3>Không thể tải dữ liệu yêu cầu</h3>' +
                '<p>Vui lòng thử bấm nút "Làm mới" hoặc liên hệ quản trị viên.</p>' +
                '</div></td></tr>'
            );
        });
    }

    /* Right Slide-in Drawer */
    function openDrawer(id) {
        var x = records.find(function (r) { return r.Id === id; });
        if (!x) return;
        selectedRecord = x;

        var av = getAvatarStyle(x.DisplayName);
        var days = calcDays(x.StartDate, x.EndDate);
        var canApprove = canUserApprove(x);

        $('#drawerReqCode').text('#' + x.RequestCode);
        $('#drawerReqStatus')
            .removeClass('waiting approved rejected cancelled')
            .addClass(getStatusCss(x.StatusCode))
            .text(getStatusLabel(x.StatusCode, x.RoleCode));

        $('#drawerAvatar').css({ background: av.bg, color: av.color }).text(getInitials(x.DisplayName));
        $('#drawerUserName').text(x.DisplayName || 'Chưa có tên');
        $('#drawerUserSub').text((x.JobTitle ? x.JobTitle + ' · ' : '') + (x.DepartmentName || 'Chưa phân phòng'));

        var contact = [];
        if (x.EmployeeCode) contact.push('Mã NV: ' + x.EmployeeCode);
        if (x.CompanyEmail) contact.push(x.CompanyEmail);
        if (x.MobilePhone) contact.push(x.MobilePhone);
        $('#drawerUserContact').text(contact.join(' · '));

        $('#drawerLeaveType').text(x.LeaveType);
        $('#drawerTimeRange').text(fmtDate(x.StartDate) + ' — ' + fmtDate(x.EndDate));
        $('#drawerDuration').text(days + ' ngày');
        $('#drawerSession').text(x.SessionCode || 'Cả ngày');
        $('#drawerHandover').text(x.HandoverTo || 'Không có');
        $('#drawerAttachment').html(x.HasAttachment
            ? '<a href="@Url.Action("LeaveAttachment", "Hrm")?id=' + Number(x.Id) + '" target="_blank" rel="noopener">' + esc(x.AttachmentName || 'Tải tệp đính kèm') + '</a>'
            : '<span>' + esc(x.AttachmentName ? x.AttachmentName + ' · Tệp cũ chưa lưu nội dung' : 'Không có') + '</span>');
        $('#drawerReason').text(x.Reason || 'Không có lý do');

        // Timeline Step 1
        $('#step1Info').text('Gửi lúc ' + fmtDateTime(x.CreatedAt) + ' bởi ' + (x.DisplayName || 'Nhân viên'));

        var isManagerRequester = (x.RoleCode === 'MANAGER');
        var approverTitle = isManagerRequester ? 'Giám đốc' : 'Trưởng phòng';
        // Timeline Step 2: Trưởng phòng/Giám đốc phê duyệt
        $('#step2Title').text(approverTitle + ' phê duyệt');
        var s2 = $('#step2Item').removeClass('is-done is-current is-rejected');
        $('#step2Note').hide().text('');
        if (x.StatusCode === 'PENDING_MANAGER' || x.StatusCode === 'PENDING_HR') {
            s2.addClass('is-current');
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">hourglass_top</i>');
            $('#step2Info').text('Đang chờ ' + approverTitle + ' xem xét & phê duyệt');
        } else if (x.StatusCode === 'APPROVED') {
            s2.addClass('is-done');
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">check</i>');
            var approverName = x.ManagerName || x.HrName;
            $('#step2Info').text(approverTitle + ' đã phê duyệt' + (approverName ? ' (' + approverName + ')' : ''));
            var note = x.ManagerNote || x.HrNote;
            if (note) $('#step2Note').show().text('Ghi chú: ' + note);
        } else if (x.StatusCode === 'REJECTED') {
            s2.addClass('is-rejected');
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">close</i>');
            var rejecterName = x.ManagerName || x.HrName;
            $('#step2Info').text(approverTitle + ' đã từ chối' + (rejecterName ? ' (' + rejecterName + ')' : ''));
            var rNote = x.ManagerNote || x.HrNote;
            if (rNote) $('#step2Note').show().text('Lý do: ' + rNote);
        } else if (x.StatusCode === 'CANCELLED') {
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">cancel</i>');
            $('#step2Info').text('Người gửi đã hủy yêu cầu này');
        } else {
            $('#step2Info').text(getStatusLabel(x.StatusCode, x.RoleCode));
        }

        // Action Box
        $('#drawerNoteInput').val('');
        if (canApprove) {
            $('#drawerActionBox').show();
            $('#drawerNoticeBox').hide();
        } else {
            $('#drawerActionBox').hide();
            $('#drawerNoticeBox').show();
            if (x.UserId === currentUserId) {
                $('#drawerNoticeBox')
                    .css({ background: '#f8f9fa', color: '#475467', border: '1px solid #eaecf0' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">info</i> Đây là yêu cầu của bạn. Bạn không thể tự phê duyệt.');
            } else if (x.StatusCode === 'APPROVED') {
                $('#drawerNoticeBox')
                    .css({ background: 'var(--tc-success-bg)', color: 'var(--tc-success)', border: '1px solid var(--tc-success-border)' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">check_circle</i> Yêu cầu này đã được phê duyệt hoàn tất.');
            } else if (x.StatusCode === 'REJECTED') {
                $('#drawerNoticeBox')
                    .css({ background: 'var(--tc-danger-bg)', color: 'var(--tc-danger)', border: '1px solid var(--tc-danger-border)' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">cancel</i> Yêu cầu này đã bị từ chối.');
            } else {
                $('#drawerNoticeBox')
                    .css({ background: '#f8f9fa', color: '#475467', border: '1px solid #eaecf0' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">info</i> Bạn chỉ có quyền xem, không có quyền phê duyệt.');
            }
        }

        $('#tcDrawerBackdrop').addClass('is-open');
        $('#tcDrawer').addClass('is-open');
    }

    function closeDrawer() {
        $('#tcDrawer').removeClass('is-open');
        $('#tcDrawerBackdrop').removeClass('is-open');
        selectedRecord = null;
    }

    /* Toast Notifications */
    function showToast(msg, type) {
        var icon = type === 'success' ? 'check_circle' : (type === 'danger' ? 'error' : 'info');
        var color = type === 'success' ? 'var(--tc-success)' : (type === 'danger' ? 'var(--tc-danger)' : 'var(--tc-primary)');
        var toast = $(
            '<div class="tc-toast ' + (type || 'info') + '">' +
            '<i class="material-icons" style="font-size:18px;color:' + color + ';">' + icon + '</i>' +
            '<span>' + esc(msg) + '</span>' +
            '</div>'
        );
        $('#tcToastContainer').append(toast);
        setTimeout(function () { toast.addClass('is-visible'); }, 20);
        setTimeout(function () {
            toast.removeClass('is-visible');
            setTimeout(function () { toast.remove(); }, 300);
        }, 3200);
    }

    /* Decide / Approve API Call */
    function decide(id, ok, note, onSuccess) {
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        var item = records.find(function (r) { return r.Id === id; });
        var code = item ? ('#' + item.RequestCode) : ('yêu cầu #' + id);
        $.post('@Url.Action("ApproveLeave", "Hrm")', {
            __RequestVerificationToken: token,
            Id: id,
            Approve: ok,
            Note: note || ''
        }).done(function () {
            showToast('Đã ' + (ok ? 'chấp thuận' : 'từ chối') + ' ' + code + ' thành công!', ok ? 'success' : 'danger');
            if (onSuccess) onSuccess();
            loadData();
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Không thể xử lý yêu cầu.';
            showToast(msg, 'danger');
            alert(msg);
        });
    }

    function bulkDecide(ids, ok, note) {
        if (!ids || !ids.length) return;
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("BulkApproveLeave", "Hrm")',
            type: 'POST',
            traditional: true,
            data: {
                __RequestVerificationToken: token,
                Ids: ids,
                Approve: ok,
                Note: note || ''
            }
        }).done(function (res) {
            var cnt = (res.Data && res.Data.Count) || ids.length;
            checkedIds.clear();
            updateBulkBar();
            loadData();
            showToast('Đã ' + (ok ? 'chấp thuận' : 'từ chối') + ' thành công ' + cnt + ' yêu cầu!', ok ? 'success' : 'danger');
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Xử lý hàng loạt thất bại.';
            showToast(msg, 'danger');
            alert(msg);
        });
    }

    function deleteLeave(id, onSuccess) {
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        var item = records.find(function (r) { return r.Id === id; });
        var code = item ? ('#' + item.RequestCode) : ('yêu cầu #' + id);
        $.post('@Url.Action("DeleteLeave", "Hrm")', {
            __RequestVerificationToken: token,
            id: id
        }).done(function () {
            showToast('Đã xóa ' + code + ' thành công!', 'info');
            if (onSuccess) onSuccess();
            loadData();
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Không thể xóa yêu cầu này.';
            showToast(msg, 'danger');
        });
    }

    function bulkDeleteLeaves(ids) {
        if (!ids || !ids.length) return;
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("BulkDeleteLeave", "Hrm")',
            type: 'POST',
            traditional: true,
            data: {
                __RequestVerificationToken: token,
                Ids: ids
            }
        }).done(function (res) {
            var cnt = (res.Data && res.Data.Count) || ids.length;
            checkedIds.clear();
            updateBulkBar();
            loadData();
            showToast('Đã xóa thành công ' + cnt + ' yêu cầu!', 'info');
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Xóa hàng loạt thất bại.';
            showToast(msg, 'danger');
            alert(msg);
        });
    }

