@using NHIGIA.Modern.Models
@{
    ViewBag.Title = "Phê duyệt yêu cầu";
    var current = HrmUser.Current;
    var managerStage = false; // Trưởng phòng được cấp quyền phê duyệt toàn quyền y chang Giám đốc
    var roleCode = current?.RoleCode ?? "";
    var canManage = HrmRoles.CanManagePeople(roleCode);
}

<style>
/* ==========================================================================
   TANCA STYLE APPROVALS PAGE (app.tanca.io/personnel/request)
   ========================================================================== */

:root {
    --tc-primary: #1769e0;
    --tc-primary-hover: #0f52b8;
    --tc-primary-light: #eaf2ff;
    --tc-text-main: #1d2939;
    --tc-text-muted: #667085;
    --tc-text-light: #98a2b3;
    --tc-border: #eaecf0;
    --tc-border-subtle: #f2f4f7;
    --tc-bg-page: #f8f9fa;
    --tc-bg-card: #ffffff;
    --tc-success: #027a48;
    --tc-success-bg: #ecfdf3;
    --tc-success-border: #a6f4c5;
    --tc-warning: #b54708;
    --tc-warning-bg: #fffaeb;
    --tc-warning-border: #fedf89;
    --tc-danger: #b42318;
    --tc-danger-bg: #fef3f2;
    --tc-danger-border: #fecdca;
    --tc-neutral: #344054;
    --tc-neutral-bg: #f2f4f7;
}

.tc-app-wrap {
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 4px 40px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--tc-text-main);
}

/* Page Header */
.tc-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
}
.tc-page-header h1 {
    font-size: 26px;
    font-weight: 700;
    color: #101828;
    margin: 0 0 6px 0;
    letter-spacing: -0.02em;
}
.tc-page-header p {
    margin: 0;
    font-size: 14px;
    color: var(--tc-text-muted);
}
.tc-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}
.tc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 38px;
    padding: 0 14px;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 8px;
    border: 1px solid var(--tc-border);
    background: #fff;
    color: var(--tc-neutral);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    text-decoration: none !important;
}
.tc-btn:hover {
    background: #f9fafb;
    border-color: #d0d5dd;
    color: #1d2939;
}
.tc-btn .material-icons {
    font-size: 18px;
}
.tc-btn-primary {
    background: var(--tc-primary);
    border-color: var(--tc-primary);
    color: #fff;
}
.tc-btn-primary:hover {
    background: var(--tc-primary-hover);
    border-color: var(--tc-primary-hover);
    color: #fff;
}
.tc-btn-danger {
    background: #fff;
    border-color: var(--tc-danger-border);
    color: var(--tc-danger);
}
.tc-btn-danger:hover {
    background: var(--tc-danger-bg);
    border-color: var(--tc-danger);
}
.tc-btn-success {
    background: var(--tc-success);
    border-color: var(--tc-success);
    color: #fff;
}
.tc-btn-success:hover {
    background: #05603a;
    border-color: #05603a;
    color: #fff;
}

/* Status Tabs (Tanca style: #filter?req_id=&req_sta=waiting) */
.tc-tabs-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid var(--tc-border);
    margin-bottom: 16px;
    overflow-x: auto;
    scrollbar-width: none;
}
.tc-tabs-bar::-webkit-scrollbar { display: none; }
.tc-tab-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--tc-text-muted);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
}
.tc-tab-item:hover {
    color: var(--tc-primary);
}
.tc-tab-item.active {
    color: var(--tc-primary);
    border-bottom-color: var(--tc-primary);
}
.tc-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 20px;
    padding: 0 6px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 99px;
    background: #f2f4f7;
    color: #344054;
}
.tc-tab-item.active .tc-tab-badge {
    background: var(--tc-primary-light);
    color: var(--tc-primary);
}
.tc-tab-item[data-status="waiting"] .tc-tab-badge {
    background: var(--tc-warning-bg);
    color: var(--tc-warning);
}
.tc-tab-item.active[data-status="waiting"] .tc-tab-badge {
    background: #fef0c7;
    color: #93370d;
}

/* Filter Toolbar */
.tc-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    background: #fff;
    padding: 12px 16px;
    border: 1px solid var(--tc-border);
    border-radius: 10px;
    margin-bottom: 16px;
}
.tc-search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1 1 260px;
    min-width: 220px;
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--tc-border);
    border-radius: 8px;
    background: #fff;
    color: var(--tc-text-light);
    transition: border-color 0.15s ease;
}
.tc-search-box:focus-within {
    border-color: var(--tc-primary);
    box-shadow: 0 0 0 3px rgba(23,105,224,0.12);
}
.tc-search-box input {
    width: 100%;
    border: 0;
    outline: 0;
    font-size: 13.5px;
    color: var(--tc-text-main);
    background: transparent;
}
.tc-search-box input::placeholder {
    color: #98a2b3;
}
.tc-select {
    height: 38px;
    padding: 0 10px;
    font-size: 13.5px;
    color: var(--tc-text-main);
    background: #fff;
    border: 1px solid var(--tc-border);
    border-radius: 8px;
    outline: 0;
    min-width: 150px;
    cursor: pointer;
    transition: border-color 0.15s ease;
}
.tc-select:focus {
    border-color: var(--tc-primary);
}
.tc-date-input {
    height: 38px;
    padding: 0 10px;
    font-size: 13px;
    color: var(--tc-text-main);
    background: #fff;
    border: 1px solid var(--tc-border);
    border-radius: 8px;
    outline: 0;
}
.tc-date-group {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--tc-text-muted);
}
.tc-clear-btn {
    height: 38px;
    padding: 0 10px;
    font-size: 13px;
    color: var(--tc-text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    display: none;
}
.tc-clear-btn:hover {
    color: var(--tc-danger);
}

/* Floating Bulk Action Bar */
.tc-bulk-bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 18px;
    background: #1e293b;
    color: #fff;
    border-radius: 10px;
    margin-bottom: 16px;
    box-shadow: 0 8px 24px rgba(15,23,42,0.18);
    animation: slideDown 0.2s ease-out;
}
@@keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}
.tc-bulk-count {
    font-size: 13.5px;
    font-weight: 500;
}
.tc-bulk-count strong {
    color: #38bdf8;
}
.tc-bulk-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}
.tc-bulk-actions .tc-btn {
    height: 32px;
    font-size: 12.5px;
    padding: 0 12px;
}

/* Table Card */
.tc-table-card {
    background: #fff;
    border: 1px solid var(--tc-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(16,24,40,0.04);
}
.tc-table-wrap {
    overflow-x: auto;
    min-height: 280px;
}
.tc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
}
.tc-table thead th {
    background: #f8fafc;
    color: #475467;
    font-weight: 600;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 12px 14px;
    border-bottom: 1px solid var(--tc-border);
    white-space: nowrap;
    text-align: left;
}
.tc-table thead th.th-checkbox,
.tc-table tbody td.td-checkbox {
    width: 44px;
    text-align: center;
    padding: 12px 6px 12px 14px;
}
.tc-table tbody tr {
    border-bottom: 1px solid var(--tc-border);
    transition: background 0.12s ease;
    cursor: pointer;
}
.tc-table tbody tr:hover {
    background: #f8fafc;
}
.tc-table tbody tr.is-selected {
    background: #f0f7ff;
}
.tc-table tbody td {
    padding: 14px;
    vertical-align: middle;
    color: #344054;
}

/* Custom Checkbox */
.tc-checkbox {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    cursor: pointer;
    accent-color: var(--tc-primary);
}

/* Table Cells */
.tc-code-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--tc-primary);
    background: var(--tc-primary-light);
    border-radius: 6px;
    text-decoration: none !important;
}
.tc-code-badge:hover {
    background: #dbeafe;
}
.tc-user-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}
.tc-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-weight: 700;
    font-size: 13px;
    flex: 0 0 36px;
    text-transform: uppercase;
}
.tc-user-cell .tc-user-name {
    font-weight: 600;
    color: #101828;
    display: block;
    line-height: 1.3;
}
.tc-user-cell .tc-user-sub {
    font-size: 12px;
    color: var(--tc-text-muted);
    display: block;
    margin-top: 2px;
}
.tc-type-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 9px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    background: #f2f4f7;
    color: #344054;
    white-space: nowrap;
}
.tc-date-range {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.tc-date-range strong {
    font-size: 13px;
    font-weight: 600;
    color: #1d2939;
}
.tc-date-range span {
    font-size: 11.5px;
    color: var(--tc-text-muted);
}
.tc-reason-text {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #475467;
}

/* Status Badges (Tanca style) */
.tc-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}
.tc-status::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
}
.tc-status.waiting {
    background: var(--tc-warning-bg);
    color: var(--tc-warning);
    border: 1px solid var(--tc-warning-border);
}
.tc-status.waiting::before { background: #f79009; }
.tc-status.approved {
    background: var(--tc-success-bg);
    color: var(--tc-success);
    border: 1px solid var(--tc-success-border);
}
.tc-status.approved::before { background: #12b76a; }
.tc-status.rejected {
    background: var(--tc-danger-bg);
    color: var(--tc-danger);
    border: 1px solid var(--tc-danger-border);
}
.tc-status.rejected::before { background: #f04438; }
.tc-status.cancelled {
    background: var(--tc-neutral-bg);
    color: var(--tc-neutral);
    border: 1px solid var(--tc-border);
}
.tc-status.cancelled::before { background: #98a2b3; }

/* Action Buttons inside Table */
.tc-action-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.tc-row-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 7px;
    border: 0;
    background: #f2f4f7;
    color: #475467;
    cursor: pointer;
    transition: all 0.15s ease;
}
.tc-row-btn:hover {
    background: #e4e7ec;
    color: #101828;
}
.tc-row-btn.btn-quick-approve:hover {
    background: var(--tc-success-bg);
    color: var(--tc-success);
}
.tc-row-btn.btn-quick-reject:hover {
    background: var(--tc-danger-bg);
    color: var(--tc-danger);
}
.tc-row-btn.btn-quick-delete:hover {
    background: var(--tc-danger-bg);
    color: var(--tc-danger);
}
.tc-row-btn .material-icons {
    font-size: 18px;
}

/* Empty State */
.tc-empty {
    padding: 60px 20px;
    text-align: center;
    color: var(--tc-text-muted);
}
.tc-empty .material-icons {
    font-size: 48px;
    color: #d0d5dd;
    margin-bottom: 12px;
}
.tc-empty h3 {
    font-size: 16px;
    font-weight: 600;
    color: #344054;
    margin: 0 0 4px;
}
.tc-empty p {
    font-size: 13.5px;
    margin: 0;
}

/* Table Footer / Summary */
.tc-table-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    font-size: 13px;
    color: var(--tc-text-muted);
    border-top: 1px solid var(--tc-border);
    background: #fdfefe;
}

/* ==========================================================================
   RIGHT SLIDE-IN DRAWER (TANCA SIGNATURE DETAIL DRAWER)
   ========================================================================== */

.tc-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,0.45);
    backdrop-filter: blur(2px);
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease, visibility 0.22s ease;
}
.tc-drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
}

.tc-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 540px;
    max-width: 100vw;
    height: 100vh;
    background: #fff;
    box-shadow: -8px 0 32px rgba(15,23,42,0.18);
    z-index: 1060;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1);
}
.tc-drawer.is-open {
    transform: translateX(0);
}
.tc-drawer:not(.is-open) { display: none; }

.tc-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--tc-border);
    background: #fff;
}
.tc-drawer-title-box {
    display: flex;
    align-items: center;
    gap: 10px;
}
.tc-drawer-title-box h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: #101828;
}
.tc-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 0;
    background: #f2f4f7;
    color: #667085;
    cursor: pointer;
    transition: all 0.15s ease;
}
.tc-drawer-close:hover {
    background: #e4e7ec;
    color: #101828;
}

.tc-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
}

/* User Card in Drawer */
.tc-drawer-profile {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    background: #f8fafc;
    border: 1px solid var(--tc-border);
    border-radius: 10px;
    margin-bottom: 22px;
}
.tc-drawer-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    font-weight: 700;
    color: #fff;
    background: var(--tc-primary);
    flex: 0 0 48px;
}
.tc-drawer-user-info h3 {
    margin: 0 0 3px 0;
    font-size: 16px;
    font-weight: 700;
    color: #101828;
}
.tc-drawer-user-info p {
    margin: 0;
    font-size: 13px;
    color: var(--tc-text-muted);
}

/* Detail Sections */
.tc-section-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #667085;
    margin: 0 0 12px 0;
}
.tc-detail-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 10px 16px;
    font-size: 13.5px;
    margin-bottom: 24px;
}
.tc-detail-grid dt {
    color: var(--tc-text-muted);
    font-weight: 500;
}
.tc-detail-grid dd {
    margin: 0;
    color: #101828;
    font-weight: 500;
    word-break: break-word;
}
.tc-reason-box {
    padding: 12px 14px;
    background: #f8fafc;
    border-left: 3px solid var(--tc-primary);
    border-radius: 4px;
    color: #344054;
    font-size: 13.5px;
    line-height: 1.5;
    white-space: pre-wrap;
}

/* Approval Workflow Timeline / Stepper */
.tc-workflow {
    position: relative;
    padding-left: 28px;
    margin-bottom: 24px;
}
.tc-workflow::before {
    content: "";
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 11px;
    width: 2px;
    background: var(--tc-border);
}
.tc-step-item {
    position: relative;
    padding-bottom: 20px;
}
.tc-step-item:last-child {
    padding-bottom: 0;
}
.tc-step-icon {
    position: absolute;
    left: -28px;
    top: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 2px solid var(--tc-border);
    color: var(--tc-text-light);
    font-size: 13px;
    z-index: 2;
}
.tc-step-item.is-done .tc-step-icon {
    background: var(--tc-success);
    border-color: var(--tc-success);
    color: #fff;
}
.tc-step-item.is-current .tc-step-icon {
    background: #fff;
    border-color: var(--tc-primary);
    color: var(--tc-primary);
    box-shadow: 0 0 0 3px rgba(23,105,224,0.18);
}
.tc-step-item.is-rejected .tc-step-icon {
    background: var(--tc-danger);
    border-color: var(--tc-danger);
    color: #fff;
}
.tc-step-title {
    font-size: 14px;
    font-weight: 600;
    color: #101828;
    margin: 0 0 3px 0;
}
.tc-step-sub {
    font-size: 12.5px;
    color: var(--tc-text-muted);
}
.tc-step-note {
    margin-top: 6px;
    padding: 8px 12px;
    border-radius: 6px;
    background: #f8fafc;
    border: 1px dashed var(--tc-border);
    font-size: 12.5px;
    color: #475467;
}

/* Action Area in Drawer */
.tc-drawer-action-box {
    background: #fcfcfd;
    border: 1px solid var(--tc-border);
    border-radius: 10px;
    padding: 16px;
    margin-top: 20px;
}
.tc-drawer-action-box label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #344054;
    margin-bottom: 8px;
}
.tc-drawer-note {
    width: 100%;
    min-height: 84px;
    padding: 10px 12px;
    font-size: 13.5px;
    color: #101828;
    background: #fff;
    border: 1px solid var(--tc-border);
    border-radius: 8px;
    outline: 0;
    resize: vertical;
    transition: border-color 0.15s ease;
}
.tc-drawer-note:focus {
    border-color: var(--tc-primary);
    box-shadow: 0 0 0 3px rgba(23,105,224,0.12);
}
.tc-action-btn-row {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 14px;
}

/* Drawer Footer */
.tc-drawer-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    border-top: 1px solid var(--tc-border);
    background: #fcfcfd;
}

/* ==========================================================================
   EXPORT MODAL (MODAL XUẤT FILE PHÂN LOẠI THEO TANCA CÓ HÌNH ICON)
   ========================================================================== */

.tc-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,0.55);
    backdrop-filter: blur(3px);
    z-index: 1070;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
}
.tc-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
}

.tc-export-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -48%) scale(0.96);
    width: 960px;
    max-width: 95vw;
    max-height: 90vh;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 24px 48px -12px rgba(15,23,42,0.25);
    z-index: 1080;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}
.tc-export-modal.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}

.tc-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--tc-border);
}
.tc-modal-header h3 {
    margin: 0 0 4px;
    font-size: 19px;
    font-weight: 700;
    color: #101828;
}
.tc-modal-header p {
    margin: 0;
    font-size: 13.5px;
    color: var(--tc-text-muted);
}
.tc-modal-close {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 0;
    background: #f2f4f7;
    color: #667085;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
}
.tc-modal-close:hover {
    background: #e4e7ec;
    color: #101828;
}

.tc-modal-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 24px;
    background: #f8fafc;
    border-bottom: 1px solid var(--tc-border);
}
.tc-modal-search {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 280px;
    height: 36px;
    padding: 0 10px;
    background: #fff;
    border: 1px solid var(--tc-border);
    border-radius: 7px;
    color: var(--tc-text-light);
}
.tc-modal-search input {
    width: 100%;
    border: 0;
    outline: 0;
    font-size: 13px;
    color: var(--tc-text-main);
    background: transparent;
}
.tc-modal-quick-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}
.tc-quick-btn {
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 6px;
    border: 1px solid var(--tc-border);
    background: #fff;
    color: #344054;
    cursor: pointer;
    transition: all 0.15s;
}
.tc-quick-btn:hover {
    background: #f2f4f7;
}

.tc-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
}

.tc-export-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 12px;
}

.tc-export-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: #ffffff;
    border: 1.5px solid var(--tc-border);
    border-radius: 10px;
    cursor: pointer;
    user-select: none;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
}
.tc-export-item:hover {
    border-color: #93c5fd;
    background: #f8fafc;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
}
.tc-export-item.is-checked {
    border-color: #2563eb;
    background: #eff6ff;
    box-shadow: 0 0 0 1px #2563eb;
}

.tc-item-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 40px;
    transition: transform 0.18s ease;
}
.tc-export-item:hover .tc-item-icon {
    transform: scale(1.08);
}
.tc-svg-icon {
    width: 22px;
    height: 22px;
    display: block;
}

.tc-item-text {
    flex: 1;
    min-width: 0;
}
.tc-item-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tc-export-item.is-checked .tc-item-title {
    color: var(--tc-primary);
}

.tc-export-options-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 14px 18px;
    background: #f8fafc;
    border: 1px solid var(--tc-border);
    border-radius: 10px;
    margin-top: 10px;
}
.tc-export-opt-group {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #344054;
}
.tc-export-opt-group select,
.tc-export-opt-group input {
    height: 32px;
    padding: 0 8px;
    font-size: 12.5px;
    border: 1px solid var(--tc-border);
    border-radius: 6px;
    background: #fff;
    outline: 0;
}

.tc-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    border-top: 1px solid var(--tc-border);
    background: #fff;
}
.tc-modal-summary {
    font-size: 13px;
    color: var(--tc-text-muted);
}
.tc-modal-summary strong {
    color: var(--tc-primary);
}

.tc-history-header { margin-top: 8px; }
.tc-history-header h2 { margin: 0 0 4px; font-size: 18px; font-weight: 700; }

/* Print Support */
@@media print {
    .approval-inbox, .tc-page-header, .tc-tabs-bar, .tc-toolbar, .tc-bulk-bar, .tc-table-card, .tc-drawer-backdrop, .tc-modal-backdrop, .tc-export-modal, .tc-create-modal {
        display: none !important;
    }
    .tc-drawer {
        position: static !important;
        width: 100% !important;
        height: auto !important;
        box-shadow: none !important;
        transform: none !important;
    }
    .tc-drawer-action-box, .tc-drawer-footer, .tc-drawer-close {
        display: none !important;
    }
}

/* Mobile Responsiveness */
@@media (max-width: 768px) {
    .tc-page-header {
        flex-direction: column;
        align-items: stretch;
    }
    .tc-header-actions {
        margin-top: 10px;
    }
    .tc-toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    .tc-select, .tc-search-box {
        width: 100%;
    }
    .tc-search-box { flex: 0 0 38px; min-width: 0; }
    .tc-search-box input { min-width: 0; }
    .tc-date-group { display: grid; grid-template-columns: auto minmax(0, 1fr); width: 100%; }
    .tc-date-input { min-width: 0; width: 100%; }
    .tc-drawer {
        width: 100vw;
    }
    .tc-export-modal {
        width: 98vw;
        max-height: 94vh;
    }
    .tc-export-grid {
        grid-template-columns: 1fr;
    }
    .tc-form-row-2 {
        grid-template-columns: 1fr;
    }
    .tc-detail-grid {
        grid-template-columns: 1fr;
        gap: 4px;
    }
    .tc-detail-grid dt {
        margin-top: 8px;
    }
}
/* Toast Notifications */
.tc-toast-container {
    position: fixed;
    top: 68px;
    right: 24px;
    z-index: 10050;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
}
.tc-toast {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #ffffff;
    color: #1d2939;
    font-size: 13.5px;
    font-weight: 500;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(15,23,42,0.18);
    transform: translateY(-16px);
    opacity: 0;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}
.tc-toast.is-visible {
    transform: translateY(0);
    opacity: 1;
}
.tc-toast.success {
    border-left: 4px solid var(--tc-success);
}
.tc-toast.danger {
    border-left: 4px solid var(--tc-danger);
}
.tc-toast.info {
    border-left: 4px solid var(--tc-primary);
}
</style>

<div class="tc-app-wrap">
    <form id="tcTokenForm" style="display:none">@Html.AntiForgeryToken()</form>
    <div id="tcToastContainer" class="tc-toast-container"></div>
    <!-- Header -->
    <div class="tc-page-header">
        <div>
            <h1>Phê duyệt</h1>
            <p>Duyệt các yêu cầu đang chờ bạn, rồi tra cứu lịch sử thủ tục trong phạm vi quản lý ở bảng bên dưới.</p>
        </div>
    </div>

    @await Html.PartialAsync("_ApprovalInbox")

    <div class="tc-page-header tc-history-header">
        <div>
            <h2>Tra cứu thủ tục</h2>
            <p>Mọi đơn thủ tục trong phạm vi của bạn, kể cả đơn đang chờ người khác duyệt.</p>
        </div>
        <div class="tc-header-actions">
            <button id="tcExportBtn" type="button" class="tc-btn" title="Xuất danh sách thủ tục ra Excel hoặc CSV">
                <i class="material-icons">file_download</i> Xuất file
            </button>
            <button id="tcRefreshBtn" type="button" class="tc-btn" title="Tải lại dữ liệu">
                <i class="material-icons">refresh</i> Làm mới
            </button>
        </div>
    </div>

    <!-- Status Tabs (Tanca style) -->
    <div class="tc-tabs-bar" role="tablist">
        <button type="button" class="tc-tab-item active" data-status="all">
            <span>Tất cả</span>
            <span id="badgeAll" class="tc-tab-badge">0</span>
        </button>
        <button type="button" class="tc-tab-item" data-status="waiting">
            <span>Đang chờ các cấp</span>
            <span id="badgeWaiting" class="tc-tab-badge">0</span>
        </button>
        <button type="button" class="tc-tab-item" data-status="approved">
            <span>Chấp thuận</span>
            <span id="badgeApproved" class="tc-tab-badge">0</span>
        </button>
        <button type="button" class="tc-tab-item" data-status="rejected">
            <span>Từ chối</span>
            <span id="badgeRejected" class="tc-tab-badge">0</span>
        </button>
    </div>

    <!-- Filter Toolbar -->
    <div class="tc-toolbar">
        <label class="tc-search-box" title="Tìm theo mã yêu cầu, tên nhân viên, phòng ban, lý do...">
            <i class="material-icons">search</i>
            <input id="filterSearch" type="text" placeholder="Tìm mã yêu cầu, nhân viên, phòng ban..." aria-label="Tìm kiếm" />
        </label>

        <select id="filterDepartment" class="tc-select" aria-label="Lọc theo phòng ban">
            <option value="">Tất cả phòng ban</option>
        </select>

        <select id="filterType" class="tc-select" aria-label="Lọc theo loại yêu cầu">
            <option value="">Tất cả loại yêu cầu</option>
        </select>

        <div class="tc-date-group">
            <span>Từ</span>
            <input id="filterFromDate" type="date" class="tc-date-input" title="Từ ngày gửi đơn" />
            <span>đến</span>
            <input id="filterToDate" type="date" class="tc-date-input" title="Đến ngày gửi đơn" />
        </div>

        <button id="btnClearFilters" type="button" class="tc-clear-btn" title="Xóa bộ lọc">
            <i class="material-icons" style="font-size:16px;vertical-align:middle;">close</i> Xóa lọc
        </button>
    </div>

    <!-- Floating Bulk Action Bar -->
    <div id="tcBulkBar" class="tc-bulk-bar">
        <div class="tc-bulk-count">
            Đã chọn <strong id="tcBulkCountText">0</strong> yêu cầu
        </div>
        <div class="tc-bulk-actions">
            <button id="btnBulkDeselect" type="button" class="tc-btn">Bỏ chọn</button>
            @if (canManage)
            {
                <button id="btnBulkDelete" type="button" class="tc-btn" style="color:var(--tc-danger);border-color:var(--tc-danger-border);background:var(--tc-danger-bg);">
                    <i class="material-icons">delete</i> Xóa đã chọn
                </button>
            }
            <button id="btnBulkReject" type="button" class="tc-btn tc-btn-danger">
                <i class="material-icons">close</i> Từ chối đã chọn
            </button>
            <button id="btnBulkApprove" type="button" class="tc-btn tc-btn-success">
                <i class="material-icons">check</i> Chấp thuận đã chọn
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="tc-table-card">
        <div class="tc-table-wrap">
            <table class="tc-table">
                <thead>
                    <tr>
                        <th class="th-checkbox">
                            <input id="chkSelectAll" type="checkbox" class="tc-checkbox" title="Chọn tất cả" />
                        </th>
                        <th>Mã yêu cầu</th>
                        <th>Người yêu cầu</th>
                        <th>Loại yêu cầu</th>
                        <th>Thời gian áp dụng</th>
                        <th>Lý do</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right;padding-right:20px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tcTableRows">
                    <tr>
                        <td colspan="9">
                            <div class="tc-empty">
                                <i class="material-icons">hourglass_empty</i>
                                <h3>Đang tải dữ liệu...</h3>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="tc-table-footer">
            <div id="tcTableSummary">Đang tải...</div>
            <div style="display:flex;align-items:center;gap:12px;">
                <span id="tcTotalCountText"></span>
            </div>
        </div>
    </div>
</div>

<!-- Anti-forgery Token -->
<form id="tcTokenForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- RIGHT SLIDE-IN DRAWER (TANCA SIGNATURE) -->
<div id="tcDrawerBackdrop" class="tc-drawer-backdrop" aria-hidden="true"></div>

<aside id="tcDrawer" class="tc-drawer" aria-labelledby="drawerReqCode" role="dialog" aria-modal="true">
    <div class="tc-drawer-header">
        <div class="tc-drawer-title-box">
            <h2>Chi tiết yêu cầu</h2>
            <span id="drawerReqCode" class="tc-code-badge">#REQ</span>
            <span id="drawerReqStatus" class="tc-status waiting">Chờ duyệt</span>
        </div>
        <button id="tcDrawerClose" type="button" class="tc-drawer-close" aria-label="Đóng chi tiết">
            <i class="material-icons">close</i>
        </button>
    </div>

    <div class="tc-drawer-body">
        <!-- Requester Profile -->
        <div class="tc-drawer-profile">
            <div id="drawerAvatar" class="tc-drawer-avatar">NG</div>
            <div class="tc-drawer-user-info">
                <h3 id="drawerUserName">—</h3>
                <p id="drawerUserSub">—</p>
                <div id="drawerUserContact" style="font-size:12px;color:#667085;margin-top:4px;"></div>
            </div>
        </div>

        <!-- Detail Info -->
        <h4 class="tc-section-title">Thông tin đề xuất</h4>
        <dl class="tc-detail-grid">
            <dt>Loại yêu cầu</dt>
            <dd id="drawerLeaveType">—</dd>

            <dt>Khoảng thời gian</dt>
            <dd id="drawerTimeRange">—</dd>

            <dt>Tổng thời gian</dt>
            <dd id="drawerDuration">—</dd>

            <dt>Buổi nghỉ</dt>
            <dd id="drawerSession">—</dd>

            <dt>Người bàn giao</dt>
            <dd id="drawerHandover">—</dd>

            <dt>Tệp đính kèm</dt>
            <dd id="drawerAttachment">—</dd>
        </dl>

        <h4 class="tc-section-title">Lý do đề xuất</h4>
        <div id="drawerReason" class="tc-reason-box" style="margin-bottom:24px;">—</div>

        <!-- Approval Workflow Timeline -->
        <h4 class="tc-section-title">Tiến trình phê duyệt</h4>
        <div class="tc-workflow">
            <!-- Step 1: Request Created -->
            <div class="tc-step-item is-done">
                <span class="tc-step-icon"><i class="material-icons" style="font-size:14px;">check</i></span>
                <div class="tc-step-title">Nhân viên gửi yêu cầu</div>
                <div id="step1Info" class="tc-step-sub">—</div>
            </div>

            <!-- Step 2: Manager Approval -->
            <div id="step2Item" class="tc-step-item">
                <span id="step2Icon" class="tc-step-icon"><i class="material-icons" style="font-size:14px;">schedule</i></span>
                <div id="step2Title" class="tc-step-title">Trưởng phòng phê duyệt</div>
                <div id="step2Info" class="tc-step-sub">Chờ xác nhận</div>
                <div id="step2Note" class="tc-step-note" style="display:none;"></div>
            </div>
        </div>

        <!-- Approval Action Box -->
        <div id="drawerActionBox" class="tc-drawer-action-box">
            <label for="drawerNoteInput">Ghi chú xử lý / Lý do từ chối:</label>
            <textarea id="drawerNoteInput" class="tc-drawer-note" maxlength="1000" placeholder="Nhập ý kiến phản hồi hoặc lý do từ chối đơn..."></textarea>
            
            <div class="tc-action-btn-row">
                <button id="btnDrawerReject" type="button" class="tc-btn tc-btn-danger">
                    <i class="material-icons">close</i> Từ chối
                </button>
                <button id="btnDrawerApprove" type="button" class="tc-btn tc-btn-success">
                    <i class="material-icons">check</i> Chấp thuận
                </button>
            </div>
        </div>

        <div id="drawerNoticeBox" style="display:none;padding:12px 14px;border-radius:8px;margin-top:16px;font-size:13.5px;"></div>
    </div>

    <div class="tc-drawer-footer">
        <button id="tcPrintBtn" type="button" class="tc-btn" title="In phiếu yêu cầu">
            <i class="material-icons">print</i> In đơn
        </button>
        @if (canManage)
        {
            <button id="btnDrawerDelete" type="button" class="tc-btn" style="color:var(--tc-danger);border-color:var(--tc-danger-border);background:var(--tc-danger-bg);" title="Xóa yêu cầu này">
                <i class="material-icons">delete</i> Xóa đơn
            </button>
        }
        <button id="tcDrawerCloseBtn" type="button" class="tc-btn tc-btn-primary">
            Đóng
        </button>
    </div>
</aside>

<!-- EXPORT MODAL (MODAL XUẤT FILE CÓ HÌNH THEO CÁC NHÓM CỦA TANCA) -->
<div id="tcExportModalBackdrop" class="tc-modal-backdrop" aria-hidden="true"></div>

<div id="tcExportModal" class="tc-export-modal" role="dialog" aria-labelledby="exportModalTitle" aria-modal="true">
    <div class="tc-modal-header">
        <div>
            <h3 id="exportModalTitle">Xuất file danh sách yêu cầu</h3>
            <p>Chọn các loại yêu cầu và tiêu chí bạn muốn xuất ra tệp Excel/CSV.</p>
        </div>
        <button id="tcExportModalClose" type="button" class="tc-modal-close" aria-label="Đóng">
            <i class="material-icons">close</i>
        </button>
    </div>

    <div class="tc-modal-toolbar">
        <label class="tc-modal-search">
            <i class="material-icons" style="font-size:18px;">search</i>
            <input id="exportSearchInput" type="text" placeholder="Tìm loại yêu cầu..." />
        </label>
        <div class="tc-modal-quick-actions">
            <button id="btnExportSelectAll" type="button" class="tc-quick-btn">Chọn tất cả</button>
            <button id="btnExportDeselectAll" type="button" class="tc-quick-btn">Bỏ chọn tất cả</button>
        </div>
    </div>

    <div class="tc-modal-body">
        <div id="exportTypeList" class="tc-export-grid"></div>

        <!-- Options Bar -->
        <div class="tc-export-options-bar">
            <div class="tc-export-opt-group">
                <span><strong>Trạng thái:</strong></span>
                <select id="exportStatusSelect">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="waiting">Chờ duyệt</option>
                    <option value="approved">Đã chấp thuận</option>
                    <option value="rejected">Bị từ chối</option>
                </select>
            </div>
            <div class="tc-export-opt-group">
                <span><strong>Thời gian:</strong></span>
                <input id="exportFromDate" type="date" title="Từ ngày" />
                <span>—</span>
                <input id="exportToDate" type="date" title="Đến ngày" />
            </div>
            <div class="tc-export-opt-group">
                <span><strong>Định dạng:</strong></span>
                <select id="exportFormatSelect">
                    <option value="xls">Excel (.xls - Bảng biểu có màu sắc)</option>
                    <option value="csv">CSV (.csv - UTF-8 chuẩn Tiếng Việt)</option>
                </select>
            </div>
        </div>
    </div>

    <div class="tc-modal-footer">
        <div class="tc-modal-summary">
            Đã chọn <strong id="exportCountText">0</strong> / <span id="exportTypeTotal">0</span> loại yêu cầu
        </div>
        <div style="display:flex;gap:10px;">
            <button id="tcExportModalCancel" type="button" class="tc-btn">Đóng</button>
            <button id="btnDoExport" type="button" class="tc-btn tc-btn-primary">
                <i class="material-icons">file_download</i> Xuất file Excel
            </button>
        </div>
    </div>
</div>

<script>
(function () {
    var managerStage = @managerStage.ToString().ToLowerInvariant();
    var canManage = @canManage.ToString().ToLowerInvariant();
    var currentDisplayName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(current?.DisplayName ?? "Tôi"));
    var currentUserId = @(current?.Id ?? 0);
    var roleCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleCode));
    var records = [];
    var selectedRecord = null;
    var checkedIds = new Set();

    var AVATAR_PALETTE = [
        { bg: '#EBF4FF', color: '#1769E0' },
        { bg: '#ECFDF3', color: '#027A48' },
        { bg: '#FFFAEB', color: '#B54708' },
        { bg: '#FEF3F2', color: '#B42318' },
        { bg: '#FDF2FA', color: '#C11574' },
        { bg: '#F0FDF9', color: '#0E9384' },
        { bg: '#F8F9FC', color: '#363F72' }
    ];

    function esc(v) {
        return HrmRequestForm.escapeHtml(v);
    }

    function getInitials(name) {
        if (!name) return 'NV';
        var parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function getAvatarStyle(name) {
        if (!name) return AVATAR_PALETTE[0];
        var hash = 0;
        for (var i = 0; i < name.length; i++) {
            hash = (hash << 5) - hash + name.charCodeAt(i);
            hash |= 0;
        }
        var idx = Math.abs(hash) % AVATAR_PALETTE.length;
        return AVATAR_PALETTE[idx];
    }

    function fmtDate(v) {
        return v ? moment(v).format('DD/MM/YYYY') : '—';
    }

    function fmtDateTime(v) {
        return v ? moment(v).format('DD/MM/YYYY HH:mm') : '—';
    }

    // Số ngày công do máy chủ tính theo lịch và buổi nghỉ; yêu cầu không phải nghỉ dùng số ngày lịch.
    function leaveDays(x) {
        return x.RequestedDays == null ? calcDays(x.StartDate, x.EndDate) : String(x.RequestedDays).replace('.', ',');
    }
    function calcDays(start, end) {
        if (!start || !end) return 1;
        var s = moment(start).startOf('day');
        var e = moment(end).startOf('day');
        return Math.max(1, e.diff(s, 'days') + 1);
    }

    function getStatusLabel(s, requesterRole) {
        switch (s) {
            case 'PENDING_MANAGER': return 'Chờ Trưởng phòng duyệt';
            case 'PENDING_HR': return 'Chờ HR/Giám đốc duyệt';
            case 'APPROVED': return 'Chấp thuận';
            case 'REJECTED': return 'Từ chối';
            case 'CANCELLED': return 'Đã hủy';
            default: return s || 'Chờ duyệt';
        }
    }

    function getStatusCss(s) {
        switch (s) {
            case 'APPROVED': return 'approved';
            case 'REJECTED': return 'rejected';
            case 'CANCELLED': return 'cancelled';
            default: return 'waiting';
        }
    }

    function canUserApprove(x) {
        return HrmRequestForm.canApprove(x, roleCode, currentUserId, @(current?.DepartmentId ?? 0));
    }

    /* URL Hash Navigation: #filter?req_id=&req_sta=waiting */
    function parseHash() {
        var hash = window.location.hash || '';
        var params = { req_id: '', req_sta: 'all' };
        if (hash.indexOf('#filter?') === 0) {
            var q = hash.substring(8);
            var pairs = q.split('&');
            for (var i = 0; i < pairs.length; i++) {
                var p = pairs[i].split('=');
                if (p.length === 2) {
                    params[decodeURIComponent(p[0])] = decodeURIComponent(p[1]);
                }
            }
        }
        return params;
    }

    function updateHash() {
        var activeTab = $('.tc-tab-item.active').data('status') || 'all';
        var searchVal = $('#filterSearch').val().trim();
        var newHash = '#filter?req_id=' + encodeURIComponent(searchVal) + '&req_sta=' + encodeURIComponent(activeTab);
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', newHash);
        } else {
            window.location.hash = newHash;
        }
    }

    function applyHashParams() {
        var p = parseHash();
        if (p.req_sta) {
            $('.tc-tab-item').removeClass('active');
            var matchTab = $('.tc-tab-item[data-status="' + p.req_sta + '"]');
            if (matchTab.length) {
                matchTab.addClass('active');
            } else {
                $('.tc-tab-item[data-status="all"]').addClass('active');
            }
        }
        if (p.req_id && !$('#filterSearch').val()) {
            $('#filterSearch').val(p.req_id);
        }
    }

    /* Filter & Render */
    function getFilteredList() {
        var tab = $('.tc-tab-item.active').data('status') || 'all';
        var search = $('#filterSearch').val().trim().toLowerCase();
        var dept = $('#filterDepartment').val();
        var type = $('#filterType').val();
        var from = $('#filterFromDate').val();
        var to = $('#filterToDate').val();

        var isFiltering = !!(search || dept || type || from || to);
        $('#btnClearFilters').toggle(isFiltering);

        return records.filter(function (x) {
            // Status Tab Filtering
            if (tab === 'waiting') {
                if (x.StatusCode !== 'PENDING_MANAGER' && x.StatusCode !== 'PENDING_HR') return false;
            } else if (tab === 'approved') {
                if (x.StatusCode !== 'APPROVED') return false;
            } else if (tab === 'rejected') {
                if (x.StatusCode !== 'REJECTED') return false;
            }

            // Department
            if (dept && (x.DepartmentName || '') !== dept) return false;

            // Leave Type
            if (type && x.LeaveType !== type) return false;

            // Date Range (CreatedAt)
            if (from) {
                var dStart = moment(x.CreatedAt).startOf('day');
                if (dStart.isBefore(moment(from).startOf('day'))) return false;
            }
            if (to) {
                var dEnd = moment(x.CreatedAt).startOf('day');
                if (dEnd.isAfter(moment(to).startOf('day'))) return false;
            }

            // Text search
            if (search) {
                var text = [
                    x.RequestCode,
                    x.DisplayName,
                    x.DepartmentName,
                    x.EmployeeCode,
                    x.LeaveType,
                    x.Reason,
                    x.HandoverTo
                ].join(' ').toLowerCase();
                if (text.indexOf(search) === -1) return false;
            }

            return true;
        });
    }

    function updateBadges() {
        var waiting = records.filter(function (x) {
            return x.StatusCode === 'PENDING_MANAGER' || x.StatusCode === 'PENDING_HR';
        }).length;
        var approved = records.filter(function (x) { return x.StatusCode === 'APPROVED'; }).length;
        var rejected = records.filter(function (x) { return x.StatusCode === 'REJECTED'; }).length;

        $('#badgeWaiting').text(waiting);
        $('#badgeApproved').text(approved);
        $('#badgeRejected').text(rejected);
        $('#badgeAll').text(records.length);
    }

    function updateBulkBar() {
        var count = checkedIds.size;
        if (count > 0) {
            $('#tcBulkCountText').text(count);
            $('#tcBulkBar').css('display', 'flex');
        } else {
            $('#tcBulkBar').hide();
        }
        var currentFiltered = getFilteredList();
        var currentManageable = currentFiltered.filter(function (x) { return canManage || canUserApprove(x); });
        var allChecked = currentManageable.length > 0 && currentManageable.every(function (x) { return checkedIds.has(x.Id); });
        $('#chkSelectAll').prop('checked', allChecked);
    }

    function render() {
        try {
            var tab = $('.tc-tab-item.active').data('status') || 'all';
            var rows = getFilteredList();
            updateBadges();
            updateBulkBar();

            $('#tcTableSummary').text('Hiển thị ' + rows.length + ' / ' + records.length + ' yêu cầu');
            $('#tcTotalCountText').text(rows.length ? 'Tổng ' + rows.length + ' mục' : '');

            if (!rows.length) {
                var isWaiting = tab === 'waiting';
                var emptyHtml = '<div class="tc-empty">' +
                    '<i class="material-icons">inbox</i>' +
                    '<h3>' + (isWaiting ? 'Không có thủ tục nào đang chờ duyệt' : 'Không tìm thấy yêu cầu phù hợp') + '</h3>' +
                    '<p>' + (isWaiting ? 'Các cấp duyệt đã xử lý hết thủ tục trong phạm vi của bạn.' : 'Hãy thử thay đổi từ khóa hoặc tiêu chí bộ lọc.') + '</p>' +
                    '</div>';
                $('#tcTableRows').html('<tr><td colspan="9">' + emptyHtml + '</td></tr>');
                return;
            }

            var html = rows.map(function (x) {
                var isChecked = checkedIds.has(x.Id);
                var canApprove = canUserApprove(x);
                var av = getAvatarStyle(x.DisplayName);
                var days = leaveDays(x);

                return '<tr class="tc-row ' + (isChecked ? 'is-selected' : '') + '" data-id="' + x.Id + '">' +
                    '<td class="td-checkbox">' +
                        ((canManage || canApprove)
                            ? '<input type="checkbox" class="tc-checkbox row-chk" data-id="' + x.Id + '" ' + (isChecked ? 'checked' : '') + ' />'
                            : '<span style="display:inline-block;width:18px;"></span>') +
                    '</td>' +
                    '<td>' +
                        '<a href="javascript:void(0)" class="tc-code-badge open-detail" data-id="' + x.Id + '">#' + esc(x.RequestCode) + '</a>' +
                    '</td>' +
                    '<td>' +
                        '<div class="tc-user-cell">' +
                            '<div class="tc-avatar" style="background:' + av.bg + ';color:' + av.color + ';">' + esc(getInitials(x.DisplayName)) + '</div>' +
                            '<div>' +
                                '<span class="tc-user-name">' + esc(x.DisplayName) + '</span>' +
                                '<span class="tc-user-sub">' + esc(x.EmployeeCode ? x.EmployeeCode + ' · ' : '') + esc(x.DepartmentName || 'Chưa phân phòng') + '</span>' +
                            '</div>' +
                        '</div>' +
                    '</td>' +
                    '<td><span class="tc-type-tag">' + esc(x.LeaveType) + '</span></td>' +
                    '<td>' +
                        '<div class="tc-date-range">' +
                            '<strong>' + fmtDate(x.StartDate) + ' — ' + fmtDate(x.EndDate) + '</strong>' +
                            '<span>' + days + ' ngày · ' + esc(x.SessionCode || 'Cả ngày') + '</span>' +
                        '</div>' +
                    '</td>' +
                    '<td><div class="tc-reason-text" title="' + esc(x.Reason) + '">' + esc(x.Reason || '—') + '</div></td>' +
                    '<td>' + fmtDateTime(x.CreatedAt) + '</td>' +
                    '<td><span class="tc-status ' + getStatusCss(x.StatusCode) + '">' + esc(getStatusLabel(x.StatusCode, x.RoleCode)) + '</span></td>' +
                    '<td style="text-align:right;padding-right:20px;">' +
                        '<div class="tc-action-group">' +
                            (canApprove ? '<button type="button" class="tc-row-btn btn-quick-approve" data-id="' + x.Id + '" title="Chấp thuận nhanh"><i class="material-icons">check</i></button>' : '') +
                            (canApprove ? '<button type="button" class="tc-row-btn btn-quick-reject" data-id="' + x.Id + '" title="Từ chối nhanh"><i class="material-icons">close</i></button>' : '') +
                            (canManage ? '<button type="button" class="tc-row-btn btn-quick-delete" data-id="' + x.Id + '" title="Xóa yêu cầu" style="color:var(--tc-danger);"><i class="material-icons">delete_outline</i></button>' : '') +
                            '<button type="button" class="tc-row-btn open-detail" data-id="' + x.Id + '" title="Xem chi tiết đơn"><i class="material-icons">arrow_forward</i></button>' +
                        '</div>' +
                    '</td>' +
                '</tr>';
            }).join('');

            $('#tcTableRows').html(html);
        } catch (err) {
            console.error('Lỗi khi hiển thị bảng yêu cầu:', err);
            $('#tcTableRows').html(
                '<tr><td colspan="9"><div class="tc-empty" style="color:var(--tc-danger);">' +
                '<i class="material-icons" style="color:var(--tc-danger);">error_outline</i>' +
                '<h3>Đã xảy ra lỗi khi hiển thị dữ liệu</h3>' +
                '<p>' + esc(err && err.message ? err.message : 'Vui lòng làm mới lại trang.') + '</p>' +
                '</div></td></tr>'
            );
        }
    }

    window.addEventListener('hrm-approvals-changed', function () { loadData(true); });
    function loadData(fromInbox) {
        if (!fromInbox) window.dispatchEvent(new Event('hrm-procedures-changed'));
        $.get('@Url.Action("LeaveRequests", "Hrm")').done(function (res) {
            records = res.Data || [];

            // Populate unique departments
            var currentDept = $('#filterDepartment').val();
            var depts = [...new Set(records.map(function (x) { return x.DepartmentName; }).filter(Boolean))].sort();
            var deptOptions = '<option value="">Tất cả phòng ban</option>' + depts.map(function (d) {
                return '<option value="' + esc(d) + '">' + esc(d) + '</option>';
            }).join('');
            $('#filterDepartment').html(deptOptions).val(currentDept);

            // Populate unique leave types
            var currentType = $('#filterType').val();
            var types = [...new Set(records.map(function (x) { return x.LeaveType; }).filter(Boolean))].sort();
            var typeOptions = '<option value="">Tất cả loại yêu cầu</option>' + types.map(function (t) {
                return '<option value="' + esc(t) + '">' + esc(t) + '</option>';
            }).join('');
            $('#filterType').html(typeOptions).val(currentType);

            render();

            // Check if selected drawer is open and update it
            if (selectedRecord) {
                var updated = records.find(function (x) { return x.Id === selectedRecord.Id; });
                if (updated) openDrawer(updated.Id);
            }
        }).fail(function () {
            $('#tcTableRows').html(
                '<tr><td colspan="9"><div class="tc-empty" style="color:var(--tc-danger);">' +
                '<i class="material-icons" style="color:var(--tc-danger);">error_outline</i>' +
                '<h3>Không thể tải dữ liệu yêu cầu</h3>' +
                '<p>Vui lòng thử bấm nút "Làm mới" hoặc liên hệ quản trị viên.</p>' +
                '</div></td></tr>'
            );
        });
    }

    /* Right Slide-in Drawer */
    function openDrawer(id) {
        var x = records.find(function (r) { return r.Id === id; });
        if (!x) return;
        selectedRecord = x;

        var av = getAvatarStyle(x.DisplayName);
        var days = leaveDays(x);
        var canApprove = canUserApprove(x);

        $('#drawerReqCode').text('#' + x.RequestCode);
        $('#drawerReqStatus')
            .removeClass('waiting approved rejected cancelled')
            .addClass(getStatusCss(x.StatusCode))
            .text(getStatusLabel(x.StatusCode, x.RoleCode));

        $('#drawerAvatar').css({ background: av.bg, color: av.color }).text(getInitials(x.DisplayName));
        $('#drawerUserName').text(x.DisplayName || 'Chưa có tên');
        $('#drawerUserSub').text((x.JobTitle ? x.JobTitle + ' · ' : '') + (x.DepartmentName || 'Chưa phân phòng'));

        var contact = [];
        if (x.EmployeeCode) contact.push('Mã NV: ' + x.EmployeeCode);
        if (x.CompanyEmail) contact.push(x.CompanyEmail);
        if (x.MobilePhone) contact.push(x.MobilePhone);
        $('#drawerUserContact').text(contact.join(' · '));

        $('#drawerLeaveType').text(x.LeaveType);
        $('#drawerTimeRange').text(fmtDate(x.StartDate) + ' — ' + fmtDate(x.EndDate));
        $('#drawerDuration').text(days + ' ngày');
        $('#drawerSession').text(x.SessionCode || 'Cả ngày');
        $('#drawerHandover').text(x.HandoverTo || 'Không có');
        $('#drawerAttachment').html(x.HasAttachment
            ? '<a href="@Url.Action("LeaveAttachment", "Hrm")?id=' + Number(x.Id) + '" target="_blank" rel="noopener">' + esc(x.AttachmentName || 'Tải tệp đính kèm') + '</a>'
            : '<span>' + esc(x.AttachmentName ? x.AttachmentName + ' · Tệp cũ chưa lưu nội dung' : 'Không có') + '</span>');
        $('#drawerReason').text(x.Reason || 'Không có lý do');

        // Timeline Step 1
        $('#step1Info').text('Gửi lúc ' + fmtDateTime(x.CreatedAt) + ' bởi ' + (x.DisplayName || 'Nhân viên'));

        var approverTitle = x.StatusCode === 'PENDING_HR' || (x.StatusCode !== 'PENDING_MANAGER' && !!x.ApprovedByHrId)
            ? 'HR/Giám đốc' : 'Trưởng phòng';
        // Timeline Step 2: Trưởng phòng/Giám đốc phê duyệt
        $('#step2Title').text(approverTitle + ' phê duyệt');
        var s2 = $('#step2Item').removeClass('is-done is-current is-rejected');
        $('#step2Note').hide().text('');
        if (x.StatusCode === 'PENDING_MANAGER' || x.StatusCode === 'PENDING_HR') {
            s2.addClass('is-current');
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">hourglass_top</i>');
            $('#step2Info').text('Đang chờ ' + approverTitle + ' xem xét & phê duyệt');
        } else if (x.StatusCode === 'APPROVED') {
            s2.addClass('is-done');
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">check</i>');
            var approverName = x.ManagerName || x.HrName;
            $('#step2Info').text(approverTitle + ' đã phê duyệt' + (approverName ? ' (' + approverName + ')' : ''));
            var note = x.ManagerNote || x.HrNote;
            if (note) $('#step2Note').show().text('Ghi chú: ' + note);
        } else if (x.StatusCode === 'REJECTED') {
            s2.addClass('is-rejected');
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">close</i>');
            var rejecterName = x.ManagerName || x.HrName;
            $('#step2Info').text(approverTitle + ' đã từ chối' + (rejecterName ? ' (' + rejecterName + ')' : ''));
            var rNote = x.ManagerNote || x.HrNote;
            if (rNote) $('#step2Note').show().text('Lý do: ' + rNote);
        } else if (x.StatusCode === 'CANCELLED') {
            $('#step2Icon').html('<i class="material-icons" style="font-size:14px;">cancel</i>');
            $('#step2Info').text('Người gửi đã hủy yêu cầu này');
        } else {
            $('#step2Info').text(getStatusLabel(x.StatusCode, x.RoleCode));
        }

        // Action Box
        $('#drawerNoteInput').val('');
        if (canApprove) {
            $('#drawerActionBox').show();
            $('#drawerNoticeBox').hide();
        } else {
            $('#drawerActionBox').hide();
            $('#drawerNoticeBox').show();
            if (x.UserId === currentUserId) {
                $('#drawerNoticeBox')
                    .css({ background: '#f8f9fa', color: '#475467', border: '1px solid #eaecf0' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">info</i> Đây là yêu cầu của bạn. Bạn không thể tự phê duyệt.');
            } else if (x.StatusCode === 'APPROVED') {
                $('#drawerNoticeBox')
                    .css({ background: 'var(--tc-success-bg)', color: 'var(--tc-success)', border: '1px solid var(--tc-success-border)' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">check_circle</i> Yêu cầu này đã được phê duyệt hoàn tất.');
            } else if (x.StatusCode === 'REJECTED') {
                $('#drawerNoticeBox')
                    .css({ background: 'var(--tc-danger-bg)', color: 'var(--tc-danger)', border: '1px solid var(--tc-danger-border)' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">cancel</i> Yêu cầu này đã bị từ chối.');
            } else {
                $('#drawerNoticeBox')
                    .css({ background: '#f8f9fa', color: '#475467', border: '1px solid #eaecf0' })
                    .html('<i class="material-icons" style="font-size:18px;vertical-align:middle;">info</i> Bạn chỉ có quyền xem, không có quyền phê duyệt.');
            }
        }

        $('#tcDrawerBackdrop').addClass('is-open');
        $('#tcDrawer').addClass('is-open');
    }

    function closeDrawer() {
        $('#tcDrawer').removeClass('is-open');
        $('#tcDrawerBackdrop').removeClass('is-open');
        selectedRecord = null;
    }

    /* Toast Notifications */
    function showToast(msg, type) {
        var icon = type === 'success' ? 'check_circle' : (type === 'danger' ? 'error' : 'info');
        var color = type === 'success' ? 'var(--tc-success)' : (type === 'danger' ? 'var(--tc-danger)' : 'var(--tc-primary)');
        var toast = $(
            '<div class="tc-toast ' + (type || 'info') + '">' +
            '<i class="material-icons" style="font-size:18px;color:' + color + ';">' + icon + '</i>' +
            '<span>' + esc(msg) + '</span>' +
            '</div>'
        );
        $('#tcToastContainer').append(toast);
        setTimeout(function () { toast.addClass('is-visible'); }, 20);
        setTimeout(function () {
            toast.removeClass('is-visible');
            setTimeout(function () { toast.remove(); }, 300);
        }, 3200);
    }

    /* Decide / Approve API Call */
    function decide(id, ok, note, onSuccess) {
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        var item = records.find(function (r) { return r.Id === id; });
        var code = item ? ('#' + item.RequestCode) : ('yêu cầu #' + id);
        $.post('@Url.Action("ApproveLeave", "Hrm")', {
            __RequestVerificationToken: token,
            Id: id,
            Approve: ok,
            Note: note || ''
        }).done(function () {
            showToast('Đã ' + (ok ? 'chấp thuận' : 'từ chối') + ' ' + code + ' thành công!', ok ? 'success' : 'danger');
            if (onSuccess) onSuccess();
            loadData();
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Không thể xử lý yêu cầu.';
            showToast(msg, 'danger');
            alert(msg);
        });
    }

    function bulkDecide(ids, ok, note) {
        if (!ids || !ids.length) return;
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("BulkApproveLeave", "Hrm")',
            type: 'POST',
            traditional: true,
            data: {
                __RequestVerificationToken: token,
                Ids: ids,
                Approve: ok,
                Note: note || ''
            }
        }).done(function (res) {
            var cnt = res.Data ? res.Data.Count : ids.length;
            checkedIds.clear();
            updateBulkBar();
            loadData();
            showToast('Đã ' + (ok ? 'chấp thuận' : 'từ chối') + ' thành công ' + cnt + ' yêu cầu!', ok ? 'success' : 'danger');
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Xử lý hàng loạt thất bại.';
            showToast(msg, 'danger');
            alert(msg);
        });
    }

    function deleteLeave(id, onSuccess) {
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        var item = records.find(function (r) { return r.Id === id; });
        var code = item ? ('#' + item.RequestCode) : ('yêu cầu #' + id);
        $.post('@Url.Action("DeleteLeave", "Hrm")', {
            __RequestVerificationToken: token,
            id: id
        }).done(function () {
            showToast('Đã xóa ' + code + ' thành công!', 'info');
            if (onSuccess) onSuccess();
            loadData();
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Không thể xóa yêu cầu này.';
            showToast(msg, 'danger');
        });
    }

    function bulkDeleteLeaves(ids) {
        if (!ids || !ids.length) return;
        var token = $('#tcTokenForm input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("BulkDeleteLeave", "Hrm")',
            type: 'POST',
            traditional: true,
            data: {
                __RequestVerificationToken: token,
                Ids: ids
            }
        }).done(function (res) {
            var cnt = res.Data ? res.Data.Count : ids.length;
            checkedIds.clear();
            updateBulkBar();
            loadData();
            showToast('Đã xóa thành công ' + cnt + ' yêu cầu!', 'info');
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Xóa hàng loạt thất bại.';
            showToast(msg, 'danger');
            alert(msg);
        });
    }

    /* Export Modal Handlers */
    function openExportModal() {
        var counts = {};
        records.forEach(function (x) { counts[x.LeaveType] = (counts[x.LeaveType] || 0) + 1; });
        var types = Object.keys(counts).sort(function (a, b) { return a.localeCompare(b, 'vi'); });
        $('#exportTypeList').html(types.map(function (type) {
            return '<label class="tc-export-item is-checked" data-type="' + esc(type) + '"><input type="checkbox" class="tc-checkbox exp-chk" value="' + esc(type) + '" checked />' +
                '<span class="tc-item-text"><span class="tc-item-title">' + esc(type) + ' (' + counts[type] + ')</span></span></label>';
        }).join('') || '<p>Chưa có thủ tục nào để xuất.</p>');
        $('#exportTypeTotal').text(types.length);
        $('#exportSearchInput').val('');
        updateExportCount();
        $('#tcExportModalBackdrop').addClass('is-open');
        $('#tcExportModal').addClass('is-open');
    }

    function closeExportModal() {
        $('#tcExportModal').removeClass('is-open');
        $('#tcExportModalBackdrop').removeClass('is-open');
    }

    function updateExportCount() {
        var count = $('.exp-chk:checked').length;
        $('#exportCountText').text(count);
    }

    function performExport() {
        var selectedTypes = [];
        $('.exp-chk:checked').each(function () {
            selectedTypes.push($(this).val());
        });

        if (!selectedTypes.length) {
            alert('Vui lòng chọn ít nhất một loại yêu cầu để xuất file.');
            return;
        }

        var statusFilter = $('#exportStatusSelect').val();
        var from = $('#exportFromDate').val();
        var to = $('#exportToDate').val();

        // Filter records matching the export criteria
        var exportRows = records.filter(function (x) {
            if (selectedTypes.indexOf(x.LeaveType) === -1) return false;

            if (statusFilter === 'waiting') {
                if (x.StatusCode !== 'PENDING_MANAGER' && x.StatusCode !== 'PENDING_HR') return false;
            } else if (statusFilter === 'approved') {
                if (x.StatusCode !== 'APPROVED') return false;
            } else if (statusFilter === 'rejected') {
                if (x.StatusCode !== 'REJECTED') return false;
            }

            if (from) {
                if (moment(x.CreatedAt).isBefore(moment(from).startOf('day'))) return false;
            }
            if (to) {
                if (moment(x.CreatedAt).isAfter(moment(to).endOf('day'))) return false;
            }

            return true;
        });

        var headers = ['Mã yêu cầu', 'Nhân viên', 'Mã NV', 'Phòng ban', 'Loại yêu cầu', 'Từ ngày', 'Đến ngày', 'Số ngày', 'Buổi nghỉ', 'Người bàn giao', 'Lý do', 'Ngày gửi', 'Trạng thái', 'Ghi chú phê duyệt'];
        var format = $('#exportFormatSelect').val();
        var now = moment().format('YYYYMMDD_HHmm');
        var fileName = 'BaoCaoYeuCau_' + now;

        if (format === 'xls') {
            var xlsContent = '\x3Chtml xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"\x3E';
            xlsContent += '\x3Chead\x3E\x3Cmeta charset="utf-8"\x3E\x3C!--[if gte mso 9]\x3E\x3Cxml\x3E\x3Cx:ExcelWorkbook\x3E\x3Cx:ExcelWorksheets\x3E\x3Cx:ExcelWorksheet\x3E\x3Cx:Name\x3EBaoCaoYeuCau\x3C/x:Name\x3E\x3Cx:WorksheetOptions\x3E\x3Cx:DisplayGridlines/\x3E\x3C/x:WorksheetOptions\x3E\x3C/x:ExcelWorksheet\x3E\x3C/x:ExcelWorksheets\x3E\x3Cx:ExcelWorkbook\x3E\x3C/xml\x3E\x3C![endif]--\x3E\x3C/head\x3E';
            xlsContent += '\x3Cbody\x3E\x3Ctable border="1" style="border-collapse:collapse;font-family:Arial,sans-serif;font-size:13px;"\x3E';
            xlsContent += '<tr style="background:#1769e0;color:#ffffff;font-weight:bold;text-align:center;height:36px;">';
            headers.forEach(function (h) {
                xlsContent += '<th style="padding:8px 12px;border:1px solid #cbd5e1;">' + esc(h) + '</th>';
            });
            xlsContent += '</tr>';

            if (exportRows.length > 0) {
                exportRows.forEach(function (x, idx) {
                    var days = leaveDays(x);
                    var bg = idx % 2 === 0 ? '#ffffff' : '#f8fafc';
                    xlsContent += '<tr style="background:' + bg + ';height:30px;">';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:bold;color:#1769e0;">' + esc(x.RequestCode) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.DisplayName) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.EmployeeCode || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.DepartmentName || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;font-weight:bold;">' + esc(x.LeaveType) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + fmtDate(x.StartDate) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + fmtDate(x.EndDate) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;font-weight:bold;">' + days + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + esc(x.SessionCode || 'Cả ngày') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.HandoverTo || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.Reason || '') + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + fmtDateTime(x.CreatedAt) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;text-align:center;">' + esc(getStatusLabel(x.StatusCode, x.RoleCode)) + '</td>';
                    xlsContent += '<td style="padding:6px 10px;border:1px solid #e2e8f0;">' + esc(x.ManagerNote || x.HrNote || '') + '</td>';
                    xlsContent += '</tr>';
                });
            } else {
                xlsContent += '<tr><td colspan="' + headers.length + '" style="padding:16px;text-align:center;color:#667085;">Không có dữ liệu cho các loại yêu cầu đã chọn</td></tr>';
            }
            xlsContent += '\x3C/table\x3E\x3C/body\x3E\x3C/html\x3E';

            var blob = new Blob([xlsContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', fileName + '.xls');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else {
            var csvContent = '\uFEFF' + headers.join(',') + '\n';
            if (exportRows.length > 0) {
                exportRows.forEach(function (x) {
                    var days = leaveDays(x);
                    var rowData = [
                        x.RequestCode,
                        x.DisplayName,
                        x.EmployeeCode || '',
                        x.DepartmentName || '',
                        x.LeaveType,
                        fmtDate(x.StartDate),
                        fmtDate(x.EndDate),
                        days,
                        x.SessionCode || 'Cả ngày',
                        x.HandoverTo || '',
                        (x.Reason || '').replace(/"/g, '""'),
                        fmtDateTime(x.CreatedAt),
                        getStatusLabel(x.StatusCode, x.RoleCode),
                        (x.ManagerNote || x.HrNote || '').replace(/"/g, '""')
                    ];
                    var quoted = rowData.map(function (val) {
                        var text = val == null ? '' : String(val);
                        return '"' + (/^[=+@@\-]/.test(text) ? "'" : '') + text + '"';
                    });
                    csvContent += quoted.join(',') + '\n';
                });
            } else {
                csvContent += '"Thông báo: Không có dữ liệu phát sinh cho các loại yêu cầu đã chọn: ' + selectedTypes.join(', ') + '"\n';
            }

            var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', fileName + '.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        closeExportModal();
    }

    /* Event Handlers */
    $(document).ready(function () {
        applyHashParams();

        // Tabs click
        $('.tc-tab-item').on('click', function () {
            $('.tc-tab-item').removeClass('active');
            $(this).addClass('active');
            updateHash();
            render();
        });

        // Search & Filters input
        $('#filterSearch').on('input', function () {
            updateHash();
            render();
        });
        $('#filterDepartment, #filterType, #filterFromDate, #filterToDate').on('change', render);

        $('#btnClearFilters').on('click', function () {
            $('#filterSearch').val('');
            $('#filterDepartment').val('');
            $('#filterType').val('');
            $('#filterFromDate').val('');
            $('#filterToDate').val('');
            updateHash();
            render();
        });

        $('#tcRefreshBtn').on('click', function () {
            showToast('Đang làm mới dữ liệu...', 'info');
            loadData();
        });

        // Open Export Modal
        $('#tcExportBtn').on('click', openExportModal);
        $('#tcExportModalClose, #tcExportModalCancel, #tcExportModalBackdrop').on('click', closeExportModal);

        $(document).on('change', '.exp-chk', function () {
            var item = $(this).closest('.tc-export-item');
            if ($(this).is(':checked')) {
                item.addClass('is-checked');
            } else {
                item.removeClass('is-checked');
            }
            updateExportCount();
        });

        $('#btnExportSelectAll').on('click', function () {
            $('.tc-export-item:visible').each(function () {
                $(this).addClass('is-checked').find('.exp-chk').prop('checked', true);
            });
            updateExportCount();
        });

        $('#btnExportDeselectAll').on('click', function () {
            $('.tc-export-item').removeClass('is-checked').find('.exp-chk').prop('checked', false);
            updateExportCount();
        });

        // Search inside Export Modal
        $('#exportSearchInput').on('input', function () {
            var q = $(this).val().trim().toLowerCase();
            $('.tc-export-item').each(function () {
                var type = $(this).data('type').toLowerCase();
                if (!q || type.indexOf(q) !== -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        $('#btnDoExport').on('click', performExport);

        // Checkbox table events
        $('#chkSelectAll').on('change', function () {
            var checked = $(this).is(':checked');
            var currentFiltered = getFilteredList();
            currentFiltered.forEach(function (x) {
                if (canManage || canUserApprove(x)) {
                    if (checked) checkedIds.add(x.Id);
                    else checkedIds.delete(x.Id);
                }
            });
            render();
        });

        $(document).on('change', '.row-chk', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            if ($(this).is(':checked')) checkedIds.add(id);
            else checkedIds.delete(id);
            render();
        });

        $('#btnBulkDeselect').on('click', function () {
            checkedIds.clear();
            render();
        });

        $('#btnBulkApprove').on('click', function () {
            var ids = Array.from(checkedIds);
            if (!ids.length) return;
            if (!confirm('Bạn có chắc chắn muốn chấp thuận ' + ids.length + ' yêu cầu đã chọn?')) return;
            bulkDecide(ids, true, 'Chấp thuận hàng loạt');
        });

        $('#btnBulkReject').on('click', function () {
            var ids = Array.from(checkedIds);
            if (!ids.length) return;
            var note = prompt('Nhập lý do từ chối chung cho ' + ids.length + ' yêu cầu:');
            if (note === null) return;
            if (!note.trim()) {
                alert('Vui lòng nhập lý do từ chối.');
                return;
            }
            bulkDecide(ids, false, note.trim());
        });

        $('#btnBulkDelete').on('click', function () {
            var ids = Array.from(checkedIds);
            if (!ids.length) return;
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn ' + ids.length + ' yêu cầu đã chọn?')) return;
            bulkDeleteLeaves(ids);
        });

        // Row Click & Actions
        $(document).on('click', '.tc-table tbody tr', function (e) {
            if ($(e.target).closest('.td-checkbox, .tc-action-group, a').length) return;
            var id = +$(this).data('id');
            if (id) openDrawer(id);
        });

        $(document).on('click', '.open-detail', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openDrawer(+$(this).data('id'));
        });

        $(document).on('click', '.btn-quick-approve', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            var item = records.find(function (r) { return r.Id === id; });
            if (!item) return;
            if (!confirm('Chấp thuận yêu cầu ' + item.RequestCode + ' của ' + item.DisplayName + '?')) return;
            decide(id, true, 'Duyệt nhanh');
        });

        $(document).on('click', '.btn-quick-reject', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            var item = records.find(function (r) { return r.Id === id; });
            if (!item) return;
            var note = prompt('Nhập lý do từ chối yêu cầu ' + item.RequestCode + ':');
            if (note === null) return;
            if (!note.trim()) {
                alert('Vui lòng nhập lý do từ chối.');
                return;
            }
            decide(id, false, note.trim());
        });

        $(document).on('click', '.btn-quick-delete', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            var item = records.find(function (r) { return r.Id === id; });
            if (!item) return;
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn yêu cầu #' + item.RequestCode + ' của ' + item.DisplayName + '?')) return;
            deleteLeave(id);
        });

        // Drawer Close
        $('#tcDrawerClose, #tcDrawerCloseBtn, #tcDrawerBackdrop').on('click', closeDrawer);
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') {
                if ($('#tcExportModal').hasClass('is-open')) closeExportModal();
                else if ($('#tcDrawer').hasClass('is-open')) closeDrawer();
            }
        });

        // Drawer Approve / Reject Buttons
        $('#btnDrawerApprove').on('click', function () {
            if (!selectedRecord) return;
            var note = $('#drawerNoteInput').val().trim();
            decide(selectedRecord.Id, true, note, function () {
                closeDrawer();
            });
        });

        $('#btnDrawerReject').on('click', function () {
            if (!selectedRecord) return;
            var note = $('#drawerNoteInput').val().trim();
            if (!note) {
                alert('Vui lòng nhập lý do từ chối vào ô ghi chú.');
                $('#drawerNoteInput').focus();
                return;
            }
            decide(selectedRecord.Id, false, note, function () {
                closeDrawer();
            });
        });

        $('#btnDrawerDelete').on('click', function () {
            if (!selectedRecord) return;
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn yêu cầu #' + selectedRecord.RequestCode + ' này?')) return;
            deleteLeave(selectedRecord.Id, function () {
                closeDrawer();
            });
        });

        // Drawer Print
        $('#tcPrintBtn').on('click', function () {
            window.print();
        });

        // Listen for browser back/forward URL hash changes
        window.addEventListener('hashchange', function () {
            applyHashParams();
            render();
        });

        // Initial Load
        loadData();
    });
})();
</script>
