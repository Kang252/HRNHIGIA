@using NHIGIA.Modern.Models
@{
    var current = HrmUser.Current;
    var managerStage = current != null && current.RoleCode == HrmRoles.Manager;
}
<div class="container-fluid">
    <div class="hrm-page-header">
        <div><h1 class="hrm-page-title">Phê duyệt nghỉ phép</h1><p class="hrm-page-subtitle">@(managerStage ? "Duyệt cấp phòng trước khi chuyển HR" : "Xác nhận cuối cùng và cập nhật trạng thái phép")</p></div>
        <a class="hrm-btn" href="@Url.Action("LeaveRequests", "Home")"><i class="material-icons">event_note</i> Đơn của tôi</a>
    </div>
    <div class="hrm-card">
        <div class="hrm-card-header"><div><h2 class="hrm-card-title">Danh sách cần xử lý</h2><p class="hrm-card-subtitle">Dữ liệu tự động giới hạn theo vai trò và phòng ban</p></div><span id="approvalCount" class="hrm-badge hrm-badge-warning">0 đơn</span></div>
        <div class="hrm-table-wrap"><table class="hrm-table"><thead><tr><th>Nhân viên</th><th>Loại nghỉ</th><th>Thời gian</th><th>Lý do</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="approvalRows"></tbody></table></div>
    </div>
</div>
<form id="approvalToken">@Html.AntiForgeryToken()</form>
<script>
(function(){
    $('.approvals_menu').addClass('active');
    var managerStage = @managerStage.ToString().ToLowerInvariant();
    function esc(value){ return $('<div>').text(value == null ? '' : value).html(); }
    function date(value){ return value ? moment(value).format('DD/MM/YYYY') : ''; }
    function load(){
        $.get('@Url.Action("LeaveRequests","Hrm")').done(function(response){
            var pending = (response.Data || []).filter(function(item){ return managerStage ? item.StatusCode === 'PENDING_MANAGER' : item.StatusCode === 'PENDING_MANAGER' || item.StatusCode === 'PENDING_HR'; });
            $('#approvalCount').text(pending.length + ' đơn');
            if(!pending.length){ $('#approvalRows').html('<tr><td colspan="6"><div class="hrm-empty"><i class="material-icons">task_alt</i>Không có đơn nào cần xử lý.</div></td></tr>'); return; }
            $('#approvalRows').html(pending.map(function(item){
                return '<tr><td><strong>'+esc(item.DisplayName)+'</strong><small class="hrm-cell-note">'+esc(item.DepartmentName)+'</small></td><td>'+esc(item.LeaveType)+'</td><td>'+date(item.StartDate)+' — '+date(item.EndDate)+'</td><td>'+esc(item.Reason)+'</td><td><span class="hrm-badge hrm-badge-warning">'+(item.StatusCode==='PENDING_MANAGER'?'Chờ Trưởng phòng':'Chờ HR')+'</span></td><td><button class="hrm-btn decide" data-id="'+item.Id+'" data-ok="true">Duyệt</button> <button class="hrm-btn decide" data-id="'+item.Id+'" data-ok="false">Từ chối</button></td></tr>';
            }).join(''));
        });
    }
    $(document).on('click','.decide',function(){
        var button=$(this), approve=String(button.data('ok'))==='true';
        var note=window.prompt(approve?'Ghi chú duyệt (không bắt buộc):':'Nhập lý do từ chối:','');
        if(note===null)return;
        $.post('@Url.Action("ApproveLeave","Hrm")',{__RequestVerificationToken:$('#approvalToken input').val(),Id:button.data('id'),Approve:approve,Note:note}).done(load).fail(function(xhr){alert((xhr.responseJSON&&xhr.responseJSON.Message)||'Không thể xử lý đơn.');});
    });
    load();
})();
</script>
