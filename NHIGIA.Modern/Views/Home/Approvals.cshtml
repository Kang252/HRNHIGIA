                endDate = lastDay;
                sessionCode = 'Bàn giao: ' + fmtDate(hoDay);
                handoverTo = ho;

                reason = 'Tiêu đề: ' + title + '\n' +
                         'Ngày làm việc cuối: ' + fmtDate(lastDay) + ' | Hoàn tất bàn giao: ' + fmtDate(hoDay) + '\n' +
                         'Người nhận bàn giao: ' + ho + '\n' +
                         'Lý do nghỉ việc: ' + r;
            } else if (tpl === 'APPOINTMENT') {
                var oldPos = ($('#dynOldPos').val() || '').trim();
                var newPos = ($('#dynNewPos').val() || '').trim();
                var effDate = $('#dynEffectiveDate').val();
                var newSal = ($('#dynNewSalary').val() || '').trim();
                var r = ($('#dynReason').val() || '').trim();

                if (!newPos) {
                    alert('Vui lòng nhập vị trí/chức vụ mới.');
                    $('#dynNewPos').focus();
                    return;
                }
                if (!effDate) {
                    alert('Vui lòng chọn ngày có hiệu lực.');
                    return;
                }
                if (!r) {
                    alert('Vui lòng nhập lý do đề xuất bổ nhiệm/điều chuyển.');
                    $('#dynReason').focus();
                    return;
                }

                startDate = moment().format('YYYY-MM-DD');
                endDate = effDate;
                sessionCode = 'Bổ nhiệm: ' + newPos;
                handoverTo = oldPos;

                reason = 'Tiêu đề: ' + title + '\n' +
                         'Hiện tại: ' + (oldPos || 'Chưa cập nhật') + ' -> Mới: ' + newPos + '\n' +
                         'Ngày hiệu lực: ' + fmtDate(effDate) + (newSal ? ' | Mức lương mới: ' + newSal : '') + '\n' +
                         'Lý do đề xuất: ' + r;
            } else if (tpl === 'REWARD_DISCIPLINE') {
                var formType = $('#dynFormType').val();
                var amt = ($('#dynAmount').val() || '').trim();
                var effDate = $('#dynEffectiveDate').val();
                var r = ($('#dynReason').val() || '').trim();

                if (!effDate) {
                    alert('Vui lòng chọn ngày có hiệu lực.');
                    return;
                }
                if (!r) {
                    alert('Vui lòng nhập nội dung thành tích hoặc vi phạm.');
                    $('#dynReason').focus();
                    return;
                }

                startDate = moment().format('YYYY-MM-DD');
                endDate = effDate;
                sessionCode = formType;
                handoverTo = amt ? ('Số tiền: ' + amt) : 'Không có tiền mặt';

                reason = 'Tiêu đề: ' + title + '\n' +
                         'Hình thức: ' + formType + (amt ? ' | Số tiền: ' + amt : '') + ' | Ngày hiệu lực: ' + fmtDate(effDate) + '\n' +
                         'Chi tiết: ' + r;
            }

            var btn = $(this);
            btn.prop('disabled', true).html('<i class="material-icons" style="font-size:16px;vertical-align:middle;">sync</i> Đang gửi...');

            var rangeError = HrmRequestForm.dateRangeError(startDate, endDate);
        if (rangeError) { alert(rangeError); return; }
        if (reason.length > 16000) { alert('Nội dung yêu cầu tối đa 16.000 ký tự.'); return; }
        var payload = new FormData();
            payload.append('__RequestVerificationToken', token || '');
            if (empId) payload.append('EmployeeId', +empId);
            payload.append('LeaveType', type);
            payload.append('StartDate', startDate);
            payload.append('EndDate', endDate);
            payload.append('SessionCode', sessionCode);
            payload.append('HandoverTo', handoverTo);
            payload.append('Reason', reason);
            if (file) payload.append('attachment', file, file.name);
            $.ajax({
                url: '@Url.Action("CreateLeave", "Hrm")', method: 'POST', data: payload,
                processData: false, contentType: false
            }).done(function (res) {
                var reqCode = (res.Data && res.Data.RequestCode) || '';
                showToast('Đã tạo đề xuất ' + (reqCode ? '#' + reqCode : '') + ' thành công!', 'success');
                closeCreateModal();
                $('.tc-tab-item[data-status="waiting"]').trigger('click');
                loadData();
            }).fail(function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Không thể tạo yêu cầu.';
                showToast(msg, 'danger');
                alert(msg);
            }).always(function () {
                btn.prop('disabled', false).html('<i class="material-icons" style="font-size:18px;">add_task</i> Tạo mới');
            });
        });

        // Open Export Modal
        $('#tcExportBtn').on('click', openExportModal);
        $('#tcExportModalClose, #tcExportModalCancel, #tcExportModalBackdrop').on('click', closeExportModal);

        $(document).on('change', '.exp-chk', function () {
            var item = $(this).closest('.tc-export-item');
            if ($(this).is(':checked')) {
                item.addClass('is-checked');
            } else {
                item.removeClass('is-checked');
            }
            updateExportCount();
        });

        // Category Toggle
        $(document).on('click', '.tc-cat-select-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var cat = $(this).closest('.tc-export-category');
            var chks = cat.find('.exp-chk');
            var allChecked = chks.length === cat.find('.exp-chk:checked').length;
            chks.prop('checked', !allChecked).each(function () {
                var item = $(this).closest('.tc-export-item');
                if (!allChecked) item.addClass('is-checked');
                else item.removeClass('is-checked');
            });
            updateExportCount();
        });

        $('#btnExportSelectAll').on('click', function () {
            $('.tc-export-item:visible').each(function () {
                $(this).addClass('is-checked').find('.exp-chk').prop('checked', true);
            });
            updateExportCount();
        });

        $('#btnExportDeselectAll').on('click', function () {
            $('.tc-export-item').removeClass('is-checked').find('.exp-chk').prop('checked', false);
            updateExportCount();
        });

        // Search inside Export Modal
        $('#exportSearchInput').on('input', function () {
            var q = $(this).val().trim().toLowerCase();
            $('.tc-export-item').each(function () {
                var type = $(this).data('type').toLowerCase();
                if (!q || type.indexOf(q) !== -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
            $('.tc-export-category').each(function () {
                var hasVisible = $(this).find('.tc-export-item:visible').length > 0;
                $(this).toggle(hasVisible);
            });
        });

        $('#btnDoExport').on('click', performExport);

        // Checkbox table events
        $('#chkSelectAll').on('change', function () {
            var checked = $(this).is(':checked');
            var currentFiltered = getFilteredList();
            currentFiltered.forEach(function (x) {
                if (canManage || canUserApprove(x)) {
                    if (checked) checkedIds.add(x.Id);
                    else checkedIds.delete(x.Id);
                }
            });
            render();
        });

        $(document).on('change', '.row-chk', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            if ($(this).is(':checked')) checkedIds.add(id);
            else checkedIds.delete(id);
            render();
        });

        $('#btnBulkDeselect').on('click', function () {
            checkedIds.clear();
            render();
        });

        $('#btnBulkApprove').on('click', function () {
            var ids = Array.from(checkedIds);
            if (!ids.length) return;
            if (!confirm('Bạn có chắc chắn muốn chấp thuận ' + ids.length + ' yêu cầu đã chọn?')) return;
            bulkDecide(ids, true, 'Chấp thuận hàng loạt');
        });

        $('#btnBulkReject').on('click', function () {
            var ids = Array.from(checkedIds);
            if (!ids.length) return;
            var note = prompt('Nhập lý do từ chối chung cho ' + ids.length + ' yêu cầu:');
            if (note === null) return;
            if (!note.trim()) {
                alert('Vui lòng nhập lý do từ chối.');
                return;
            }
            bulkDecide(ids, false, note.trim());
        });

        $('#btnBulkDelete').on('click', function () {
            var ids = Array.from(checkedIds);
            if (!ids.length) return;
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn ' + ids.length + ' yêu cầu đã chọn?')) return;
            bulkDeleteLeaves(ids);
        });

        // Row Click & Actions
        $(document).on('click', '.tc-table tbody tr', function (e) {
            if ($(e.target).closest('.td-checkbox, .tc-action-group, a').length) return;
            var id = +$(this).data('id');
            if (id) openDrawer(id);
        });

        $(document).on('click', '.open-detail', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openDrawer(+$(this).data('id'));
        });

        $(document).on('click', '.btn-quick-approve', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            var item = records.find(function (r) { return r.Id === id; });
            if (!item) return;
            if (!confirm('Chấp thuận yêu cầu ' + item.RequestCode + ' của ' + item.DisplayName + '?')) return;
            decide(id, true, 'Duyệt nhanh');
        });

        $(document).on('click', '.btn-quick-reject', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            var item = records.find(function (r) { return r.Id === id; });
            if (!item) return;
            var note = prompt('Nhập lý do từ chối yêu cầu ' + item.RequestCode + ':');
            if (note === null) return;
            if (!note.trim()) {
                alert('Vui lòng nhập lý do từ chối.');
                return;
            }
            decide(id, false, note.trim());
        });

        $(document).on('click', '.btn-quick-delete', function (e) {
            e.stopPropagation();
            var id = +$(this).data('id');
            var item = records.find(function (r) { return r.Id === id; });
            if (!item) return;
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn yêu cầu #' + item.RequestCode + ' của ' + item.DisplayName + '?')) return;
            deleteLeave(id);
        });

        // Drawer Close
        $('#tcDrawerClose, #tcDrawerCloseBtn, #tcDrawerBackdrop').on('click', closeDrawer);
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') {
                if ($('#tcCreateModal').hasClass('is-open')) closeCreateModal();
                else if ($('#tcExportModal').hasClass('is-open')) closeExportModal();
                else if ($('#tcDrawer').hasClass('is-open')) closeDrawer();
            }
        });

        // Drawer Approve / Reject Buttons
        $('#btnDrawerApprove').on('click', function () {
            if (!selectedRecord) return;
            var note = $('#drawerNoteInput').val().trim();
            decide(selectedRecord.Id, true, note, function () {
                closeDrawer();
            });
        });

        $('#btnDrawerReject').on('click', function () {
            if (!selectedRecord) return;
            var note = $('#drawerNoteInput').val().trim();
            if (!note) {
                alert('Vui lòng nhập lý do từ chối vào ô ghi chú.');
                $('#drawerNoteInput').focus();
                return;
            }
            decide(selectedRecord.Id, false, note, function () {
                closeDrawer();
            });
        });

        $('#btnDrawerDelete').on('click', function () {
            if (!selectedRecord) return;
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn yêu cầu #' + selectedRecord.RequestCode + ' này?')) return;
            deleteLeave(selectedRecord.Id, function () {
                closeDrawer();
            });
        });

        // Drawer Print
        $('#tcPrintBtn').on('click', function () {
            window.print();
        });

        // Listen for browser back/forward URL hash changes
        window.addEventListener('hashchange', function () {
            applyHashParams();
            render();
        });

        // Initial Load
        loadData();
    });
})();
</script>
