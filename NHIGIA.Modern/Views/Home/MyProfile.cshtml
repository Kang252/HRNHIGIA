                        <p>Nhân sự đang hoạt động chính thức và gắn bó tại Nhị Gia.</p>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- TAB 16: EXIT CHECKLIST -->
            <!-- ========================================================================= -->
            <div id="tab-exit" class="s5-tab-pane">
                <div class="s5-card">
                    <div class="s5-card-header"><h3 class="s5-card-title">Exit Checklist (Bàn giao nghỉ việc)</h3></div>
                    <div class="s5-empty-state">
                        <i class="material-icons text-muted">assignment_turned_in</i>
                        <h4>Quy trình Exit Checklist chưa kích hoạt</h4>
                        <p>Chỉ áp dụng khi có thủ tục chấm dứt hợp đồng lao động đã được phê duyệt.</p>
                    </div>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Clear any leftover cached test avatar from localStorage
        try {
            for (let i = 1; i <= 30; i++) {
                localStorage.removeItem("hrm_avatar_" + i);
            }
        } catch (e) {}

        // Tab switching interaction
        const tabItems = document.querySelectorAll(".s5-tab-item");
        const tabPanes = document.querySelectorAll(".s5-tab-pane");

        tabItems.forEach(item => {
            item.addEventListener("click", function () {
                const targetTabId = this.getAttribute("data-tab");
                if (!targetTabId) return;

                tabItems.forEach(t => t.classList.remove("active"));
                tabPanes.forEach(p => p.classList.remove("active"));

                this.classList.add("active");
                const targetPane = document.getElementById(targetTabId);
                if (targetPane) {
                    targetPane.classList.add("active");
                }
            });
        });

        // Search inputs inside data tables
        const searchInputs = document.querySelectorAll(".s5-search-input");
        searchInputs.forEach(input => {
            input.addEventListener("input", function () {
                const targetTable = document.querySelector(this.getAttribute("data-target"));
                if (!targetTable) return;
                const filter = this.value.toLowerCase().trim();
                const rows = targetTable.querySelectorAll("tbody tr");

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(filter) ? "" : "none";
                });
            });
        });
    });
</script>

