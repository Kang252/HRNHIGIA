@using NHIGIA.Modern.Models
@{ var u=HrmUser.Current; var role=u?.RoleCode??""; var moderate=role==HrmRoles.Admin||role==HrmRoles.Hr||role==HrmRoles.Director; var company=u!=null&&HrmRoles.CanPublishCompanyWide(role); var managers=company||role==HrmRoles.Manager; var currentAvatarUrl=ViewBag.CurrentAvatarUrl as string; var currentJobTitle=ViewBag.CurrentJobTitle as string; var nameParts=(u?.DisplayName??"NV").Split(' ',StringSplitOptions.RemoveEmptyEntries); var currentInitials=string.Concat(nameParts.TakeLast(2).Select(x=>x[0])).ToUpperInvariant(); }
<div class="container-fluid wall">
 <div class="hrm-page-header"><div><h1 class="hrm-page-title">Truyền thông nội bộ</h1><p class="hrm-page-subtitle">Chia sẻ và kết nối trong Nhị Gia</p></div><button id="newPost" class="hrm-btn hrm-btn-primary"><i class="material-icons">edit</i>Tạo bài viết</button></div>
 <div id="notice" class="notice" hidden></div>
 <div class="wall-grid">
  <aside><div class="hrm-card wall-user"><span class="avatar wall-avatar">@currentInitials@if(!string.IsNullOrWhiteSpace(currentAvatarUrl)){<img src="@currentAvatarUrl" alt="Ảnh đại diện của @u?.DisplayName" />}</span><b>@u?.DisplayName</b><small>@(string.IsNullOrWhiteSpace(currentJobTitle)?"Nhân viên":currentJobTitle)</small><small>@u?.DepartmentName</small></div><nav class="hrm-card wall-tabs"><button class="active" data-tab="feed"><i class="material-icons">dynamic_feed</i>Bảng tin</button><button data-tab="mine"><i class="material-icons">article</i>Bài của tôi</button><button data-tab="pending"><i class="material-icons">hourglass_top</i>@(moderate?"Chờ duyệt":"Đang chờ duyệt") <b id="pendingCount">0</b></button></nav></aside>
  <main>
   <section id="composer" class="hrm-card composer" hidden><header><b>Tạo bài viết</b><button id="closePost"><i class="material-icons">close</i></button></header>
    <form id="postForm" enctype="multipart/form-data">@Html.AntiForgeryToken()
     <div class="form-grid"><label>Chuyên mục<select id="cat" class="hrm-control"><option>Thông báo công ty</option><option>Nhân sự</option><option>Hoạt động nội bộ</option><option>Đào tạo</option><option>Chia sẻ</option><option>Khác</option></select></label><label>Phạm vi<select id="scope" class="hrm-control">@if(company){<option value="ALL">Toàn công ty</option>}<option value="DEPARTMENT">Phòng ban của tôi</option>@if(managers){<option value="MANAGER">Nhóm quản lý</option>}</select></label></div>
     <input id="title" class="post-title" maxlength="200" required placeholder="Tiêu đề bài viết"><textarea id="body" maxlength="5000" required placeholder="Bạn muốn chia sẻ điều gì?"></textarea>
     <div id="fileInfo" class="file-info" hidden><i class="material-icons">attach_file</i><span></span><button type="button">Bỏ tệp</button></div><img id="preview" class="preview" hidden>
     <footer><label class="attach"><i class="material-icons">image</i>Ảnh / tệp<input id="attachment" name="attachment" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,image/*"></label>@if(moderate){<label><input id="pinned" type="checkbox"> Ghim bài</label>}<button class="hrm-btn hrm-btn-primary" type="submit"><i class="material-icons">send</i>@(moderate?"Đăng bài":"Gửi duyệt")</button></footer>
    </form>
   </section>
   <div class="hrm-card mobile-search"><input class="search hrm-control" placeholder="Tìm bài viết..."></div>
   <div id="feed" class="feed"><div class="hrm-card hrm-empty">Đang tải bảng tin…</div></div>
  </main>
  <aside class="right"><div class="hrm-card filters"><h2>Tìm trên bảng tin</h2><input class="search hrm-control" placeholder="Tiêu đề hoặc nội dung..."><h3>Chuyên mục</h3><div id="categories"><button class="active" data-category="">Tất cả</button><button data-category="Thông báo công ty">Thông báo</button><button data-category="Nhân sự">Nhân sự</button><button data-category="Hoạt động nội bộ">Hoạt động</button><button data-category="Đào tạo">Đào tạo</button><button data-category="Chia sẻ">Chia sẻ</button></div></div></aside>
 </div>
</div>
<script>
(function(){
 var mod=@moderate.ToString().ToLowerInvariant(),tab='feed',category='',timer,token=$('#postForm input[name="__RequestVerificationToken"]').val();
 function e(v){return $('<div>').text(v==null?'':v).html()} function job(v){return e(v||'Nhân viên')} function av(url,name){return '<span class="avatar">'+ini(name)+(url?'<img src="'+e(url)+'" alt="Ảnh đại diện của '+e(name)+'" loading="lazy" onerror="this.remove()">':'')+'</span>'} function ini(v){return e((v||'NV').trim().split(/\s+/).slice(-2).map(x=>x[0]).join('').toUpperCase())} function sc(v){return v==='ALL'?'Toàn công ty':v==='MANAGER'?'Nhóm quản lý':'Phòng ban'} function sl(v){return v==='PENDING'?'Chờ duyệt':v==='REJECTED'?'Đã từ chối':'Đã đăng'}
 function note(v,bad){$('#notice').toggleClass('bad',!!bad).text(v).prop('hidden',false);setTimeout(()=>$('#notice').prop('hidden',true),4000)}
 function file(x){if(!x.AttachmentName)return'';var url='@Url.Action("CommunicationAttachment","Hrm")?id='+x.Id,img=(x.AttachmentContentType||'').startsWith('image/')?'<a href="'+url+'" target="_blank"><img class="post-image" src="'+url+'" loading="lazy"></a>':'';return img+'<a class="post-file" href="'+url+'&download=true"><i class="material-icons">description</i><span>'+e(x.AttachmentName)+'</span><i class="material-icons">download</i></a>'}
 function comments(x){return '<div class="comments">'+(x.Comments||[]).map(c=>'<div class="comment">'+av(c.AuthorAvatarUrl,c.AuthorName)+'<div><b>'+e(c.AuthorName)+'</b><small class="comment-role">'+job(c.AuthorJobTitle)+'</small><p>'+e(c.Body)+'</p><small>'+moment(c.CreatedAt).fromNow()+'</small></div></div>').join('')+'</div><form class="comment-form" data-id="'+x.Id+'"><input maxlength="1500" required placeholder="Viết bình luận..."><button><i class="material-icons">send</i></button></form>'}
 function card(x){var published=x.StatusCode==='PUBLISHED',actions=mod&&x.StatusCode==='PENDING'?'<div class="review"><button class="approve hrm-btn" data-id="'+x.Id+'">Duyệt đăng</button><button class="reject hrm-btn" data-id="'+x.Id+'">Từ chối</button></div>':'';return '<article class="hrm-card post"><header>'+av(x.AuthorAvatarUrl,x.AuthorName)+'<div><b>'+e(x.AuthorName)+'</b><small class="author-role">'+job(x.AuthorJobTitle)+'</small><small>'+moment(x.SubmittedAt||x.PublishedAt).format('DD/MM/YYYY HH:mm')+' · '+sc(x.ScopeCode)+'</small></div><em class="'+(x.StatusCode||'').toLowerCase()+'">'+sl(x.StatusCode)+'</em></header><label>'+e(x.Category)+'</label><h2>'+e(x.Title)+'</h2><p>'+e(x.Body).replace(/\n/g,'<br>')+'</p>'+file(x)+(x.ReviewNote?'<div class="reason"><b>Lý do:</b> '+e(x.ReviewNote)+'</div>':'')+actions+(published?'<div class="counts"><span><b class="likes">'+(x.LikeCount||0)+'</b> lượt thích</span><span><b>'+(x.CommentCount||0)+'</b> bình luận</span></div><div class="interact"><button class="like '+(x.LikedByCurrentUser?'active':'')+'" data-id="'+x.Id+'"><i class="material-icons">thumb_up</i>Thích</button><button class="focus-comment"><i class="material-icons">chat_bubble_outline</i>Bình luận</button></div>'+comments(x):'')+'</article>'}
 function load(){var status=tab==='feed'?'PUBLISHED':tab==='pending'?'PENDING':'';$('#feed').html('<div class="hrm-card hrm-empty">Đang tải…</div>');$.get('@Url.Action("Communications","Hrm")',{keyword:$('.search').first().val()||'',category:category,status:status}).done(r=>{var a=r.Data||[];if(tab==='mine')a=a.filter(x=>x.IsMine);if(tab==='pending')$('#pendingCount').text(a.length);$('#feed').html(a.length?a.map(card).join(''):'<div class="hrm-card hrm-empty"><i class="material-icons">dynamic_feed</i><strong>Chưa có bài viết phù hợp</strong></div>')}).fail(x=>$('#feed').html('<div class="hrm-card alert alert-danger">'+e(x.responseJSON?.Message||'Không thể tải bảng tin.')+'</div>'))}
 function send(url,data){data.__RequestVerificationToken=token;return $.post(url,data)}
 $('#newPost').click(()=>{$('#composer').prop('hidden',false);$('#title').focus()});$('#closePost').click(()=>$('#composer').prop('hidden',true));$('.wall-tabs button').click(function(){$('.wall-tabs button').removeClass('active');$(this).addClass('active');tab=$(this).data('tab');load()});$('#categories button').click(function(){$('#categories button').removeClass('active');$(this).addClass('active');category=$(this).data('category');load()});$('.search').on('input',function(){$('.search').val(this.value);clearTimeout(timer);timer=setTimeout(load,350)});
 function resetFile(){var p=document.getElementById('preview');if(p.src)URL.revokeObjectURL(p.src);$('#attachment').val('');p.hidden=true;p.removeAttribute('src');$('#fileInfo').prop('hidden',true)} $('#attachment').change(function(){var f=this.files[0],p=document.getElementById('preview');if(!f)return resetFile();if(f.size>10485760){note('Tệp vượt quá 10 MB.',true);return resetFile()}$('#fileInfo').prop('hidden',false).find('span').text(f.name);if(f.type.startsWith('image/')){p.src=URL.createObjectURL(f);p.hidden=false}});$('#fileInfo button').click(resetFile);
 $('#postForm').submit(function(ev){ev.preventDefault();var d=new FormData(this),btn=$(this).find('[type=submit]');d.append('Category',$('#cat').val());d.append('ScopeCode',$('#scope').val());d.append('Title',$('#title').val());d.append('Body',$('#body').val());d.append('IsPinned',$('#pinned').is(':checked'));btn.prop('disabled',true);$.ajax({url:'@Url.Action("CreateCommunication","Hrm")',method:'POST',data:d,processData:false,contentType:false}).done(r=>{var pending=r.Data?.StatusCode==='PENDING';note(pending?'Đã gửi bài và đang chờ duyệt.':'Đã đăng bài viết.');this.reset();resetFile();$('#composer').prop('hidden',true);tab=pending?'mine':'feed';$('.wall-tabs button[data-tab="'+tab+'"]').trigger('click')}).fail(x=>note(x.responseJSON?.Message||'Không thể gửi bài.',true)).always(()=>btn.prop('disabled',false))});
 $('#feed').on('click','.like',function(){var b=$(this);send('@Url.Action("ToggleCommunicationReaction","Hrm")',{Id:b.data('id')}).done(r=>{b.toggleClass('active',r.Data.Liked);b.closest('.post').find('.likes').text(r.Data.Count)})}).on('click','.focus-comment',function(){$(this).closest('.post').find('.comment-form input').focus()}).on('click','.approve',function(){send('@Url.Action("ModerateCommunication","Hrm")',{Id:$(this).data('id'),Approve:true}).done(()=>{note('Đã duyệt bài.');load()})}).on('click','.reject',function(){var id=$(this).data('id'),n=prompt('Lý do từ chối:');if(n!==null)send('@Url.Action("ModerateCommunication","Hrm")',{Id:id,Approve:false,Note:n}).done(()=>{note('Đã từ chối bài.');load()})}).on('submit','.comment-form',function(ev){ev.preventDefault();var f=$(this),i=f.find('input');send('@Url.Action("AddCommunicationComment","Hrm")',{Id:f.data('id'),Body:i.val()}).done(()=>{i.val('');load()}).fail(x=>note(x.responseJSON?.Message||'Không thể bình luận.',true))});
 $.get('@Url.Action("Communications","Hrm")',{status:'PENDING'}).done(r=>$('#pendingCount').text((r.Data||[]).length));load();
})();
</script>
<style>
.wall{max-width:1500px}.wall-grid{display:grid;grid-template-columns:210px minmax(430px,720px) minmax(230px,300px);gap:16px;justify-content:center;align-items:start}.wall-grid>aside{position:sticky;top:74px}.wall-user{padding:20px;text-align:center}.wall-avatar{width:64px!important;height:64px!important;margin:0 auto 10px;font-size:16px!important}.avatar{position:relative;overflow:hidden}.avatar img{position:absolute;inset:0;width:100%;height:100%;border-radius:inherit;object-fit:cover;background:#eaf2ff}.wall-user b,.wall-user small{display:block}.wall-user small{color:#718096;margin-top:4px}.wall-tabs{padding:8px;margin-top:12px}.wall-tabs button{display:flex;width:100%;align-items:center;gap:9px;padding:11px;border:0;border-radius:9px;background:none;color:#475467;text-align:left}.wall-tabs button.active,.wall-tabs button:hover{color:#1769e0;background:#eaf2ff}.wall-tabs i{font-size:20px}.wall-tabs b{margin-left:auto}.wall-grid main,.feed{display:grid;gap:14px}.composer{padding:18px}.composer[hidden],.file-info[hidden],.preview[hidden],.notice[hidden]{display:none}.composer header{display:flex;justify-content:space-between}.composer header button,.file-info button{border:0;background:none}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.form-grid label{font-size:12px;font-weight:700}.post-title,.composer textarea{width:100%;border:0;border-bottom:1px solid #e2e8f0;outline:0}.post-title{padding:16px 2px 10px;font-size:18px;font-weight:700}.composer textarea{min-height:110px;padding:12px 2px;resize:vertical}.composer footer{display:flex;align-items:center;gap:12px;margin-top:12px}.composer footer>.hrm-btn{margin-left:auto}.attach{display:flex;gap:6px;align-items:center;color:#16824f;cursor:pointer}.attach input{display:none}.file-info,.post-file{display:flex;gap:9px;align-items:center;padding:10px;border:1px solid #dce5f0;border-radius:9px;background:#f7faff}.file-info span,.post-file span{flex:1}.preview,.post-image{display:block;width:100%;max-height:540px;margin-top:12px;border-radius:12px;object-fit:contain;background:#f3f6fa}.post{padding:18px}.post header{display:flex;gap:10px;align-items:center}.avatar{display:inline-grid;width:40px;height:40px;flex:0 0 40px;place-items:center;border-radius:50%;background:#438ced;color:#fff;font-size:11px;font-weight:700}.post header>div{flex:1}.post header b,.post header small{display:block}.post header small{color:#718096}.post header em{padding:5px 9px;border-radius:14px;background:#eaf8ef;color:#16824f;font-size:11px;font-style:normal}.post header em.pending{background:#fff5df;color:#946200}.post header em.rejected{background:#ffebec;color:#b4232a}.post>label{display:inline-block;margin-top:13px;color:#1769e0;font-size:12px}.post h2{margin:6px 0 8px;font-size:19px}.post>p{line-height:1.6;overflow-wrap:anywhere}.post-file{margin-top:10px;text-decoration:none}.counts{display:flex;justify-content:space-between;margin-top:12px;padding:9px 0;border-bottom:1px solid #edf0f4;color:#667085;font-size:12px}.interact{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #edf0f4}.interact button{padding:10px;border:0;background:none;color:#667085}.interact button.active,.interact button:hover{color:#1769e0;background:#f5f8fd}.interact i{font-size:18px;vertical-align:middle;margin-right:6px}.comments{display:grid;gap:9px;margin-top:12px}.comment{display:flex;gap:8px}.comment .avatar{width:30px;height:30px;flex-basis:30px}.comment>div{padding:8px 11px;border-radius:5px 14px 14px;background:#f1f4f8}.comment p{margin:2px 0}.comment small{color:#8491a3}.comment-form{display:flex;gap:8px;margin-top:10px}.comment-form input{flex:1;min-width:0;padding:9px 13px;border:1px solid #dde4ed;border-radius:20px}.comment-form button{width:36px;border:0;border-radius:50%;background:#1769e0;color:#fff}.review{display:flex;gap:8px;margin-top:12px;padding:11px;background:#fff8e8;border-radius:9px}.review .approve{background:#159455;color:#fff}.reason{padding:10px;background:#fff0f0;color:#963737}.filters{padding:16px}.filters h2{font-size:15px}.filters h3{font-size:12px;color:#667085;text-transform:uppercase}.filters input{margin-bottom:16px}.filters button{padding:7px 10px;margin:3px;border:1px solid #e0e6ee;border-radius:15px;background:#fff}.filters button.active{color:#1769e0;background:#eaf2ff}.notice{position:fixed;z-index:1100;right:20px;top:70px;padding:12px 16px;border-radius:8px;background:#159455;color:#fff}.notice.bad{background:#c83b45}.mobile-search{display:none;padding:10px}@@media(max-width:1180px){.wall-grid{grid-template-columns:190px minmax(430px,1fr)}.wall-grid>.right{display:none}}@@media(max-width:900px){.wall-grid{grid-template-columns:1fr}.wall-grid>aside{position:static}.wall-user{display:none}.wall-tabs{display:grid;grid-template-columns:repeat(3,1fr)}.wall-tabs button{justify-content:center}.wall-tabs i{display:none}.mobile-search{display:block}}@@media(max-width:600px){.form-grid{grid-template-columns:1fr}.composer footer{flex-wrap:wrap}.composer footer>.hrm-btn{width:100%;margin:0}.post{padding:14px}}
.post header .author-role,.comment .comment-role{color:#1769e0;font-size:11px;font-weight:600}.comment .comment-role{display:block;margin-top:1px}
</style>
