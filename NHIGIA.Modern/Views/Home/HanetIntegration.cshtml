<div class="container-fluid">
    <div class="hrm-page-header">
        <div><h1 class="hrm-page-title">Tích hợp camera HANET</h1><p class="hrm-page-subtitle">Cấu hình API, webhook và ánh xạ khuôn mặt với nhân viên</p></div>
        <button id="testHanet" class="hrm-btn"><i class="material-icons">network_check</i> Kiểm tra kết nối</button>
    </div>
    <div class="hrm-grid hrm-grid-2">
        <div class="hrm-card"><div class="hrm-card-header"><div><h2 class="hrm-card-title">Cấu hình kết nối</h2><p class="hrm-card-subtitle">Thông tin bí mật được mã hóa trước khi lưu</p></div></div><div class="hrm-card-body">
            <form id="hanetForm">@Html.AntiForgeryToken()
                <div class="form-group"><label>API base URL</label><input id="hanetApi" class="hrm-control" required /></div>
                <div class="form-group"><label>OAuth token URL</label><input id="hanetOAuth" class="hrm-control" required /></div>
                <div class="row"><div class="col-sm-6"><div class="form-group"><label>Client ID</label><input id="hanetClient" class="hrm-control" /></div></div><div class="col-sm-6"><div class="form-group"><label>Client secret</label><input id="hanetSecret" class="hrm-control" type="password" placeholder="Để trống nếu không đổi" /></div></div></div>
                <div class="form-group"><label>Access token</label><input id="hanetToken" class="hrm-control" type="password" placeholder="Để trống nếu không đổi" /></div>
                <div class="row"><div class="col-sm-6"><div class="form-group"><label>Địa điểm HANET</label><input id="hanetPlace" class="hrm-control" list="hanetPlaceOptions" placeholder="Nhập hoặc chọn Place ID" /><datalist id="hanetPlaceOptions"></datalist><p id="hanetPlaceNote" class="hrm-field-note">Place ID được lấy trực tiếp từ tài khoản HANET.</p></div></div><div class="col-sm-6"><div class="form-group"><label>Webhook secret dự phòng</label><input id="hanetWebhook" class="hrm-control" /><p class="hrm-field-note">Có thể để trống khi dùng chữ ký hash chính thức.</p></div></div></div>
                <label class="hrm-check"><input id="hanetEnabled" type="checkbox" /> Bật nhận dữ liệu HANET</label>
                <div class="hanet-webhook-box"><span>Webhook khai báo trên HANET</span><code id="hanetWebhookUrl">@($"{Context.Request.Scheme}://{Context.Request.Host}")@Url.Action("Receive","HanetWebhook")</code><button id="copyWebhook" class="hrm-btn" type="button"><i class="material-icons">content_copy</i> Sao chép</button></div>
                <button class="hrm-btn hrm-btn-primary" type="submit" style="margin-top:16px">Lưu cấu hình</button> <span id="hanetMessage" class="hrm-field-note"></span>
                <div id="hanetStatus" class="hanet-status"></div>
            </form>
        </div></div>
        <div class="hrm-card"><div class="hrm-card-header"><div><h2 class="hrm-card-title">Ánh xạ nhân viên</h2><p class="hrm-card-subtitle">Ghép Person ID/Alias ID từ HANET với tài khoản HRM</p></div></div><div class="hrm-card-body">
            <div class="hanet-person-toolbar">
                <button id="loadHanetPersons" class="hrm-btn hrm-btn-primary" type="button"><i class="material-icons">groups</i> Tải nhân viên HANET</button>
                <label class="hanet-person-search"><i class="material-icons">search</i><input id="hanetPersonSearch" type="search" placeholder="Tìm theo tên, Person ID hoặc Alias ID" /></label>
            </div>
            <div id="hanetPersonResult" class="hanet-import-result" hidden></div>
            <div id="hanetPersonList" class="hanet-person-list" hidden></div>
            <form id="mapForm">@Html.AntiForgeryToken()
                <div class="form-group"><label>Nhân viên</label><select id="mapUser" class="hrm-control"></select></div>
                <div class="form-group"><label>Person ID</label><input id="mapPerson" class="hrm-control" /></div>
                <div class="form-group"><label>Alias ID</label><input id="mapAlias" class="hrm-control" /></div>
                <button class="hrm-btn hrm-btn-primary" type="submit">Lưu ánh xạ</button>
            </form>
            <div class="hanet-import">
                <div class="hanet-import-heading"><div><strong>Nhập hàng loạt bằng file</strong><p>CSV UTF-8, có thể chỉnh sửa và lưu từ Excel.</p></div><a class="hrm-btn" href="@Url.Action("HanetMappingTemplate","Hrm")"><i class="material-icons">download</i> Tải file mẫu</a></div>
                <form id="hanetImportForm" enctype="multipart/form-data">@Html.AntiForgeryToken()
                    <label class="hanet-file-picker" for="hanetMappingFile"><i class="material-icons">upload_file</i><span id="hanetFileName">Chọn file ánh xạ .csv</span></label>
                    <input id="hanetMappingFile" name="file" type="file" accept=".csv,text/csv" required hidden />
                    <button class="hrm-btn hrm-btn-primary" type="submit">Nhập ánh xạ</button>
                </form>
                <div id="hanetImportResult" class="hanet-import-result" hidden></div>
            </div>
            <div class="hrm-field-note" style="margin-top:18px">Sự kiện webhook được chống ghi trùng bằng Event ID; bản ghi chưa ánh xạ vẫn được giữ để đối soát.</div>
        </div></div>
    </div>
</div>
<script>
(function(){
    $('.hanet_menu').addClass('active');
    var hrmUsers=[],hanetPersons=[];
    function token(form){return $(form+' input[name=__RequestVerificationToken]').val();}
    function message(xhr, fallback){return xhr.responseJSON&&xhr.responseJSON.Message||fallback;}
    function esc(value){return $('<div>').text(value==null?'':value).html();}
    function normalize(value){return (value||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]/g,'').toLowerCase();}
    function placeOptions(places){$('#hanetPlaceOptions').html((places||[]).map(function(place){return '<option value="'+esc(place.id)+'">'+esc(place.name+(place.address?' · '+place.address:''))+'</option>';}).join(''));}
    function loadHanetPlaces(current){$('#hanetPlace').val(current||'');$.post('@Url.Action("TestHanet","Hrm")',{__RequestVerificationToken:token('#hanetForm')}).done(function(r){var places=r.Data||[];placeOptions(places);if(!current&&places.length===1)$('#hanetPlace').val(String(places[0].id));$('#hanetPlaceNote').text(places.length?'Đã tìm thấy '+places.length+' địa điểm. Hãy chọn địa điểm đặt camera chấm công.':'Token hiện không liệt kê địa điểm. Có thể nhập Place ID thủ công nếu đây là địa điểm được chia sẻ.');}).fail(function(x){$('#hanetPlaceNote').text(message(x,'Không thể tải danh sách địa điểm HANET.'));});}
    function suggestedUser(person){var alias=normalize(person.aliasID),name=normalize(person.name),matches=hrmUsers.filter(function(user){return alias&&(alias===normalize(user.EmployeeCode)||alias===normalize(user.Username));});if(matches.length===1)return matches[0].Id;matches=hrmUsers.filter(function(user){return name&&name===normalize(user.DisplayName);});return matches.length===1?matches[0].Id:'';}
    function renderHanetPersons(){var keyword=normalize($('#hanetPersonSearch').val()),rows=hanetPersons.filter(function(person){return !keyword||normalize([person.name,person.personID,person.aliasID,person.title].join(' ')).indexOf(keyword)>=0;});$('#hanetPersonList').prop('hidden',false).html(rows.length?rows.map(function(person){var selected=suggestedUser(person),options='<option value="">Chọn nhân viên HRM</option>'+hrmUsers.map(function(user){return '<option value="'+user.Id+'" '+(String(user.Id)===String(selected)?'selected':'')+'>'+esc(user.DisplayName+' · '+(user.EmployeeCode||user.Username))+'</option>';}).join('');return '<article class="hanet-person-row" data-index="'+hanetPersons.indexOf(person)+'"><div class="hanet-person-avatar">'+(person.avatar?'<img src="'+esc(person.avatar)+'" alt="" />':'<i class="material-icons">person</i>')+'</div><div class="hanet-person-info"><strong>'+esc(person.name||'Chưa đặt tên')+'</strong><span>Person ID: '+esc(person.personID||'--')+'</span><span>Alias ID: '+esc(person.aliasID||'--')+(person.title?' · '+esc(person.title):'')+'</span></div><select class="hrm-control hanet-user-select">'+options+'</select><button class="hrm-btn map-hanet-person" type="button">Lưu ánh xạ</button></article>';}).join(''):'<div class="hrm-empty">Không có nhân viên HANET phù hợp.</div>');}
    $.get('@Url.Action("HanetSettings","Hrm")').done(function(r){var s=r.Data||{};$('#hanetApi').val(s.ApiBaseUrl);$('#hanetOAuth').val(s.OAuthTokenUrl);$('#hanetClient').val(s.ClientId);$('#hanetWebhook').val(s.WebhookSecret);$('#hanetEnabled').prop('checked',s.IsEnabled);$('#hanetStatus').text(s.LastSyncMessage||'Chưa kiểm tra kết nối.').attr('data-status',s.LastSyncStatus||'NOT_CONFIGURED');loadHanetPlaces(s.PlaceId);});
    $.get('@Url.Action("Users","Hrm")').done(function(r){hrmUsers=r.Data||[];$('#mapUser').html(hrmUsers.map(function(x){return '<option value="'+x.Id+'">'+esc(x.DisplayName+' · '+(x.DepartmentName||''))+'</option>';}).join(''));});
    $('#hanetForm').on('submit',function(e){e.preventDefault();$.post('@Url.Action("SaveHanetSettings","Hrm")',{__RequestVerificationToken:token('#hanetForm'),ApiBaseUrl:$('#hanetApi').val(),OAuthTokenUrl:$('#hanetOAuth').val(),ClientId:$('#hanetClient').val(),ClientSecret:$('#hanetSecret').val(),AccessToken:$('#hanetToken').val(),PlaceId:$('#hanetPlace').val(),WebhookSecret:$('#hanetWebhook').val(),IsEnabled:$('#hanetEnabled').is(':checked')}).done(function(){$('#hanetMessage').text('Đã lưu cấu hình.');}).fail(function(x){$('#hanetMessage').text(message(x,'Không thể lưu.'));});});
    $('#mapForm').on('submit',function(e){e.preventDefault();$.post('@Url.Action("SaveHanetPersonMap","Hrm")',{__RequestVerificationToken:token('#mapForm'),UserId:$('#mapUser').val(),PersonId:$('#mapPerson').val(),AliasId:$('#mapAlias').val(),PlaceId:$('#hanetPlace').val()}).done(function(){alert('Đã lưu ánh xạ.');}).fail(function(x){alert(message(x,'Không thể lưu ánh xạ.'));});});
    $('#hanetMappingFile').on('change',function(){var file=this.files&&this.files[0];$('#hanetFileName').text(file?file.name:'Chọn file ánh xạ .csv');});
    $('#loadHanetPersons').on('click',function(){var button=$(this),result=$('#hanetPersonResult').prop('hidden',false).text('Đang tải danh sách từ HANET...');button.prop('disabled',true);$.post('@Url.Action("HanetPersons","Hrm")',{__RequestVerificationToken:token('#mapForm')}).done(function(r){hanetPersons=r.Data||[];result.text((r.Message||'Đã tải danh sách.')+' Có '+hanetPersons.length+' người. Các dòng trùng mã hoặc họ tên đã được chọn gợi ý.');renderHanetPersons();}).fail(function(x){result.text(message(x,'Không thể tải danh sách HANET.'));}).always(function(){button.prop('disabled',false);});});
    $('#hanetPersonSearch').on('input',renderHanetPersons);
    $('#hanetPersonList').on('click','.map-hanet-person',function(){var row=$(this).closest('.hanet-person-row'),person=hanetPersons[Number(row.attr('data-index'))],userId=row.find('.hanet-user-select').val(),button=$(this);if(!userId){alert('Vui lòng chọn nhân viên HRM.');return;}button.prop('disabled',true).text('Đang lưu...');$.post('@Url.Action("SaveHanetPersonMap","Hrm")',{__RequestVerificationToken:token('#mapForm'),UserId:userId,PersonId:person.personID||'',AliasId:person.aliasID||'',PlaceId:$('#hanetPlace').val()}).done(function(){button.text('Đã ánh xạ').addClass('hrm-btn-success');}).fail(function(x){button.text('Lưu ánh xạ');alert(message(x,'Không thể lưu ánh xạ.'));}).always(function(){button.prop('disabled',false);});});
    $('#hanetImportForm').on('submit',function(e){e.preventDefault();var result=$('#hanetImportResult').prop('hidden',false).text('Đang kiểm tra và nhập dữ liệu...');var data=new FormData(this);$.ajax({url:'@Url.Action("ImportHanetMappings","Hrm")',method:'POST',data:data,processData:false,contentType:false}).done(function(r){var detail=r.Data||{};var errors=detail.Errors||[];result.empty().append($('<strong>').text(r.Message||'Đã nhập ánh xạ.'));if(errors.length){result.append($('<ul>').append(errors.map(function(x){return $('<li>').text(x);})));}}).fail(function(x){result.text(message(x,'Không thể nhập file ánh xạ.'));});});
    $('#testHanet').on('click',function(){$.post('@Url.Action("TestHanet","Hrm")',{__RequestVerificationToken:token('#hanetForm')}).done(function(r){$('#hanetStatus').text(r.Message).attr('data-status','SUCCESS');placeOptions(r.Data||[]);}).fail(function(x){$('#hanetStatus').text(message(x,'Kết nối thất bại.')).attr('data-status','FAILED');});});
    $('#copyWebhook').on('click',function(){navigator.clipboard.writeText($('#hanetWebhookUrl').text()).then(function(){$('#hanetMessage').text('Đã sao chép URL webhook.');});});
})();
</script>
