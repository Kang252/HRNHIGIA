<div class="container-fluid hanet-page">
    <div class="hrm-page-header">
        <div><h1 class="hrm-page-title">Tích hợp camera HANET</h1><p class="hrm-page-subtitle">Cấu hình API, webhook và ánh xạ khuôn mặt với nhân viên</p></div>
        <button id="testHanet" class="hrm-btn"><i class="material-icons">network_check</i> Kiểm tra kết nối</button>
    </div>
    <nav class="hanet-tabs" aria-label="Quản lý tích hợp HANET">
        <button type="button" class="active" data-panel="devices" aria-pressed="true"><i class="material-icons">videocam</i> Thiết bị</button>
        <button type="button" data-panel="connection" aria-pressed="false"><i class="material-icons">settings_ethernet</i> Kết nối</button>
        <button type="button" data-panel="mapping" aria-pressed="false"><i class="material-icons">people_alt</i> Ánh xạ nhân viên</button>
    </nav>
    <div class="hanet-feedback" id="hanetGlobalStatus" role="status">Đang tải cấu hình kết nối…</div>
    <div class="hanet-content">
        <div class="hrm-card hanet-panel" data-hanet-panel="connection" hidden><div class="hrm-card-header"><div><h2 class="hrm-card-title">Cấu hình kết nối</h2><p class="hrm-card-subtitle">Thông tin bí mật được mã hóa trước khi lưu</p></div></div><div class="hrm-card-body">
            <form id="hanetForm">@Html.AntiForgeryToken()
                <div class="form-group"><label>API base URL</label><input id="hanetApi" class="hrm-control" required /></div>
                <div class="form-group"><label>OAuth token URL</label><input id="hanetOAuth" class="hrm-control" required /></div>
                <div class="row"><div class="col-sm-6"><div class="form-group"><label>Client ID</label><input id="hanetClient" class="hrm-control" /></div></div><div class="col-sm-6"><div class="form-group"><label>Client secret</label><input id="hanetSecret" class="hrm-control" type="password" placeholder="Để trống nếu không đổi" /></div></div></div>
                <div class="form-group"><label>Access token</label><input id="hanetToken" class="hrm-control" type="password" placeholder="Để trống nếu không đổi" /></div>
                <div class="row"><div class="col-sm-6"><div class="form-group"><label>Địa điểm HANET</label><input id="hanetPlace" class="hrm-control" list="hanetPlaceOptions" placeholder="Nhập hoặc chọn Place ID" /><datalist id="hanetPlaceOptions"></datalist><p id="hanetPlaceNote" class="hrm-field-note">Place ID được lấy trực tiếp từ tài khoản HANET.</p></div></div><div class="col-sm-6"><div class="form-group"><label>Webhook secret dự phòng</label><input id="hanetWebhook" class="hrm-control" /><p class="hrm-field-note">Có thể để trống khi dùng chữ ký hash chính thức.</p></div></div></div>
                <label class="hrm-check"><input id="hanetEnabled" type="checkbox" /> Bật nhận dữ liệu HANET</label>
                <div class="hanet-webhook-box"><span>Webhook khai báo trên HANET</span><code id="hanetWebhookUrl">@($"{Context.Request.Scheme}://{Context.Request.Host}")@Url.Action("Receive","HanetWebhook")</code><button id="copyWebhook" class="hrm-btn" type="button"><i class="material-icons">content_copy</i> Sao chép</button></div>
                <button class="hrm-btn hrm-btn-primary" type="submit" style="margin-top:16px">Lưu cấu hình</button> <span id="hanetMessage" class="hrm-field-note"></span>
                <div id="hanetStatus" class="hanet-status"></div>
            </form>
        </div></div>
        <div class="hrm-card hanet-panel" data-hanet-panel="mapping" hidden><div class="hrm-card-header"><div><h2 class="hrm-card-title">Ánh xạ nhân viên</h2><p class="hrm-card-subtitle">Ghép Person ID/Alias ID từ HANET với tài khoản HRM</p></div></div><div class="hrm-card-body">
            <div class="hanet-person-toolbar">
                <button id="loadHanetPersons" class="hrm-btn hrm-btn-primary" type="button"><i class="material-icons">groups</i> Tải nhân viên HANET</button>
                <label class="hanet-person-search"><i class="material-icons">search</i><input id="hanetPersonSearch" type="search" placeholder="Tìm theo tên, Person ID hoặc Alias ID" /></label>
            </div>
            <datalist id="hanetHrmUserOptions"></datalist>
            <div id="hanetPersonResult" class="hanet-import-result" hidden></div>
            <div id="hanetPersonList" class="hanet-person-list" hidden></div>
            <form id="mapForm">@Html.AntiForgeryToken()
                <div class="form-group"><label>Nhân viên</label><select id="mapUser" class="hrm-control"></select></div>
                <div class="form-group"><label>Person ID</label><input id="mapPerson" class="hrm-control" /></div>
                <div class="form-group"><label>Alias ID</label><input id="mapAlias" class="hrm-control" /></div>
                <button class="hrm-btn hrm-btn-primary" type="submit">Lưu ánh xạ</button>
            </form>
            <div class="hanet-import">
                <div class="hanet-import-heading"><div><strong>Nhập hàng loạt bằng file</strong><p>CSV UTF-8, có thể chỉnh sửa và lưu từ Excel.</p></div><a class="hrm-btn" href="@Url.Action("HanetMappingTemplate","Hrm")"><i class="material-icons">download</i> Tải file mẫu</a></div>
                <form id="hanetImportForm" enctype="multipart/form-data">@Html.AntiForgeryToken()
                    <label class="hanet-file-picker" for="hanetMappingFile"><i class="material-icons">upload_file</i><span id="hanetFileName">Chọn file ánh xạ .csv</span></label>
                    <input id="hanetMappingFile" name="file" type="file" accept=".csv,text/csv" required hidden />
                    <button class="hrm-btn hrm-btn-primary" type="submit">Nhập ánh xạ</button>
                </form>
                <div id="hanetImportResult" class="hanet-import-result" hidden></div>
            </div>
            <div class="hrm-field-note" style="margin-top:18px">Sự kiện webhook được chống ghi trùng bằng Event ID; bản ghi chưa ánh xạ vẫn được giữ để đối soát.</div>
        </div></div>
    </div>
</div>
<div class="container-fluid hanet-page hanet-panel" data-hanet-panel="devices">
 <div class="hrm-card"><div class="hrm-card-header"><div><h2 class="hrm-card-title">Danh sách thiết bị đã lưu</h2><p class="hrm-card-subtitle">Quản lý bản ghi trong HRM; không thay đổi camera hoặc lịch sử chấm công trên HANET.</p></div></div>
 <div class="hrm-card-body">
  <div class="hanet-device-toolbar"><label class="hanet-device-search" for="deviceSearch"><i class="material-icons" aria-hidden="true">search</i><input id="deviceSearch" type="search" placeholder="Tìm theo tên, Device ID, địa điểm hoặc vị trí…" /></label><button type="button" id="deviceAdd" class="hrm-btn hrm-btn-primary"><i class="material-icons">add</i> Thêm thiết bị</button></div>
  <div style="overflow-x:auto;margin:16px 0"><table class="hrm-table hanet-device-table"><thead><tr><th>Tên thiết bị</th><th>Device ID</th><th>Place ID</th><th>Vị trí</th><th>Trạng thái quản lý</th><th>Thao tác</th></tr></thead><tbody id="deviceRows"></tbody></table></div>
  <form id="deviceForm" class="hanet-device-editor" hidden>@Html.AntiForgeryToken()
   <h3 id="deviceEditorTitle">Thêm thiết bị</h3><input name="Id" id="deviceRecordId" type="hidden" value="0" />
   <div class="row">
    <div class="col-sm-6 form-group"><label for="deviceName">Tên thiết bị *</label><input id="deviceName" name="Name" class="hrm-control" required maxlength="150" /></div>
    <div class="col-sm-6 form-group"><label for="deviceCode">Device ID *</label><input id="deviceCode" name="DeviceId" class="hrm-control" required maxlength="100" /></div>
    <div class="col-sm-6 form-group"><label for="devicePlace">Place ID *</label><input id="devicePlace" name="PlaceId" class="hrm-control" list="hanetPlaceOptions" required maxlength="100" /></div>
    <div class="col-sm-6 form-group"><label for="deviceLocation">Vị trí lắp đặt</label><input id="deviceLocation" name="Location" class="hrm-control" maxlength="250" /></div>
   </div>
   <div class="form-group"><label for="deviceNotes">Ghi chú</label><textarea id="deviceNotes" name="Notes" class="hrm-control" maxlength="1000"></textarea></div>
   <label class="hrm-check"><input id="deviceActive" type="checkbox" checked /> Đang sử dụng (không phải trạng thái online của camera)</label>
   <div style="margin-top:16px"><button id="deviceSave" class="hrm-btn hrm-btn-primary" type="submit">Lưu thiết bị</button> <button id="deviceCancel" class="hrm-btn" type="button">Hủy chỉnh sửa</button></div>
  </form><p id="deviceMessage" role="status" class="hrm-field-note" style="margin-top:12px"></p>
 </div></div>
</div>
<script>
(function(){
 var devices=[];
 function safe(v){return $('<div>').text(v==null?'':v).html();}
 function fail(x){$('#deviceMessage').text(x.responseJSON&&x.responseJSON.Message||'Không thể xử lý thiết bị. Vui lòng thử lại.');}
 function render(){var q=($('#deviceSearch').val()||'').toLowerCase();var rows=devices.filter(function(d){return [d.Name,d.DeviceId,d.PlaceId,d.Location].join(' ').toLowerCase().indexOf(q)>=0;});$('#deviceRows').html(rows.length?rows.map(function(d){return '<tr><td>'+safe(d.Name)+'</td><td>'+safe(d.DeviceId)+'</td><td>'+safe(d.PlaceId)+'</td><td>'+safe(d.Location||'—')+'</td><td>'+ (d.IsActive?'Đang sử dụng':'Ngừng sử dụng')+'</td><td><button type="button" class="hrm-btn device-edit" data-id="'+d.Id+'">Sửa</button> <button type="button" class="hrm-btn device-delete" data-id="'+d.Id+'">Xóa</button></td></tr>';}).join(''):'<tr><td colspan="6">Chưa có thiết bị phù hợp. Chọn Thêm thiết bị để tạo bản ghi mới.</td></tr>');}
 function load(){$.get('@Url.Action("HanetDevices","Hrm")').done(function(r){devices=r.Data||[];render();}).fail(fail);}
 function reset(){document.getElementById('deviceForm').reset();$('#deviceRecordId').val('0');$('#deviceEditorTitle').text('Thêm thiết bị');$('#deviceForm').prop('hidden',true);}
 $('#deviceAdd').on('click',function(){reset();$('#deviceForm').prop('hidden',false);$('#devicePlace').val($('#hanetPlace').val());$('#deviceName').trigger('focus');});$('#deviceSearch').on('input',render);$('#deviceCancel').on('click',reset);
 $('#deviceRows').on('click','.device-edit',function(){var id=Number($(this).attr('data-id'));var d=devices.find(function(x){return x.Id===id;});if(!d)return;$('#deviceForm').prop('hidden',false);$('#deviceRecordId').val(d.Id);$('#deviceName').val(d.Name);$('#deviceCode').val(d.DeviceId);$('#devicePlace').val(d.PlaceId);$('#deviceLocation').val(d.Location);$('#deviceNotes').val(d.Notes);$('#deviceActive').prop('checked',d.IsActive);$('#deviceEditorTitle').text('Sửa thiết bị');document.getElementById('deviceForm').scrollIntoView({behavior:'smooth',block:'center'});});
 $('#deviceForm').on('submit',function(e){e.preventDefault();var b=$('#deviceSave').prop('disabled',true);var data=$(this).serializeArray();data.push({name:'IsActive',value:$('#deviceActive').is(':checked')});$.post('@Url.Action("SaveHanetDevice","Hrm")',data).done(function(){reset();load();$('#deviceMessage').text('Đã lưu thiết bị.');}).fail(fail).always(function(){b.prop('disabled',false);});});
 $('#deviceRows').on('click','.device-delete',function(){var id=Number($(this).attr('data-id'));if(!confirm('Xóa bản ghi thiết bị trong HRM? Camera HANET và lịch sử chấm công vẫn được giữ nguyên.'))return;var b=$(this).prop('disabled',true);$.post('@Url.Action("DeleteHanetDevice","Hrm")',{id:id,__RequestVerificationToken:$('#deviceForm input[name=__RequestVerificationToken]').val()}).done(function(){if(Number($('#deviceRecordId').val())===id)reset();load();$('#deviceMessage').text('Đã xóa bản ghi thiết bị.');}).fail(fail).always(function(){b.prop('disabled',false);});});
 load();
})();
</script>
<script>
(function(){
    $('.hanet_menu').addClass('active');
    var hrmUsers=[],hanetPersons=[];
    function token(form){return $(form+' input[name=__RequestVerificationToken]').val();}
    function message(xhr, fallback){return xhr.responseJSON&&xhr.responseJSON.Message||fallback;}
    function esc(value){return $('<div>').text(value==null?'':value).html();}
    function normalize(value){return (value||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]/g,'').toLowerCase();}
    function placeOptions(places){$('#hanetPlaceOptions').html((places||[]).map(function(place){return '<option value="'+esc(place.id)+'">'+esc(place.name+(place.address?' · '+place.address:''))+'</option>';}).join(''));}
    function userLabel(user){return user.DisplayName+' · '+(user.EmployeeCode||user.Username);}
    function suggestedUser(person){var alias=normalize(person.aliasID),name=normalize(person.name),matches=hrmUsers.filter(function(user){return alias&&(alias===normalize(user.EmployeeCode)||alias===normalize(user.Username));});if(matches.length===1)return matches[0].Id;matches=hrmUsers.filter(function(user){return name&&name===normalize(user.DisplayName);});return matches.length===1?matches[0].Id:'';}
    function renderHanetPersons(){var keyword=normalize($('#hanetPersonSearch').val()),rows=hanetPersons.filter(function(person){return !keyword||normalize([person.name,person.personID,person.aliasID,person.title].join(' ')).indexOf(keyword)>=0;});$('#hanetPersonList').prop('hidden',false).html(rows.length?rows.map(function(person){var selectedId=suggestedUser(person),selected=hrmUsers.find(function(user){return String(user.Id)===String(selectedId);});return '<article class="hanet-person-row" data-index="'+hanetPersons.indexOf(person)+'"><div class="hanet-person-avatar">'+(person.avatar?'<img src="'+esc(person.avatar)+'" alt="" loading="lazy" />':'<i class="material-icons">person</i>')+'</div><div class="hanet-person-info"><strong>'+esc(person.name||'Chưa đặt tên')+'</strong><span>Person ID: '+esc(person.personID||'--')+'</span><span>Alias ID: '+esc(person.aliasID||'--')+(person.title?' · '+esc(person.title):'')+'</span></div><input class="hrm-control hanet-user-input" list="hanetHrmUserOptions" value="'+esc(selected?userLabel(selected):'')+'" placeholder="Tìm và chọn nhân viên HRM" /><button class="hrm-btn map-hanet-person" type="button">Lưu ánh xạ</button></article>';}).join(''):'<div class="hrm-empty">Không có nhân viên HANET phù hợp.</div>');}
    $.get('@Url.Action("HanetSettings","Hrm")').done(function(r){var s=r.Data||{};$('#hanetApi').val(s.ApiBaseUrl);$('#hanetOAuth').val(s.OAuthTokenUrl);$('#hanetClient').val(s.ClientId);$('#hanetWebhook').val(s.WebhookSecret);$('#hanetEnabled').prop('checked',s.IsEnabled);$('#hanetPlace').val(s.PlaceId||'');$('#hanetStatus').text(s.LastSyncMessage||'Chưa kiểm tra kết nối.').attr('data-status',s.LastSyncStatus||'NOT_CONFIGURED');$('#hanetGlobalStatus').text(s.LastSyncMessage||'Chưa kiểm tra kết nối. Lưu cấu hình trước khi kiểm tra.');$('#hanetPlaceNote').text(s.PlaceId?'Đang dùng Place ID đã lưu. Bấm Kiểm tra kết nối khi cần tải lại danh sách địa điểm.':'Chưa có Place ID. Bấm Kiểm tra kết nối để chọn địa điểm.');});
    $.get('@Url.Action("Users","Hrm")').done(function(r){hrmUsers=r.Data||[];$('#mapUser').html(hrmUsers.map(function(x){return '<option value="'+x.Id+'">'+esc(x.DisplayName+' · '+(x.DepartmentName||''))+'</option>';}).join(''));$('#hanetHrmUserOptions').html(hrmUsers.map(function(x){return '<option value="'+esc(userLabel(x))+'"></option>';}).join(''));});
    $('#hanetForm').on('submit',function(e){e.preventDefault();$.post('@Url.Action("SaveHanetSettings","Hrm")',{__RequestVerificationToken:token('#hanetForm'),ApiBaseUrl:$('#hanetApi').val(),OAuthTokenUrl:$('#hanetOAuth').val(),ClientId:$('#hanetClient').val(),ClientSecret:$('#hanetSecret').val(),AccessToken:$('#hanetToken').val(),PlaceId:$('#hanetPlace').val(),WebhookSecret:$('#hanetWebhook').val(),IsEnabled:$('#hanetEnabled').is(':checked')}).done(function(){$('#hanetMessage').text('Đã lưu cấu hình.');}).fail(function(x){$('#hanetMessage').text(message(x,'Không thể lưu.'));});});
    $('#mapForm').on('submit',function(e){e.preventDefault();$.post('@Url.Action("SaveHanetPersonMap","Hrm")',{__RequestVerificationToken:token('#mapForm'),UserId:$('#mapUser').val(),PersonId:$('#mapPerson').val(),AliasId:$('#mapAlias').val(),PlaceId:$('#hanetPlace').val()}).done(function(){alert('Đã lưu ánh xạ.');}).fail(function(x){alert(message(x,'Không thể lưu ánh xạ.'));});});
    $('#hanetMappingFile').on('change',function(){var file=this.files&&this.files[0];$('#hanetFileName').text(file?file.name:'Chọn file ánh xạ .csv');});
    $('#loadHanetPersons').on('click',function(){var button=$(this),refresh=hanetPersons.length>0,result=$('#hanetPersonResult').prop('hidden',false).text(refresh?'Đang làm mới trực tiếp từ HANET...':'Đang tải danh sách; lần đầu có thể mất vài giây...');button.prop('disabled',true);$.post('@Url.Action("HanetPersons","Hrm")',{__RequestVerificationToken:token('#mapForm'),refresh:refresh}).done(function(r){hanetPersons=r.Data||[];result.text((r.Message||'Đã tải danh sách.')+' Có '+hanetPersons.length+' người. Các dòng trùng mã hoặc họ tên đã được chọn gợi ý.');renderHanetPersons();button.find('i').text('refresh');button.contents().filter(function(){return this.nodeType===3;}).last().replaceWith(' Làm mới từ HANET');}).fail(function(x){result.text(message(x,'Không thể tải danh sách HANET.'));}).always(function(){button.prop('disabled',false);});});
    $('#hanetPersonSearch').on('input',renderHanetPersons);
    $('#hanetPersonList').on('click','.map-hanet-person',function(){var row=$(this).closest('.hanet-person-row'),person=hanetPersons[Number(row.attr('data-index'))],label=row.find('.hanet-user-input').val(),user=hrmUsers.find(function(x){return userLabel(x)===label;}),button=$(this);if(!user){alert('Vui lòng chọn đúng một nhân viên trong danh sách HRM.');return;}button.prop('disabled',true).text('Đang lưu...');$.post('@Url.Action("SaveHanetPersonMap","Hrm")',{__RequestVerificationToken:token('#mapForm'),UserId:user.Id,PersonId:person.personID||'',AliasId:person.aliasID||'',PlaceId:$('#hanetPlace').val()}).done(function(){button.text('Đã ánh xạ').addClass('hrm-btn-success');}).fail(function(x){button.text('Lưu ánh xạ');alert(message(x,'Không thể lưu ánh xạ.'));}).always(function(){button.prop('disabled',false);});});
    $('#hanetImportForm').on('submit',function(e){e.preventDefault();var result=$('#hanetImportResult').prop('hidden',false).text('Đang kiểm tra và nhập dữ liệu...');var data=new FormData(this);$.ajax({url:'@Url.Action("ImportHanetMappings","Hrm")',method:'POST',data:data,processData:false,contentType:false}).done(function(r){var detail=r.Data||{};var errors=detail.Errors||[];result.empty().append($('<strong>').text(r.Message||'Đã nhập ánh xạ.'));if(errors.length){result.append($('<ul>').append(errors.map(function(x){return $('<li>').text(x);})));}}).fail(function(x){result.text(message(x,'Không thể nhập file ánh xạ.'));});});
    $('#testHanet').on('click',function(){var button=$(this).prop('disabled',true);$('#hanetGlobalStatus').text('Đang kiểm tra kết nối API HANET…');$.post('@Url.Action("TestHanet","Hrm")',{__RequestVerificationToken:token('#hanetForm')}).done(function(r){$('#hanetGlobalStatus').text(r.Message);$('#hanetStatus').text(r.Message).attr('data-status','SUCCESS');placeOptions(r.Data||[]);}).fail(function(x){$('#hanetGlobalStatus').text(message(x,'Kết nối thất bại.'));$('#hanetStatus').text(message(x,'Kết nối thất bại.')).attr('data-status','FAILED');}).always(function(){button.prop('disabled',false);});});
    $('#copyWebhook').on('click',function(){navigator.clipboard.writeText($('#hanetWebhookUrl').text()).then(function(){$('#hanetMessage').text('Đã sao chép URL webhook.');});});
})();
</script>

<style>
.hanet-page{min-width:0}.hanet-panel[hidden],.hanet-device-editor[hidden]{display:none!important}
.hanet-tabs{display:flex;gap:8px;padding:8px;background:white;border:1px solid #e2e8f0;border-radius:14px;margin-bottom:16px;flex-wrap:wrap}
.hanet-tabs button{display:flex;align-items:center;gap:10px;border:0;background:transparent;color:#526480;padding:14px 20px;border-radius:10px;font:inherit;font-weight:600;cursor:pointer}
.hanet-tabs button.active{background:#eaf2ff;color:#1769e0}.hanet-tabs button:focus-visible{outline:2px solid #1769e0;outline-offset:2px}
.hanet-feedback{padding:12px 16px;background:#eef5ff;border:1px solid #dbeafe;border-radius:10px;margin-bottom:20px;color:#36577a;overflow-wrap:anywhere}
.hanet-content{display:block}.hanet-page .hrm-card{overflow:hidden}.hanet-page .hrm-card-body{padding:24px}
.hanet-device-toolbar{display:flex;align-items:center;gap:16px;justify-content:space-between}
.hanet-device-search{display:flex;align-items:center;gap:10px;border:1px solid #d5dfec;border-radius:10px;padding:12px 16px;flex:1;max-width:650px;margin:0;color:#74849b}
.hanet-device-search input{border:0;outline:0;width:100%;min-width:0;background:transparent;font:inherit;color:#203650}
.hanet-device-editor{margin-top:20px;padding:24px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px}.hanet-device-editor h3{margin:0 0 20px;font-size:20px}
.hanet-page .hanet-person-toolbar{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:20px}.hanet-page .hanet-person-search{display:flex;align-items:center;gap:10px;flex:1;border:1px solid #d5dfec;border-radius:10px;padding:12px;min-width:200px}.hanet-person-search input{min-width:0;width:100%;border:0;background:transparent;outline:0;font:inherit}
.hanet-page #mapForm{margin-top:24px;padding:20px;border:1px solid #e2e8f0;border-radius:12px}.hanet-page .hanet-import{margin-top:24px;padding:20px;background:#f8fafc;border-radius:12px}
.hanet-page .hanet-webhook-box{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:16px;background:#f8fafc;border-radius:10px;margin-top:18px}.hanet-webhook-box code{overflow-wrap:anywhere;min-width:0;flex:1}
.hanet-device-table td:last-child{white-space:nowrap}
@@media(min-width:1000px){.hanet-page #hanetForm{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}.hanet-page #hanetForm>.row,.hanet-page #hanetForm>.hanet-webhook-box,.hanet-page #hanetForm>.hanet-status{grid-column:1/-1}}
@@media(max-width:600px){.hanet-tabs{gap:4px}.hanet-tabs button{flex:1;justify-content:center;padding:12px 6px;gap:6px;font-size:13px}.hanet-tabs button i{font-size:20px}.hanet-device-toolbar{flex-direction:column;align-items:stretch}.hanet-device-search{max-width:none}.hanet-page .hrm-card-body,.hanet-device-editor{padding:16px}.hanet-page .hanet-person-toolbar{flex-direction:column}.hanet-page .hrm-page-header{gap:16px}.hanet-import-heading{display:flex;flex-wrap:wrap;gap:12px}}
</style>
<script>
(function(){
 $('.hanet-tabs button').on('click',function(){var key=$(this).attr('data-panel');$('.hanet-tabs button').removeClass('active').attr('aria-pressed','false');$(this).addClass('active').attr('aria-pressed','true');$('.hanet-panel').each(function(){$(this).prop('hidden',$(this).attr('data-hanet-panel')!==key);});});
})();
