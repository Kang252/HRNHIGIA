@model EmployeeProfileModel
@{
    var departments = ViewBag.Departments as IList<WorkDepartment> ?? new List<WorkDepartment>();
    var supervisors = ViewBag.Supervisors as IList<HrmUserAccountModel> ?? new List<HrmUserAccountModel>();
    Func<IEnumerable<string>, string, IEnumerable<string>> options = (items, current) =>
        items.Concat(string.IsNullOrWhiteSpace(current) ? Array.Empty<string>() : new[] { current }).Distinct();
}

<div class="container-fluid profile-edit-page">
    <div class="hrm-page-header">
        <div><h1 class="hrm-page-title">Cập nhật hồ sơ nhân viên</h1><p class="hrm-page-subtitle">@Model.DisplayName · @Model.Username</p></div>
        <a class="hrm-btn" asp-action="EmployeeInformation"><i class="material-icons">arrow_back</i> Danh sách nhân sự</a>
    </div>

    <form method="post" asp-action="EditEmployeeProfile">
        <input asp-for="UserId" type="hidden" />
        @if (TempData["ProfileSuccess"] is string success) { <div class="alert alert-success" role="status"><i class="material-icons">check_circle</i> @success</div> }
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Thông tin chung</h2></div>
            <div class="profile-edit-grid">
                <label>Họ và tên *<input asp-for="DisplayName" class="form-control" maxlength="200" required /></label>
                <label>Mã nhân viên *<input asp-for="EmployeeCode" class="form-control" maxlength="30" required /></label>
                <label>Phòng ban<select asp-for="DepartmentId" class="form-control"><option value="">Chưa phân phòng</option>@foreach (var item in departments) { <option value="@item.Id">@item.Name</option> }</select></label>
                <label>Quản lý trực tiếp<select asp-for="SupervisorUserId" class="form-control"><option value="">Chưa phân công</option>@foreach (var item in supervisors) { <option value="@item.Id">@item.DisplayName</option> }</select></label>
                <label>Giới tính<select asp-for="Gender" class="form-control"><option value="">Chọn giới tính</option>@foreach (var item in options(EmployeeProfileOptions.Genders, Model.Gender)) { <option value="@item">@item</option> }</select></label>
                <label>Ngày sinh<input asp-for="DateOfBirth" type="date" class="form-control" /></label>
                <label>Nơi sinh<input asp-for="PlaceOfBirth" class="form-control" maxlength="250" /></label>
                <label>Quốc tịch<select asp-for="Nationality" class="form-control"><option value="">Chọn quốc tịch</option>@foreach (var item in options(EmployeeProfileOptions.Nationalities, Model.Nationality)) { <option value="@item">@item</option> }</select></label>
                <label>Dân tộc<select asp-for="Ethnicity" class="form-control"><option value="">Chọn dân tộc</option>@foreach (var item in options(EmployeeProfileOptions.Ethnicities, Model.Ethnicity)) { <option value="@item">@item</option> }</select></label>
                <label>Tôn giáo<select asp-for="Religion" class="form-control"><option value="">Chọn tôn giáo</option>@foreach (var item in options(EmployeeProfileOptions.Religions, Model.Religion)) { <option value="@item">@item</option> }</select></label>
                <label>Tình trạng hôn nhân<select asp-for="MaritalStatus" class="form-control"><option value="">Chọn tình trạng</option>@foreach (var item in options(EmployeeProfileOptions.MaritalStatuses, Model.MaritalStatus)) { <option value="@item">@item</option> }</select></label>
            </div>
        </section>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Liên hệ và địa chỉ</h2></div>
            <div class="profile-edit-grid">
                <label>Điện thoại di động<input asp-for="MobilePhone" class="form-control" maxlength="30" /></label>
                <label>Điện thoại cơ quan<input asp-for="OfficePhone" class="form-control" maxlength="30" /></label>
                <label>Điện thoại nhà<input asp-for="HomePhone" class="form-control" maxlength="30" /></label>
                <label>Email cá nhân<input asp-for="PersonalEmail" type="email" class="form-control" maxlength="150" /></label>
                <label>Email công ty<input asp-for="CompanyEmail" type="email" class="form-control" maxlength="150" /></label>
                <label class="wide">Địa chỉ thường trú<input asp-for="PermanentAddress" class="form-control" maxlength="500" /></label>
                <label class="wide">Địa chỉ hiện tại<input asp-for="CurrentAddress" class="form-control" maxlength="500" /></label>
            </div>
        </section>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Giấy tờ định danh</h2></div>
            <div class="profile-edit-grid">
                <label>Số CCCD/CMND<input asp-for="IdentityNumber" class="form-control" maxlength="30" /></label>
                <label>Ngày cấp<input asp-for="IdentityIssuedDate" type="date" class="form-control" /></label>
                <label>Nơi cấp<input asp-for="IdentityIssuedPlace" class="form-control" maxlength="250" /></label>
                <label>Ngày hết hạn<input asp-for="IdentityExpiryDate" type="date" class="form-control" /></label>
                <label>Số hộ chiếu<input asp-for="PassportNumber" class="form-control" maxlength="30" /></label>
                <label>Ngày cấp hộ chiếu<input asp-for="PassportIssuedDate" type="date" class="form-control" /></label>
                <label>Nơi cấp hộ chiếu<input asp-for="PassportIssuedPlace" class="form-control" maxlength="250" /></label>
                <label>Ngày hết hạn hộ chiếu<input asp-for="PassportExpiryDate" type="date" class="form-control" /></label>
                <label>Mã số thuế cá nhân<input asp-for="PersonalTaxCode" class="form-control" maxlength="30" /></label>
            </div>
        </section>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Công việc và hợp đồng</h2></div>
            <div class="profile-edit-grid">
                <label>Vị trí công việc<input asp-for="JobTitle" class="form-control" maxlength="150" /></label>
                <label>Trạng thái làm việc<select asp-for="EmploymentStatus" class="form-control"><option value="">Chọn trạng thái</option>@foreach (var item in options(EmployeeProfileOptions.EmploymentStatuses, Model.EmploymentStatus)) { <option value="@item">@item</option> }</select></label>
                <label>Địa điểm làm việc<input asp-for="WorkLocation" class="form-control" maxlength="250" /></label>
                <label>Mã chấm công<input asp-for="TimekeepingCode" class="form-control" maxlength="50" /></label>
                <label>Ngày tiếp nhận<input asp-for="HireDate" type="date" class="form-control" /></label>
                <label>Ngày thử việc<input asp-for="ProbationDate" type="date" class="form-control" /></label>
                <label>Ngày chính thức<input asp-for="OfficialDate" type="date" class="form-control" /></label>
                <label>Loại hợp đồng<select asp-for="ContractType" class="form-control"><option value="">Chọn loại hợp đồng</option>@foreach (var item in options(EmployeeProfileOptions.ContractTypes, Model.ContractType)) { <option value="@item">@item</option> }</select></label>
                <label>Số hợp đồng<input asp-for="ContractNumber" class="form-control" maxlength="50" /></label>
                <label>Ngày bắt đầu<input asp-for="ContractStartDate" type="date" class="form-control" /></label>
                <label>Ngày kết thúc<input asp-for="ContractEndDate" type="date" class="form-control" /></label>
                <label>Phép năm tiêu chuẩn<input asp-for="AnnualLeaveDays" type="number" min="0" max="365" step="0.5" class="form-control" /></label>
                <label>Mức lương cơ bản<input asp-for="BasicSalary" class="form-control" maxlength="50" /></label>
            </div>
        </section>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Học vấn</h2></div>
            <div class="profile-edit-grid">
                <label>Trình độ<select asp-for="EducationLevel" class="form-control"><option value="">Chọn trình độ</option>@foreach (var item in options(EmployeeProfileOptions.EducationLevels, Model.EducationLevel)) { <option value="@item">@item</option> }</select></label>
                <label>Bằng cấp<input asp-for="Degree" class="form-control" maxlength="150" /></label>
                <label>Nơi đào tạo<input asp-for="SchoolName" class="form-control" maxlength="250" /></label>
                <label>Khoa<input asp-for="Faculty" class="form-control" maxlength="150" /></label>
                <label>Chuyên ngành<input asp-for="Major" class="form-control" maxlength="150" /></label>
                <label>Năm tốt nghiệp<input asp-for="GraduationYear" class="form-control" maxlength="4" /></label>
                <label>Xếp loại<select asp-for="GraduationClassification" class="form-control"><option value="">Chọn xếp loại</option>@foreach (var item in options(EmployeeProfileOptions.GraduationClassifications, Model.GraduationClassification)) { <option value="@item">@item</option> }</select></label>
            </div>
        </section>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Ngân hàng và bảo hiểm</h2></div>
            <div class="profile-edit-grid">
                <label>Số tài khoản ngân hàng<input asp-for="BankAccountNumber" class="form-control" maxlength="50" /></label>
                <label>Ngân hàng<input asp-for="BankName" class="form-control" maxlength="150" /></label>
                <label>Chi nhánh<input asp-for="BankBranch" class="form-control" maxlength="150" /></label>
                <label>Số sổ BHXH<input asp-for="SocialInsuranceNumber" class="form-control" maxlength="50" /></label>
                <label>Ngày tham gia BHXH<input asp-for="SocialInsuranceStartDate" type="date" class="form-control" /></label>
                <label>Số thẻ BHYT<input asp-for="HealthInsuranceNumber" class="form-control" maxlength="50" /></label>
                <label>Ngày hết hạn BHYT<input asp-for="HealthInsuranceExpiryDate" type="date" class="form-control" /></label>
                <label>Nơi đăng ký khám chữa bệnh<input asp-for="RegisteredHealthFacility" class="form-control" maxlength="250" /></label>
            </div>
        </section>

        <section class="hrm-card edit-section">
            <div class="hrm-card-header"><h2 class="hrm-card-title">Liên hệ khẩn cấp và ghi chú</h2></div>
            <div class="profile-edit-grid">
                <label>Họ tên người liên hệ<input asp-for="EmergencyContactName" class="form-control" maxlength="150" /></label>
                <label>Mối quan hệ<select asp-for="EmergencyContactRelationship" class="form-control"><option value="">Chọn mối quan hệ</option>@foreach (var item in options(EmployeeProfileOptions.EmergencyRelationships, Model.EmergencyContactRelationship)) { <option value="@item">@item</option> }</select></label>
                <label>Số điện thoại<input asp-for="EmergencyContactPhone" class="form-control" maxlength="30" /></label>
                <label>Email<input asp-for="EmergencyContactEmail" type="email" class="form-control" maxlength="150" /></label>
                <label class="wide">Địa chỉ<input asp-for="EmergencyContactAddress" class="form-control" maxlength="500" /></label>
                <label class="wide">Ghi chú<textarea asp-for="Notes" class="form-control" rows="4" maxlength="1000"></textarea></label>
            </div>
        </section>

        <div class="profile-edit-actions"><a class="hrm-btn" asp-action="EmployeeInformation">Hủy</a><button class="hrm-btn hrm-btn-primary" type="submit"><i class="material-icons">save</i> Lưu thông tin</button></div>
    </form>
</div>

<style>
    .edit-section{padding:20px;margin-bottom:18px}.profile-edit-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 18px}.profile-edit-grid label{font-weight:600;color:#26364d}.profile-edit-grid .form-control{margin-top:7px;font-weight:400}.profile-edit-grid .wide{grid-column:span 2}.profile-edit-actions{position:sticky;bottom:0;display:flex;justify-content:flex-end;gap:10px;padding:14px 0;background:rgba(247,249,252,.96);z-index:5}@@media(max-width:900px){.profile-edit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:600px){.profile-edit-grid{grid-template-columns:1fr}.profile-edit-grid .wide{grid-column:auto}.edit-section{padding:15px}}
</style>
