@model ChangePasswordRequest
@{ var mustChange = ViewBag.MustChange == true; }
<div class="container-fluid">
    <div class="hrm-page-header"><div><h1 class="hrm-page-title">Đổi mật khẩu</h1><p class="hrm-page-subtitle">@(mustChange ? "Bạn đang dùng mật khẩu tạm. Hãy đặt mật khẩu riêng để tiếp tục." : "Sau khi đổi, các phiên đăng nhập khác của bạn sẽ bị đăng xuất.")</p></div></div>
    @if (TempData["AccountSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="hrm-card" style="max-width:520px">
        <form method="post" asp-action="ChangePassword" class="hrm-card-body" autocomplete="off">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <div class="form-group"><label for="CurrentPassword">@(mustChange ? "Mật khẩu tạm" : "Mật khẩu hiện tại") *</label><input id="CurrentPassword" name="CurrentPassword" type="password" class="hrm-control" required autocomplete="current-password" /></div>
            <div class="form-group"><label for="NewPassword">Mật khẩu mới *</label><input id="NewPassword" name="NewPassword" type="password" class="hrm-control" required minlength="@AccountPolicy.MinimumPasswordLength" maxlength="128" autocomplete="new-password" /><p class="hrm-field-note">Ít nhất @AccountPolicy.MinimumPasswordLength ký tự, có cả chữ và số, không chứa tên tài khoản.</p></div>
            <div class="form-group"><label for="ConfirmPassword">Nhập lại mật khẩu mới *</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" class="hrm-control" required autocomplete="new-password" /></div>
            <button type="submit" class="hrm-btn hrm-btn-primary"><i class="material-icons">lock</i> Đổi mật khẩu</button>
        </form>
    </div>
</div>
