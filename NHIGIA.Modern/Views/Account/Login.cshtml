@model NHIGIA.Modern.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - HRM Nhị Gia</title>
    <link rel="icon" type="image/png" href="~/images/nhigia-symbol-logo.png" asp-append-version="true" />
    <link href="@Url.Content("~/Content/css/css.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/icon.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/plugins/bootstrap/css/bootstrap.css")" rel="stylesheet" />
    <link href="~/Content/hrm-modern.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="hrm-login-body">
    <main class="hrm-login-shell">
        <section class="hrm-login-intro">
            <div class="hrm-login-brand"><img class="hrm-login-logo" src="~/images/nhigia-header-logo.png" asp-append-version="true" alt="Nhị Gia" /></div>
            <div>
                <h1>Quản trị nhân sự<br />trên một nền tảng</h1>
                <p>Hồ sơ, lịch làm việc, chấm công, nghỉ phép và truyền thông nội bộ.</p>
            </div>
            <div class="hrm-login-feature"><i class="material-icons">verified_user</i><span>Phân quyền theo Nhân viên, Trưởng phòng, HR và Giám đốc</span></div>
        </section>
        <section class="hrm-login-panel">
            <div class="hrm-login-form-wrap">
                <h2>Đăng nhập</h2>
                <p>Sử dụng tài khoản Nhị Gia được cấp để truy cập hệ thống.</p>
                @if (Model?.LogoutCompleted == true)
                {
                    if (Model.SingleSignOutIncomplete)
                    {
                        <div class="hrm-login-warning">Đã đăng xuất khỏi HRM. Dịch vụ đăng nhập tập trung đang gián đoạn nên phiên Keycloak có thể chưa kết thúc. Hãy đóng trình duyệt nếu bạn đang dùng thiết bị chung.</div>
                    }
                    else
                    {
                        <div class="hrm-login-success">Bạn đã đăng xuất khỏi HRM.</div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(Model?.AuthenticationMessage))
                {
                    <div class="hrm-login-error">@Model.AuthenticationMessage</div>
                }
                else if (TempData["LoginError"] is string loginError)
                {
                    <div class="hrm-login-error">@loginError</div>
                }
                @if (Model?.UseSingleSignOn == true)
                {
                    if (Model.SingleSignOutIncomplete)
                    {
                        @using (Html.BeginForm("CompleteSingleSignOut", "Account", FormMethod.Post, new { @class = "hrm-login-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hrm-btn hrm-btn-primary hrm-login-submit">Hoàn tất đăng xuất SSO</button>
                        }
                        @using (Html.BeginForm("ResumeSingleSignOn", "Account", FormMethod.Post, new { @class = "hrm-login-secondary-form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.ReturnUrl)
                            <button class="hrm-login-secondary-action" type="submit">Đăng nhập lại vào HRM</button>
                        }
                    }
                    else
                    {
                        <div class="hrm-login-form">
                            <a class="hrm-btn hrm-btn-primary hrm-login-submit"
                               href="@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })">
                                @(Model.AuthenticationUnavailable ? "Thử kết nối lại" : "Đăng nhập lại")
                            </a>
                        </div>
                    }
                }
                else
                {
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "hrm-login-form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.ReturnUrl)
                        @Html.ValidationSummary(true, "", new { @class = "hrm-login-error" })
                        <div class="form-group">
                            <label for="Username">Tài khoản</label>
                            @Html.TextBoxFor(m => m.Username, new { @class = "hrm-control", autocomplete = "username", autofocus = "autofocus", placeholder = "Nhập tài khoản" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "hrm-login-error" })
                        </div>
                        <div class="form-group">
                            <label for="Password">Mật khẩu</label>
                            @Html.PasswordFor(m => m.Password, new { @class = "hrm-control", autocomplete = "current-password", placeholder = "Nhập mật khẩu" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "hrm-login-error" })
                        </div>
                        <label class="hrm-check hrm-login-remember">@Html.CheckBoxFor(m => m.RememberMe) <span>Duy trì đăng nhập</span></label>
                        <button type="submit" class="hrm-btn hrm-btn-primary hrm-login-submit">Đăng nhập</button>
                    }
                }
            </div>
        </section>
    </main>
</body>
</html>
