    /* Master Dynamic Form Renderer */
    function renderDynamicCreateForm(type, cat) {
        var tpl = getRequestCategoryTemplate(type, cat);
        var container = $('#dynamicFormContainer');
        var html = '';
        switch (tpl) {
            case 'FINANCE': html = renderFinanceForm(type, cat); break;
            case 'OVERTIME': html = renderOvertimeForm(type, cat); break;
            case 'ATTENDANCE': html = renderAttendanceForm(type, cat); break;
            case 'SHIFT': html = renderShiftForm(type, cat); break;
            case 'MEAL': html = renderMealForm(type, cat); break;
            case 'RECRUITMENT': html = renderRecruitmentForm(type, cat); break;
            case 'RESIGNATION': html = renderResignationForm(type, cat); break;
            case 'APPOINTMENT': html = renderAppointmentForm(type, cat); break;
            case 'REWARD_DISCIPLINE': html = renderRewardDisciplineForm(type, cat); break;
            case 'SUPPORT': html = renderSupportForm(type, cat); break;
            default: html = renderLeaveForm(type, cat); break;
        }
        container.html(html);

        if (tpl === 'FINANCE') {
            financeItemCounter = 0;
            $('#financeDetailList').empty();
            addFinanceDetailItem('Đề xuất chi phí đợt 1', 1, 0, '');
        }
    }

    var financeItemCounter = 0;
    function addFinanceDetailItem(prefillTitle, prefillQty, prefillPrice, prefillNote) {
        financeItemCounter++;
        var idx = financeItemCounter;
        var cardHtml = '<div class="tc-detail-card" id="finDetailCard_' + idx + '" data-idx="' + idx + '">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">' +
                '<strong style="font-size:13.5px;color:#1e293b;" class="fin-card-title">Mục ' + ($('#financeDetailList .tc-detail-card').length + 1) + '</strong>' +
                '<button type="button" class="btn-remove-detail" onclick="removeFinanceDetailItem(' + idx + ')" title="Xoá mục này">' +
                    '<i class="material-icons" style="font-size:18px;">close</i>' +
                '</button>' +
            '</div>' +
            '<div style="margin-bottom:10px;">' +
                '<label style="display:block;font-size:12.5px;color:#475467;margin-bottom:4px;font-weight:600;">Nội dung đề xuất <span class="req">*</span></label>' +
                '<input type="text" class="tc-tanca-input fin-item-title" placeholder="Nhập nội dung chi tiêu, mua sắm..." value="' + esc(prefillTitle || '') + '" required />' +
            '</div>' +
            '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:10px;">' +
                '<div>' +
                    '<label style="display:block;font-size:12.5px;color:#475467;margin-bottom:4px;font-weight:600;">Số lượng <span class="req">*</span></label>' +
                    '<input type="number" class="tc-tanca-input fin-item-qty" min="1" step="1" value="' + (prefillQty || 1) + '" />' +
                '</div>' +
                '<div>' +
                    '<label style="display:block;font-size:12.5px;color:#475467;margin-bottom:4px;font-weight:600;">Đơn giá (VNĐ) <span class="req">*</span></label>' +
                    '<input type="number" class="tc-tanca-input fin-item-price" min="0" step="1000" placeholder="0" value="' + (prefillPrice || '') + '" />' +
                '</div>' +
                '<div>' +
                    '<label style="display:block;font-size:12.5px;color:#475467;margin-bottom:4px;font-weight:600;">Tổng tiền</label>' +
                    '<input type="text" class="tc-tanca-input fin-item-subtotal" readonly style="background:#f1f5f9;font-weight:700;color:#059669;" value="0 VNĐ" />' +
                '</div>' +
            '</div>' +
            '<div>' +
                '<label style="display:block;font-size:12.5px;color:#475467;margin-bottom:4px;font-weight:600;">Ghi chú</label>' +
                '<input type="text" class="tc-tanca-input fin-item-note" placeholder="Nhập ghi chú thêm nếu có..." value="' + esc(prefillNote || '') + '" />' +
            '</div>' +
        '</div>';
        $('#financeDetailList').append(cardHtml);
        renumberFinanceCards();
        recalcFinanceTotal();
    }
    window.addFinanceDetailItem = addFinanceDetailItem;

    function removeFinanceDetailItem(idx) {
        if ($('#financeDetailList .tc-detail-card').length <= 1) {
            showToast('Cần ít nhất một mục chi tiết.', 'info');
            return;
        }
        $('#finDetailCard_' + idx).remove();
        renumberFinanceCards();
        recalcFinanceTotal();
    }
    window.removeFinanceDetailItem = removeFinanceDetailItem;

    function renumberFinanceCards() {
        $('#financeDetailList .tc-detail-card').each(function(i) {
            $(this).find('.fin-card-title').text('Mục ' + (i + 1));
        });
    }

    function recalcFinanceTotal() {
        var grandTotal = 0;
        $('#financeDetailList .tc-detail-card').each(function() {
            var qty = parseFloat($(this).find('.fin-item-qty').val()) || 0;
            var price = parseFloat($(this).find('.fin-item-price').val()) || 0;
            var subtotal = qty * price;
            grandTotal += subtotal;
            $(this).find('.fin-item-subtotal').val(fmtMoney(subtotal) + ' VNĐ');
        });
        $('#financeGrandTotalDisplay').text(fmtMoney(grandTotal) + ' VNĐ');
        $('#financeGrandTotalVal').val(grandTotal);
    }
    window.recalcFinanceTotal = recalcFinanceTotal;

    function selectCreateType(type, cat, iconHtml, iconBg, iconColor) {
        $('#newReqTypeBadge').text(type);
        $('#newReqCatBadge').text('Nhóm: ' + (cat || 'Thủ tục'));
        $('#newReqSelectedIcon').html(iconHtml).css({
            'background-color': iconBg || '#d1fae5',
            'color': iconColor || '#059669'
        });
        $('#newReqModalHeaderTitle').text('Tạo yêu cầu: ' + type);
        renderDynamicCreateForm(type, cat);
        $('#createStepTypes').removeClass('is-active');
        $('#createStepForm').addClass('is-active');
    }

    function openDirectLeaveModal() {
        loadCachedUsers();
        $('#createSearchInput').val('');
        $('#tcCreateModalBackdrop').addClass('is-open');
        $('#tcCreateModal').addClass('is-open');
        selectCreateType('Nghỉ phép', 'Lượt chấm công', '<svg class="tc-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20" /><path d="M12 2a10 10 0 0 1 10 10c0 1.5-1.5 2-3 2-2 0-3-1-4-1s-2 1-3 1-2-1-3-1-2 1-4 1c-1.5 0-3-.5-3-2A10 10 0 0 1 12 2z" /><circle cx="12" cy="12" r="1.5" /></svg>', '#d1fae5', '#059669');
    }
    window.openDirectLeaveModal = openDirectLeaveModal;

    function openCreateModal() {
        loadCachedUsers();
        $('#createSearchInput').val('');
        $('.tc-create-item').show();
        $('.tc-create-cat').show();
        $('#createStepForm').removeClass('is-active');
        $('#createStepTypes').addClass('is-active');
        $('#tcCreateModalBackdrop').addClass('is-open');
        $('#tcCreateModal').addClass('is-open');
    }
    window.openCreateModal = openCreateModal;

    function closeCreateModal() {
        $('#tcCreateModal').removeClass('is-open');
        $('#tcCreateModalBackdrop').removeClass('is-open');
        $('#dynamicFormContainer').empty();
    }
    window.closeCreateModal = closeCreateModal;

    // Events
    $(document).on('click', '#tcCreateModalClose, #tcCreateModalCancel, #tcCreateModalBackdrop, #tcCreateFormClose', closeCreateModal);
    $(document).on('click', '#btnBackToTypes, #btnChangeType, #btnCancelCreateForm', function () {
        $('#createStepForm').removeClass('is-active');
        $('#createStepTypes').addClass('is-active');
    });

    $('#createSearchInput').on('input', function () {
        var q = $(this).val().trim().toLowerCase();
        $('.tc-create-item').each(function () {
            var type = ($(this).data('type') || '').toLowerCase();
            if (!q || type.indexOf(q) !== -1) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
        $('.tc-create-cat').each(function () {
            var hasVisible = $(this).find('.tc-create-item:visible').length > 0;
            $(this).toggle(hasVisible);
        });
    });

    $(document).on('click', '.tc-create-item', function () {
        var type = $(this).data('type');
        var cat = $(this).data('cat');
        var iconSpan = $(this).find('.tc-item-icon');
        var iconHtml = iconSpan.html();
        var iconBg = iconSpan.css('background-color');
        var iconColor = iconSpan.css('color');
        selectCreateType(type, cat, iconHtml, iconBg, iconColor);
    });

    $(document).on('input change', '.fin-item-qty, .fin-item-price', recalcFinanceTotal);
    $(document).on('click', '#btnFinanceAddDetail', function () { addFinanceDetailItem('', 1, '', ''); });
    $(document).on('change', '#dynAttachmentFile', function () {
        var f = this.files && this.files[0];
        $('#dynAttachmentName').html(f ? ('<i class="material-icons" style="font-size:14px;color:#10b981;vertical-align:middle;">check_circle</i> ' + esc(f.name) + ' (' + (f.size / 1024).toFixed(1) + ' KB)') : 'Chưa có tệp nào');
    });
    $(document).on('change', '#dynStartDate, #dynEndDate', function () {
        var s = $('#dynStartDate').val();
        var e = $('#dynEndDate').val();
        if (s && e) {
            var d = calcDays(s, e);
            $('#dynLeaveDaysCalc').text(d + ' ngày');
        }
    });
    $(document).on('input change', '#dynRuleTime, #dynActualTime', function () {
        var r = $('#dynRuleTime').val();
        var a = $('#dynActualTime').val();
        if (r && a) {
            var diff = moment(a, 'HH:mm').diff(moment(r, 'HH:mm'), 'minutes');
            var txt = diff >= 0 ? ('Chậm ' + diff + ' phút') : ('Sớm ' + Math.abs(diff) + ' phút');
            $('#dynAttendDiffCalc').text(txt);
        }
    });
    $(document).on('input change', '#dynOtFrom, #dynOtTo', function () {
        var f = $('#dynOtFrom').val();
        var t = $('#dynOtTo').val();
        if (f && t) {
            var mins = moment(t, 'HH:mm').diff(moment(f, 'HH:mm'), 'minutes');
            if (mins < 0) mins += 24 * 60;
            var hrs = (mins / 60).toFixed(1);
            $('#dynOtHoursCalc').text(hrs + ' giờ OT');
        }
    });

    $(document).on('input change', '#dynEmployeeInput', function () {
        var val = ($(this).val() || '').trim().toLowerCase();
        var matchedId = '';
        if (cachedUsers && cachedUsers.length) {
            for (var i = 0; i < cachedUsers.length; i++) {
                var u = cachedUsers[i];
                var uName = (u.DisplayName || '').toLowerCase();
                var fullText = (u.DisplayName + (u.DepartmentName ? ' - ' + u.DepartmentName : '')).toLowerCase();
                if (val === uName || val === fullText) {
                    matchedId = u.Id;
                    break;
                }
            }
        }
        if (!matchedId && val === (currentDisplayName || '').toLowerCase()) {
            matchedId = currentUserId;
        }
        $('#dynEmployeeId').val(matchedId);
    });

    /* Submit Dynamic Request Handler */
    $(document).on('click', '#btnSubmitDynamicRequest', function () {
        var formBox = $('#dynamicFormContainer .tc-tanca-form');
        if (!formBox.length) return;
        var tpl = formBox.data('template');
        var type = $('#dynReqType').val() || 'Yêu cầu';
        var empName = ($('#dynEmployeeInput').val() || '').trim();
        var empId = $('#dynEmployeeId').val() || null;
        var title = ($('#dynTitle').val() || '').trim();
        var fileInput = $('#dynAttachmentFile')[0];
        var file = fileInput && fileInput.files && fileInput.files[0];
        var token = $('#tcTokenFormShared input[name="__RequestVerificationToken"]').val() ||
                    $('#tcTokenForm input[name="__RequestVerificationToken"]').val() ||
                    $('input[name="__RequestVerificationToken"]').val();

        var startDate = moment().format('YYYY-MM-DD');
        var endDate = startDate;
        var sessionCode = 'Cả ngày';
        var handoverTo = '';
        var reason = '';

        if (!empName) {
            empName = currentDisplayName || 'Chính tôi';
        }
        if (!title) {
            alert('Vui lòng nhập tiêu đề đề xuất.');
            $('#dynTitle').focus();
            return;
        }

        if (tpl === 'FINANCE') {
            var date = $('#dynDate').val();
            var subtype = $('#dynSubtype').val();
            var purpose = $('#dynPurpose').val();
            var payMethod = $('#dynPaymentMethod').val();
            var dueDate = $('#dynDueDate').val();
            var grandTotal = parseFloat($('#financeGrandTotalVal').val()) || 0;

            if (!date) {
                alert('Vui lòng chọn ngày đề xuất.');
                return;
            }

            var items = [];
            var hasInvalid = false;
            $('#financeDetailList .tc-detail-card').each(function () {
                var itTitle = ($(this).find('.fin-item-title').val() || '').trim();
                var qty = parseFloat($(this).find('.fin-item-qty').val()) || 0;
                var price = parseFloat($(this).find('.fin-item-price').val()) || 0;
                var note = ($(this).find('.fin-item-note').val() || '').trim();
                if (!itTitle) {
                    hasInvalid = true;
                    $(this).find('.fin-item-title').focus();
                    return false;
                }
                items.push({ title: itTitle, qty: qty, price: price, subtotal: qty * price, note: note });
            });

            if (hasInvalid || !items.length) {
                alert('Vui lòng điền nội dung đề xuất cho các mục chi tiết.');
                return;
            }

            startDate = date;
            endDate = dueDate || date;
            sessionCode = payMethod;
            handoverTo = purpose;

            var reasonLines = [];
            reasonLines.push('Tiêu đề: ' + title);
            reasonLines.push('Loại: ' + subtype + ' | Nhóm: Tài chính & chi phí');
            reasonLines.push('Mục đích: ' + purpose + ' | Phương thức: ' + payMethod + (dueDate ? ' | Hạn hoàn ứng: ' + fmtDate(dueDate) : ''));
            reasonLines.push('Tổng số tiền: ' + fmtMoney(grandTotal) + ' VNĐ');
            reasonLines.push('Chi tiết các mục:');
            items.forEach(function (it, i) {
                var l = ' - Mục ' + (i + 1) + ': ' + it.title + ' (SL: ' + it.qty + ', Đơn giá: ' + fmtMoney(it.price) + ' đ, Thành tiền: ' + fmtMoney(it.subtotal) + ' đ)';
                if (it.note) l += ' [Ghi chú: ' + it.note + ']';
                reasonLines.push(l);
            });
            reason = reasonLines.join('\n');
        } else if (tpl === 'LEAVE') {
            var sDate = $('#dynStartDate').val();
            var eDate = $('#dynEndDate').val();
            var leaveSubtype = $('#dynLeaveSubtype').val();
            var sess = $('#dynSession').val();
            var ho = ($('#dynHandover').val() || '').trim();
            var loc = ($('#dynLocation').val() || '').trim();
            var r = ($('#dynReason').val() || '').trim();
            var isTrip = type.indexOf('Công tác') !== -1;

            if (!sDate || !eDate) {
                alert('Vui lòng chọn từ ngày và đến ngày.');
                return;
            }
            if (moment(eDate).isBefore(moment(sDate))) {
                alert('Ngày kết thúc không được trước ngày bắt đầu.');
                return;
            }
            if (!r) {
                alert('Vui lòng nhập lý do đề xuất.');
                $('#dynReason').focus();
                return;
            }
            if (isTrip && !loc) {
                alert('Vui lòng nhập địa điểm công tác.');
                $('#dynLocation').focus();
                return;
            }

            startDate = sDate;
            endDate = eDate;
            sessionCode = sess;
            handoverTo = ho;
            var days = calcDays(sDate, eDate);

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Loại: ' + leaveSubtype + (loc ? ' | Địa điểm: ' + loc : '') + ' | Thời gian: ' + days + ' ngày (' + sess + ')\n';
            if (isTrip) {
                var advance = parseFloat($('#dynAdvanceAmount').val()) || 0;
                reason += 'Đối tác / liên hệ: ' + (($('#dynTripContact').val() || '').trim() || 'Chưa cung cấp') + '\n' +
                          'Phương tiện: ' + $('#dynTransport').val() + ' | Lưu trú: ' + $('#dynLodging').val() + '\n' +
                          'Tạm ứng: ' + (advance ? fmtMoney(advance) + ' VNĐ - ' + $('#dynAdvanceMethod').val() : 'Không tạm ứng') + '\n' +
                          'Dự toán: ' + (($('#dynTripBudget').val() || '').trim() || 'Chưa cung cấp') + '\n' +
                          'Người cùng công tác: ' + (($('#dynTripCompanions').val() || '').trim() || 'Không có') + '\n';
            }
            reason += 'Lý do / nội dung công việc: ' + r;
        } else if (tpl === 'SUPPORT') {
            var targetDate = $('#dynTargetDate').val();
            var supportGroup = $('#dynSupportGroup').val();
            var supportType = $('#dynSupportType').val();
            var priority = $('#dynPriority').val();
            var detail = ($('#dynReason').val() || '').trim();
            if (!detail) {
                alert('Vui lòng mô tả chi tiết yêu cầu hỗ trợ.');
                $('#dynReason').focus();
                return;
            }
            startDate = moment().format('YYYY-MM-DD');
            endDate = targetDate || startDate;
            sessionCode = priority;
            handoverTo = supportGroup;
            reason = 'Tiêu đề: ' + title + '\n' +
                     'Nhóm hỗ trợ: ' + supportGroup + ' | Loại: ' + supportType + ' | Ưu tiên: ' + priority + '\n' +
                     'Hạn mong muốn: ' + fmtDate(endDate) + '\n' +
                     'Địa điểm / phòng ban: ' + (($('#dynSupportLocation').val() || '').trim() || 'Chưa cung cấp') + '\n' +
                     'Thiết bị / mã tài sản: ' + (($('#dynAssetCode').val() || '').trim() || 'Không có') + '\n' +
                     'Liên hệ: ' + (($('#dynContactInfo').val() || '').trim() || 'Theo hồ sơ nhân viên') + '\n' +
                     'Mô tả: ' + detail;
        } else if (tpl === 'ATTENDANCE') {
            var aDate = $('#dynDate').val();
            var adjType = $('#dynAdjustType').val();
            var rTime = $('#dynRuleTime').val();
            var aTime = $('#dynActualTime').val();
            var shift = $('#dynShift').val();
            var r = ($('#dynReason').val() || '').trim();

            if (!aDate) {
                alert('Vui lòng chọn ngày áp dụng.');
                return;
            }
            if (!r) {
                alert('Vui lòng nhập lý do giải trình.');
                $('#dynReason').focus();
                return;
            }

            startDate = aDate;
            endDate = aDate;
            sessionCode = shift;
            handoverTo = adjType;

            var diffText = $('#dynAttendDiffCalc').text();
            reason = 'Tiêu đề: ' + title + '\n' +
                     'Loại điều chỉnh: ' + adjType + ' | Ca làm: ' + shift + '\n' +
                     'Giờ quy định: ' + rTime + ' | Giờ thực tế: ' + aTime + ' (' + diffText + ')\n' +
                     'Giải trình: ' + r;
        } else if (tpl === 'OVERTIME') {
            var otDate = $('#dynDate').val();
            var fromT = $('#dynOtFrom').val();
            var toT = $('#dynOtTo').val();
            var rate = $('#dynOtRate').val();
            var proj = ($('#dynProject').val() || '').trim();
            var sup = ($('#dynSupervisor').val() || '').trim();
            var r = ($('#dynReason').val() || '').trim();

            if (!otDate) {
                alert('Vui lòng chọn ngày làm thêm giờ.');
                return;
            }
            if (!proj) {
                alert('Vui lòng nhập dự án hoặc mục tiêu công việc OT.');
                $('#dynProject').focus();
                return;
            }
            if (!r) {
                alert('Vui lòng nhập chi tiết nội dung công việc OT.');
                $('#dynReason').focus();
                return;
            }

            startDate = otDate;
            endDate = otDate;
            var otHoursTxt = $('#dynOtHoursCalc').text();
            sessionCode = fromT + ' - ' + toT + ' (' + otHoursTxt + ')';
            handoverTo = sup;

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Thời gian OT: ' + otDate + ' từ ' + fromT + ' đến ' + toT + ' (' + otHoursTxt + ') | Hệ số: ' + rate + '\n' +
                     'Dự án/Công việc: ' + proj + (sup ? ' | Người giám sát: ' + sup : '') + '\n' +
                     'Nội dung thực hiện: ' + r;
        } else if (tpl === 'SHIFT') {
            var sDate = $('#dynDate').val();
            var curS = $('#dynCurShift').val();
            var newS = $('#dynNewShift').val();
            var partner = ($('#dynSwapPartner').val() || '').trim();
            var r = ($('#dynReason').val() || '').trim();

            if (!sDate) {
                alert('Vui lòng chọn ngày áp dụng.');
                return;
            }
            if (!r) {
                alert('Vui lòng nhập lý do đề xuất.');
                $('#dynReason').focus();
                return;
            }

            startDate = sDate;
            endDate = sDate;
            sessionCode = curS + ' -> ' + newS;
            handoverTo = partner;

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Ca hiện tại: ' + curS + ' -> Ca mới: ' + newS + (partner ? ' | Đổi cùng: ' + partner : '') + '\n' +
                     'Lý do: ' + r;
        } else if (tpl === 'MEAL') {
            var sDate = $('#dynStartDate').val();
            var eDate = $('#dynEndDate').val();
            var mType = $('#dynMealType').val();
            var loc = ($('#dynLocation').val() || '').trim();
            var r = ($('#dynReason').val() || '').trim();

            if (!sDate || !eDate) {
                alert('Vui lòng chọn khoảng thời gian đăng ký.');
                return;
            }

            startDate = sDate;
            endDate = eDate;
            sessionCode = mType;
            handoverTo = loc;

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Loại suất ăn: ' + mType + (loc ? ' | Địa điểm: ' + loc : '') + '\n' +
                     'Ghi chú dinh dưỡng: ' + (r || 'Không có');
        } else if (tpl === 'RECRUITMENT') {
            var pos = ($('#dynPosition').val() || '').trim();
            var dept = $('#dynDept').val();
            var qty = $('#dynHeadcount').val() || 1;
            var salary = ($('#dynSalary').val() || '').trim();
            var tDate = $('#dynTargetDate').val();
            var r = ($('#dynReason').val() || '').trim();

            if (!pos) {
                alert('Vui lòng nhập vị trí chức danh cần tuyển.');
                $('#dynPosition').focus();
                return;
            }
            if (!r) {
                alert('Vui lòng nhập lý do tuyển dụng và mô tả công việc (JD).');
                $('#dynReason').focus();
                return;
            }

            startDate = moment().format('YYYY-MM-DD');
            endDate = tDate || startDate;
            sessionCode = 'SL: ' + qty + ' người (' + dept + ')';
            handoverTo = pos;

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Vị trí: ' + pos + ' | Phòng ban: ' + dept + ' | Số lượng: ' + qty + ' người\n' +
                     'Mức lương dự kiến: ' + (salary || 'Thỏa thuận') + (tDate ? ' | Hạn đi làm: ' + fmtDate(tDate) : '') + '\n' +
                     'Mô tả & Lý do tuyển dụng: ' + r;
        } else if (tpl === 'RESIGNATION') {
            var lastDay = $('#dynLastDay').val();
            var hoDay = $('#dynHandoverDay').val();
            var ho = ($('#dynHandover').val() || '').trim();
            var r = ($('#dynReason').val() || '').trim();

            if (!lastDay) {
                alert('Vui lòng chọn ngày làm việc cuối cùng.');
                return;
            }
            if (!ho) {
                alert('Vui lòng nhập người nhận bàn giao công việc & tài sản.');
                $('#dynHandover').focus();
                return;
            }
            if (!r) {
                alert('Vui lòng nhập lý do xin nghỉ việc.');
                $('#dynReason').focus();
                return;
            }

            startDate = moment().format('YYYY-MM-DD');
            endDate = lastDay;
            sessionCode = 'Bàn giao: ' + fmtDate(hoDay);
            handoverTo = ho;

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Ngày làm việc cuối: ' + fmtDate(lastDay) + ' | Hoàn tất bàn giao: ' + fmtDate(hoDay) + '\n' +
                     'Người nhận bàn giao: ' + ho + '\n' +
                     'Lý do nghỉ việc: ' + r;
        } else if (tpl === 'APPOINTMENT') {
            var oldPos = ($('#dynOldPos').val() || '').trim();
            var newPos = ($('#dynNewPos').val() || '').trim();
            var effDate = $('#dynEffectiveDate').val();
            var newSal = ($('#dynNewSalary').val() || '').trim();
            var r = ($('#dynReason').val() || '').trim();

            if (!newPos) {
                alert('Vui lòng nhập vị trí/chức vụ mới.');
                $('#dynNewPos').focus();
                return;
            }
            if (!effDate) {
                alert('Vui lòng chọn ngày có hiệu lực.');
                return;
            }
            if (!r) {
                alert('Vui lòng nhập lý do đề xuất bổ nhiệm/điều chuyển.');
                $('#dynReason').focus();
                return;
            }

            startDate = moment().format('YYYY-MM-DD');
            endDate = effDate;
            sessionCode = 'Bổ nhiệm: ' + newPos;
            handoverTo = oldPos;

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Hiện tại: ' + (oldPos || 'Chưa cập nhật') + ' -> Mới: ' + newPos + '\n' +
                     'Ngày hiệu lực: ' + fmtDate(effDate) + (newSal ? ' | Mức lương mới: ' + newSal : '') + '\n' +
                     'Lý do đề xuất: ' + r;
        } else if (tpl === 'REWARD_DISCIPLINE') {
            var formType = $('#dynFormType').val();
            var amt = ($('#dynAmount').val() || '').trim();
            var effDate = $('#dynEffectiveDate').val();
            var r = ($('#dynReason').val() || '').trim();

            if (!effDate) {
                alert('Vui lòng chọn ngày có hiệu lực.');
                return;
            }
            if (!r) {
                alert('Vui lòng nhập nội dung thành tích hoặc vi phạm.');
                $('#dynReason').focus();
                return;
            }

            startDate = moment().format('YYYY-MM-DD');
            endDate = effDate;
            sessionCode = formType;
            handoverTo = amt ? ('Số tiền: ' + amt) : 'Không có tiền mặt';

            reason = 'Tiêu đề: ' + title + '\n' +
                     'Hình thức: ' + formType + (amt ? ' | Số tiền: ' + amt : '') + ' | Ngày hiệu lực: ' + fmtDate(effDate) + '\n' +
                     'Chi tiết: ' + r;
        }

        var btn = $(this);
        btn.prop('disabled', true).html('<i class="material-icons" style="font-size:16px;vertical-align:middle;">sync</i> Đang gửi...');

        var payload = new FormData();
        payload.append('__RequestVerificationToken', token || '');
        if (empId) payload.append('EmployeeId', +empId);
        payload.append('LeaveType', type);
        payload.append('StartDate', startDate);
        payload.append('EndDate', endDate);
        payload.append('SessionCode', sessionCode);
        payload.append('HandoverTo', handoverTo);
        payload.append('Reason', reason);
        if (file) payload.append('attachment', file, file.name);

        $.ajax({
            url: '@Url.Action("CreateLeave", "Hrm")',
            method: 'POST',
            data: payload,
            processData: false,
            contentType: false
        }).done(function (res) {
            var reqCode = (res.Data && res.Data.RequestCode) || '';
            showToast('Đã tạo đề xuất ' + (reqCode ? '#' + reqCode : '') + ' thành công!', 'success');
            closeCreateModal();
            $(document).trigger('tanca:requestCreated', [res]);
            if (typeof window.onTancaRequestCreated === 'function') {
                window.onTancaRequestCreated(res);
            }
            if (typeof load === 'function') {
                load();
            }
            if (typeof loadData === 'function') {
                loadData();
            }
        }).fail(function (xhr) {
            var msg = (xhr.responseJSON && xhr.responseJSON.Message) || 'Không thể tạo yêu cầu.';
            showToast(msg, 'danger');
            alert(msg);
        }).always(function () {
            btn.prop('disabled', false).html('<i class="material-icons" style="font-size:18px;">add_task</i> Tạo mới');
        });
    });
})();
</script>
