<script>
(function () {
    var currentDisplayName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentDisplayName));
    var currentUserId = @currentUserId;
    var roleCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleCode));

    function esc(v) {
        return $('<div>').text(v == null ? '' : v).html();
    }
    function fmtDate(v) {
        return v ? moment(v).format('DD/MM/YYYY') : '—';
    }
    function fmtMoney(n) {
        return (n || 0).toLocaleString('vi-VN');
    }
    function calcDays(start, end) {
        if (!start || !end) return 1;
        var s = moment(start).startOf('day');
        var e = moment(end).startOf('day');
        return Math.max(1, e.diff(s, 'days') + 1);
    }

    function showToast(msg, type) {
        var container = $('#tcToastContainerShared');
        if (!container.length) container = $('#tcToastContainer');
        var toast = $('<div class="tc-toast ' + (type || 'info') + '">' +
            '<i class="material-icons" style="font-size:18px;">' + (type === 'success' ? 'check_circle' : type === 'danger' ? 'error' : 'info') + '</i>' +
            '<span>' + esc(msg) + '</span>' +
            '</div>');
        container.append(toast);
        setTimeout(function () { toast.addClass('is-visible'); }, 20);
        setTimeout(function () {
            toast.removeClass('is-visible');
            setTimeout(function () { toast.remove(); }, 300);
        }, 3600);
    }
    window.showTancaToast = showToast;

    /* User Cache for Dynamic Dropdowns */
    var cachedUsers = [];
    function loadCachedUsers() {
        if (!cachedUsers.length) {
            $.get('@Url.Action("Users", "Hrm")').done(function (res) {
                cachedUsers = res.Data || [];
            });
        }
    }

    function getRequestCategoryTemplate(type, cat) {
        var t = (type || '').toLowerCase();
        var c = (cat || '').toLowerCase();
        if (c.indexOf('tài chính') !== -1 || t.indexOf('tạm ứng') !== -1 || t.indexOf('hoàn ứng') !== -1 ||
            t.indexOf('thanh toán') !== -1 || t.indexOf('phiếu đề nghị') !== -1 || t.indexOf('trả góp') !== -1 ||
            t.indexOf('tiền thưởng') !== -1 || t.indexOf('hoa hồng') !== -1 || t.indexOf('chi phí') !== -1) {
            return 'FINANCE';
        }
        if (t.indexOf('làm thêm') !== -1 || t.indexOf('ot') !== -1 || t.indexOf('tăng ca') !== -1) {
            return 'OVERTIME';
        }
        if (t.indexOf('đi muộn') !== -1 || t.indexOf('về sớm') !== -1 || t.indexOf('thay đổi giờ') !== -1) {
            return 'ATTENDANCE';
        }
        if (t.indexOf('ca làm') !== -1 || t.indexOf('đổi ca') !== -1 || t.indexOf('đăng ký ca') !== -1) {
            return 'SHIFT';
        }
        if (t.indexOf('suất ăn') !== -1 || t.indexOf('cơm') !== -1) {
            return 'MEAL';
        }
        if (t.indexOf('tuyển dụng') !== -1) {
            return 'RECRUITMENT';
        }
        if (t.indexOf('nghỉ việc') !== -1 || t.indexOf('thôi việc') !== -1) {
            return 'RESIGNATION';
        }
        if (t.indexOf('bổ nhiệm') !== -1 || t.indexOf('điều chuyển') !== -1) {
            return 'APPOINTMENT';
        }
        if (t.indexOf('khen thưởng') !== -1 || t.indexOf('kỷ luật') !== -1) {
            return 'REWARD_DISCIPLINE';
        }
        if (t.indexOf('hỗ trợ') !== -1) {
            return 'SUPPORT';
        }
        return 'LEAVE';
    }

