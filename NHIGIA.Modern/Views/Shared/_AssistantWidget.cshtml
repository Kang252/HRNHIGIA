@{
    var assistantUser = HrmUser.Current;
}
<div class="hrm-ai" id="hrmAi" data-endpoint="@Url.Action("Ask", "Assistant")" data-user-id="@assistantUser?.Id">
    <button class="hrm-ai-launcher" id="hrmAiLauncher" type="button" aria-controls="hrmAiPanel" aria-expanded="false" title="Trợ lý Nhị Gia">
        <svg class="hrm-ai-launcher-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm-2 11H6v-2h12v2Zm0-3H6V8h12v2Zm0-3H6V5h12v2Z" /></svg>
        <span>Trợ lý AI</span>
    </button>
    <section class="hrm-ai-panel" id="hrmAiPanel" aria-label="Trợ lý Nhị Gia" aria-hidden="true">
        <header class="hrm-ai-header">
            <div class="hrm-ai-brand"><span><i class="material-icons">smart_toy</i></span><div><strong>Trợ lý Nhị Gia</strong><small>Trò chuyện tự do · SQL theo quyền @assistantUser?.RoleLabel</small></div></div>
            <button id="hrmAiClose" type="button" aria-label="Đóng trợ lý"><i class="material-icons">close</i></button>
        </header>
        <div class="hrm-ai-privacy"><i class="material-icons">verified_user</i><span>Chỉ dữ liệu SQL bị giới hạn theo quyền tài khoản.</span></div>
        <div class="hrm-ai-messages" id="hrmAiMessages" aria-live="polite">
            <div class="hrm-ai-message is-bot"><div>Xin chào @assistantUser?.DisplayName! Bạn có thể trò chuyện với tôi về mọi chủ đề hoặc tra cứu dữ liệu HRM theo quyền tài khoản.</div></div>
        </div>
        <div class="hrm-ai-suggestions" id="hrmAiSuggestions">
            <button type="button">Chấm công hôm nay</button>
            <button type="button">Tôi còn bao nhiêu ngày phép?</button>
            <button type="button">Lịch làm việc của tôi</button>
            <button type="button">KPI của tôi</button>
        </div>
        <form class="hrm-ai-form" id="hrmAiForm">
            @Html.AntiForgeryToken()
            <label class="sr-only" for="hrmAiQuestion">Nhập câu hỏi</label>
            <textarea id="hrmAiQuestion" maxlength="500" rows="1" placeholder="Nhập câu hỏi bất kỳ..." required></textarea>
            <button type="submit" aria-label="Gửi câu hỏi"><i class="material-icons">send</i></button>
        </form>
    </section>
</div>
