@{
    var user = HrmUser.Current;
    var role = user?.RoleCode ?? string.Empty;
    var canManage = HrmRoles.CanManagePeople(role);
    var canConfigure = role == HrmRoles.Admin || role == HrmRoles.Hr || role == HrmRoles.Director;
    var workKind = ViewContext.RouteData.Values["controller"]?.ToString() == "Work" ? ((Model as WorkPage)?.Kind ?? "kpi") : "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isWork = ViewContext.RouteData.Values["controller"]?.ToString() == "Work";

    if (isWork) { action = "Work"; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nhị Gia - @ViewBag.Title</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/Content/css/css.css" />
    <link rel="stylesheet" href="~/Content/css/icon.css" />
    <link rel="stylesheet" href="~/Content/plugins/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/hrm-modern.css" asp-append-version="true" />
    <style>
        .navbar-brand,.navbar-brand:hover,.navbar-brand:focus{color:#111827!important}.navbar-brand:before{content:"NG"!important}.navbar .navbar-header{display:flex;align-items:center}.hrm-top-user{color:#fff;padding:21px 18px;display:inline-block}.hrm-logout{display:inline-block;margin:13px 16px 0 0}.hrm-logout button{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:7px;padding:7px 12px}.hrm-menu-toggle{display:inline-flex;width:40px;height:40px;flex:0 0 40px;align-items:center;justify-content:center;margin-left:5px;border:0;border-radius:9px;background:rgba(255,255,255,.16);color:#fff}.hrm-menu-toggle:hover,.hrm-menu-toggle:focus{background:rgba(255,255,255,.26);outline:0}.hrm-menu-toggle .material-icons{font-size:24px}.sidebar,.sidebar .menu,.sidebar .menu .list{overflow-x:hidden!important}.sidebar .menu .list{width:100%;margin:0}.sidebar .menu .list a{display:flex;align-items:center;gap:10px;width:calc(100% - 20px);box-sizing:border-box}.sidebar .menu .list a i{margin-top:0!important;flex:0 0 24px;width:24px}.sidebar .menu .list a span{margin-left:12px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sidebar .menu .list li.active>a{background:#eaf2ff;color:#1769e0}.hrm-sidebar-overlay{display:none}body.hrm-menu-collapsed .sidebar{transform:translateX(-105%)}body.hrm-menu-collapsed section.content{margin-left:22px}
        @@media(max-width:900px){body.hrm-menu-open{overflow:hidden}.navbar{z-index:1003!important}.navbar .container-fluid{display:flex;align-items:center;height:64px}.navbar .navbar-header{min-width:0;flex:1}.navbar .navbar-brand{min-width:0;margin-left:0!important;padding-left:0;white-space:nowrap}.navbar .pull-right{display:flex;align-items:center;flex:0 0 auto}.hrm-top-user{display:none}.hrm-logout{margin:0 8px 0 0}.hrm-logout button{padding:7px 9px}.hrm-logout button .material-icons{margin:0}.hrm-logout-label{display:none}.hrm-menu-toggle{width:42px;height:42px;flex-basis:42px;margin-left:0;margin-right:12px}.sidebar,body.hrm-menu-collapsed .sidebar{display:flex!important;top:64px;left:0;width:min(84vw,300px);height:calc(100dvh - 64px);z-index:1002!important;transform:translate3d(-105%,0,0);transition:transform .22s ease;box-shadow:8px 0 24px rgba(15,35,65,.22);visibility:hidden}body.hrm-menu-open .sidebar,body.hrm-menu-open.hrm-menu-collapsed .sidebar{transform:translate3d(0,0,0);visibility:visible}.hrm-sidebar-overlay{position:fixed;inset:64px 0 0;background:rgba(15,23,42,.45);z-index:1001!important}body.hrm-menu-open .hrm-sidebar-overlay{display:block}.sidebar .menu{max-height:none;overscroll-behavior:contain}.sidebar .user-info{height:108px;min-height:108px;flex-basis:108px}section.content,body.hrm-menu-collapsed section.content{width:auto;max-width:none;margin:80px 12px 18px}.hrm-page-header{margin-top:0}.hrm-grid-4,.hrm-grid-3,.hrm-grid-2,.hrm-content-grid{grid-template-columns:1fr!important}}
    </style>
    <script src="~/Content/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.js"></script>
    <script src="~/Scripts/moment.js"></script>
</head>
<body class="theme-red">
    <nav class="navbar navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button class="hrm-menu-toggle" type="button" aria-label="Mở menu" aria-controls="leftsidebar" aria-expanded="false"><i class="material-icons">menu</i></button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">HRM NHỊ GIA</a>
            </div>
            <div class="pull-right">
                <span class="hrm-top-user">@user?.DisplayName · @user?.RoleLabel</span>
                <form class="hrm-logout" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"><i class="material-icons" style="font-size:16px;vertical-align:middle">logout</i><span class="hrm-logout-label"> Đăng xuất</span></button>
                </form>
            </div>
        </div>
    </nav>

    <div class="hrm-sidebar-overlay" aria-hidden="true"></div>

    <section>
        <aside id="leftsidebar" class="sidebar">
            <div class="user-info">
                <div class="image"><span class="hrm-avatar">@((user?.DisplayName ?? "NG").Substring(0, Math.Min(2, (user?.DisplayName ?? "NG").Length)).ToUpperInvariant())</span></div>
                <div class="info-container">
                    <div class="name">@user?.DisplayName</div>
                    <div class="email">@user?.DepartmentName</div>
                    <small>@user?.RoleLabel</small>
                </div>
            </div>
            <div class="menu">
                <ul class="list">
                    <li class="header">NGHIỆP VỤ NHÂN SỰ</li>
                    <li class="@(action == "Index" && string.IsNullOrEmpty(workKind) ? "active" : "")"><a asp-controller="Home" asp-action="Index"><i class="material-icons">dashboard</i><span>Tổng quan</span></a></li>
                    <li class="@(action == "MyProfile" ? "active" : "")"><a asp-controller="Home" asp-action="MyProfile"><i class="material-icons">badge</i><span>Hồ sơ của tôi</span></a></li>
                    <li class="@(action == "Attendance" ? "active" : "")"><a asp-controller="Home" asp-action="Attendance"><i class="material-icons">alarm_on</i><span>Chấm công</span></a></li>
                    <li class="@(action == "WorkSchedules" ? "active" : "")"><a asp-controller="Home" asp-action="WorkSchedules"><i class="material-icons">event_note</i><span>@(canManage ? "Phân ca làm việc" : "Lịch làm việc")</span></a></li>
                    <li class="@(action == "LeaveRequests" ? "active" : "")"><a asp-controller="Home" asp-action="LeaveRequests"><i class="material-icons">event_busy</i><span>Nghỉ phép</span></a></li>
                    @if (canManage)
                    {
                        <li class="@(action == "Approvals" ? "active" : "")"><a asp-controller="Home" asp-action="Approvals"><i class="material-icons">fact_check</i><span>Phê duyệt</span></a></li>
                    }
                    <li class="@(action == "InternalCommunications" ? "active" : "")"><a asp-controller="Home" asp-action="InternalCommunications"><i class="material-icons">campaign</i><span>Truyền thông nội bộ</span></a></li>
                    @if (canConfigure)
                    {
                        <li class="@(action == "Reports" ? "active" : "")"><a asp-controller="Home" asp-action="Reports"><i class="material-icons">analytics</i><span>Báo cáo</span></a></li>
                        @if (Configuration.GetValue<bool>("Features:HanetIntegrationUiEnabled"))
                        {
                            <li class="@(action == "HanetIntegration" ? "active" : "")"><a asp-controller="Home" asp-action="HanetIntegration"><i class="material-icons">sync</i><span>Tích hợp HANET</span></a></li>
                        }
                    }
                    <li class="header">HIỆU SUẤT &amp; HỖ TRỢ</li>
                    <li class="@(workKind == "kpi" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="kpi"><i class="material-icons">track_changes</i><span>KPI</span></a></li>
                    <li class="@(workKind == "payroll" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="payroll"><i class="material-icons">payments</i><span>Tính lương</span></a></li>
                    @if (canConfigure) {
                    <li class="@(workKind == "recruitment" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="recruitment"><i class="material-icons">person_search</i><span>Tuyển dụng</span></a></li>
                    }
                    @if (canManage) {
                    <li class="@(workKind == "training" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="training"><i class="material-icons">school</i><span>Quản lý đào tạo</span></a></li>
                    }
                    <li class="@(workKind == "overtime" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="overtime"><i class="material-icons">more_time</i><span>Tăng ca</span></a></li>
                    <li class="@(workKind == "resignation" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="resignation"><i class="material-icons">person_remove</i><span>Quản lý nghỉ việc</span></a></li>
                    @if (canConfigure) {
                    <li class="@(workKind == "transfer" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="transfer"><i class="material-icons">swap_horiz</i><span>Điều chuyển nhân sự</span></a></li>
                    }
                    <li class="@(workKind == "assets" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="assets"><i class="material-icons">devices</i><span>Quản lý tài sản</span></a></li>
                    <li class="@(workKind == "helpdesk" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="helpdesk"><i class="material-icons">support_agent</i><span>Helpdesk IT</span></a></li>
                </ul>
            </div>
            <div class="legal"><div class="copyright">&copy; @DateTime.Now.Year <a asp-controller="Home" asp-action="Index">HRM NHỊ GIA</a></div></div>
        </aside>
    </section>

    <section class="content">@RenderBody()</section>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            var body = document.body;
            var toggle = document.querySelector('.hrm-menu-toggle');
            var overlay = document.querySelector('.hrm-sidebar-overlay');
            var sidebar = document.getElementById('leftsidebar');
            if (!toggle || !overlay || !sidebar) return;

            function setMenu(open) {
                body.classList.toggle('hrm-menu-open', open);
                updateToggle();
            }

            function updateToggle() {
                var expanded = window.innerWidth <= 900
                    ? body.classList.contains('hrm-menu-open')
                    : !body.classList.contains('hrm-menu-collapsed');
                toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                toggle.setAttribute('aria-label', expanded ? 'Ẩn menu' : 'Mở menu');
                toggle.querySelector('.material-icons').textContent = expanded ? 'menu_open' : 'menu';
            }

            if (window.innerWidth > 900 && window.localStorage.getItem('hrm-menu-collapsed') === 'true') {
                body.classList.add('hrm-menu-collapsed');
            }
            updateToggle();

            toggle.addEventListener('click', function () {
                if (window.innerWidth <= 900) {
                    setMenu(!body.classList.contains('hrm-menu-open'));
                    return;
                }
                body.classList.toggle('hrm-menu-collapsed');
                window.localStorage.setItem('hrm-menu-collapsed', body.classList.contains('hrm-menu-collapsed') ? 'true' : 'false');
                updateToggle();
            });
            overlay.addEventListener('click', function () { setMenu(false); });
            sidebar.addEventListener('click', function (event) {
                if (event.target.closest('a') && window.innerWidth <= 900) setMenu(false);
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') setMenu(false);
            });
            window.addEventListener('resize', function () {
                setMenu(false);
            });
        })();
    </script>
</body>
</html>
