@{
    var user = HrmUser.Current;
    var role = user?.RoleCode ?? string.Empty;
    var canManage = HrmRoles.CanManagePeople(role);
    var canConfigure = role == HrmRoles.Admin || role == HrmRoles.Hr || role == HrmRoles.Director;
    var workKind = ViewContext.RouteData.Values["controller"]?.ToString() == "Work" ? ((Model as WorkPage)?.Kind ?? "kpi") : "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isWork = ViewContext.RouteData.Values["controller"]?.ToString() == "Work";

    if (isWork) { action = "Work"; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nhị Gia - @ViewBag.Title</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/Content/css/css.css" />
    <link rel="stylesheet" href="~/Content/css/icon.css" />
    <link rel="stylesheet" href="~/Content/plugins/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/hrm-modern.css" asp-append-version="true" />
    <style>
        .navbar-brand:before{content:"NG"!important}.hrm-top-user{color:#fff;padding:21px 18px;display:inline-block}.hrm-logout{display:inline-block;margin:13px 16px 0 0}.hrm-logout button{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:7px;padding:7px 12px}.sidebar .menu .list a{display:flex;align-items:center;gap:10px}.sidebar .menu .list a i{margin-top:0!important}.sidebar .menu .list li.active>a{background:#eaf2ff;color:#1769e0}.hrm-mobile-menu{display:none}
        @@media(max-width:900px){.sidebar{display:none}section.content{margin:82px 12px 20px}.hrm-mobile-menu{display:flex;gap:8px;overflow-x:auto;padding:8px 12px;background:#fff;position:fixed;top:64px;left:0;right:0;z-index:8;border-bottom:1px solid #e5eaf1}.hrm-mobile-menu a{white-space:nowrap}.hrm-page-header{margin-top:48px}.hrm-grid-4,.hrm-grid-3,.hrm-grid-2,.hrm-content-grid{grid-template-columns:1fr!important}}
    </style>
    <script src="~/Content/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.js"></script>
    <script src="~/Scripts/moment.js"></script>
</head>
<body class="theme-red">
    <nav class="navbar navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header"><a class="navbar-brand" asp-controller="Home" asp-action="Index">HRM NHỊ GIA</a></div>
            <div class="pull-right">
                <span class="hrm-top-user">@user?.DisplayName · @user?.RoleLabel</span>
                <form class="hrm-logout" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"><i class="material-icons" style="font-size:16px;vertical-align:middle">logout</i> Đăng xuất</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="hrm-mobile-menu">
        <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="kpi">KPI</a>
        <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="payroll">@(canConfigure ? "Tính lương" : "Phiếu lương")</a>
        @if (canConfigure) { <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="recruitment">Tuyển dụng</a> }
        @if (canManage) { <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="training">Đào tạo</a> }
        <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="overtime">Tăng ca</a>
        <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="resignation">Nghỉ việc</a>
        @if (canConfigure) { <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="transfer">Điều chuyển</a> }
        <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="assets">Tài sản</a>
        <a class="hrm-btn" asp-controller="Work" asp-action="Index" asp-route-kind="helpdesk">Helpdesk IT</a>
        <a class="hrm-btn" href="/Home/Index">Tổng quan</a><a class="hrm-btn" href="/Home/Attendance">Chấm công</a><a class="hrm-btn" href="/Home/LeaveRequests">Nghỉ phép</a><a class="hrm-btn" href="/Home/WorkSchedules">Lịch làm việc</a>

    </div>

    <section>
        <aside id="leftsidebar" class="sidebar">
            <div class="user-info">
                <div class="image"><span class="hrm-avatar">@((user?.DisplayName ?? "NG").Substring(0, Math.Min(2, (user?.DisplayName ?? "NG").Length)).ToUpperInvariant())</span></div>
                <div class="info-container">
                    <div class="name">@user?.DisplayName</div>
                    <div class="email">@user?.DepartmentName</div>
                    <small>@user?.RoleLabel</small>
                </div>
            </div>
            <div class="menu">
                <ul class="list">
                    <li class="header">NGHIỆP VỤ NHÂN SỰ</li>
                    <li class="@(action == "Index" && string.IsNullOrEmpty(workKind) ? "active" : "")"><a asp-controller="Home" asp-action="Index"><i class="material-icons">dashboard</i><span>Tổng quan</span></a></li>
                    <li class="@(action == "MyProfile" ? "active" : "")"><a asp-controller="Home" asp-action="MyProfile"><i class="material-icons">badge</i><span>Hồ sơ của tôi</span></a></li>
                    <li class="@(action == "Attendance" ? "active" : "")"><a asp-controller="Home" asp-action="Attendance"><i class="material-icons">alarm_on</i><span>Chấm công</span></a></li>
                    <li class="@(action == "WorkSchedules" ? "active" : "")"><a asp-controller="Home" asp-action="WorkSchedules"><i class="material-icons">event_note</i><span>@(canManage ? "Phân ca làm việc" : "Lịch làm việc")</span></a></li>
                    <li class="@(action == "LeaveRequests" ? "active" : "")"><a asp-controller="Home" asp-action="LeaveRequests"><i class="material-icons">event_busy</i><span>Nghỉ phép</span></a></li>
                    @if (canManage)
                    {
                        <li class="@(action == "Approvals" ? "active" : "")"><a asp-controller="Home" asp-action="Approvals"><i class="material-icons">fact_check</i><span>Phê duyệt</span></a></li>
                    }
                    <li class="@(action == "InternalCommunications" ? "active" : "")"><a asp-controller="Home" asp-action="InternalCommunications"><i class="material-icons">campaign</i><span>Truyền thông nội bộ</span></a></li>
                    @if (canConfigure)
                    {
                        <li class="@(action == "Reports" ? "active" : "")"><a asp-controller="Home" asp-action="Reports"><i class="material-icons">analytics</i><span>Báo cáo</span></a></li>
                        @if (Configuration.GetValue<bool>("Features:HanetIntegrationUiEnabled"))
                        {
                            <li class="@(action == "HanetIntegration" ? "active" : "")"><a asp-controller="Home" asp-action="HanetIntegration"><i class="material-icons">sync</i><span>Tích hợp HANET</span></a></li>
                        }
                    }
                    <li class="header">HIỆU SUẤT &amp; HỖ TRỢ</li>
                    <li class="@(workKind == "kpi" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="kpi"><i class="material-icons">track_changes</i><span>KPI</span></a></li>
                    <li class="@(workKind == "payroll" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="payroll"><i class="material-icons">payments</i><span>Tính lương</span></a></li>
                    @if (canConfigure) {
                    <li class="@(workKind == "recruitment" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="recruitment"><i class="material-icons">person_search</i><span>Tuyển dụng</span></a></li>
                    }
                    @if (canManage) {
                    <li class="@(workKind == "training" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="training"><i class="material-icons">school</i><span>Quản lý đào tạo</span></a></li>
                    }
                    <li class="@(workKind == "overtime" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="overtime"><i class="material-icons">more_time</i><span>Tăng ca</span></a></li>
                    <li class="@(workKind == "resignation" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="resignation"><i class="material-icons">person_remove</i><span>Quản lý nghỉ việc</span></a></li>
                    @if (canConfigure) {
                    <li class="@(workKind == "transfer" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="transfer"><i class="material-icons">swap_horiz</i><span>Điều chuyển nhân sự</span></a></li>
                    }
                    <li class="@(workKind == "assets" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="assets"><i class="material-icons">inventory_2</i><span>Quản lý tài sản</span></a></li>
                    <li class="@(workKind == "helpdesk" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="helpdesk"><i class="material-icons">support_agent</i><span>Helpdesk IT</span></a></li>
                </ul>
            </div>
            <div class="legal"><div class="copyright">&copy; @DateTime.Now.Year <a asp-controller="Home" asp-action="Index">HRM NHỊ GIA</a></div></div>
        </aside>
    </section>

    <section class="content">@RenderBody()</section>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
