@{
    var user = HrmUser.Current;
    var role = user?.RoleCode ?? string.Empty;
    var canManage = HrmRoles.CanManagePeople(role);
    var canConfigure = role == HrmRoles.Admin || role == HrmRoles.Hr || role == HrmRoles.Director;
    var isEmployee = role == HrmRoles.Employee;
    var isManager = role == HrmRoles.Manager;
    var isDirector = role == HrmRoles.Director;
    var workKind = ViewContext.RouteData.Values["controller"]?.ToString() == "Work" ? ((Model as WorkPage)?.Kind ?? "kpi") : "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isWork = ViewContext.RouteData.Values["controller"]?.ToString() == "Work";

    if (isWork) { action = "Work"; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nhị Gia - @ViewBag.Title</title>
    <link rel="icon" type="image/png" href="~/images/nhigia-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/css.css" />
    <link rel="stylesheet" href="~/Content/css/icon.css" />
    <link rel="stylesheet" href="~/Content/plugins/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
    <link rel="stylesheet" href="~/Content/hrm-modern.css" asp-append-version="true" />
    <style>
        .theme-red .navbar{min-height:56px}.navbar .container-fluid{display:flex;align-items:center;height:56px}.navbar .navbar-header{display:flex;align-items:center;flex:1;padding:0 7px}.navbar-brand,.navbar-brand:hover,.navbar-brand:focus{height:56px!important;color:#111827!important}.navbar-brand:before{display:none!important}.hrm-brand-logo{width:36px;height:36px;flex:0 0 36px;border-radius:10px;background:#fff;object-fit:cover}.navbar .pull-right{display:flex;align-items:center;height:56px;gap:8px}.hrm-notification{display:inline-flex;width:38px;height:38px;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.35);border-radius:9px;background:rgba(255,255,255,.16);color:#fff}.hrm-notification:hover,.hrm-notification:focus{background:rgba(255,255,255,.26);color:#fff;text-decoration:none;outline:0}.hrm-notification .material-icons{font-size:21px}.hrm-logout{display:inline-flex;margin:0 16px 0 0}.hrm-logout button{height:38px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:9px;padding:7px 12px}.hrm-menu-toggle{display:inline-flex;width:38px;height:38px;flex:0 0 38px;align-items:center;justify-content:center;margin-left:5px;border:0;border-radius:9px;background:rgba(255,255,255,.16);color:#fff}.hrm-menu-toggle:hover,.hrm-menu-toggle:focus{background:rgba(255,255,255,.26);outline:0}.hrm-menu-toggle .material-icons{font-size:23px}.sidebar{top:56px!important;height:calc(100vh - 56px)!important}.sidebar,.sidebar .menu,.sidebar .menu .list{overflow-x:hidden!important}.sidebar .menu .list{width:100%;margin:0}.sidebar .menu .list a{display:flex;align-items:center;gap:10px;width:calc(100% - 20px);box-sizing:border-box}.sidebar .menu .list a i{margin-top:0!important;flex:0 0 24px;width:24px}.sidebar .menu .list a span{margin-left:12px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sidebar .menu .list li.active>a{background:#eaf2ff;color:#1769e0}.hrm-sidebar-overlay{display:none}section.content{margin-top:72px}body.hrm-menu-collapsed .sidebar,html.hrm-menu-collapsed-persisted .sidebar{transform:translateX(-105%)}body.hrm-menu-collapsed section.content,html.hrm-menu-collapsed-persisted section.content{margin-left:22px}
        @@media(max-width:900px){body.hrm-menu-open{overflow:hidden}.navbar{z-index:1003!important}.navbar .container-fluid{height:56px}.navbar .navbar-header{min-width:0;flex:1}.navbar .navbar-brand{min-width:0;margin-left:0!important;padding-left:0;white-space:nowrap}.navbar .pull-right{flex:0 0 auto}.hrm-notification{width:36px;height:36px}.hrm-logout{margin:0 8px 0 0}.hrm-logout button{height:36px;padding:7px 9px}.hrm-logout button .material-icons{margin:0}.hrm-logout-label{display:none}.hrm-menu-toggle{width:38px;height:38px;flex-basis:38px;margin-left:0;margin-right:10px}.sidebar,body.hrm-menu-collapsed .sidebar{display:flex!important;top:56px!important;left:0;width:min(84vw,300px);height:calc(100dvh - 56px)!important;z-index:1002!important;transform:translate3d(-105%,0,0);transition:transform .22s ease;box-shadow:8px 0 24px rgba(15,35,65,.22);visibility:hidden}body.hrm-menu-open .sidebar,body.hrm-menu-open.hrm-menu-collapsed .sidebar{transform:translate3d(0,0,0);visibility:visible}.hrm-sidebar-overlay{position:fixed;inset:56px 0 0;background:rgba(15,23,42,.45);z-index:1001!important}body.hrm-menu-open .hrm-sidebar-overlay{display:block}.sidebar .menu{max-height:none;overscroll-behavior:contain}.sidebar .user-info{height:108px;min-height:108px;flex-basis:108px}section.content,body.hrm-menu-collapsed section.content{width:auto;max-width:none;margin:72px 12px 18px}.hrm-page-header{margin-top:0}.hrm-grid-4,.hrm-grid-3,.hrm-grid-2,.hrm-content-grid{grid-template-columns:1fr!important}}
    </style>
    <script src="~/Content/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/plugins/bootstrap/js/bootstrap.js"></script>
    <script src="~/Scripts/moment.js"></script>
    <script>
        try {
            if (window.innerWidth > 900 && window.localStorage.getItem('hrm-menu-collapsed') === 'true') {
                document.documentElement.classList.add('hrm-menu-collapsed-persisted');
            }
        } catch (ignore) { }
    </script>
</head>
<body class="theme-red">
    <nav class="navbar navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button class="hrm-menu-toggle" type="button" aria-label="Mở menu" aria-controls="leftsidebar" aria-expanded="false"><i class="material-icons">menu</i></button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><img class="hrm-brand-logo" src="~/images/nhigia-logo.png" asp-append-version="true" alt="Nhị Gia" />HRM NHỊ GIA</a>
            </div>
            <div class="pull-right">
                <a class="hrm-notification" asp-controller="Work" asp-action="Notifications" title="Thông báo" aria-label="Mở thông báo"><i class="material-icons">notifications_none</i><span id="hrmNotificationBadge" class="hrm-notification-badge" hidden></span></a>
                <form class="hrm-logout" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"><i class="material-icons" style="font-size:16px;vertical-align:middle">logout</i><span class="hrm-logout-label"> Đăng xuất</span></button>
                </form>
            </div>
        </div>
    </nav>

    <div class="hrm-sidebar-overlay" aria-hidden="true"></div>

    <section>
        <aside id="leftsidebar" class="sidebar">
            <div class="user-info">
                <div class="image"><span class="hrm-avatar">@((user?.DisplayName ?? "NG").Substring(0, Math.Min(2, (user?.DisplayName ?? "NG").Length)).ToUpperInvariant())</span></div>
                <div class="info-container">
                    <div class="name">@user?.DisplayName</div>
                    <div class="email">@user?.DepartmentName</div>
                    <small>@user?.RoleLabel</small>
                </div>
            </div>
            <div class="menu">
                <ul class="list">
                    <li class="header">NGHIỆP VỤ NHÂN SỰ</li>
                    <li class="@(action == "Index" && string.IsNullOrEmpty(workKind) ? "active" : "")"><a asp-controller="Home" asp-action="Index"><i class="material-icons">dashboard</i><span>Tổng quan</span></a></li>
                    <li class="@(action == "MyProfile" ? "active" : "")"><a asp-controller="Home" asp-action="MyProfile"><i class="material-icons">badge</i><span>Hồ sơ của tôi</span></a></li>
                    @if (canManage)
                    {
                        <li class="@(action == "EmployeeInformation" ? "active" : "")"><a asp-controller="Home" asp-action="EmployeeInformation"><i class="material-icons">groups</i><span>@(isManager ? "Nhân sự phòng ban" : "Quản lý nhân sự")</span></a></li>
                    }
                    <li class="@(action == "Attendance" ? "active" : "")"><a asp-controller="Home" asp-action="Attendance"><i class="material-icons">alarm_on</i><span>Chấm công</span></a></li>
                    <li class="@(action == "WorkSchedules" ? "active" : "")"><a asp-controller="Home" asp-action="WorkSchedules"><i class="material-icons">event_note</i><span>@(canManage ? "Phân ca làm việc" : "Lịch làm việc")</span></a></li>
                    <li class="@(action == "LeaveRequests" ? "active" : "")"><a asp-controller="Home" asp-action="LeaveRequests"><i class="material-icons">event_busy</i><span>Nghỉ phép</span></a></li>
                    @if (canManage)
                    {
                        <li class="@(action == "Approvals" ? "active" : "")"><a asp-controller="Home" asp-action="Approvals"><i class="material-icons">fact_check</i><span>Phê duyệt</span></a></li>
                    }
                    <li class="@(action == "InternalCommunications" ? "active" : "")"><a asp-controller="Home" asp-action="InternalCommunications"><i class="material-icons">campaign</i><span>Truyền thông nội bộ</span></a></li>
                    <li class="header">TIỆN ÍCH & ĐIỀU PHỐI</li>
                    <li class="@(workKind == "meeting" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="meeting"><i class="material-icons">meeting_room</i><span>Đặt phòng họp</span></a></li>
                    <li class="@(workKind == "vehicle" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="vehicle"><i class="material-icons">directions_car</i><span>Đặt xe</span></a></li>
                    <li class="@(workKind == "business-trip" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="business-trip"><i class="material-icons">flight_takeoff</i><span>@(isEmployee ? "Công tác của tôi" : "Phân công công tác")</span></a></li>
                    @if (canConfigure)
                    {
                        <li class="@(action == "Reports" ? "active" : "")"><a asp-controller="Home" asp-action="Reports"><i class="material-icons">analytics</i><span>Báo cáo</span></a></li>
                        @if (Configuration.GetValue<bool>("Features:HanetIntegrationUiEnabled"))
                        {
                            <li class="@(action == "HanetIntegration" ? "active" : "")"><a asp-controller="Home" asp-action="HanetIntegration"><i class="material-icons">sync</i><span>Tích hợp HANET</span></a></li>
                        }
                    }
                    <li class="header">@(isEmployee ? "CÔNG VIỆC CỦA TÔI" : "HIỆU SUẤT & HỖ TRỢ")</li>
                    <li class="@(workKind == "kpi" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="kpi"><i class="material-icons">track_changes</i><span>@(isEmployee ? "KPI của tôi" : isManager ? "KPI phòng ban" : "KPI")</span></a></li>
                    <li class="@(workKind == "payroll" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="payroll"><i class="material-icons">payments</i><span>@(isDirector ? "Duyệt bảng lương" : canConfigure ? "Tính lương" : "Phiếu lương")</span></a></li>
                    @if (canConfigure) {
                    <li class="@(workKind == "recruitment" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="recruitment"><i class="material-icons">person_search</i><span>Tuyển dụng</span></a></li>
                    }
                    <li class="@(workKind == "training" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="training"><i class="material-icons">school</i><span>@(isEmployee ? "Đào tạo của tôi" : "Quản lý đào tạo")</span></a></li>
                    <li class="@(workKind == "overtime" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="overtime"><i class="material-icons">more_time</i><span>@(isEmployee ? "Đăng ký tăng ca" : "Quản lý tăng ca")</span></a></li>
                    <li class="@(workKind is "resignation" or "offboarding" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="resignation"><i class="material-icons">person_remove</i><span>@(isEmployee ? "Yêu cầu nghỉ việc" : "Nghỉ việc & thôi việc")</span></a></li>
                    @if (canConfigure) {
                    <li class="@(workKind == "transfer" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="transfer"><i class="material-icons">swap_horiz</i><span>Điều chuyển nhân sự</span></a></li>
                    }
                    <li class="@(workKind == "assets" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="assets"><i class="material-icons">devices</i><span>@(isEmployee ? "Tài sản của tôi" : isManager ? "Tài sản phòng ban" : "Quản lý tài sản")</span></a></li>
                    <li class="@(workKind == "helpdesk" ? "active" : "")"><a asp-controller="Work" asp-action="Index" asp-route-kind="helpdesk"><i class="material-icons">support_agent</i><span>@(isEmployee ? "Yêu cầu Helpdesk IT" : "Helpdesk IT")</span></a></li>
                </ul>
            </div>
            <div class="legal"><div class="copyright">&copy; @DateTime.Now.Year <a asp-controller="Home" asp-action="Index">HRM NHỊ GIA</a></div></div>
        </aside>
    </section>

    <section class="content">@RenderBody()</section>
    <div id="hrmRowPreview" class="hrm-row-preview" role="tooltip" aria-hidden="true"></div>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            var body = document.body;
            var toggle = document.querySelector('.hrm-menu-toggle');
            var overlay = document.querySelector('.hrm-sidebar-overlay');
            var sidebar = document.getElementById('leftsidebar');
            var menu = sidebar && sidebar.querySelector('.menu');
            var scrollStorageKey = 'hrm-sidebar-scroll';
            if (!toggle || !overlay || !sidebar) return;

            function restoreMenuPosition() {
                if (!menu) return;
                try {
                    var storedPosition = Number(window.sessionStorage.getItem(scrollStorageKey));
                    if (Number.isFinite(storedPosition) && storedPosition >= 0) menu.scrollTop = storedPosition;
                } catch (ignore) { }
            }

            function rememberMenuPosition() {
                if (!menu) return;
                try { window.sessionStorage.setItem(scrollStorageKey, String(menu.scrollTop)); } catch (ignore) { }
            }

            function setMenu(open) {
                body.classList.toggle('hrm-menu-open', open);
                updateToggle();
            }

            function updateToggle() {
                var expanded = window.innerWidth <= 900
                    ? body.classList.contains('hrm-menu-open')
                    : !body.classList.contains('hrm-menu-collapsed');
                toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                toggle.setAttribute('aria-label', expanded ? 'Ẩn menu' : 'Mở menu');
                toggle.querySelector('.material-icons').textContent = expanded ? 'menu_open' : 'menu';
            }

            if (window.innerWidth > 900 && window.localStorage.getItem('hrm-menu-collapsed') === 'true') {
                body.classList.add('hrm-menu-collapsed');
            }
            document.documentElement.classList.remove('hrm-menu-collapsed-persisted');
            restoreMenuPosition();
            updateToggle();

            if (menu) menu.addEventListener('scroll', rememberMenuPosition, { passive: true });
            window.addEventListener('pagehide', rememberMenuPosition);

            toggle.addEventListener('click', function () {
                if (window.innerWidth <= 900) {
                    setMenu(!body.classList.contains('hrm-menu-open'));
                    return;
                }
                body.classList.toggle('hrm-menu-collapsed');
                window.localStorage.setItem('hrm-menu-collapsed', body.classList.contains('hrm-menu-collapsed') ? 'true' : 'false');
                updateToggle();
            });
            overlay.addEventListener('click', function () { setMenu(false); });
            sidebar.addEventListener('click', function (event) {
                if (!event.target.closest('a')) return;
                rememberMenuPosition();
                if (window.innerWidth <= 900) setMenu(false);
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') setMenu(false);
            });
            window.addEventListener('resize', function () {
                document.documentElement.classList.remove('hrm-menu-collapsed-persisted');
                setMenu(false);
            });
        })();
    </script>
    <script>
        (function () {
            var badge = document.getElementById('hrmNotificationBadge');
            if (!badge) return;
            fetch('@Url.Action("NotificationCount", "Work")', { credentials: 'same-origin' })
                .then(function (response) { return response.ok ? response.json() : { Count: 0 }; })
                .then(function (data) {
                    var count = Number(data.Count) || 0;
                    badge.textContent = count > 99 ? '99+' : String(count);
                    badge.hidden = count < 1;
                })
                .catch(function () { badge.hidden = true; });
        })();
    </script>
    <script>
        (function () {
            var preview = document.getElementById('hrmRowPreview');
            var activeRow = null;
            var closeTimer = 0;
            if (!preview) return;

            function place(row) {
                var rect = row.getBoundingClientRect();
                var width = Math.min(390, window.innerWidth - 24);
                var left = Math.min(Math.max(12, rect.left + 18), window.innerWidth - width - 12);
                preview.style.width = width + 'px';
                preview.style.left = left + 'px';
                preview.style.top = Math.min(rect.bottom + 8, window.innerHeight - preview.offsetHeight - 12) + 'px';
            }
            function open(row) {
                var source = row && row.querySelector('.hrm-preview-template');
                if (!source) return;
                window.clearTimeout(closeTimer);
                activeRow = row;
                preview.innerHTML = source.innerHTML;
                preview.classList.add('is-visible');
                preview.setAttribute('aria-hidden', 'false');
                row.setAttribute('aria-expanded', 'true');
                place(row);
            }
            function close() {
                if (activeRow) activeRow.setAttribute('aria-expanded', 'false');
                activeRow = null;
                preview.classList.remove('is-visible');
                preview.setAttribute('aria-hidden', 'true');
            }
            function scheduleClose() {
                window.clearTimeout(closeTimer);
                closeTimer = window.setTimeout(function () {
                    if (!(activeRow && activeRow.matches(':hover')) && !preview.matches(':hover')) close();
                }, 120);
            }
            document.addEventListener('mouseover', function (event) {
                var row = event.target.closest && event.target.closest('.hrm-preview-row');
                if (row && row !== activeRow) open(row);
            });
            document.addEventListener('mouseout', function (event) {
                if (event.target.closest && event.target.closest('.hrm-preview-row')) scheduleClose();
            });
            document.addEventListener('focusin', function (event) {
                var row = event.target.closest && event.target.closest('.hrm-preview-row');
                if (row && event.target.matches(':focus-visible') && !event.target.closest('button, a, input, select, textarea')) open(row);
            });
            document.addEventListener('focusout', function (event) {
                if (event.target.closest && event.target.closest('.hrm-preview-row')) scheduleClose();
            });
            document.addEventListener('click', function (event) {
                var row = event.target.closest && event.target.closest('.hrm-preview-row');
                if (!row || event.target.closest('button, a, input, select, textarea, form')) return;
                if (activeRow === row && preview.classList.contains('is-visible')) close(); else open(row);
            });
            preview.addEventListener('mouseenter', function () { window.clearTimeout(closeTimer); });
            preview.addEventListener('mouseleave', scheduleClose);
            window.addEventListener('scroll', function () { if (activeRow) place(activeRow); }, true);
            window.addEventListener('resize', close);
            document.addEventListener('keydown', function (event) { if (event.key === 'Escape') close(); });
        })();
    </script>
</body>
</html>
