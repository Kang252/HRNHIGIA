<section class="hrm-card approval-inbox" aria-labelledby="approvalInboxTitle">
    <div class="hrm-card-header approval-inbox-head">
        <div>
            <h2 id="approvalInboxTitle" class="hrm-card-title">Chờ bạn duyệt <span id="approvalInboxCount" class="approval-inbox-count">…</span></h2>
            <p class="hrm-card-subtitle">Tất cả đơn và nghiệp vụ đang chờ đúng bạn quyết định. Tiền và nhân sự phải duyệt từng phiếu; bảng lương duyệt cả kỳ.</p>
        </div>
        <div class="approval-inbox-tools">
            <button type="button" class="hrm-btn" id="refreshApprovalInbox"><i class="material-icons">refresh</i> Làm mới</button>
            <button type="button" class="hrm-btn hrm-btn-primary" id="approveAllRequests" style="display:none" disabled><i class="material-icons">done_all</i> Duyệt các đơn thường</button>
        </div>
    </div>
    <div id="approvalInboxFilters" class="approval-inbox-filters" hidden></div>
    <div id="approvalInboxMessage" class="approval-inbox-message" role="status"></div>
    <div id="approvalInboxRows" class="approval-inbox-list"></div>
</section>
<style>
.approval-inbox{margin-bottom:24px}
.approval-inbox-head{display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.approval-inbox-count{display:inline-block;min-width:26px;padding:1px 8px;border-radius:999px;background:var(--hrm-primary-soft);color:var(--hrm-primary);font-size:13px;text-align:center}
.approval-inbox-tools{display:flex;gap:8px;flex-wrap:wrap}
.approval-inbox-filters{display:flex;gap:6px;flex-wrap:wrap;padding:12px 24px 0}
.approval-inbox-filters[hidden]{display:none}
.approval-inbox-filters button{padding:5px 12px;border:1px solid var(--hrm-border);border-radius:999px;background:#fff;color:var(--hrm-text);font-size:12.5px;cursor:pointer}
.approval-inbox-filters button[aria-pressed=true]{border-color:var(--hrm-primary);background:var(--hrm-primary-soft);color:var(--hrm-primary);font-weight:600}
.approval-inbox-message{padding:12px 24px;color:var(--hrm-muted)}
.approval-inbox-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;padding:12px 24px 20px}
.approval-inbox-list:empty{display:none}
.approval-card{display:flex;flex-direction:column;gap:8px;min-width:0;padding:14px 16px;border:1px solid var(--hrm-border);border-radius:12px;background:#fff}
.approval-card-top{display:flex;justify-content:space-between;gap:8px;color:var(--hrm-muted);font-size:12px}
.approval-card-type{padding:1px 9px;border-radius:999px;background:var(--hrm-primary-soft);color:var(--hrm-primary);font-weight:600}
.approval-card-type.is-sensitive{background:#fff5df;color:#8c6200}
.approval-card h3{margin:0;font-size:15px;font-weight:700;line-height:1.35}
.approval-card h3 small{display:block;color:var(--hrm-muted);font-size:12.5px;font-weight:400}
.approval-card-when{font-size:14px;font-weight:600}
.approval-card ul{margin:0;padding:0;list-style:none;font-size:13px;line-height:1.55}
.approval-card li,.approval-card-text{overflow-wrap:anywhere}
.approval-card details summary{color:var(--hrm-primary);font-size:13px;cursor:pointer}
.approval-card-text{margin-top:6px;max-height:220px;overflow:auto;font-size:13px;white-space:pre-wrap}
.approval-card-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:auto}
.approval-card-actions.is-single{grid-template-columns:1fr}
.approval-card-actions .hrm-btn{justify-content:center;min-height:40px}
@@media(max-width:600px){
    .approval-inbox-list{grid-template-columns:minmax(0,1fr);padding:12px 14px 14px}
    .approval-inbox-filters{padding:12px 14px 0}
    .approval-inbox-message{padding:12px 14px}
    .approval-inbox-tools,.approval-inbox-tools .hrm-btn{width:100%}
}
</style>
<script>
(function () {
    var items = [], busy = false, filter = '';
    var esc = HrmRequestForm.escapeHtml;
    var rows = $('#approvalInboxRows'), message = $('#approvalInboxMessage'), all = $('#approveAllRequests'),
        filters = $('#approvalInboxFilters'), counter = $('#approvalInboxCount');

    function shown() { return items.filter(function (x) { return !filter || x.RequestType === filter; }); }
    function routine() { return shown().filter(function (x) { return x.IsRoutine; }); }
    function countByType(list) {
        var kinds = {};
        list.forEach(function (x) { kinds[x.RequestType] = (kinds[x.RequestType] || 0) + 1; });
        return kinds;
    }
    function card(item) {
        var index = items.indexOf(item), facts = item.Facts || [];
        var sent = item.CreatedAt ? 'gửi ' + moment(item.CreatedAt).format('DD/MM HH:mm') : '';
        return '<article class="approval-card">' +
            '<div class="approval-card-top"><span class="approval-card-type' + (item.IsRoutine ? '' : ' is-sensitive') + '">' + esc(item.RequestType) + '</span><span>' + esc(item.Code) + '</span></div>' +
            '<h3>' + esc(item.EmployeeName || '—') + '<small>' + esc([item.DepartmentName, sent].filter(Boolean).join(' · ')) + '</small></h3>' +
            (item.When ? '<div class="approval-card-when">' + esc(item.When) + '</div>' : '') +
            (facts.length ? '<ul>' + facts.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>' : '') +
            '<details><summary>Xem nội dung</summary><div class="approval-card-text"><strong>' + esc(item.Title) + '</strong>\n' + esc(item.Description || 'Không có ghi chú.') +
                (item.HasAttachment ? '\n<a href="@Url.Action("LeaveAttachment", "Hrm")?id=' + Number(item.Id) + '" target="_blank" rel="noopener">' + esc(item.AttachmentName || 'Tệp đính kèm') + '</a>' : '') + '</div></details>' +
            (item.Url ? '<div class="approval-card-actions is-single"><a class="hrm-btn hrm-btn-primary" href="' + esc(item.Url) + '">Mở để duyệt</a></div>'
                : '<div class="approval-card-actions"><button type="button" class="hrm-btn" data-inbox-index="' + index + '" data-decision="reject">Từ chối</button>' +
                '<button type="button" class="hrm-btn hrm-btn-primary" data-inbox-index="' + index + '" data-decision="approve">Duyệt</button></div>') + '</article>';
    }
    function draw() {
        var kinds = countByType(items), names = Object.keys(kinds);
        if (filter && !kinds[filter]) filter = '';
        filters.prop('hidden', names.length < 2).html([''].concat(names).map(function (name) {
            return '<button type="button" data-filter="' + esc(name) + '" aria-pressed="' + (filter === name) + '">' +
                (name ? esc(name) + ' (' + kinds[name] + ')' : 'Tất cả (' + items.length + ')') + '</button>';
        }).join(''));
        rows.html(shown().map(card).join(''));
        counter.text(items.length);
        message.text(items.length ? '' : 'Không có yêu cầu nào đang chờ bạn duyệt.').toggle(!items.length);
        var bulk = routine().length;
        all.toggle(bulk > 0).prop('disabled', busy).html('<i class="material-icons">done_all</i> Duyệt các đơn thường' + ' (' + bulk + ')');
    }
    function refresh() {
        all.prop('disabled', true);
        $.get('@Url.Action("ApprovalInbox", "Hrm")').done(function (res) { items = res.Data || []; draw(); })
            .fail(function (xhr) {
                items = []; rows.empty(); filters.prop('hidden', true); counter.text('!');
                message.show().text(xhr.responseJSON?.Message || 'Không tải được danh sách phê duyệt. Vui lòng thử lại.');
            });
    }
    function decide(url, data) {
        if (busy) return;
        busy = true; rows.find('button').prop('disabled', true); all.prop('disabled', true);
        data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').first().val();
        $.ajax({ url: url, method: 'POST', data: data, traditional: true }).done(function (res) {
            var errors = res.Data && res.Data.Errors;
            if (errors && errors.length) alert('Đã duyệt ' + res.Data.Count + ' đơn. Chưa xử lý được:\n' + errors.join('\n'));
            window.dispatchEvent(new Event('hrm-approvals-changed'));
        }).fail(function (xhr) { alert(xhr.responseJSON?.Message || 'Chưa thể xử lý yêu cầu. Hãy tải lại để kiểm tra trạng thái.'); })
            .always(function () { busy = false; refresh(); });
    }
    rows.on('click', '[data-inbox-index]', function () {
        var item = items[Number(this.dataset.inboxIndex)], approve = this.dataset.decision === 'approve';
        if (approve && !item.IsRoutine && !confirm('Duyệt ' + item.RequestType.toLowerCase() + ' ' + item.Code + ' của ' + (item.EmployeeName || '') + '?')) return;
        var note = approve ? '' : prompt('Lý do từ chối ' + item.Code + ':');
        if (!approve && !note?.trim()) return;
        decide('@Url.Action("DecideApproval", "Hrm")', { Source: item.Source, Kind: item.Kind, Id: item.Id, Approve: approve, Note: note });
    });
    filters.on('click', '[data-filter]', function () { filter = this.dataset.filter; draw(); });
    all.on('click', function () {
        var list = routine(), kinds = countByType(list);
        if (confirm('Duyệt ' + list.length + ' đơn đang hiển thị?\n' + Object.keys(kinds).map(function (x) { return '• ' + x + ': ' + kinds[x]; }).join('\n')))
            decide('@Url.Action("ApproveAllRequests", "Hrm")', { keys: list.map(function (x) { return x.Key; }) });
    });
    $('#refreshApprovalInbox').on('click', refresh);
    window.addEventListener('hrm-procedures-changed', refresh);
    refresh();
})();
</script>
