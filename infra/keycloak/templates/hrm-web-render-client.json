{
  "clientId": "hrm-web",
  "name": "Nhị Gia HRM production",
  "description": "Confidential OIDC client for NHIGIA.Modern on Render.",
  "rootUrl": "https://hrnhigia.onrender.com",
  "baseUrl": "https://hrnhigia.onrender.com",
  "enabled": true,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "publicClient": false,
  "clientAuthenticatorType": "client-secret",
  "frontchannelLogout": true,
  "protocol": "openid-connect",
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://hrnhigia.onrender.com/signout-callback-oidc"
  },
  "redirectUris": [
    "https://hrnhigia.onrender.com/signin-oidc"
  ],
  "webOrigins": [
    "https://hrnhigia.onrender.com"
  ],
  "defaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ]
}
