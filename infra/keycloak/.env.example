# Local development only. Copy this file to infra/keycloak/.env and replace both passwords
# before the first startup. Do not commit the copied .env file.
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-this-before-first-start
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-before-first-start
