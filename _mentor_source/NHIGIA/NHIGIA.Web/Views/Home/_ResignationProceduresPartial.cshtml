<div id="KenWindownResignationProcedures" class="k-window-content KenWindownPopup" style="display:none;">
    <div class="content" style="margin: 0 0 15px 0;">
        <div class="row m-t--10">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <label>
                    Ngày dự kiến thôi việc <span class="asterisk">*</span>
                </label>
                <input kendo-date-picker
                       class="form-control date-picker-style"
                       k-format="'dd/MM/yyyy'"
                       onkeydown="return true;"
                       k-ng-model="modelResignationProcedures.ExpectedResignationDate"
                       id="ExpectedResignationDate"
                       name="ExpectedResignationDate"
                       ng-model="modelResignationProcedures.ExpectedResignationDate"
                       placeholder="dd/MM/yyyy">
            </div>
        </div>
    </div>
    <hr />
    <div class="footer">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <button type="button"
                        id="btnSaveResignationProcedures"
                        class="btn btn-primary waves-effect float-right m-l-5"
                        ng-click="SaveResignationProcedures()"
                        disabled>
                    <i class="material-icons">save</i><span class="icon-name">Đồng ý</span>
                </button>
                <button type="button"
                        class="btn bg-grey waves-effect float-right m-l-5"
                        id="btnCloseResignationProcedures"
                        ng-click="CloseResignationProcedures()"
                        disabled>
                    <i class="material-icons">close</i><span class="icon-name">Huỷ bỏ</span>
                </button>
            </div>
        </div>
    </div>
</div>