<script src="@Url.Content("~/Scripts/app/controller/EmployeesOnBusinessTripPaymentsController.js")"></script>
<div class="container-fluid" ng-controller="EmployeesOnBusinessTripPaymentsController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-click="ShowPopupEmployeesOnBusinessTripPayments('ADD_EMPLOYEESONBUSINESSTRIPPAYMENTS')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:100px;">Khoản chi</th>
                            <th style="max-width:100px;">Số chứng từ</th>
                            <th style="max-width:100px;">Ngày chứng từ</th>
                            <th style="max-width:100px;">Số tiền đã chi</th>
                            <th style="max-width: 150px;">Ghi chú</th>
                            <th ng-if="GetAllEmployeesOnBusinessTripPayments.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllEmployeesOnBusinessTripPayments.length > 0" ng-repeat="item in GetAllEmployeesOnBusinessTripPayments">
                            <td>{{item.Expenses}}</td>
                            <td>{{item.VoucherNumber}}</td>
                            <td>{{item.DayVouchersString}}</td>
                            <td>{{item.AmountSpent}}</td>
                            <td>{{item.Note}}</td>
                            <td>
                                <a ng-click="ShowPopupEmployeesOnBusinessTripPayments('EDIT_EMPLOYEESONBUSINESSTRIPPAYMENTS',item.Id)"><i class="material-icons" style="color:#0c68b4;">mode_edit</i></a>
                                <a ng-click="ShowPopupEmployeesOnBusinessTripPayments('DELETE_EMPLOYEESONBUSINESSTRIPPAYMENTS',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllEmployeesOnBusinessTripPayments.length === 0">
                            <td colspan="5" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("EmployeesOnBusinessTripPayments", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidEmployeesOnBusinessTripPayments", @id = "ValidEmployeesOnBusinessTripPayments", @novalidate = "novalidate" }))
    {
        <div id="KenWindownEmployeesOnBusinessTripPayments" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="margin: 0 0 15px 0;">
                <div class="row m-t--10">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Khoản chi <span class="asterisk">*</span>
                        </label>
                        <input class="form-control"
                               name="ExpensesEmployeesOnBusinessTripPayments"
                               id="ExpensesEmployeesOnBusinessTripPayments"
                               maxlength="50"
                               ng-model="modelEmployeesOnBusinessTripPayments.Expenses"
                               ng-class="{'has-error': showHasErrorExpensesEmployeesOnBusinessTripPayments}"
                               title="{{MessageErrorForInput}}"
                               ng-change="onChangeValueEmployeesOnBusinessTripPayments('Expenses')"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Số chứng từ
                        </label>
                        <input class="form-control"
                               name="VoucherNumber"
                               id="VoucherNumber"
                               maxlength="50"
                               ng-model="modelEmployeesOnBusinessTripPayments.VoucherNumber"
                               numbers-Only
                               autocomplete="off" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Ngày chứng từ
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelEmployeesOnBusinessTripPayments.DayVouchers"
                               id="DayVouchers"
                               name="DayVouchers"
                               ng-model="modelEmployeesOnBusinessTripPayments.DayVouchers"
                               placeholder="dd/MM/yyyy">
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Số tiền đã chi
                        </label>
                        <input class="form-control"
                               name="AmountSpent"
                               id="AmountSpent"
                               ng-model="modelEmployeesOnBusinessTripPayments.AmountSpent"
                               min="0"
                               max="999999999999999"
                               number-format
                               maxlength="15"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Ghi chú
                        </label>
                        <textarea class="form-control"
                                  name="NoteEmployeesOnBusinessTripPayments"
                                  id="NoteEmployeesOnBusinessTripPayments"
                                  ng-model="modelEmployeesOnBusinessTripPayments.Note"
                                  maxlength="100"
                                  autocomplete="off"
                                  rows="5"></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveEmployeesOnBusinessTripPayments"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-click="SaveEmployeesOnBusinessTripPayments()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseEmployeesOnBusinessTripPayments"
                                ng-click="CloseEmployeesOnBusinessTripPayments()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>