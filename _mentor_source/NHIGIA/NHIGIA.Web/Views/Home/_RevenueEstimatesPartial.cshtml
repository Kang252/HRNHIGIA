<script src="@Url.Content("~/Scripts/app/controller/EmployeesOnBusinessTripRevenueEstimatesController.js")"></script>
<div class="container-fluid" ng-controller="EmployeesOnBusinessTripRevenueEstimatesController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right" ng-click="ShowPopupEmployeesOnBusinessTripRevenueEstimates('ADD_EMPLOYEESONBUSINESSTRIPREVENUEESTIMATES')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:150px;">Khoản thu</th>
                            <th style="max-width:150px;">Số tiền</th>
                            <th style="max-width: 200px;">Ghi chú</th>
                            <th ng-if="GetAllEmployeesOnBusinessTripRevenueEstimates.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllEmployeesOnBusinessTripRevenueEstimates.length > 0" ng-repeat="item in GetAllEmployeesOnBusinessTripRevenueEstimates">
                            <td>{{item.Revenue}}</td>
                            <td>{{item.AmountOfMoney}}</td>
                            <td>{{item.Note}}</td>
                            <td>
                                <a ng-click="ShowPopupEmployeesOnBusinessTripRevenueEstimates('EDIT_EMPLOYEESONBUSINESSTRIPREVENUEESTIMATES',item.Id)"><i class="material-icons" style="color:#0c68b4;">mode_edit</i></a>
                                <a ng-click="ShowPopupEmployeesOnBusinessTripRevenueEstimates('DELETE_EMPLOYEESONBUSINESSTRIPREVENUEESTIMATES',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllEmployeesOnBusinessTripRevenueEstimates.length === 0">
                            <td colspan="3" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("EmployeesOnBusinessTripRevenueEstimates", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidEmployeesOnBusinessTripRevenueEstimates", @id = "ValidEmployeesOnBusinessTripRevenueEstimates", @novalidate = "novalidate" }))
    {
        <div id="KenWindownEmployeesOnBusinessTripRevenueEstimates" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="margin: 0 0 15px 0;">
                <div class="row m-t--10">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Khoản thu <span class="asterisk">*</span>
                        </label>
                        <input class="form-control"
                               name="Revenue"
                               id="Revenue"
                               maxlength="50"
                               ng-model="modelEmployeesOnBusinessTripRevenueEstimates.Revenue"
                               ng-class="{'has-error': showHasErrorRevenue}"
                               title="{{MessageErrorForInput}}"
                               ng-change="onChangeValueEmployeesOnBusinessTripRevenueEstimates('Revenue')"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Số tiền
                        </label>
                        <input class="form-control"
                               name="AmountOfMoney"
                               id="AmountOfMoney"
                               ng-model="modelEmployeesOnBusinessTripRevenueEstimates.AmountOfMoney"
                               min="0"
                               max="999999999999999"
                               number-format
                               maxlength="15"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label>
                            Ghi chú
                        </label>
                        <textarea class="form-control"
                                  name="NoteEmployeesOnBusinessTripRevenueEstimates"
                                  id="NoteEmployeesOnBusinessTripRevenueEstimates"
                                  ng-model="modelEmployeesOnBusinessTripRevenueEstimates.Note"
                                  maxlength="100"
                                  autocomplete="off"
                                  rows="5"></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveEmployeesOnBusinessTripRevenueEstimates"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-click="SaveEmployeesOnBusinessTripRevenueEstimates()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseEmployeesOnBusinessTripRevenueEstimates"
                                ng-click="CloseEmployeesOnBusinessTripRevenueEstimates()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>