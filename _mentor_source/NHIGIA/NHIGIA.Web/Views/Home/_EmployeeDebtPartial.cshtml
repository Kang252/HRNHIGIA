<script src="@Url.Content("~/Scripts/app/controller/ResignationProceduresEmployeeDebtController.js")"></script>
<div class="container-fluid" ng-controller="ResignationProceduresEmployeeDebtController">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 p-r-0 p-l-0">
            <div class="card box-shadow-none">
                <button type="button" class="btn add-action-text m-r-0 m-b-10 float-right add_hide" ng-click="ShowPopupResignationProceduresEmployeeDebt('ADD_RESIGNATIONPROCEDURESEMPLOYEEDEBT')"><i class="material-icons">add_circle</i><span class="icon-name">Thêm</span></button>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="max-width:125px;">Trạng thái</th>
                            <th style="max-width:200px;">Ngày hoàn thành</th>
                            <th style="max-width:180px;">Tên khoản công nợ</th>
                            <th style="max-width: 180px;">Số tiền</th>
                            <th ng-if="GetAllResignationProceduresEmployeeDebt.length > 0" style="width:85px; min-width:85px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="GetAllResignationProceduresEmployeeDebt.length > 0" ng-repeat="item in GetAllResignationProceduresEmployeeDebt">
                            <td>
                                <div class="statusIconGreen" ng-if="item.Accomplished === true"></div>
                                <div class="statusIconGray" ng-if="item.Accomplished === false"></div>
                                {{item.AccomplishedString}}
                            </td>
                            <td>{{item.FinishDayString}}</td>
                            <td>{{item.NameOfTheDebtName}}</td>
                            <td>{{item.AmountOfMoney}}</td>
                            <td>
                                <a ng-click="ShowPopupResignationProceduresEmployeeDebt('EDIT_RESIGNATIONPROCEDURESEMPLOYEEDEBT',item.Id)"><i class="material-icons" style="color:#0c68b4;">mode_edit</i></a>
                                <a ng-click="ShowPopupResignationProceduresEmployeeDebt('DELETE_RESIGNATIONPROCEDURESEMPLOYEEDEBT',item.Id)"><i class="material-icons" style="color:#E55B5C;">close</i></a>
                            </td>
                        </tr>
                        <tr ng-if="GetAllResignationProceduresEmployeeDebt.length === 0">
                            <td colspan="4" align="center">Không có dữ liệu</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @using (Ajax.BeginForm("ResignationProceduresEmployeeDebt", "Home", null, new AjaxOptions { HttpMethod = "POST" }, new { @name = "ValidResignationProceduresEmployeeDebt", @id = "ValidResignationProceduresEmployeeDebt", @novalidate = "novalidate" }))
    {
        <div id="KenWindownResignationProceduresEmployeeDebt" class="k-window-content KenWindownPopup" style="display:none;">
            <div class="content" style="margin: 0 0 15px 0;">
                <div class="row m-t--10">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Tên khoản công nợ <span class="asterisk">*</span>
                        </label>
                        <select kendo-drop-down-list
                                id="NameOfTheDebtId"
                                name="NameOfTheDebtId"
                                ng-model="modelResignationProceduresEmployeeDebt.NameOfTheDebtId"
                                k-data-source="NameOfTheDebtDropdownlist"
                                k-data-text-field="'Name'"
                                k-data-value-field="'Id'"
                                k-filter="'contains'"
                                class="Dropdownlist-Custom"
                                ng-class="{'has-error': showHasErrorNameOfTheDebtId}"
                                title="{{MessageErrorForSelect}}"
                                ng-change="onChangeValueResignationProceduresEmployeeDebt('NameOfTheDebtId')"></select>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label>
                            Số tiền
                        </label>
                        <input class="form-control"
                               name="AmountOfMoney"
                               id="AmountOfMoney"
                               ng-model="modelResignationProceduresEmployeeDebt.AmountOfMoney"
                               min="0"
                               max="999999999999999"
                               number-format
                               maxlength="15"
                               autocomplete="off" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 p-r-0">
                        <label>
                            Ngày hoàn thành
                        </label>
                        <input kendo-date-picker
                               class="form-control date-picker-style"
                               k-format="'dd/MM/yyyy'"
                               onkeydown="return true;"
                               k-ng-model="modelResignationProceduresEmployeeDebt.FinishDay"
                               id="FinishDay"
                               name="FinishDay"
                               ng-model="modelResignationProceduresEmployeeDebt.FinishDay"
                               placeholder="dd/MM/yyyy">
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <label style="width:100%;">&nbsp;</label>
                        <div class="demo-checkbox">
                            <input type="checkbox" id="Accomplished" class="filled-in chk-col-blue" ng-model="modelResignationProceduresEmployeeDebt.Accomplished" />
                            <label class="m-t-5 checkbox_label_popup" for="Accomplished">Đã hoàn thành</label>
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="footer">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <button type="button"
                                id="btnSaveResignationProceduresEmployeeDebt"
                                class="btn btn-primary waves-effect float-right m-l-5"
                                ng-click="SaveResignationProceduresEmployeeDebt()"
                                disabled>
                            <i class="material-icons">save</i><span class="icon-name">Lưu</span>
                        </button>
                        <button type="button"
                                class="btn bg-grey waves-effect float-right m-l-5"
                                id="btnCloseResignationProceduresEmployeeDebt"
                                ng-click="CloseResignationProceduresEmployeeDebt()"
                                disabled>
                            <i class="material-icons">close</i><span class="icon-name">Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
