# HTTP listener
NODE_ENV=development
PORT=10000
HOST=0.0.0.0
# Render terminates TLS at one trusted proxy. Set 0 only for a direct local
# listener that must ignore forwarded client IP headers.
TRUST_PROXY_HOPS=1
API_PREFIX=api/v1
LOG_LEVEL=log
CLIENT_APP_DIR=

# Keep false until a non-production database is explicitly configured.
# The API can start with database disabled so the health and authentication-boundary
# behavior can be checked safely.
DB_ENABLED=false
DB_CONNECT_ON_STARTUP=false
# Optional connection-string source. DB_CONNECTION_STRING takes precedence.
# ConnectionStrings__MainConnectionString is accepted only for a verified,
# compatible SQL-login secret; do not copy a legacy C# production secret that
# uses TrustServerCertificate=True. Do not set both unless they are identical.
# Supports Server/Data Source, Database/Initial Catalog, User Id, Password,
# Encrypt, TrustServerCertificate, Connect Timeout, Command Timeout and pool sizes.
DB_CONNECTION_STRING=
ConnectionStrings__MainConnectionString=
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=DEV_NHIGIA
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECT_TIMEOUT_MS=5000
DB_REQUEST_TIMEOUT_MS=15000
DB_POOL_MIN=0
DB_POOL_MAX=10

# NHIGIA.Api authenticates directly against the existing HrmUserAccount hashes,
# then writes an opaque server-side session to HrmApiSession. Run the SQL migration
# in sql/001_api_sessions.sql before enabling this in a shared environment.
# Remain disabled until DB_ENABLED and the session migration are intentionally
# enabled. Production validation rejects this value.
AUTH_MODE=disabled
SESSION_COOKIE_NAME=NHIGIA.Api.Session
SESSION_TTL_HOURS=8
SESSION_REMEMBER_ME_TTL_HOURS=168
# Per-process protection for direct password login. When scaling beyond one
# instance, enforce an equivalent shared limit at the gateway or Redis layer.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_MAX_TRACKED_KEYS=5000

# Optional future bridge. The ASP.NET Core cookie NHIGIA.Auth.v3 is Microsoft
# Data Protection encrypted and must never be parsed by NestJS.
AUTH_PROXY_SHARED_SECRET=
AUTH_PROXY_MAX_SKEW_SECONDS=60
